---
import "../styles/globals.css";

import BrandLogo from "../components/BrandLogo.astro";
import { currentYearWIB } from "../lib/date";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number | string;
  imageHeight?: number | string;
  twitterCard?: string;
  type?: string;
  canonical?: string;
  hideBreadcrumbs?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
}

// Affiliate publisher ID — displayed as-is in the header.
// NOTE: This is NOT a coupon count. Do NOT reformat, do NOT replace with data.
const affiliateNumber = "679990";

const siteUrl = import.meta.env.SITE || "https://courseswyn.com";
const currentYear = currentYearWIB();
const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const currentMonth = months[new Date().getMonth()];
const currentMonthYear = `${currentMonth} ${currentYear}`;

const {
  title = "Udemy Coupon Codes & Discounts " + currentMonthYear + " | CoursesWyn",
  description = "Find verified Udemy coupon codes and discounts " + currentMonthYear + " — save up to 95% on premium courses across IT, Development, Business & more. Updated daily.",
  image,
  imageWidth,
  imageHeight,
  twitterCard,
  type = "website",
  canonical,
  pubDate,
  updatedDate,
  hideBreadcrumbs = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const absoluteImageUrl = image ? (image.startsWith('http') ? image : new URL(image, siteUrl).href) : new URL('/assets/images/og-default.svg', siteUrl).href;

// Tipe MIME yang benar untuk scraper sosmed (FB/X/WA menolak tipe yang salah).
function detectImageType(url: string): string {
  const clean = url.split('?')[0].toLowerCase();
  if (clean.endsWith('.png')) return 'image/png';
  if (clean.endsWith('.webp')) return 'image/webp';
  if (clean.endsWith('.gif')) return 'image/gif';
  if (clean.endsWith('.svg')) return 'image/svg+xml';
  return 'image/jpeg';
}
const ogImageType = detectImageType(absoluteImageUrl);

// Dimensi: prop eksplisit menang; avatar instructor Udemy (200_H) = 200x200;
// default SVG/landscape = 1200x630. Dimensi yang jujur mencegah scraper menolak gambar.
const isUdemyAvatar = /\/user\/.*200_H/.test(absoluteImageUrl);
const ogImageWidth = String(imageWidth ?? (isUdemyAvatar ? 200 : 1200));
const ogImageHeight = String(imageHeight ?? (isUdemyAvatar ? 200 : 630));

// Avatar kecil/persegi pakai `summary` agar pasti tampil di X/Twitter
// (summary_large_image butuh min. 300x157 dan crop buruk untuk foto profil).
const resolvedTwitterCard = twitterCard ?? (isUdemyAvatar ? 'summary' : 'summary_large_image');

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [{
    "@type": "Organization",
    "@id": "https://courseswyn.com/#organization",
    "name": "CoursesWyn",
    "url": "https://courseswyn.com",
    "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 },
    "description": "Find verified Udemy courses with coupon discounts.",
    "foundingDate": "2024",
    "sameAs": ["https://www.facebook.com/CoursesWyn", "https://x.com/CoursesWyn", "https://medium.com/@coursewyn"],
    "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "url": "https://courseswyn.com/contact" }
  },
  {
    "@type": "WebSite",
    "@id": "https://courseswyn.com/#website",
    "name": "CoursesWyn",
    "url": "https://courseswyn.com",
    "description": "Find verified Udemy coupon codes & discounts. Daily updated deals for online learning.",
    "publisher": { "@id": "https://courseswyn.com/#organization" },
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://courseswyn.com/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@type": "SiteNavigationElement",
    "name": "Main Navigation",
    "hasPart": [
      { "@type": "SiteNavigationElement", "name": "Udemy Coupons", "url": "https://courseswyn.com/udemy-coupon-code" },
      { "@type": "SiteNavigationElement", "name": "Today's Coupons", "url": "https://courseswyn.com/udemy-coupons-today" },
      { "@type": "SiteNavigationElement", "name": "Categories", "url": "https://courseswyn.com/categories" },
      { "@type": "SiteNavigationElement", "name": "Topics", "url": "https://courseswyn.com/topics" },
      { "@type": "SiteNavigationElement", "name": "Instructors", "url": "https://courseswyn.com/instructors" },
      { "@type": "SiteNavigationElement", "name": "Popular Courses", "url": "https://courseswyn.com/popular" },
      { "@type": "SiteNavigationElement", "name": "Blog", "url": "https://courseswyn.com/blog" },
      { "@type": "SiteNavigationElement", "name": "Compare Platforms", "url": "https://courseswyn.com/platforms" },
      { "@type": "SiteNavigationElement", "name": "Coupon Guide", "url": "https://courseswyn.com/udemy-coupons-guide" }
    ]
  }]
};
const jsonLdHtml = JSON.stringify(jsonLdGraph);

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="440e92a0ff41e1b5" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8220442576502761" crossorigin="anonymous"></script>

    <meta name="theme-color" content="#ffffff" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.ampproject.org https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://ipapi.co https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; object-src 'none'; base-uri 'self'" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CoursesWyn" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://img-c.udemycdn.com" />

    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="alternate" type="application/rss+xml" title="CoursesWyn Blog RSS Feed" href={`${siteUrl}/rss.xml`} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {type === "article" && <meta property="article:author" content="Andrew Derek" />}
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="revisit-after" content="1 days" />
    <meta name="language" content="English" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="classification" content="Education, Online Learning, Course Deals" />
    <meta name="category" content="Education" />

    <script type="application/ld+json" set:html={jsonLdHtml}></script>

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CoursesWyn" />
    <meta property="og:locale" content="en_US" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    {absoluteImageUrl && <meta property="og:image:alt" content={title} />}
    <meta property="og:image:type" content={ogImageType} />

    <meta name="twitter:card" content={resolvedTwitterCard} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@CoursesWyn" />
    <meta property="twitter:creator" content="@CoursesWyn" />
    {absoluteImageUrl && <meta property="twitter:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="twitter:image:alt" content={title} />}

    <meta name="author" content="Andrew Derek" />
    <meta property="article:author" content="Andrew Derek" />
    <meta property="article:publisher" content="https://courseswyn.com" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <style>
      .site-header {
        background: #0b0e14;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .skip-link { position: absolute; top: -100%; left: 8px; background: var(--brand); color: #fff; padding: 8px 16px; border-radius: 0 0 8px 8px; z-index: 9999; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: top 0.2s; }
      .skip-link:focus { top: 0; }
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;
      }
      h1, h2, h3, h4, h5, h6 { font-family: inherit; color: var(--text); }
      h1 { font-size: clamp(2.5rem, 4.5vw, 4rem); font-weight: 800; line-height: 1.2; letter-spacing: -0.02em; }
      h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 800; line-height: 1.3; letter-spacing: -0.01em; }
      h3 { font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 700; line-height: 1.5; }
      h4 { font-size: clamp(1.1rem, 1.5vw, 1.25rem); font-weight: 700; line-height: 1.5; }
      h5 { font-size: clamp(1rem, 1.3vw, 1.1rem); font-weight: 700; line-height: 1.5; }
      h6 { font-size: 1.0625rem; font-weight: 600; line-height: 1.55; }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
      }
      .brand-name {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--text);
        line-height: 1.2;
      }
      .brand-tagline {
        font-size: 0.62rem;
        color: var(--muted);
        font-weight: 500;
        letter-spacing: 0.03em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        gap: 2px;
        align-items: center;
        justify-content: flex-start;
      }
      .nav-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        border: 1px solid var(--brand-soft);
        background: transparent;
        transition: all 0.25s ease;
        white-space: nowrap;
        position: relative;
      }
      .nav-item::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #0b0e14, #FFC94D, #FFC94D);
        border-radius: 1px;
        transition: all 0.3s ease;
      }
      .nav-item:hover {
        background: var(--brand-soft);
        border-color: rgba(76, 195, 138, 0.3);
      }
      .nav-item:hover::after {
        width: 60%;
      }
      .nav-item.active {
        background: rgba(76, 195, 138, 0.18);
        border-color: rgba(76, 195, 138, 0.4);
      }
      .nav-item.active::after {
        width: 60%;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }
      .search-form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 7px 14px;
        width: 280px;
        transition: all 0.3s ease;
        cursor: text;
        position: relative;
      }
      .search-form:hover {
        border-color: rgba(76, 195, 138, 0.4);
        background: var(--bg-secondary);
      }
      .search-form:focus-within {
        border-color: var(--brand);
        background: var(--bg-secondary);
        box-shadow: 0 0 28px -6px rgba(255,201,77,0.3);
      }
      .nav-count {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .nav-count::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #FFC94D;
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }

      .nav-more { position: relative; }
      .nav-more summary { list-style: none; cursor: pointer; }
      .nav-more summary::-webkit-details-marker { display: none; }
      .nav-more-toggle { border-color: transparent; background: transparent; }
      .nav-more-caret { transition: transform 0.2s; }
      .nav-more[open] .nav-more-caret { transform: rotate(180deg); }
      .nav-more-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        min-width: 180px;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 6px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.5);
        z-index: 50;
      }
      .nav-more-menu a {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        transition: all 0.15s;
        white-space: nowrap;
      }
      .nav-more-menu a:hover { background: var(--brand-soft); color: var(--brand); }

      .nav-hamburger {
        display: none;
        flex-direction: column;
        gap: 4px;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        padding: 0;
      }
      .nav-hamburger span {
        width: 18px;
        height: 2px;
        background: var(--text);
        border-radius: 1px;
        transition: all 0.2s;
      }
      .nav-hamburger.open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
      .nav-hamburger.open span:nth-child(2) { opacity: 0; }
      .nav-hamburger.open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

      .nav-mobile { display: none; }
      .nav-mobile[hidden] { display: none !important; }

      @media (max-width: 1024px) {
        .nav-links { display: none; }
        .search-form { display: none; }
        .nav-hamburger { display: flex; }
        .nav-count { display: none; }
        .nav-mobile { display: block; position: absolute; top: 70px; left: 0; right: 0; background: var(--bg); border-bottom: 1px solid var(--border); padding: 1rem 1.5rem 1.25rem; z-index: 60; box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.4); }
        .nav-mobile[hidden] { display: none; }
        .nav-mobile-search { display: flex; width: 100%; margin-bottom: 1rem; }
        .nav-mobile nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
        .nav-mobile-link {
          display: block;
          padding: 12px 14px;
          border-radius: 10px;
          background: var(--bg-secondary);
          border: 1px solid var(--border);
          font-size: 0.85rem;
          font-weight: 600;
          color: var(--text);
          text-decoration: none;
          transition: all 0.15s;
        }
        .nav-mobile-link:hover, .nav-mobile-link.active { border-color: var(--brand); color: var(--brand); }
      }

      /* ── CourseLegend light chrome (overrides dark defaults above) ── */
      .site-header { background: #fff; border-bottom: 1px solid #e5e5e5; }
      .brand-name { color: #111; }
      .brand-tagline { color: #666; }
      .nav-item { color: #111; border-color: transparent; background: transparent; }
      .nav-item::after { background: linear-gradient(90deg, #fff, #550E71, #550E71); }
      .nav-item:hover { background: #faf5ff; border-color: #e9d5ff; }
      .nav-item.active { background: #faf5ff; border-color: #550E71; }
      .nav-more-menu { background: #fff; border-color: #e5e5e5; box-shadow: 0 18px 40px -12px rgba(0,0,0,0.15); }
      .nav-more-menu a { color: #111; }
      .nav-more-menu a:hover { background: #faf5ff; color: #550E71; }
      .search-form { background: #f5f5f5; border-color: #e5e5e5; }
      .search-form:hover { border-color: #550E71; background: #fff; }
      .search-form:focus-within { border-color: #550E71; background: #fff; box-shadow: 0 0 0 3px rgba(85,14,113,0.12); }
      .nav-count { color: #666; white-space: nowrap; flex-shrink: 0; }
      .site-header .container { width: 100%; gap: 1rem; }
      .nav-links { min-width: 0; }
      .search-form { width: 210px; flex-shrink: 0; }
      @media (max-width: 1250px) { .nav-count { display: none; } }
      .nav-hamburger { border-color: #e5e5e5; }
      .nav-hamburger span { background: #111; }
      .nav-mobile { background: #fff; border-bottom: 1px solid #e5e5e5; box-shadow: 0 18px 40px -12px rgba(0,0,0,0.15); }
      .nav-mobile-link { background: #f9f9f9; border-color: #e5e5e5; color: #111; }
      .nav-mobile-link:hover, .nav-mobile-link.active { border-color: #550E71; color: #550E71; }
      .fresh-btn { display: inline-flex; align-items: center; gap: 8px; background: #773BFF; color: #fff; font-size: 0.82rem; font-weight: 700; padding: 9px 18px; border-radius: 7px; text-decoration: none; white-space: nowrap; }
      .fresh-btn:hover { filter: brightness(1.07); }
      .top-alert { display: flex; flex-wrap: wrap; align-items: center; background: linear-gradient(90deg, #6600FF 0%, #267EDB 100%); color: #fff; font-size: 15px; padding: 12px 20px; gap: 12px; }
      .top-alert .alert-message { flex: 1 1 auto; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 120px; }
      .top-alert .alert-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
      .top-alert .alert-button { background: #fff; color: #6600FF; font-weight: 600; padding: 8px 18px; border-radius: 999px; text-decoration: none; font-size: 14px; white-space: nowrap; }
      .top-alert .alert-button:hover { background: #F1F1F1; }
      .top-alert .close-btn { background: none; border: none; color: #fff; font-size: 20px; cursor: pointer; padding: 0; line-height: 1; }
      @media (max-width: 1024px) { .fresh-btn { display: none; } }
      @media (max-width: 600px) {
        .top-alert { flex-direction: column; align-items: stretch; padding: 14px; gap: 10px; }
        .top-alert .alert-message { white-space: normal; width: 100%; }
        .top-alert .alert-actions { justify-content: space-between; width: 100%; }
        .top-alert .alert-button { flex: 1; text-align: center; }
      }


    </style>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="top-alert" id="siteAlert">
      <span class="alert-message">🔥 2 days left! Want to build career momentum? | Courses on the latest skills start at just $12.99</span>
      <span class="alert-actions">
        <a href="https://trk.udemy.com/c/6564357/3708159/39854" class="alert-button">Flash Sale Coupons</a>
        <button class="close-btn" id="siteAlertClose" aria-label="Dismiss">✕</button>
      </span>
    </div>
    <header role="banner" class="site-header">
      <nav
        itemscope
        itemtype="https://schema.org/SiteNavigationElement"
        class="container"
        aria-label="Main navigation"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "0 1.5rem",
          maxWidth: "1400px",
          margin: "0 auto",
          height: "70px"
        }}
      >
        <a href="/" class="brand" aria-label="CoursesWyn Home">
          <BrandLogo size={28} />
          <div class="brand-text">
            <span class="brand-name">CoursesWyn</span>
            <span class="brand-tagline">Free Udemy Courses Daily</span>
          </div>
        </a>

        <div class="nav-links">
          <a href="/udemy-coupon-code" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/udemy-coupon-code' }]}
            aria-current={currentPath === '/udemy-coupon-code' ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6l4-4z"/><path d="M2 6h20"/><path d="M16 2v4H8V2"/><rect x="8" y="10" width="8" height="6"/></svg>
            <span itemprop="name">Udemy Coupons</span>
          </a>
          <a href="/udemy-coupons-today" itemprop="url"
