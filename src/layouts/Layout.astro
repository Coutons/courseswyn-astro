---
import "../styles/globals.css";

import { readDeals } from "../lib/store";
import { currentYearWIB } from "../lib/date";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  hideBreadcrumbs?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
}

const allDeals = await readDeals();
const activeCouponCount = "679990";

const siteUrl = import.meta.env.SITE || "https://courseswyn.com";
const currentYear = currentYearWIB();
const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const currentMonth = months[new Date().getMonth()];
const currentMonthYear = `${currentMonth} ${currentYear}`;

const {
  title = "Udemy Coupon Codes & Discounts " + currentMonthYear + " | CoursesWyn",
  description = "Find verified Udemy coupon codes and discounts " + currentMonthYear + " — free and up to 100% off deals across IT, Development, Business & more. Updated daily.",
  image,
  type = "website",
  canonical,
  pubDate,
  updatedDate,
  hideBreadcrumbs = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const absoluteImageUrl = image ? (image.startsWith('http') ? image : new URL(image, siteUrl).href) : new URL('/assets/images/og-default.svg', siteUrl).href;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="440e92a0ff41e1b5" />

        <meta name="theme-color" content="#ff5a2c" />
    <meta name="msapplication-TileColor" content="#ff5a2c" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://f.convertkit.com https://cdn.ampproject.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://ipapi.co; frame-src 'none'; object-src 'none'; base-uri 'self'" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CoursesWyn" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://img-c.udemycdn.com" />

    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {canonicalURL.includes('/coupon/') && !canonicalURL.includes('.amp') && (
      <link rel="amphtml" href={canonicalURL + '.amp'} />
    )}

    <link rel="alternate" type="application/rss+xml" title="CoursesWyn Blog RSS Feed" href={`${siteUrl}/rss.xml`} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {type === "article" && <meta property="article:author" content="Andrew Derek" />}
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="revisit-after" content="1 days" />
    <meta name="language" content="English" />
    <meta name="distribution" content="global" />
    <meta name="rating" content="general" />
    <meta name="classification" content="Education, Online Learning, Course Deals" />
    <meta name="category" content="Education" />

    <script type="application/ld+json">
    [{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CoursesWyn",
      "url": "https://courseswyn.com",
      "logo": "https://courseswyn.com/logo.svg",
      "description": "Find verified Udemy courses with 100% off coupons.",
      "foundingDate": "2024",
      "sameAs": ["https://www.facebook.com/CoursesWyn", "https://x.com/CoursesWyn"],
      "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "url": "https://courseswyn.com/contact" }
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CoursesWyn",
      "url": "https://courseswyn.com",
      "description": "Find 100% off & free Udemy courses with verified working coupon codes. Daily updated deals for online learning.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://courseswyn.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "name": "Main Navigation",
      "hasPart": [
        { "@type": "SiteNavigationElement", "name": "Udemy Coupon Codes", "url": "https://courseswyn.com/udemy-coupon-code" },
        { "@type": "SiteNavigationElement", "name": "Today's Coupons", "url": "https://courseswyn.com/udemy-coupons-today" },
        { "@type": "SiteNavigationElement", "name": "Topics", "url": "https://courseswyn.com/topics" }
      ]
    }]
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CoursesWyn" />
    <meta property="og:locale" content="en_US" />
    {absoluteImageUrl && <meta property="og:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:secure_url" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="og:image:width" content="1200" />}
    {absoluteImageUrl && <meta property="og:image:height" content="630" />}
    {absoluteImageUrl && <meta property="og:image:alt" content={title} />}
    {absoluteImageUrl && <meta property="og:image:type" content="image/jpeg" />}

    <meta property="twitter:card" content={absoluteImageUrl ? "summary_large_image" : "summary"} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:site" content="@CoursesGift" />
    <meta property="twitter:creator" content="@CoursesGift" />
    {absoluteImageUrl && <meta property="twitter:image" content={absoluteImageUrl} />}
    {absoluteImageUrl && <meta property="twitter:image:alt" content={title} />}

    <meta name="author" content="Andrew Derek" />
    <meta property="article:author" content="Andrew Derek" />
    <meta property="article:publisher" content="https://courseswyn.com" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script src="https://f.convertkit.com/ckjs/ck.5.js" defer></script>

    <style>
      .skip-link { position: absolute; top: -100%; left: 8px; background: var(--brand); color: #fff; padding: 8px 16px; border-radius: 0 0 8px 8px; z-index: 9999; font-weight: 700; font-size: 0.85rem; text-decoration: none; transition: top 0.2s; }
      .skip-link:focus { top: 0; }
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        flex-shrink: 0;
      }
      .brand-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #d94420 0%, #ff5a2c 40%, #ff8159 60%, #ff5a2c 100%);
        color: #1a1814;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 0 16px rgba(255,90,44,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
        position: relative;
      }
      .brand-icon::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.12);
        pointer-events: none;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
      }
      .brand-name {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--text);
        line-height: 1.2;
      }
      .brand-tagline {
        font-size: 0.62rem;
        color: var(--muted);
        font-weight: 500;
        letter-spacing: 0.03em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        gap: 2px;
        align-items: center;
        justify-content: flex-start;
      }
      .nav-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        border: 1px solid var(--brand-soft);
        background: transparent;
        transition: all 0.25s ease;
        white-space: nowrap;
        position: relative;
      }
      .nav-item::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #d94420, #ff5a2c, #ff8159);
        border-radius: 1px;
        transition: all 0.3s ease;
      }
      .nav-item:hover {
        background: var(--brand-soft);
        border-color: rgba(255, 90, 44, 0.3);
      }
      .nav-item:hover::after {
        width: 60%;
      }
      .nav-item.active {
        background: rgba(255, 90, 44, 0.18);
        border-color: rgba(255, 90, 44, 0.4);
      }
      .nav-item.active::after {
        width: 60%;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }
      .search-form {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 7px 14px;
        width: 280px;
        transition: all 0.3s ease;
        cursor: text;
        position: relative;
      }
      .search-form:hover {
        border-color: rgba(255, 90, 44, 0.4);
        background: var(--bg-secondary);
      }
      .search-form:focus-within {
        border-color: var(--brand);
        background: var(--bg-secondary);
        box-shadow: 0 0 28px -6px rgba(255,90,44,0.3);
      }
      .nav-count {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .nav-count::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ff5a2c;
        display: inline-block;
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }


    </style>
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header role="banner" class="site-header">
      <nav
        itemscope
        itemtype="https://schema.org/SiteNavigationElement"
        class="container"
        aria-label="Main navigation"
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "0 1.5rem",
          maxWidth: "1400px",
          margin: "0 auto",
          height: "70px"
        }}
      >
        <a href="/" class="brand" aria-label="CoursesWyn Home">
          <span class="brand-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 44 44" fill="none">
              <defs>
                <mask id="cw-mask">
                  <rect width="44" height="44" fill="white"/>
                  <path d="M28 16H18a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h10" stroke="black" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </mask>
              </defs>
              <path d="M22 3L40 13v18L22 41 4 31V13L22 3Z" fill="var(--bg)" mask="url(#cw-mask)"/>
              <path d="M22 3L4 13 22 23 40 13 22 3Z" fill="rgba(255,255,248,0.06)" mask="url(#cw-mask)"/>
              <path d="M4 13v18l7-5 11-14Z" fill="rgba(0,0,0,0.12)" mask="url(#cw-mask)"/>
              <path d="M40 13v18l-7-5L22 13Z" fill="rgba(0,0,0,0.04)" mask="url(#cw-mask)"/>
              <path d="M11 31l-7-5 7-5 11 10Z" fill="rgba(0,0,0,0.08)" mask="url(#cw-mask)"/>
              <path d="M33 31l7-5-7-5-11 10Z" fill="rgba(0,0,0,0.02)" mask="url(#cw-mask)"/>
              <circle cx="28" cy="9" r="1.2" fill="#ff8159" opacity="0.8"/>
              <circle cx="35" cy="15" r="0.6" fill="#ff8159" opacity="0.5"/>
              <circle cx="17" cy="36" r="0.5" fill="#ff8159" opacity="0.3"/>
            </svg>
          </span>
          <div class="brand-text">
            <span class="brand-name">CoursesWyn</span>
            <span class="brand-tagline">Verified Udemy Coupon Codes Daily</span>
          </div>
        </a>

        <div class="nav-links">
          <a href="/udemy-coupon-code" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/udemy-coupon-code' }]}
            aria-current={currentPath === '/udemy-coupon-code' ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span itemprop="name">Udemy Coupon Codes</span>
          </a>
          <a href="/udemy-coupons-today" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/udemy-coupons-today' }]}
            aria-current={currentPath === '/udemy-coupons-today' ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12l4 4v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6l4-4z"/><path d="M2 6h20"/><path d="M16 2v4H8V2"/><rect x="8" y="10" width="8" height="6"/></svg>
            <span itemprop="name">Today's Coupons</span>
          </a>
          <a href="/topics" itemprop="url"
            class:list={['nav-item', { active: currentPath === '/topics' || currentPath.startsWith('/topics/') }]}
            aria-current={currentPath === '/topics' || currentPath.startsWith('/topics/') ? 'page' : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            <span itemprop="name">Topics</span>
          </a>
        </div>

        <div class="nav-right">
          <form action="/search" method="get" class="search-form" role="search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff5a2c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style={{ flexShrink: 0, opacity: 0.9 }}>
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              type="text"
              name="q"
              placeholder="Search courses..."
                style={{
                  background: 'transparent',
                  color: 'var(--text)',
                  border: 'none',
                  fontSize: '0.82rem',
                  width: '100%',
                  outline: 'none',
                  padding: 0
                }}
            />
          </form>
          <span class="nav-count">{activeCouponCount}</span>
        </div>
      </nav>
    </header>

    <!-- Breadcrumb Navigation -->
    {!hideBreadcrumbs && currentPath !== '/' && !currentPath.startsWith('/coupon/') && !currentPath.startsWith('/blog/') && currentPath !== '/blog' && (
      <nav
        aria-label="Breadcrumb"
        class="container"
        style={{
          padding: "12px 0",
          fontSize: "0.85rem",
          borderBottom: "1px solid var(--border)"
        }}
      >
        <ol itemscope itemtype="https://schema.org/BreadcrumbList" style={{ display: "flex", gap: "8px", listStyle: "none", margin: 0, padding: 0, alignItems: "center", flexWrap: "wrap", justifyContent: "center" }}>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" style={{ display: "flex", alignItems: "center" }}>
            <a href="/" itemprop="item" style={{ color: "var(--muted)", textDecoration: "none", display: "flex", alignItems: "center", gap: "4px" }}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>

          {currentPath === '/udemy-coupon-code' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>All Deals</span><meta itemprop="position" content="2" /></li></>
          )}

          {currentPath === '/categories' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>Categories</span><meta itemprop="position" content="2" /></li></>
          )}

          {currentPath.startsWith('/categories/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/categories" itemprop="item" style={{ color: "var(--muted)", textDecoration: "none" }}><span itemprop="name">Categories</span></a><meta itemprop="position" content="2" /></li>
            <li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>{currentPath.split('/')[2]?.replace(/-/g, ' ')?.replace(/\b\w/g, l => l.toUpperCase()) || 'Category'}</span><meta itemprop="position" content="3" /></li></>
          )}

          {currentPath === '/topics' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>Topics</span><meta itemprop="position" content="2" /></li></>
          )}

          {currentPath.startsWith('/topic/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem"><a href="/topics" itemprop="item" style={{ color: "var(--muted)", textDecoration: "none" }}><span itemprop="name">Topics</span></a><meta itemprop="position" content="2" /></li>
            <li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>{currentPath.split('/')[2]?.replace(/-/g, ' ')?.replace(/\b\w/g, l => l.toUpperCase()) || 'Topic'}</span><meta itemprop="position" content="3" /></li></>
          )}

          {currentPath === '/popular' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>Popular</span><meta itemprop="position" content="2" /></li></>
          )}

          {currentPath === '/instructors' && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page"><span itemprop="name" style={{ color: "var(--text)", fontWeight: 500 }}>Instructors</span><meta itemprop="position" content="2" /></li></>
          )}

          {currentPath.startsWith('/instructor/') && (
            <><li aria-hidden="true" style={{ color: "var(--muted)" }}>/</li>
