---
import Layout from "../layouts/Layout.astro";
import { formatDateWIB, toISODateWIB } from "../lib/date";
import { getDeals } from "../lib/store.js";

const canonicalUrl = "https://courseswyn.com/udemy-coupons-guide/";
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const pageTitle = `Udemy Coupons Guide ${currentYear}: Find, Check & Redeem Coupon Codes`;
const pageDescription = `A practical guide to Udemy coupons in ${currentYear}: how instructor codes work, why they expire fast, how to check a deal, and how to redeem one at checkout.`;

const lastModified = toISODateWIB();

import { Image } from "astro:assets";
const allDeals = await getDeals();
const now = new Date();
const activeDeals = allDeals.filter(d => !d.expiresAt || new Date(d.expiresAt) > now);
const activeCount = activeDeals.length;
const freeActive = activeDeals.filter(d => d.price === 0).length;
const todayStr = toISODateWIB(now);
const updatedToday = activeDeals.filter(d => {
  const raw = d.updatedAt || d.createdAt;
  return raw ? toISODateWIB(new Date(raw)) === todayStr : false;
}).length;
const ogImage = "https://courseswyn.com/assets/images/udemy-coupons-guide-2026.jpg";
const featuredImage = "/assets/images/udemy-coupons-guide-2026.jpg";

const faqs = [
  { q: "Are CoursesWyn coupons safe?", a: "Yes. We list instructor-issued coupons and Udemy sale prices from Udemy's official affiliate feed. We never ask for personal data, surveys, or downloads." },
  { q: "How often do you update the deals?", a: "The catalog is refreshed from Udemy's feed on a daily schedule, and listings past their expiry date are filtered out automatically. Every deal card shows the last-checked date so you can judge how fresh it is." },
  { q: "Do courses include certificates?", a: "Udemy courses generally include a certificate of completion. Check the individual course page to confirm, since the instructor controls what is offered." },
  { q: "Can I get banned for using too many coupons?", a: "Udemy doesn't publicly state a coupon limit, but mass-enrolling in hundreds of courses you never open can look like abusive activity. Enroll only in courses you actually plan to take." },
  { q: "What if a coupon doesn't work?", a: "Use the contact form and send us the deal URL. Coupons can hit their redemption cap between checks, so we'll re-check the listing and update or remove it." },
  { q: "Do you have coupons for other platforms?", a: "Currently we focus on Udemy. We may expand to Coursera and Skillshare in the future." },
  { q: "Are all Udemy coupons free?", a: "No. Most live coupons are paid discounts, often $9.99–$19.99. 100% off codes exist, but they are capped and disappear quickly. The deal card always shows the current price before you click through." },
  { q: "Do I need to type a coupon code at checkout?", a: "Usually not. Most instructor coupons apply automatically when you open Udemy through the deal link. If a code must be entered manually, the deal page shows it with copy instructions." },
];
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl} type="article" image={ogImage} imageWidth={1200} imageHeight={630}>
  <meta name="author" content="Andrew Derek" slot="head" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": `${canonicalUrl}#article`,
        "url": canonicalUrl,
        "headline": pageTitle,
        "description": pageDescription,
        "datePublished": "2026-05-29",
        "dateModified": lastModified,
        "inLanguage": "en-US",
        "image": { "@type": "ImageObject", "url": ogImage, "width": 1200, "height": 630 },
        "author": { "@type": "Person", "name": "Andrew Derek", "url": "https://courseswyn.com" },
        "publisher": { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg" } },
        "isPartOf": { "@id": "https://courseswyn.com" },
        "breadcrumb": { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }, { "@type": "ListItem", "position": 2, "name": "Udemy Coupons Guide", "item": canonicalUrl }] }
      },
      {
        "@type": "HowTo",
        "@id": `${canonicalUrl}#howto`,
        "name": "How to Redeem a Udemy Coupon Code",
        "description": "A five-step process for checking and redeeming a Udemy coupon at checkout.",
        "totalTime": "PT5M",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Open the deal page", "text": "Check the current price, original price, and last-checked date before clicking through." },
          { "@type": "HowToStep", "position": 2, "name": "Reveal the code or use the deal link", "text": "Some coupons apply automatically through the deal link; others show a code you need to copy." },
          { "@type": "HowToStep", "position": 3, "name": "Open Udemy in a browser", "text": "Udemy's mobile apps do not accept coupon codes. Use Safari, Chrome, or Firefox on desktop or mobile." },
          { "@type": "HowToStep", "position": 4, "name": "Sign in and confirm the price", "text": "The checkout total should match the advertised deal price. A 100% off code shows $0.00; a paid coupon shows the discounted amount." },
          { "@type": "HowToStep", "position": 5, "name": "Enroll and learn", "text": "Complete checkout and confirm the course appears in My learning." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": { "@type": "Answer", "text": faq.a }
        }))
      }
    ]
  })} />

  <main class="gg-root">
    <div class="gg-container">

      <!-- HERO -->
      <section class="gg-hero">
        <div class="gg-hero-bg"></div>
        <div class="gg-hero-inner">
          <div class="gg-hero-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.89 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6z"/><path d="M14 2v6h6"/></svg>
            Complete Guide
          </div>
          <h1 class="gg-hero-title">
            Udemy Coupons Guide {currentYear}
            <span>How to find, check, and redeem coupon codes — without wasting time on dead deals</span>
          </h1>
          <p class="gg-hero-desc">
            Most "Udemy coupon" lists are stale within hours. This guide explains how instructor
            coupons actually work, how to check a deal before you enroll, and how to redeem a code
            at checkout — without the hype.
          </p>
          <p class="gg-hero-note">
            Looking for the actual codes? <a href="/udemy-coupon-code">Browse the live Udemy coupon list</a> — every deal shows its price and last-checked date.
          </p>
          <div class="gg-hero-meta">
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              By <strong>Andrew Derek</strong>
            </span>
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Updated <time datetime={lastModified}>{formatDateWIB(new Date(), { year:'numeric', month:'long', day:'numeric' })}</time>
            </span>
            <span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              7 min read
            </span>
          </div>
          <div class="gg-hero-stats">
            <span class="gg-hero-stat">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
              <strong>{activeCount.toLocaleString()}</strong> live coupons
            </span>
            <span class="gg-hero-stat">
              <span class="gg-dot gg-dot-green"></span>
              <strong>{freeActive}</strong> free (100% off) right now
            </span>
            <span class="gg-hero-stat">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <strong>{updatedToday}</strong> refreshed today
            </span>
          </div>
        </div>
      </section>

      <!-- FEATURED IMAGE -->
      <div class="gg-featured-wrap">
        <div class="gg-featured-img">
          <Image src={featuredImage} alt="Udemy Coupons Guide 2026 — how coupon codes work and how to redeem them" width={1200} height={630} loading="eager" inferSize={false} />
        </div>
      </div>

      <!-- TABLE OF CONTENTS -->
      <nav class="gg-toc" aria-labelledby="toc-heading">
        <div class="gg-toc-inner">
          <h2 id="toc-heading" class="gg-toc-title">In this guide</h2>
          <ol class="gg-toc-list">
            {[
              ["#types", "Instructor coupons vs. Udemy sitewide sales"],
              ["#why-they-fail", "Why most coupon lists go stale"],
              ["#redeem", "How to redeem a Udemy coupon"],
              ["#mistakes", "5 mistakes that waste your coupon"],
              ["#strategy", "Smart enrollment strategy"],
              ["#beyond", "Beyond coupons — other ways to save"],
              ["#faq", "Quick answers"],
            ].map(([href, label], i) => (
              <li>
                <a href={href as string} class="gg-toc-link">
                  <span class="gg-toc-num">{i+1}</span>
                  {label as string}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>

      <!-- BODY -->
      <article class="gg-article">
        <div class="gg-article-inner">

          <!-- Section 1: What a Udemy coupon is -->
          <section id="types" class="gg-section">
            <h2 class="gg-section-title">Instructor Coupons vs. Udemy Sitewide Sales</h2>
            <p>
              "Udemy coupon" is used for two different things, and that confusion is why so many
              searches end in disappointment. Before you hunt for a code, it helps to know which
              kind of discount you're actually looking at.
            </p>
            <div class="gg-grid-2">
              <div class="gg-card">
                <h3>Instructor coupon codes</h3>
                <p>Created by the instructor for one specific course. They can be a paid discount (often $9.99–$19.99) or, less often, 100% off. Each code has an expiry date and a redemption cap, so it can stop working before the listed date.</p>
              </div>
              <div class="gg-card">
                <h3>Udemy sitewide sales</h3>
                <p>Udemy's own promotions run every few weeks and apply automatically at checkout. There is no code to copy, and most courses are included unless the instructor opts out.</p>
              </div>
            </div>
            <p>
              <strong>What this means for you:</strong> most live "Udemy coupons" are paid discounts,
              not free courses. 100% off codes do exist, but they are capped and disappear quickly.
              If a page promises hundreds of free codes with no timestamps, treat that as a red flag.
            </p>
          </section>

          <!-- Section 2: Why coupon lists go stale -->
          <section id="why-they-fail" class="gg-section">
            <h2 class="gg-section-title">Why Most Udemy Coupon Lists Go Stale</h2>
            <p>
              If you've searched for "free Udemy coupons" and landed on a page full of dead codes,
              the site may not be malicious — it may just be old. Udemy coupons expire in two ways:
              the clock runs out, or the redemption cap fills. A code posted this morning can be gone
              by lunchtime.
            </p>
            <p>
              Static coupon pages make this worse. They are indexed once and rarely re-checked, so a
              page can rank for months while every code on it is dead. A banner that says "updated
              daily" is not proof; a timestamp next to each deal is.
            </p>
            <div class="gg-callout gg-callout-brand">
              <strong>How CoursesWyn handles it:</strong> we refresh the catalog from Udemy's affiliate
              feed, re-check listings on a daily schedule, filter out deals past their expiry date, and
              show a last-checked date on every card. We don't claim a coupon will work forever — no
              honest site can. We show you when it was last checked and what it cost then.
            </div>
          </section>

          <!-- Section 3: How to redeem -->
          <section id="redeem" class="gg-section">
            <h2 class="gg-section-title">How to Redeem a Udemy Coupon (5 Steps)</h2>
            <p>
              Once you've found a deal that fits, redeeming it takes about a minute. The important
              part is checking the price before you enroll.
            </p>
            <ol class="gg-list gg-list-numbered">
              <li>
                <strong>Open the deal page</strong> — Every CoursesWyn listing shows the current price,
                the original price, and the last-checked date. Check those before you click through.
              </li>
              <li>
                <strong>Reveal the code or use the deal link</strong> — Some instructor coupons apply
                automatically through our link; others show a code you need to copy. The deal page
                tells you which.
              </li>
              <li>
                <strong>Open Udemy in a browser, not the app</strong> — Udemy's iOS and Android apps
                don't have a coupon field. Use Safari, Chrome, or Firefox on desktop or mobile.
              </li>
              <li>
                <strong>Sign in and confirm the price</strong> — The checkout total should match the
                deal price. A 100% off code will show $0.00; a paid coupon will show the discounted
                amount. If the total is full price, the code has likely expired or hit its cap.
              </li>
              <li>
                <strong>Enroll and check your library</strong> — Complete checkout and confirm the
                course appears under "My learning".
              </li>
            </ol>
          </section>

          <!-- Section 4: 5 mistakes -->
          <section id="mistakes" class="gg-section">
            <h2 class="gg-section-title">5 Mistakes That Waste Your Coupon</h2>
            <p>
              Even with a valid code, these common slip-ups can cost you the deal:
            </p>
            <div class="gg-card-list">
              {[
                {
                  title: "Waiting too long to redeem",
                  desc: "You find a great course but tell yourself 'I'll enroll later.' By the time you come back, the redemption cap may be full. Rule of thumb: if you want it, grab it from <a href='/udemy-coupons-today'>today's deals page</a> and check out while the price is still live."
                },
                {
                  title: "Assuming every coupon means a free course",
                  desc: "Most instructor coupons are paid discounts, not 100% off. A $12.99 coupon for a $129.99 course is still a good deal, but it is not free. Read the price on the deal card and confirm it at checkout before enrolling."
                },
                {
                  title: "Redeeming in the mobile app",
                  desc: "The <a href='https://www.udemy.com/mobile/' rel='noopener' target='_blank'>Udemy mobile app</a> does not accept coupon codes. Open the course page in a browser (Safari, Chrome, or Firefox), sign in there, and confirm the price before you enroll."
                },
                {
                  title: "Enrolling in courses you won't take",
                  desc: "Mass-enrolling in hundreds of courses you never open can look like abusive activity. <a href='https://www.udemy.com/terms/' rel='noopener' target='_blank'>Udemy's terms of use</a> prohibit abuse, so enroll only in courses you actually plan to start."
                },
                {
                  title: "Using an old bookmark or screenshot",
                  desc: "A code that worked last week may be dead today. Bookmark <a href='/udemy-coupon-code'>the live deals page</a> or browse by <a href='/categories'>category</a> instead of saving a specific course link."
                },
              ].map(m => (
                <div class="gg-card">
                  <strong>{m.title}</strong>
                  <p set:html={m.desc}></p>
                </div>
              ))}
            </div>
          </section>

          <!-- Section 5: Strategy -->
          <section id="strategy" class="gg-section">
            <h2 class="gg-section-title">Smart Enrollment Strategy</h2>
            <p>
              Getting a discounted course is easy. Building real skills from it takes a bit of
              planning. Here's a strategy that works:
            </p>
            <ol class="gg-list gg-list-numbered">
              <li>
                <strong>Pick one topic per month</strong> — Instead of grabbing courses across 10 categories,
                focus on one skill area (e.g., Python, UI design, cybersecurity). You'll retain more and
                finish courses instead of starting them.
              </li>
              <li>
                <strong>Check the syllabus before enrolling</strong> — Even a cheap course costs time. Skim the
                curriculum on the Udemy course page to make sure it covers what you need. Avoid courses with
                outdated tools or versions.
              </li>
              <li>
                <strong>Set a weekly learning schedule</strong> — Block 2–3 hours per week per course.
                CoursesWyn lists the duration for each course so you can plan ahead.
              </li>
              <li>
                <strong>Leave a rating after finishing</strong> — Instructors notice when coupon-enrolled
                students leave thoughtful reviews. It encourages them to issue more coupons in the future.
              </li>
            </ol>
          </section>

          <!-- Section 6: Beyond coupons -->
          <section id="beyond" class="gg-section">
            <h2 class="gg-section-title">Beyond Coupons — Other Ways to Save</h2>
            <p>
              A 100% off code is the best deal when you can find one, but it's not the only way to
              save. Here are backup options if a coupon expires before you grab it:
            </p>
            <div class="gg-grid-2">
              <div class="gg-card">
                <h3>Udemy sitewide sales</h3>
                <p>Udemy runs sales every few weeks where many courses drop to $9.99–$14.99. No coupon needed. Sign up for Udemy's newsletter to catch the next one.</p>
              </div>
              <div class="gg-card">
                <h3>Instructor bundles</h3>
                <p>Many top instructors bundle multiple courses at a steep discount. Check the instructor's profile on Udemy for their bundle offerings.</p>
              </div>
              <div class="gg-card">
                <h3>Udemy Personal Plan</h3>
                <p>A separate subscription that gives access to a curated catalog for a monthly fee. It is not covered by instructor coupons, so check Udemy's current price and course list before subscribing.</p>
              </div>
              <div class="gg-card">
                <h3>30-day refund window</h3>
                <p>Eligible courses can be refunded within Udemy's 30-day window. Check the course page for eligibility — not every purchase qualifies, and app-store purchases follow different rules.</p>
              </div>
            </div>
          </section>

          <!-- Section 7: FAQ -->
          <section id="faq" class="gg-section">
            <h2 class="gg-section-title">Udemy Coupon Questions <span class="gg-faq-count">{faqs.length} questions</span></h2>
            <div class="gg-faq-grid">
              {faqs.map(faq => (
                <div class="gg-faq-card">
                  <h3 class="gg-faq-q">{faq.q}</h3>
                  <p class="gg-faq-a">{faq.a}</p>
                </div>
              ))}
            </div>
          </section>

          <!-- CTA -->
          <section class="gg-cta">
            <h2>Ready to check a live deal?</h2>
            <p>Browse current Udemy coupons — each listing shows its price and last-checked date, so you know what you're getting before you click.</p>
            <div class="gg-cta-actions">
              <a href="/udemy-coupon-code" class="gg-btn gg-btn-primary">Browse Live Coupons</a>
              <a href="/udemy-coupons-today" class="gg-btn gg-btn-secondary">See Today's Deals</a>
            </div>
          </section>

        </div>
      </article>

    </div>
  </main>

  <style is:global>
    .gg-root { background:var(--bg); color:var(--text); min-height:100vh; }
    .gg-container { max-width:860px; margin:0 auto; padding:0 1.5rem; }

    .gg-hero { padding:4rem 0 2rem; text-align:center; position:relative; overflow:hidden; }
    .gg-hero-bg { position:absolute; top:-20%; left:-10%; width:60%; height:80%; background:radial-gradient(ellipse at center, rgba(169, 199, 255,0.06) 0%, transparent 70%); pointer-events:none; }
    .gg-hero-inner { position:relative; z-index:1; }
    .gg-hero-tag { display:inline-flex; align-items:center; gap:0.4rem; border:1px solid var(--border); padding:0.4rem 0.85rem; border-radius:9999px; font-size:0.78rem; color:var(--muted); margin-bottom:1.5rem; }
    .gg-hero-tag svg { color:var(--brand); }
    .gg-hero-title { font-size:clamp(1.8rem,4vw,2.8rem); font-weight:800; line-height:1.2; margin:0 0 1rem; color:var(--text); }
    .gg-hero-title span { display:block; font-size:0.55em; font-weight:500; color:var(--muted); margin-top:0.4rem; }
    .gg-hero-desc { font-size:clamp(0.95rem,2vw,1.1rem); color:var(--muted); line-height:1.7; margin:0 auto 1rem; max-width:640px; }
    .gg-hero-note { font-size:0.85rem; color:var(--muted); line-height:1.6; margin:0 auto 1.5rem; max-width:640px; }
    .gg-hero-note a { color:var(--brand); font-weight:600; text-decoration:underline; }
    .gg-hero-meta { display:flex; justify-content:center; align-items:center; gap:1.5rem; flex-wrap:wrap; font-size:0.82rem; color:var(--muted); margin-bottom:1.5rem; }
    .gg-hero-meta span { display:inline-flex; align-items:center; gap:0.35rem; }
    .gg-hero-meta svg { width:14px; height:14px; flex-shrink:0; opacity:0.6; }
    .gg-hero-meta strong { color:var(--text); font-weight:600; }
    .gg-hero-stats { display:flex; justify-content:center; gap:1.5rem; flex-wrap:wrap; }
    .gg-hero-stat { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.82rem; color:var(--muted); }
    .gg-hero-stat svg { width:14px; height:14px; opacity:0.6; }
    .gg-hero-stat strong { color:var(--text); font-weight:700; }
    .gg-dot { width:8px; height:8px; border-radius:50%; display:inline-block; flex-shrink:0; }
    .gg-dot-green { background:#A9C7FF; }

    .gg-featured-wrap { margin-top:-1.5rem; }
    .gg-featured-img { border-radius:12px; overflow:hidden; border:1px solid var(--border); background:var(--card); }
    .gg-featured-img img { display:block; width:100%; height:auto; }

    .gg-toc { background:var(--card); border-bottom:1px solid var(--border); padding:1.5rem 0; margin-top:2rem; }
    .gg-toc-inner { max-width:860px; margin:0 auto; padding:0 1.5rem; }
    .gg-toc-title { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.16em; color:var(--muted); margin:0 0 1rem; }
    .gg-toc-list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:0.35rem; }
    .gg-toc-link { font-size:0.88rem; color:var(--brand); text-decoration:none; display:inline-flex; align-items:center; gap:0.5rem; transition:opacity 0.2s; }
    .gg-toc-link:hover { opacity:0.8; }
    .gg-toc-num { font-size:0.72rem; color:var(--muted); width:18px; flex-shrink:0; }

    .gg-article { padding:2.5rem 0 4rem; }
    .gg-article-inner { max-width:860px; margin:0 auto; padding:0 1.5rem; }
    .gg-section { margin-bottom:3rem; }
    .gg-section-title { font-size:clamp(1.2rem,2.5vw,1.5rem); font-weight:800; color:var(--text); margin:0 0 1rem; padding-bottom:0.5rem; border-bottom:2px solid var(--border); display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap; }
    .gg-faq-count { font-family:var(--font-mono); font-size:0.6rem; font-weight:500; color:var(--muted); border:1px solid var(--border); padding:0.2rem 0.6rem; border-radius:999px; text-transform:uppercase; letter-spacing:0.05em; white-space:nowrap; }
    .gg-article-inner a:not(.gg-btn) { color:var(--brand); text-decoration:underline; font-weight:600; }
    .gg-section p { font-size:0.95rem; line-height:1.75; color:var(--muted); margin:0 0 1rem; }
    .gg-section p:last-child { margin-bottom:0; }
    .gg-section strong { color:var(--text); }

    .gg-list { padding-left:1.25rem; margin:0 0 1.25rem; }
