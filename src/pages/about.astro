---
import Layout from "../layouts/Layout.astro";
import { readDeals } from '../lib/store';

const allDeals = await readDeals();
const totalCourses = allDeals.length;
const freeCount = allDeals.filter(d => d.price === 0 || (d.originalPrice && d.price === 0)).length;
const totalCategories = [...new Set(allDeals.map(d => d.category?.trim()).filter(Boolean))].length;
const avgDiscount = Math.round(allDeals.reduce((s, d) => s + (d.discount ?? (d.originalPrice ? Math.round((1 - d.price / d.originalPrice) * 100) : 0)), 0) / allDeals.length);
const dates = allDeals.map(d => d.updatedAt ?? d.createdAt).filter(Boolean) as string[];
const latestDate = dates.length ? dates.sort().reverse()[0] : null;
const latestStr = latestDate ? new Date(latestDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' }) : '';
const pubDate = '2024-01-01';
const modDate = latestDate || pubDate;

const canonicalUrl = 'https://courseswyn.com/about';
const pageTitle = 'About CoursesWyn: Tracking Udemy Coupons Since 2024 | CoursesWyn';
const pageDesc = `CoursesWyn has tracked ${totalCourses.toLocaleString()}+ verified Udemy coupons across ${totalCategories} categories since 2024. One developer, zero gimmicks. Full story and live numbers.`;
---

<Layout title={pageTitle} description={pageDesc} canonical={canonicalUrl} hideBreadcrumbs={true}>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": "https://courseswyn.com/about#article",
        "headline": "About CoursesWyn: Tracking Udemy Coupons Since 2024",
        "description": "CoursesWyn has tracked thousands of verified Udemy coupons since 2024. One developer, zero gimmicks. Full story and live numbers.",
        "datePublished": "2024-01-01",
        "dateModified": "2026-07-27",
        "author": { "@type": "Organization", "@id": "https://courseswyn.com#organization" },
        "publisher": { "@type": "Organization", "@id": "https://courseswyn.com#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://courseswyn.com#organization",
        "name": "CoursesWyn",
        "url": "https://courseswyn.com",
        "foundingDate": "2024",
        "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn"],
        "contactPoint": { "@type": "ContactPoint", "contactType": "customer support", "url": "https://courseswyn.com/contact" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
          { "@type": "ListItem", "position": 2, "name": "About", "item": "https://courseswyn.com/about" }
        ]
      }
    ]
  }
  </script>

  <main class="ab-root">
    <div class="ab-container">

      <nav aria-label="Breadcrumb" class="ab-breadcrumb">
        <a href="/">Home</a>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <span aria-current="page">About</span>
      </nav>

      <article>

        <h1>About CoursesWyn</h1>
        <p class="ab-subtitle">Tracking Udemy coupons since 2024 &middot; One developer &middot; Verified daily</p>
        <p class="ab-date">Published January 2024 &middot; Updated {latestStr || 'continuously'}</p>

        <p class="ab-lead">CoursesWyn tracks Udemy coupons and free courses, and verifies each before showing it to you. When a page says a coupon was checked hours ago, that is a real timestamp from a real verification, not a marketing claim. This page tells you who is behind it, how it started, and how it works.</p>

        <dl class="ab-stats">
          <div class="ab-stat">
            <dt>Udemy courses catalogued</dt>
            <dd>{totalCourses.toLocaleString()}</dd>
          </div>
          <div class="ab-stat">
            <dt>Categories tracked</dt>
            <dd>{totalCategories}</dd>
          </div>
          <div class="ab-stat">
            <dt>Average discount</dt>
            <dd>{avgDiscount}%</dd>
          </div>
          <div class="ab-stat">
            <dt>Last verified</dt>
            <dd>{latestStr || 'Today'}</dd>
          </div>
        </dl>

        <h2>It started with a simple observation</h2>

        <p>Udemy courses go on sale constantly, but finding the actual discount codes among expired or fake ones was a mess. Most coupon sites list codes they haven't checked. Some list codes that expired years ago. Many show prices that don't exist at checkout. CoursesWyn started because there was no reliable directory — one where you could trust that a listed coupon actually worked at the moment you saw it.</p>

        <p>The first version shipped in early 2024: a minimal page listing coupon codes that had been manually tested minutes before publishing. No accounts, no emails, no gimmicks. Just working codes and the time they were last checked.</p>

        <h2>What changed since then</h2>

        <p>The manual approach didn't scale. By mid-2024 the list was being updated in batches, then the verification pipeline was automated: every coupon is now checked programmatically against Udemy's own data — current price, discount, and availability. If a coupon expires or reaches its redemption limit, it disappears from the site within hours. No manual cleanup, no guesswork.</p>

        <p>The current platform runs on Astro with a lightweight data pipeline. The design has been rebuilt a few times, but the core promise never changed: show coupons that work, mark expiration honestly, and don't waste the visitor's time.</p>

        <h2>How CoursesWyn is funded</h2>

        <p>CoursesWyn earns commissions through affiliate links — when you enroll in a course after clicking through, the platform gets a small referral fee at no extra cost to you. This is the standard model across the coupon industry, and it is disclosed clearly on every page.</p>

        <p>What this means in practice: a coupon is shown because it exists and verifies, not because it pays. Expired codes are labeled as expired. The verification pipeline treats every coupon equally regardless of commission. There is no paid placement, no promoted listings, and no "editorial" content masquerading as independent review.</p>

        <h2>Who runs CoursesWyn</h2>

        <p>CoursesWyn is built and operated independently. No team, no investors, no content farm. If something on the site is wrong, you can say so and the person who built it will fix it.</p>

        <h2>Our verification promise</h2>

        <p>Every active coupon on CoursesWyn is re-checked continuously against Udemy's course data: current price, discount percentage, and coupon status. Since Udemy coupons are capped by time (typically 3–7 days) and redemption limits, the median coupon survives only a limited window — which is exactly why every listing shows when it was last verified instead of pretending codes live forever.</p>

        <p>If a coupon stops working between checks, it is removed in the next verification cycle. Our directory reflects what is actually available right now, not what was available last week.</p>

      </article>

      <div class="ab-cta">
        <p>Start browsing {totalCourses.toLocaleString()}+ verified Udemy coupons.</p>
        <a href="/udemy-coupon-code" class="ab-btn">Browse all coupons &rarr;</a>
      </div>

    </div>
  </main>

  <style>
    .ab-root { padding: 2rem 0 4rem; }
    .ab-container { max-width: 56rem; margin: 0 auto; padding: 0 1.5rem; }

    .ab-breadcrumb { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem; font-size: 0.78rem; color: var(--muted); }
    .ab-breadcrumb a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .ab-breadcrumb a:hover { text-decoration: underline; }
    .ab-breadcrumb svg { width: 0.85rem; height: 0.85rem; flex-shrink: 0; }

    article h1 { font-size: clamp(2rem,4vw,2.8rem); font-weight: 700; line-height: 1.1; color: var(--text); margin: 0; letter-spacing: -0.03em; }
    .ab-subtitle { font-size: 1rem; color: var(--brand); font-weight: 600; margin: 0.5rem 0 0; }
    .ab-date { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0.75rem 0 0; }
    .ab-lead { font-size: 1rem; line-height: 1.7; color: var(--text); margin-top: 1.5rem; }

    .ab-stats { display: grid; grid-template-columns: repeat(2,1fr); gap: 0.75rem; margin-top: 2rem; }
    .ab-stat { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; }
    .ab-stat dt { font-size: 0.65rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted); }
    .ab-stat dd { font-size: 1.5rem; font-weight: 700; color: var(--text); margin: 0.25rem 0 0; font-variant-numeric: tabular-nums; }

    article h2 { font-size: 1.35rem; font-weight: 700; color: var(--text); margin: 2.5rem 0 0; line-height: 1.3; }
    article p { font-size: 0.92rem; line-height: 1.7; color: var(--muted); margin: 0.75rem 0 0; }
    article p:first-of-type { margin-top: 1rem; }

    .ab-cta { margin-top: 3rem; padding: 2rem; background: var(--card); border: 1px solid var(--border); border-radius: 12px; text-align: center; }
    .ab-cta p { font-size: 0.95rem; color: var(--text); font-weight: 600; margin: 0 0 1rem; }
    .ab-btn { display: inline-block; padding: 0.75rem 2rem; background: var(--brand); color: var(--bg); text-decoration: none; border-radius: 8px; font-weight: 700; font-size: 0.9rem; transition: opacity 0.2s; }
    .ab-btn:hover { opacity: 0.9; }

    @media (min-width:640px) {
      .ab-stats { grid-template-columns: repeat(4,1fr); }
    }
  </style>
</Layout>