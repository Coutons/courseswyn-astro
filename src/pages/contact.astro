---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us | CoursesWyn"
  description="Get in touch with CoursesWyn. Send a message, report a bug, or suggest a feature. We read every message."
  canonical="https://courseswyn.com/contact"
>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ContactPage",
        "@id": "https://courseswyn.com/contact",
        "url": "https://courseswyn.com/contact",
        "name": "Contact CoursesWyn",
        "description": "Send a message to CoursesWyn. We read every message.",
        "isPartOf": { "@id": "https://courseswyn.com" }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
          { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://courseswyn.com/contact" }
        ]
      }
    ]
  }
  </script>

  <main class="c-root">
    <div class="c-wrap">

      <div class="c-card-out">
        <div class="c-hdr">
          <div class="c-hdr-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="c-hdr-title">Contact Us</h3>
          <p class="c-hdr-sub">We're here to help and listen to your feedback</p>
        </div>

        <div class="c-cards">
          <div class="c-card">
            <div class="c-card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <h4>Get in Touch</h4>
            <p>We are always happy to read from our visitors and hear your feedback!</p>
          </div>
          <div class="c-card">
            <div class="c-card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h4>Support & Feedback</h4>
            <p>Report a bug, propose a new feature, or just say hello</p>
          </div>
          <div class="c-card">
            <div class="c-card-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
            </div>
            <h4>FAQ First</h4>
            <p>Check our <a href="/faq">FAQ section</a> for quick answers</p>
          </div>
        </div>

        <div class="c-form-out">
          <div class="c-form-hdr">
            <h3>Send Us a Message</h3>
            <div class="c-form-note">
              <span class="c-form-note-bold">Please note we have no contact with Udemy or instructors.</span>
              <p>We are just a team of volunteers who love to help you in your learning journey.</p>
            </div>
          </div>
          <div class="c-form-body">
            <div class="c-form-card">
              <form class="c-form" action="mailto:hello@courseswyn.com" method="post" enctype="text/plain">
                <div style="position:absolute;left:-9999px" aria-hidden="true">
                  <label for="companyWebsite">Company Website</label>
                  <input type="text" id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off">
                </div>

                <div class="c-field">
                  <label for="email">Email</label>
                  <div class="c-input-wrap">
                    <svg class="c-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email">
                  </div>
                </div>

                <div class="c-field">
                  <label for="subject">Subject</label>
                  <div class="c-input-wrap">
                    <svg class="c-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input type="text" id="subject" name="subject" placeholder="What is your message about?" maxlength="200">
                  </div>
                </div>

                <div class="c-field">
                  <label for="message">Message</label>
                  <div class="c-input-wrap">
                    <textarea id="message" name="message" placeholder="Please provide as much detail as possible" maxlength="5000" required rows="7"></textarea>
                  </div>
                </div>

                <div class="c-submit-wrap">
                  <button type="submit" class="c-btn">Send Message</button>
                </div>
              </form>
            </div>
          </div>
        </div>

      </div>

    </div>
  </main>

  <style>
    .c-root { padding: 2rem 0 3rem; }
    .c-wrap { max-width: 56rem; margin: 0 auto; padding: 0 1rem; }

    .c-card-out { border: 1px solid var(--border); border-radius: 12px; background: var(--card); overflow: hidden; }

    .c-hdr { text-align: center; padding: 2rem 1.5rem 1.5rem; border-bottom: 1px solid var(--border); }
    .c-hdr-icon { display: flex; align-items: center; justify-content: center; width: 2rem; height: 2rem; margin: 0 auto 0.75rem; color: var(--brand); }
    .c-hdr-title { font-size: 1.5rem; font-weight: 600; color: var(--text); margin: 0; }
    .c-hdr-sub { font-size: 0.95rem; color: var(--muted); margin: 0.5rem 0 0; }

    .c-cards { display: grid; grid-template-columns: 1fr; gap: 1.5rem; padding: 1.5rem; }
    @media (min-width:768px) { .c-cards { grid-template-columns: repeat(3,1fr); } }

    .c-card { border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; transition: border-color 0.15s; height: 100%; }
    .c-card:hover { border-color: var(--brand); }
    .c-card-icon { width: 3rem; height: 3rem; border-radius: 50%; background: color-mix(in srgb, var(--brand) 15%, transparent); color: var(--brand); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .c-card h4 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .c-card p { font-size: 0.85rem; color: var(--muted); line-height: 1.5; margin: 0; }
    .c-card a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .c-card a:hover { text-decoration: underline; }

    .c-form-out { border-top: 1px solid var(--border); }

    .c-form-hdr { text-align: center; padding: 1.5rem; border-bottom: 1px solid var(--border); }
    .c-form-hdr h3 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .c-form-note { max-width: 32rem; margin: 0 auto; }
    .c-form-note-bold { font-weight: 700; font-size: 0.8rem; color: var(--text); }
    .c-form-note p { font-size: 0.78rem; color: var(--muted); margin: 0.25rem 0 0; }

    .c-form-body { padding: 1.5rem; }
    .c-form-card { max-width: 36rem; margin: 0 auto; border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; background: var(--bg); }
    .c-form { display: flex; flex-direction: column; gap: 1.5rem; position: relative; }

    .c-field { display: flex; flex-direction: column; gap: 0.5rem; }
    .c-field label { font-size: 0.9rem; font-weight: 600; color: var(--text); }

    .c-input-wrap { position: relative; }
    .c-input-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }

    .c-field input[type="email"],
    .c-field input[type="text"] { width: 100%; height: 2.75rem; padding: 0 0.75rem 0 2.5rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-size: 0.9rem; outline: none; transition: border-color 0.15s; box-sizing: border-box; }
    .c-field input:focus { border-color: var(--brand); }

    .c-field textarea { width: 100%; min-height: 12rem; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-size: 0.9rem; outline: none; resize: vertical; transition: border-color 0.15s; box-sizing: border-box; }
    .c-field textarea:focus { border-color: var(--brand); }

    .c-field input::placeholder,
    .c-field textarea::placeholder { color: var(--muted); }

    .c-submit-wrap { display: flex; justify-content: center; padding-top: 0.5rem; }
    .c-btn { padding: 0.75rem 3rem; background: var(--brand); color: var(--bg); border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 700; cursor: pointer; transition: opacity 0.15s; }
    .c-btn:hover { opacity: 0.9; }
  </style>
</Layout>