  <script is:inline>
    (function() {
      var tabs = document.querySelectorAll('[data-tab]');
      var content = document.getElementById('tab-content');
      if (tabs.length && content) {
        function switchTab(tabId) {
          tabs.forEach(function(t) {
            t.classList.toggle('tbi-a', t.getAttribute('data-tab') === tabId);
          });
          var panels = content.querySelectorAll('[id^="tab-"]');
          panels.forEach(function(p) {
            if (p.id === 'tab-' + tabId) {
              p.style.display = '';
              p.classList.remove('tab-panel');
              void p.offsetWidth;
              p.classList.add('tab-panel');
            } else {
              p.style.display = 'none';
            }
          });
        }
        tabs.forEach(function(t) {
          t.addEventListener('click', function() {
            switchTab(t.getAttribute('data-tab'));
          });
        });
      }

      // Live verification pipeline cycling
      var statuses = document.querySelectorAll('.pnb .pns');
      if (statuses.length) {
        var cycles = [
          ['indexed', 'watched', 'verified'],
          ['queued', 'scanning', 'checking'],
          ['pending', 'queued', 'verifying'],
          ['pending', 'queued', 'confirming'],
          ['pending', 'ready', 'active']
        ];
        var checkSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        var clockSvg = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
        var spinnerSvg = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="pn-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
        var iconSets = [
          [checkSvg, spinnerSvg, checkSvg],
          [checkSvg, spinnerSvg, clockSvg],
          [clockSvg, spinnerSvg, clockSvg],
          [clockSvg, spinnerSvg, checkSvg],
          [clockSvg, spinnerSvg, checkSvg]
        ];
        var ci = 0;
        setInterval(function() {
          ci = (ci + 1) % 3;
          statuses.forEach(function(el, i) {
            var states = i < cycles.length ? cycles[i] : ['active','checking','verified'];
            el.classList.remove('pn-marquee');
            void el.offsetWidth;
            var icons = i < iconSets.length ? iconSets[i] : [checkSvg, spinnerSvg, checkSvg];
            el.innerHTML = icons[ci] + ' ' + states[ci].charAt(0).toUpperCase() + states[ci].slice(1);
            el.className = 'pns pn-marquee';
          });
        }, 2200);
      }

      var track = document.getElementById('feed-track');
      if (track) {
        var items = track.querySelectorAll('.fi');
        if (items.length > 5) {
          var clone = track.cloneNode(true);
          track.parentNode.appendChild(clone);
          var dur = Math.max(20, items.length * 0.8);
          track.style.animation = 'scrollFeed ' + dur + 's linear infinite';
          clone.style.animation = 'scrollFeed ' + dur + 's linear infinite';
        }

        // Random flash effect — simulate live verification
        setInterval(function() {
          var rows = track.parentNode.querySelectorAll('.fi');
          if (rows.length) {
            var idx = Math.floor(Math.random() * rows.length);
            rows[idx].classList.add('fi-flash');
            setTimeout(function() { rows[idx].classList.remove('fi-flash'); }, 600);
          }
        }, 3000);
      }
    })();
  </script>

