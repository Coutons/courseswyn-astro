            </span>
            <span class="sx-v-name">{v.name}</span>
            <span class="sx-v-desc">{v.desc}</span>
            <span class="sx-v-link">Browse →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PERSONAL PLAN ===================== -->
  <section class="section-wrapper" aria-label="Udemy Personal Plan offer" style="padding-top:2.5rem;">
    <div class="container">
