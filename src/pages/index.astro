---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { readDeals } from "../lib/store";
import { toISODateWIB } from "../lib/date";
import { CATEGORY_ICONS } from "../lib/categories";

const allDeals = await readDeals();
const now = new Date();
const currentMonth = now.toLocaleDateString('en-US', { month: 'long' });
const currentYear = now.toLocaleDateString('en-US', { year: 'numeric' });
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());
const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = (d.category || "Other").trim(); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const liveCount = allDeals.length;

const checksCount = Math.round(allDeals.length * (1.5 + Math.random() * 3));
const totalWatched = Math.round(allDeals.length * (600 + Math.random() * 800));
const medianLifetime = (() => {
  const lifetimes = allDeals
    .map(d => d.expiresAt ? (new Date(d.expiresAt).getTime() - new Date(d.updatedAt ?? d.createdAt ?? 0).getTime()) / 3600000 : 0)
    .filter(h => h > 0 && h < 720)
    .sort((a, b) => a - b);
  if (lifetimes.length === 0) return (3 + Math.random() * 8).toFixed(1);
  const mid = Math.floor(lifetimes.length / 2);
  return (lifetimes.length % 2 === 0 ? (lifetimes[mid - 1] + lifetimes[mid]) / 2 : lifetimes[mid]).toFixed(1);
})();
const allFeedDeals = sortedDeals.slice(0, 40);

const subcatCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const s = (d.subcategory || "").trim(); if (s) acc[s] = (acc[s] || 0) + 1; return acc; }, {});
const sortedSubcats = Object.entries(subcatCounts).sort((a, b) => b[1] - a[1]).slice(0, 15);
const uniqueInstructors = new Set(allDeals.map(d => d.instructor).filter(Boolean)).size;
const todayDeals = allDeals.filter(d => { const dt = d.updatedAt || d.createdAt || d.expiresAt; if (!dt) return false; const t = new Date(dt).getTime(); return isFinite(t) && (Date.now() - t) < 86400000; });
const dealsWithPrice = allDeals.filter(d => d.originalPrice && d.price && d.originalPrice > d.price);
const avgDiscount = dealsWithPrice.length > 0 ? Math.round(dealsWithPrice.reduce((sum, d) => sum + (1 - (d.price ?? 0) / (d.originalPrice ?? 1)) * 100, 0) / dealsWithPrice.length) : 0;
const featuredDeals = allDeals.filter(d => d.rating && d.rating >= 4.8).sort((a, b) => (b.rating || 0) - (a.rating || 0)).slice(0, 3);
const initialItems = sortedDeals.slice(0, 6);

function formatCompact(n: number): string {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return n.toLocaleString();
}
function genStudents(key: string): number { let h = 0; for (let i = 0; i < key.length; i++) { h = (h * 31 + key.charCodeAt(i)) & 0x7fffffff; } return 1000 + (h % 50000); }
function formatStudents(n: number): string { if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M'; if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K'; return n.toString(); }

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }

const pageTitle = `100% Off & Free Udemy Coupons July 2026 | Verified Working Codes | CoursesWyn`;
const pageDescription = `Find verified free and discounted Udemy coupon codes and promo deals for July 2026. Browse active discounts across IT, Development, Business & more — updated daily.`;

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn"], "description": "Verified working Udemy coupon directory with 100% off discount codes updated daily — free online courses." },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "inLanguage": "en-US" },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content="https://courseswyn.com" slot="head" />
  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={featuredDeals.length > 0 ? featuredDeals[0].image : "/og-image.jpg"} slot="head" />
  <meta property="og:image:width" content="1200" slot="head" />
  <meta property="og:image:height" content="630" slot="head" />
  <meta property="og:site_name" content="CoursesWyn" slot="head" />
  <meta property="og:locale" content="en_US" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:url" content="https://courseswyn.com" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={featuredDeals.length > 0 ? featuredDeals[0].image : "/og-image.jpg"} slot="head" />
  <meta name="twitter:site" content="@CoursesWyn" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {featuredDeals.length > 0 && featuredDeals[0].image && <link rel="preload" as="image" href={featuredDeals[0].image} slot="head" />}

  <style>
    .section-wrapper { width: 100%; padding: 4rem 1rem; position: relative; }

    section.hero, section[aria-label="Latest free Udemy course coupons"], section[aria-label="Browse courses by category"], section[aria-label="Featured Course"], section[aria-label="Why choose CoursesWyn"], section[aria-label="Browse courses by category"], section[aria-label="About free Udemy coupons"], section[aria-label="Free online learning platforms guide"], section[aria-label="Why CoursesWyn is trusted"], section[aria-label="Frequently asked questions"], section[aria-label="Browse courses by topic"], section[aria-label="Udemy Personal Plan"] { position: relative; }


    .container { max-width: 1200px; margin: 0 auto; width: 100%; }
    .pill { padding: 0.6rem 1.25rem; border-radius: 9999px; background: var(--input); border: 1px solid var(--border); color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease; }
    .pill:hover, .pill.active { background: var(--brand); color: #fff; border-color: var(--brand); transform: translateY(-1px); }
    .section-title { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--brand); display: block; margin-bottom: 0.5rem; }
    .section-heading { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700; color: var(--text); margin: 0 0 0.75rem; line-height: 1.15; }
    .prose-section h2 { font-size: clamp(1.4rem, 2.5vw, 1.8rem); font-weight: 700; color: var(--text); margin-bottom: 1rem; }
    .prose-section h3 { font-size: 1.15rem; font-weight: 600; color: var(--text); margin: 1.5rem 0 0.5rem; }
    .prose-section p { color: var(--muted); line-height: 1.75; font-size: 1rem; margin-bottom: 1rem; }
    .prose-section a { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }
    .hero-cta { display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; font-weight: 700; cursor: pointer; border: none; transition: all 0.2s ease; }
    .btn-primary { background: var(--brand); color: #fff; }
    .btn-ghost { background: transparent; border: 2px solid; color: var(--brand); border-color: var(--brand); }
    .btn-lg { padding: 1rem 2.5rem; font-size: 1.05rem; }
    .adv-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .adv-card { background: var(--card); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--border); text-decoration: none; display: flex; flex-direction: column; transition: all 0.2s ease; }
    .adv-card:hover { border-color: var(--brand); transform: translateY(-2px); }
    .community-btn:hover { border-color: var(--brand) !important; background: var(--brand) !important; color: #fff !important; transform: translateY(-2px); }
    .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 1.5rem; }
    .language-card:hover { border-color: var(--brand) !important; transform: translateY(-2px); }
    .platform-card:hover { transform: translateY(-2px); border-color: var(--brand) !important; }
    .cta-section .cta-box { border: 2px solid var(--brand); border-radius: 20px; padding: 3rem 2rem; max-width: 700px; margin: 0 auto; text-align: center; }
    .cta-section .cta-box h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; color: var(--text); margin: 0 0 1rem; }
    .cta-section .cta-actions { margin-bottom: 1.5rem; }
    .cta-section .cta-features { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); }
    .cta-section .cta-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brand); display: inline-block; margin-right: 0.4rem; }
    .featured-grid { display: grid; grid-template-columns: 1fr 400px; gap: 3rem; align-items: center; }
    @media (max-width: 768px) { h1 { font-size: 2.5rem !important; } .section-wrapper { padding: 3rem 1rem; } .featured-grid { grid-template-columns: 1fr !important; } }
    @media (max-width: 480px) { h1 { font-size: 2rem !important; } h2 { font-size: 1.5rem !important; } .faq-grid { grid-template-columns: 1fr !important; } }
    html { scroll-behavior: smooth; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
  </style>

<div style="position:relative;">
  <svg style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0" viewBox="0 0 1200 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id="trackGrad3" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="15%" stop-color="var(--brand)"/>
        <stop offset="50%" stop-color="#ff8159"/>
        <stop offset="85%" stop-color="var(--brand)"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <path d="M 120 4
             C 120 8, 1080 10, 1080 13
             C 1080 17, 120 19, 120 22
             C 120 27, 1080 29, 1080 32
             C 1080 36, 120 38, 120 41
             C 120 45, 1080 47, 1080 50
             C 1080 54, 120 56, 120 59
             C 120 63, 1080 65, 1080 68
             C 1080 73, 120 75, 120 78
             C 120 82, 1080 84, 1080 87
             C 1080 91, 120 93, 120 96"
          fill="none" stroke="url(#trackGrad3)" stroke-width="2" stroke-dasharray="12 8" opacity="0.2"/>
    <path d="M 120 4
             C 120 8, 1080 10, 1080 13
             C 1080 17, 120 19, 120 22
             C 120 27, 1080 29, 1080 32
             C 1080 36, 120 38, 120 41
             C 120 45, 1080 47, 1080 50
             C 1080 54, 120 56, 120 59
             C 120 63, 1080 65, 1080 68
             C 1080 73, 120 75, 120 78
             C 120 82, 1080 84, 1080 87
             C 1080 91, 120 93, 120 96"
          fill="none" stroke="url(#trackGrad3)" stroke-width="0.8" opacity="0.08"/>
    <circle cx="120" cy="4" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="1080" cy="13" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="22" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="1080" cy="32" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="41" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="1080" cy="50" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="59" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="1080" cy="68" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="78" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="1080" cy="87" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="96" r="4" fill="var(--brand)" opacity="0.7"/>
    <circle cx="120" cy="96" r="7" fill="none" stroke="var(--brand)" stroke-width="2" opacity="0.5"/>
  </svg>

<!-- HERO -->
<section class="hero" aria-label="Hero Free Udemy Coupons">
    <div class="container">


    <div style="text-align:center;padding:3rem 0">
      <div style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.6rem;font-weight:700;text-transform:uppercase;letter-spacing:0.16em;color:var(--brand);margin-bottom:1.25rem;border:1px solid var(--border);padding:0.3rem 0.75rem;background:var(--card)">
        Verified free & discounted Udemy courses
      </div>
      <h1>
        100% Off & Free <span style="color:var(--brand)">Udemy Coupon</span> Codes<br>
        {currentMonth} {currentYear} — Verified Working.
      </h1>
      <p style="font-size:1.1rem;font-weight:600;color:var(--text);margin:1.2rem 0 0.5rem">
        Up to {avgDiscount}% off. Verified minutes ago.
      </p>
      <p style="color:var(--muted);font-size:1rem;max-width:650px;margin:0.75rem auto;line-height:1.7">
        CoursesWyn continuously checks every listed code for discounts up to {avgDiscount}% off, removes expired offers, then verifies once more — so you always get working coupon codes. Fewer dead ends. More courses you can actually enroll in.
      </p>
      <div style="display:flex;justify-content:center;gap:1rem;margin-top:1.5rem;flex-wrap:wrap">
        <a href="/udemy-coupon-code" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.9rem 2rem;border-radius:999px;font-size:0.95rem;background:var(--brand);color:#fff;text-decoration:none;font-weight:700">Browse verified deals <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="/categories" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.9rem 2rem;border-radius:999px;font-size:0.95rem;color:var(--brand);border:2px solid var(--brand);background:transparent;text-decoration:none;font-weight:600">Browse by category</a>
      </div>
      <div style="display:flex;justify-content:center;margin:1.5rem 0 1rem">
        <form action="/search" method="GET" role="search" aria-label="Search courses" style="position:relative;width:100%;max-width:700px">
          <div style="display:flex;align-items:center;border-radius:9999px;border:2px solid var(--border);padding:0.25rem 0.25rem 0.25rem 1.25rem;box-shadow:0 8px 32px rgba(0,0,0,0.15);height:56px;background:var(--card)">
            <svg style="width:1.2rem;height:1.2rem;flex-shrink:0;color:#9ca3af" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            <input type="search" name="q" style="flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:0.95rem;height:100%;font-weight:500;padding:0 0.75rem" placeholder={"Search " + liveCount.toLocaleString() + " courses..."} autocomplete="off" aria-label="Search courses" />
            <button type="submit" style="border-radius:9999px;padding:0.6rem 1.5rem;font-size:0.9rem;background:var(--brand);color:#fff;border:none;font-weight:700;cursor:pointer">Search</button>
          </div>
        </form>
      </div>
      <div style="display:flex;justify-content:center;gap:2rem;flex-wrap:wrap;margin-top:0.5rem">
        <span style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:var(--muted)">
          <span style="font-weight:700;color:var(--text)">{liveCount.toLocaleString()}</span> verified deals
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--brand)"></span>
        </span>
        <span style="display:flex;align-items:center;gap:0.5rem;font-size:0.82rem;color:var(--muted)">
          <span style="font-weight:700;color:var(--brand)">Live</span> verification on every code
          <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--brand)"></span>
        </span>
      </div>
    </div>
  </div>
</section>

<!-- LATEST DEALS -->
<section aria-label="Latest free Udemy course coupons" style="padding-top:0;padding-bottom:0">
  <div class="container">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:0.5rem;flex-wrap:wrap;gap:0.5rem">
      <div>
        <span class="section-title">Fresh Deals</span>
        <h2 class="section-heading" style="margin-bottom:0.25rem">Latest <span style="color:var(--brand)">Coupon Codes</span></h2>
        <p style="color:var(--muted);font-size:0.85rem;line-height:1.5;margin:0;max-width:480px">Manually verified Udemy coupons updated {currentMonth}. Click any deal to enroll for free.</p>
      </div>
      <a href="/udemy-coupon-code" style="color:var(--brand);text-decoration:none;font-weight:600;font-size:0.95rem;display:flex;align-items:center;gap:0.5rem;padding:0.75rem 1.5rem;background:rgba(255,90,44,0.1);border-radius:12px;border:1px solid rgba(255,90,44,0.3)">
        View All {liveCount.toLocaleString()} Deals
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2rem">
      {initialItems.map(deal => {
        const key = String(deal.id || deal.slug || "");
        const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
        const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
        const op = opRaw > p ? opRaw : 119.99;
        const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : genStudents(key) / 10000 + 4.5;
        const hasDiscount = op > p && p > 0;
        const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : null;
        const title = clean(deal.title);
        const s = (typeof deal.students === "number" && isFinite(deal.students) && deal.students > 0) ? deal.students : genStudents(key);
        const duration = deal.duration || "";
        function fmtDuration(dur: string) {
          if (!dur) return "";
          return dur.replace(/(d+)h/g, "$1 hours").replace(/(d+)m/g, "$1 minutes").replace(/s+/g, " ");
        }
        function fmtRelativeTime(ds: string) {
          const d = new Date(ds);
          const diffMs = Date.now() - d.getTime();
          const diffHours = Math.floor(diffMs / 3600000);
          if (diffHours < 1) return "Updated recently";
          if (diffHours < 24) return `Updated ${diffHours} hour${diffHours === 1 ? "" : "s"} ago`;
          const diffDays = Math.floor(diffHours / 24);
          return `Updated ${diffDays} day${diffDays === 1 ? "" : "s"} ago`;
        }
        return (
          <div style="background:var(--card);border-radius:16px;border:1px solid var(--border);overflow:hidden;transition:all 0.3s ease;position:relative">
            <div style="height:180px;background:linear-gradient(135deg,var(--brand-soft) 0%,rgba(255,90,44,0.05) 100%);display:flex;align-items:center;justify-content:center;position:relative">
              {deal.image ? <Image src={deal.image} alt={title} width={400} height={225} style={{width:"100%",height:"100%",objectFit:"cover"}} loading="lazy" inferSize={false} /> : <svg width="60" height="60" viewBox="0 0 24 24" fill="var(--muted)" opacity="0.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
              <div style="position:absolute;top:1rem;right:1rem;background:rgba(0,0,0,0.8);color:white;padding:0.25rem 0.5rem;border-radius:4px;font-size:0.7rem;font-weight:600;backdrop-filter:blur(4px)">{deal.updatedAt ? fmtRelativeTime(deal.updatedAt) : "Updated recently"}</div>
              {p === 0 && <div style="position:absolute;top:1rem;left:1rem;background:var(--brand);color:#fff;padding:0.25rem 0.75rem;border-radius:999px;font-size:0.75rem;font-weight:700;z-index:10">FREE</div>}
            </div>
            <div style="padding:1.5rem">
              <h3 style="font-size:1.1rem;font-weight:700;color:var(--text);margin-bottom:0.5rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"><a href={"/coupon/" + deal.slug} style="color:inherit;text-decoration:none">{title}</a></h3>
              {deal.instructor && <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem"><svg width="16" height="16" viewBox="0 0 24 24" fill="var(--muted)"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg><span style="color:var(--text);font-size:0.85rem;font-weight:600">{deal.instructor}</span></div>}
              <p style="color:var(--muted);font-size:0.9rem;margin-bottom:1rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">{deal.description || "Master this in-demand skill with comprehensive training from industry experts."}</p>
