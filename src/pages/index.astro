  .sx-sub { font-size: 1.15rem; color: rgba(228,228,231,0.78); max-width: 640px; margin: 0 auto 1.75rem; line-height: 1.6; }
  .sx-search { display: flex; gap: 8px; max-width: 640px; margin: 0 auto; background: #fff; border-radius: 14px; padding: 6px; box-shadow: 0 20px 50px -12px rgba(0,0,0,0.45); }
  .sx-search input { flex: 1; border: none; outline: none; font-size: 0.95rem; padding: 12px 16px; min-width: 0; color: #111; background: transparent; font-family: inherit; }
