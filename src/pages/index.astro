  html { scroll-behavior: smooth; }


  /* ── Sales design (sx-) ── */
  .sx-hero { background: linear-gradient(160deg, #0E0E10 0%, #121212 45%, #1E1E1E 100%); padding: 4rem 0 0; text-align: center; position: relative; overflow: hidden; }
