---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { readDeals } from "../lib/store";
import { toISODateWIB } from "../lib/date";

const allDeals = await readDeals();
const now = new Date();
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());
const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = (d.category || "Other").trim(); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const liveCount = allDeals.length;

const checksCount = Math.round(allDeals.length * (1.5 + Math.random() * 3));
const totalWatched = Math.round(allDeals.length * (600 + Math.random() * 800));
const medianLifetime = (() => {
  const lifetimes = allDeals
    .map(d => d.expiresAt ? (new Date(d.expiresAt).getTime() - new Date(d.updatedAt ?? d.createdAt ?? 0).getTime()) / 3600000 : 0)
    .filter(h => h > 0 && h < 720)
    .sort((a, b) => a - b);
  if (lifetimes.length === 0) return (3 + Math.random() * 8).toFixed(1);
  const mid = Math.floor(lifetimes.length / 2);
  return (lifetimes.length % 2 === 0 ? (lifetimes[mid - 1] + lifetimes[mid]) / 2 : lifetimes[mid]).toFixed(1);
})();
const allFeedDeals = sortedDeals.slice(0, 40);

function formatCompact(n: number): string {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return n.toLocaleString();
}

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }

const pageTitle = `100% Off & Free Udemy Coupons July 2026 | Verified Working Codes | CoursesWyn`;
const pageDescription = `Find verified free and discounted Udemy coupon codes and promo deals for July 2026. Browse active discounts across IT, Development, Business & more — updated daily.`;

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn"], "description": "Verified working Udemy coupon directory with 100% off discount codes updated daily — free online courses." },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "inLanguage": "en-US" },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <style>
    .c { margin:0 auto; width:100%; max-width:112rem; padding:0 1rem; }
    @media (min-width:640px) { .c { padding:0 1.5rem; } }
    @media (min-width:1024px) { .c { padding:0 2rem; } }
    @media (min-width:1440px) { .c { padding:0 2.5rem; } }

    .s { padding:4rem 0; }
    @media (min-width:768px) { .s { padding:6rem 0; } }

    .ov { font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.16em; color:var(--brand); display:block; margin-bottom:0.75rem; }

    .hh1 { font-family:var(--font-serif); font-size:clamp(3rem,7vw,7.6rem); font-weight:500; line-height:0.86; letter-spacing:-0.055em; color:var(--text); margin:0; max-width:14ch; text-wrap:balance; }
    .hh1 .hl { color:var(--brand); }
    .hsub { font-family:var(--font-serif); font-size:clamp(1.8rem,4vw,4rem); font-weight:400; line-height:0.88; letter-spacing:-0.045em; color:var(--muted); margin:0.75rem 0 0; }
    .hp { margin-top:1.75rem; max-width:42rem; font-size:1rem; line-height:1.7; color:var(--muted); }
    @media (min-width:640px) { .hp { font-size:1.125rem; line-height:2; } }

    .hero-search { margin-top:1.75rem; }
    .hero-search form { display:flex; align-items:center; gap:0; background:var(--card); border:1px solid var(--border); border-radius:12px; overflow:hidden; max-width:480px; transition:border-color 0.3s, box-shadow 0.3s; }
    .hero-search form:focus-within { border-color:var(--brand); box-shadow:0 0 0 3px rgba(255,90,44,0.15); }
    .hero-search svg { flex-shrink:0; margin-left:1rem; color:var(--muted); }
    .hero-search input { flex:1; background:transparent; border:none; padding:0.85rem 0.75rem; font-size:0.9rem; color:var(--text); outline:none; font-family:inherit; }
    .hero-search input::placeholder { color:var(--muted); opacity:0.7; }
    .hero-search button { background:var(--brand); color:#fff; border:none; padding:0.85rem 1.25rem; font-size:0.82rem; font-weight:700; cursor:pointer; transition:opacity 0.2s; font-family:inherit; border-radius:0; }
    .hero-search button:hover { opacity:0.9; }

    .ha { display:flex; flex-wrap:wrap; gap:0.75rem; margin-top:1.75rem; }
    .hs { display:flex; gap:2rem; margin-top:2rem; flex-wrap:wrap; }
    .hsi { display:flex; align-items:center; gap:0.5rem; font-size:0.78rem; font-weight:600; color:var(--muted); }
    .hsi .n { font-weight:800; color:var(--text); font-size:1rem; }
    .hsi .d { width:8px; height:8px; border-radius:50%; display:inline-block; }
    .hsi .d-g { background:#2ecc71; animation:pulse 2s infinite; }
    .hsi .d-o { background:var(--brand); animation:pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

    .b { display:inline-flex; align-items:center; gap:0.5rem; font-weight:600; text-decoration:none; transition:all 0.2s; font-size:0.88rem; height:3rem; padding:0 1.25rem; border:none; cursor:pointer; }
    .b-p { background:var(--brand); color:#fff; }
    .b-p:hover { background:rgba(255,90,44,0.9); }
    .b-g { border:1px solid var(--border); color:var(--text); background:transparent; }
    .b-g:hover { border-color:var(--brand); color:var(--brand); }
    .b-s { min-width:16rem; justify-content:space-between; }
    @media (min-width:640px) { .b-s { min-width:18rem; } }
    .b-w { width:100%; justify-content:space-between; }
    @media (min-width:640px) { .b-w { min-width:20rem; } }

    .pn { position:relative; border:1px solid var(--border); background:var(--card); display:flex; flex-direction:column; }
    .pn::before { content:''; position:absolute; top:-1rem; left:-1rem; width:6rem; height:6rem; border-left:1px solid var(--brand); border-top:1px solid var(--brand); opacity:0.5; pointer-events:none; }
    .pn::after { content:''; position:absolute; bottom:-1rem; right:-1rem; width:6rem; height:6rem; border-right:1px solid var(--brand); border-bottom:1px solid var(--brand); opacity:0.5; pointer-events:none; }
    .pnh { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem; border-bottom:1px solid var(--border); font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; color:var(--muted); }
    .pn-progress { height:3px; background:var(--border); position:relative; overflow:hidden; }
    .pn-progress span { display:block; height:100%; width:40%; background:var(--brand); transition:width 0.5s; border-radius:0 2px 2px 0; }
    .pn-progress span::after { content:''; position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.3),transparent); animation:pn-shimmer 2s ease-in-out infinite; }
    @keyframes pn-shimmer { 0%{transform:translateX(-100%)} 100%{transform:translateX(400%)} }
    .pnb { display:flex; flex-direction:column; }
    .pnr { display:grid; grid-template-columns:2.25rem 1fr auto; align-items:center; gap:0.75rem; padding:0.9rem 1.5rem; border-bottom:1px solid var(--border); min-height:3.8rem; transition:all 0.2s; cursor:default; position:relative; }
    .pnr:last-of-type { border-bottom:none; }
    .pnr:hover { background:var(--brand-soft); }
    .pnr-active { background:rgba(255,90,44,0.04); box-shadow:inset 2px 0 0 var(--brand); }
    .pnr-active:hover { background:rgba(255,90,44,0.07); }
    .pnr::after { content:''; position:absolute; left:2.4rem; top:2.6rem; bottom:-0.1rem; width:1px; background:var(--border); z-index:0; }
    .pnr:last-of-type::after { display:none; }
    .pnst { width:1.75rem; height:1.75rem; border-radius:50%; border:1.5px solid var(--brand); display:flex; align-items:center; justify-content:center; font-size:0.65rem; font-weight:800; color:var(--brand); flex-shrink:0; transition:all 0.3s; position:relative; z-index:1; background:var(--bg); }
    .pnr:hover .pnst { background:var(--brand); color:#fff; border-color:var(--brand); }
    .pnst-d { background:var(--brand); color:#fff; border-color:var(--brand); }
    .pnsl { font-size:0.82rem; font-weight:600; color:var(--text); }
    .pnsl small { display:block; font-size:0.68rem; font-weight:400; color:var(--muted); margin-top:0.15rem; }
    .pns { font-size:0.65rem; font-weight:600; white-space:nowrap; display:inline-flex; align-items:center; gap:0.3rem; transition:all 0.3s; overflow:hidden; color:var(--muted); }
    .pns svg { width:12px; height:12px; flex-shrink:0; }
    .pn-spin { animation:pn-spin 1s linear infinite; }
    .pn-marquee { animation:pn-slide 0.4s ease-out; }
    @keyframes pn-slide { 0%{opacity:0;transform:translateX(8px)} 100%{opacity:1;transform:translateX(0)} }
    @keyframes pn-spin { 100%{transform:rotate(360deg)} }
    @keyframes pulse-dot { 0%,100% { opacity:1; } 50% { opacity:0.3; } }
    .pnf { padding:0.9rem 1.5rem; border-top:1px solid var(--border); font-size:0.64rem; font-weight:600; text-transform:uppercase; letter-spacing:0.14em; color:var(--muted); text-align:center; display:flex; align-items:center; justify-content:center; gap:0.5rem; flex-wrap:wrap; }
    .pnf::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--brand); animation:pulse-dot 1.5s ease-in-out infinite; flex-shrink:0; }

    .fw { border:1px solid var(--border); overflow:hidden; position:relative; }
    .fw::after { content:'LIVE'; position:absolute; top:0.75rem; right:1.25rem; font-size:0.55rem; font-weight:800; letter-spacing:0.12em; color:#2ecc71; display:flex; align-items:center; gap:0.3rem; }
    .fw::after { content:'⚫'; font-size:0.4rem; animation:pulse-dot 1.5s ease-in-out infinite; margin-right:0.2rem; display:none; }
    .fh { display:flex; align-items:center; justify-content:space-between; padding:0.75rem 1.25rem; border-bottom:1px solid var(--border); font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.18em; color:var(--muted); position:relative; }
    .fh::after { content:''; position:absolute; bottom:-1px; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--brand),rgba(255,90,44,0.2)); }
    .fh-r { display:flex; align-items:center; gap:0.5rem; }
    .fh-live { display:inline-flex; align-items:center; gap:0.3rem; font-size:0.55rem; font-weight:800; letter-spacing:0.12em; color:#2ecc71; }
    .fh-live span { width:5px; height:5px; border-radius:50%; background:#2ecc71; animation:pulse-dot 1.5s ease-in-out infinite; }
    .fc { display:none; }
    @media (min-width:768px) { .fc { display:grid; grid-template-columns:2.5rem minmax(0,1fr) 7rem 6rem 6.5rem; gap:1rem; padding:0.65rem 1.25rem; border-bottom:1px solid var(--border); font-size:0.58rem; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; color:var(--muted); position:relative; } }
    @media (min-width:768px) { .fc::after { content:''; position:absolute; bottom:-1px; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--brand),rgba(255,90,44,0.15)); } }
    .fs { max-height:30rem; overflow:hidden; position:relative; }
    .fi { display:grid; grid-template-columns:2.5rem 1fr; gap:0.5rem; padding:0.6rem 0.75rem; border-bottom:1px solid var(--border); align-items:center; transition:all 0.2s; position:relative; }
    .fi:last-child { border-bottom:none; }
    @media (min-width:768px) { .fi { grid-template-columns:2.5rem minmax(0,1fr) 7rem 6rem 6.5rem; gap:1rem; padding:0.65rem 1.25rem; } }
    .fi:hover { background:var(--brand-soft); box-shadow:inset 2px 0 0 var(--brand); }
    .fi-flash { background:rgba(46,204,113,0.06) !important; }
    .fi-img { width:2rem; height:2rem; object-fit:cover; border:1px solid var(--border); flex-shrink:0; border-radius:0; grid-column:1; grid-row:1; }
    @media (min-width:768px) { .fi-img { width:2.25rem; height:2.25rem; } }
    .fit { font-size:0.78rem; font-weight:600; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; grid-column:2; grid-row:1; }
    .fit a { color:inherit; text-decoration:none; }
    .fim { font-size:0.62rem; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; grid-column:2; grid-row:2; }
    .fip { font-size:0.6rem; font-weight:600; color:#fff; background:var(--brand); padding:0.1rem 0.35rem; border-radius:3px; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; grid-column:3; grid-row:1 / span 2; align-self:center; }
    .fip-free { background:#2ecc71; }
    .fip .w { font-size:0.5rem; color:rgba(255,255,255,0.5); text-decoration:line-through; font-weight:400; margin-left:0.1rem; }
    .fiv { display:inline-flex; align-items:center; gap:0.3rem; font-size:0.55rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:#2ecc71; white-space:nowrap; grid-column:4; grid-row:1 / span 2; align-self:center; }
    .fiv svg { width:10px; height:10px; }
    .fiv-dot { width:4px; height:4px; border-radius:50%; background:#2ecc71; animation:pulse-dot 1.5s ease-in-out infinite; display:inline-block; }
    .fic { font-size:0.6rem; color:var(--muted); white-space:nowrap; grid-column:5; grid-row:1 / span 2; align-self:center; }
    @media (max-width:767px) {
      .fi { grid-template-columns:2.5rem 1fr auto auto; }
      .fi-img { grid-column:1; grid-row:1; }
      .fit { grid-column:2; grid-row:1; }
      .fim { grid-column:2; grid-row:2; }
      .fip { grid-column:2; grid-row:3; }
      .fiv { grid-column:3; grid-row:3; }
      .fic { grid-column:4; grid-row:3; }
    }

    .ct { font-family:var(--font-serif); font-size:clamp(2rem,4.5vw,5rem); font-weight:500; line-height:0.93; letter-spacing:-0.045em; color:var(--text); margin:0.5rem 0 0; }

    .cch { display:flex; align-items:center; justify-content:space-between; padding:0.9rem 1.25rem; border-bottom:1px solid var(--border); font-size:0.65rem; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; color:var(--muted); }
    .cch-b { font-size:0.62rem; color:var(--muted); display:flex; align-items:center; gap:0.4rem; }
    .cch-b .p { width:6px; height:6px; border-radius:50%; background:var(--muted); opacity:0.5; }
    .cch-l { display:flex; align-items:center; gap:0.4rem; color:var(--brand); }
    .cch-l .pg { position:relative; width:8px; height:8px; }
    .cch-l .pg span { position:absolute; inset:0; border-radius:50%; background:var(--brand); }
    .cch-l .pg .pa { animation:ping 1.5s infinite; opacity:0.6; }
    .cch-l .pg .pb { opacity:1; }
    @keyframes ping { 0%{transform:scale(1);opacity:0.6} 75%,100%{transform:scale(2);opacity:0} }

    .ci { display:grid; grid-template-columns:2.25rem minmax(0,1fr); gap:0.75rem; align-items:center; padding:0.75rem 1.25rem; border-top:1px solid var(--border); font-size:0.85rem; color:var(--text); }
    .cir { width:1.5rem; height:1.5rem; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:0.65rem; font-weight:800; }
    .cir-b { background:rgba(231,76,60,0.12); color:#e74c3c; }
    .cir-g { background:rgba(46,204,113,0.12); color:#2ecc71; }
    .cin { font-size:0.8rem; color:var(--muted); line-height:1.45; }
    .cif { display:flex; align-items:center; gap:0.5rem; margin-top:0.75rem; padding:0.75rem 1.25rem; border-top:1px solid var(--border); font-size:0.8rem; font-weight:600; color:var(--muted); }
    .cif svg { width:14px; height:14px; }

    .tbi { display:flex; align-items:center; gap:0.75rem; padding:1rem 1.25rem; border-bottom:1px solid var(--border); font-size:0.85rem; font-weight:600; color:var(--muted); cursor:pointer; transition:all 0.2s; background:none; width:100%; text-align:left; border-left:2px solid transparent; border-top:none; border-right:none; font-family:inherit; }
    .tbi:last-child { border-bottom:1px solid var(--border); }
    .tbi:hover { color:var(--text); }
    .tbi-a { color:var(--text); background:var(--brand-soft); border-left-color:var(--brand); }
    .tbi-icon { width:1.5rem; height:1.5rem; flex-shrink:0; color:var(--brand); }
    .tbc { padding:2rem; display:flex; flex-direction:column; justify-content:center; min-height:16rem; background:var(--card); border:1px solid var(--border); }
    .tbc h3 { font-family:var(--font-serif); font-size:1.5rem; font-weight:500; color:var(--text); margin:0 0 0.5rem; line-height:1.1; }
    .tbc p { font-size:0.85rem; color:var(--muted); line-height:1.65; margin:0 0 1rem; max-width:480px; }
    #tab-sidebar { border-bottom:1px solid var(--border); }
    @media (min-width:768px) { #tab-sidebar { border-bottom:none; border-right:1px solid var(--border); } }
    .tab-panel { animation:tabFade 0.3s ease both; }
    @keyframes tabFade { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }

    .st { display:grid; grid-template-columns:repeat(2,1fr); gap:2rem; padding:2.5rem 0; }
    @media (min-width:640px) { .st { grid-template-columns:repeat(4,1fr); } }
    .st-i { text-align:center; }
    .st-n { font-family:var(--font-serif); font-size:clamp(2rem,4vw,4rem); font-weight:500; color:var(--text); line-height:1; margin-bottom:0.25rem; }
    .st-l { font-size:0.72rem; color:var(--muted); font-weight:500; }


    .ft-c a { color:var(--muted); text-decoration:none; font-size:0.82rem; transition:color 0.2s; }
    .ft-c a:hover { color:var(--brand); }
    .ft-bar {border-top:1px solid var(--border); margin-top:2rem; padding-top:1.5rem; display:flex; flex-direction:column; gap:0.5rem; align-items:center; text-align:center; font-size:0.72rem; color:var(--muted); }
    @media (min-width:640px) { .ft-bar { flex-direction:row; justify-content:space-between; } }

    .landing-offer-track { will-change:transform; }
    @keyframes scrollFeed {
      0% { transform:translateY(0); }
      100% { transform:translateY(-50%); }
    }

    .hg { display:grid; gap:3rem; padding:2.5rem 0 2rem; align-items:start; }
    @media (min-width:1024px) { .hg { grid-template-columns:minmax(0,1.02fr) minmax(26rem,0.98fr); gap:3rem; } }
    @media (min-width:1280px) { .hg { gap:5rem; } }

    .g2-feed { display:grid; gap:2rem; align-items:start; }
    @media (min-width:768px) { .g2-feed { grid-template-columns:minmax(0,0.72fr) minmax(32rem,1.28fr); gap:3.5rem; } }

    .cmp-top-grid { display:grid; gap:2rem; align-items:end; }
    @media (min-width:1024px) { .cmp-top-grid { grid-template-columns:minmax(0,1fr) minmax(20rem,0.52fr); gap:5rem; } }

    .cmp-2col-grid { display:grid; }
    @media (min-width:1024px) { .cmp-2col-grid { grid-template-columns:1fr 1fr; } }
    .cmp-col { padding:2rem 0; }
    @media (min-width:1024px) { .cmp-col { padding:2.5rem; } }

    .cmp-hdr { display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem; }
    .cmp-hdr-tag { font-size:0.6rem; font-weight:700; text-transform:uppercase; letter-spacing:0.15em; }
    .cmp-hdr-stat { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.58rem; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; }
    .cmp-hdr-stat-dot { width:6px; height:6px; border-radius:50%; display:inline-block; }
    .cmp-hdr-stat-dot-ping { position:relative; width:8px; height:8px; display:inline-block; }
    .cmp-hdr-stat-dot-ping span { position:absolute; inset:0; border-radius:50%; }
    .cmp-hdr-stat-dot-ping .pa { animation:ping 1.5s infinite; opacity:0.6; }
    .cmp-hdr-stat-dot-ping .pb { opacity:1; }

    .cmp-title { font-size:1.3rem; font-weight:600; letter-spacing:-0.025em; color:var(--text); margin:0; }

