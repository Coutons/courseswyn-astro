---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { readDeals } from "../lib/store";
import { toISODateWIB } from "../lib/date";
import { CATEGORY_ICONS } from "../lib/categories";
import { getCollection } from "astro:content";

const allDeals = await readDeals();
const blogPosts = await getCollection("blog");
const now = new Date();
const currentMonth = now.toLocaleDateString('en-US', { month: 'long' });
const currentYear = now.toLocaleDateString('en-US', { year: 'numeric' });
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());

const last24h = sortedDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 24 * 3600000; }).length;
const last7d = sortedDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 7 * 24 * 3600000; }).length;

const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = (d.category || "Other").trim(); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const subcatCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const s = (d.subcategory || "").trim(); if (s) acc[s] = (acc[s] || 0) + 1; return acc; }, {});
const subcatsByCat = allDeals.reduce<Record<string, Set<string>>>((acc, d) => { const c = (d.category || "Other").trim(); const s = (d.subcategory || "").trim(); if (c && s) { (acc[c] = acc[c] || new Set()).add(s); } return acc; }, {});
const sortedSubcats = Object.entries(subcatCounts).sort((a, b) => b[1] - a[1]).slice(0, 16);
const GRADIENT_COLORS = [
  { c1: '#0d9488', c2: '#115e59' },
  { c1: '#059669', c2: '#047857' },
  { c1: '#0891b2', c2: '#0e7490' },
  { c1: '#3b82f6', c2: '#1d4ed8' },
  { c1: '#6d28d9', c2: '#5b21b6' },
  { c1: '#b45309', c2: '#92400e' },
  { c1: '#7e22ce', c2: '#6b21a8' },
  { c1: '#0f766e', c2: '#134e4a' }
];
const topicHash = (s: string) => ((s.split('').reduce((h, ch) => h * 31 + ch.charCodeAt(0), 7) % 100000) + 100000) % 100000;
const topicCards = sortedSubcats.map(([topic, count]) => {
  const hash = topicHash(topic);
  const grad = GRADIENT_COLORS[hash % GRADIENT_COLORS.length];
  return {
    name: topic,
    slug: topicSlug(topic),
    count,
    c1: grad.c1,
    c2: grad.c2,
    s1x: 24 + (hash % 56),
    s1y: 16 + (hash >> 3) % 34,
    s1r: 26 + (hash >> 4) % 26,
    s2x: 200 + (hash >> 2) % 96,
    s2y: 10 + (hash >> 6) % 30,
    s2r: 22 + (hash >> 5) % 22,
    s3x: 280 - (hash >> 7) % 60,
    s3y: 130 + (hash >> 8) % 40,
    s3r: 12 + (hash >> 9) % 14
  };
});
const featuredPool = [...sortedDeals].slice(0, 36);
const featuredDeals = featuredPool.slice(0, 6);
const courseOfDay = allDeals.filter(d => d.rating && d.rating >= 4.6).sort((a, b) => (b.rating || 0) - (a.rating || 0))[0] || sortedDeals[0];
const heroCardCourse = featuredPool[1] || courseOfDay;
const redeemCardCourse = featuredPool[2] || courseOfDay;
const discountPcts = allDeals
  .filter((d): d is typeof d & { price: number; originalPrice: number } => typeof d.price === "number" && typeof d.originalPrice === "number" && d.originalPrice > d.price)
  .map((d) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;
const liveCount = allDeals.length;

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }
function formatCompact(n: number): string { if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M'; if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K'; return n.toLocaleString(); }
function genStudents(key: string): number { let h = 0; for (let i = 0; i < key.length; i++) { h = (h * 31 + key.charCodeAt(i)) & 0x7fffffff; } return 1000 + (h % 50000); }
function catSlug(c: string) { return c.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""); }
function topicSlug(s: string) { return s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, ""); }
function fmtDur(dur: string) { if (!dur) return ""; return dur.replace(/(\d+)h/g, "$1h").replace(/(\d+)m/g, "$1m").replace(/\s+/g, " "); }
function resolveImage(imagePath: string | undefined): string | null { if (!imagePath) return null; if (imagePath.startsWith('http')) return imagePath; const filename = imagePath.split('/').pop(); return `/assets/images/${filename}`; }

const faqs = [
  { q: "Does it cost anything to use CoursesWyn?", a: "No. CoursesWyn is completely free to use — no signup, no account, no credit card. Every coupon we list gets you the course at a heavily discounted price, often up to " + maxDiscountPct + "% off. You only need a free Udemy account to enroll." },
  { q: "How frequently are new deals added?", a: "New coupons are added throughout the day as soon as they go live on Udemy. We recommend checking back daily or visiting the latest deals page to catch fresh discounts before they expire." },
  { q: "What happens if a coupon expires before I enroll?", a: "Coupons have limited redemptions and fixed expiry dates. If a coupon expires, the course returns to full price. We remove expired deals from our listings daily — just check back for new discounts in the same category." },
  { q: "Do discounted courses include a certificate?", a: "Yes. Enrolling through a CoursesWyn coupon gives you the same certificate of completion as a full-price student — plus lifetime access to materials, future updates, and instructor Q&A. Nothing is held back." },
  { q: "Can I watch discounted courses on my phone?", a: "Absolutely. Any course you claim through a CoursesWyn coupon is fully accessible on the Udemy mobile app (iOS and Android). You can stream or download lectures for offline learning." },
  { q: "How does CoursesWyn pick which courses to list?", a: "We prioritize courses with strong ratings, reputable instructors, and current curriculum. Our automated pipeline checks every deal against quality signals (rating, reviews, instructor history) before publishing — so a big discount doesn't mean low quality." }
];

const titleMonth = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' });
const pageTitle = `Verified Udemy Coupon Codes - Get Premium Courses for Less | CoursesWyn`;
const pageDescription = `Get premium Udemy courses for less. Find verified coupon codes and discounts, save up to ${maxDiscountPct}% on top courses — new deals added daily.`;

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "inLanguage": "en-US", "publisher": { "@id": "https://courseswyn.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn", "https://medium.com/@coursewyn"], "description": `Verified working Udemy coupon and discount directory with up to ${maxDiscountPct}% off codes, updated daily.` },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "datePublished": toISODateWIB(new Date()), "inLanguage": "en-US", "about": { "@id": "https://courseswyn.com/#organization" }, "primaryImageOfPage": { "@type": "ImageObject", "url": "https://courseswyn.com/assets/images/og-default.svg" }, "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".rd2-sub", ".rd2-faq h3", ".rd2-faq p"] } },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] },
    {
      "@type": "ItemList", "itemListElement": featuredDeals.slice(0, 10).map((d, i) => ({
        "@type": "ListItem", "position": i + 1, "item": {
          "@type": "Course", "name": clean(d.title), "url": "https://courseswyn.com/coupon/" + d.slug,
          "description": clean(d.description), "provider": { "@type": "Organization", "name": d.provider || "Udemy", "sameAs": "https://www.udemy.com" },
          "aggregateRating": { "@type": "AggregateRating", "ratingValue": (d.rating && d.rating > 0 ? d.rating : 4.5).toFixed(1), "bestRating": 5, "reviewCount": typeof d.students === "number" && isFinite(d.students) ? Math.max(100, Math.round(d.students * 0.05)) : 500 },
          "offers": { "@type": "Offer", "price": d.price && d.price > 0 ? d.price : (d.originalPrice || 0), "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://courseswyn.com/coupon/" + d.slug }
        }
      }))
    },
    { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  ]
};

const heroChips = [
  { name: "Python", q: "Python", icon: '<path d="M13 2L4 13h5l-2 9 9-11h-5l2-9z" />' },
  { name: "ChatGPT", q: "ChatGPT", icon: '<circle cx="12" cy="12" r="3" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3" />' },
  { name: "AWS", q: "AWS", icon: '<path d="M6 6L3 12l3 6M18 6l3 6-3 6M13 4l-2 16" />' },
  { name: "Excel", q: "Excel", icon: '<path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm5 3v8m3-8l6 8m0-8l-6 8" />' },
  { name: "React", q: "React", icon: '<circle cx="12" cy="12" r="2" /><ellipse cx="12" cy="12" rx="10" ry="4.5" /><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)" /><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(-60 12 12)" />' },
  { name: "Machine Learning", q: "Machine Learning", icon: '<path d="M12 2a10 10 0 1 0 10 10M12 2v20M2 12h20" />' }
];
const typewriterWords = [
  "Search for discounted Udemy courses...",
  `${last24h} new deals added in last 24 hours`,
  `${last7d} new deals added in last 7 days`,
  'Try: "Python programming", "Web design", "Business"',
  `Over ${liveCount.toLocaleString()}+ coupon deals available!`
];
const typewriterJson = JSON.stringify(typewriterWords);
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content="https://courseswyn.com" slot="head" />
  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content={featuredDeals.length > 0 ? featuredDeals[0].image : "/assets/images/og-default.svg"} slot="head" />
  <meta property="og:image:width" content="1200" slot="head" />
  <meta property="og:image:height" content="630" slot="head" />
  <meta property="og:site_name" content="CoursesWyn" slot="head" />
  <meta property="og:locale" content="en_US" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:url" content="https://courseswyn.com" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content={featuredDeals.length > 0 ? featuredDeals[0].image : "/assets/images/og-default.svg"} slot="head" />
  <meta name="twitter:site" content="@CoursesWyn" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style is:global>
    :root {
      --rd-bg: #161a20;
      --rd-bg-2: #1d222a;
      --rd-paper: #161a21;
      --rd-neutral: #1b202a;
      --rd-text: #f5f6f8;
      --rd-muted: #98a2b3;
      --rd-border: #262c36;
      --rd-primary: #00a76f;
      --rd-primary-dark: #007867;
      --rd-primary-deep: #004b50;
      --rd-primary-soft: rgba(0, 167, 111, 0.16);
      --rd-secondary: #8e33ff;
      --rd-secondary-soft: rgba(142, 51, 255, 0.16);
      --rd-green: #22c55e;
      --rd-error: #ff5630;
    }
    .rd2-home { background: var(--rd-bg); color: var(--rd-text); font-family: 'Nunito Sans', Inter, ui-sans-serif, system-ui, sans-serif; }
    .rd2-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .rd2-section { padding: 4.5rem 0; }

    /* ===== HERO ===== */
    .rd2-hero { background: radial-gradient(1200px 520px at 50% -10%, rgba(0,167,111,0.14), transparent 60%), var(--rd-bg); padding: 5rem 0 4rem; }
    .rd2-hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    .rd2-hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 1rem; color: #fff; }
    .rd2-hero h1 span { color: #fff; -webkit-text-fill-color: #fff; }
    .rd2-hero .rd2-hero-claim { font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 800; color: #fff; margin: 0 0 1.25rem; line-height: 1.3; letter-spacing: -0.01em; }
    .rd2-hero .rd2-hero-claim span { background: linear-gradient(135deg, var(--rd-primary), #c86bff); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .rd2-hero h2 { font-size: clamp(1.05rem, 1.8vw, 1.3rem); font-weight: 600; color: var(--rd-muted); margin: 0 0 1.25rem; line-height: 1.4; }
    .rd2-hero p.rd2-sub { color: var(--rd-muted); font-size: 0.98rem; line-height: 1.7; margin: 0 0 2rem; max-width: 90%; }
    .rd2-hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 100px; background: var(--rd-primary-soft); border: 1px solid rgba(0,167,111,0.35); color: var(--rd-primary); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.02em; margin: 0 0 1rem; }
    .rd2-hero-badge svg { width: 14px; height: 14px; flex-shrink: 0; }
    .rd2-trust { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 1.5rem; }
    .rd2-trust span { display: inline-flex; align-items: center; gap: 7px; color: var(--rd-muted); font-size: 0.82rem; font-weight: 600; }
    .rd2-trust svg { width: 16px; height: 16px; color: var(--rd-primary); flex-shrink: 0; }
    .rd2-hero .rd2-trust + .rd2-chips { margin-top: 1.5rem; }
    .rd2-search { display: flex; align-items: center; gap: 10px; background: var(--rd-paper); border: 1px solid var(--rd-border); border-radius: 12px; padding: 0 16px; height: 56px; max-width: 500px; box-shadow: 0 8px 28px rgba(0,0,0,0.35); transition: border-color 0.2s, box-shadow 0.2s; }
    .rd2-search:focus-within { border-color: rgba(0,167,111,0.6); box-shadow: 0 8px 32px rgba(0,167,111,0.18); }
    .rd2-search svg { width: 20px; height: 20px; color: var(--rd-muted); flex-shrink: 0; }
    .rd2-search input { flex: 1; background: transparent; border: none; outline: none; color: var(--rd-text); font-size: 0.95rem; font-family: inherit; }
    .rd2-search kbd { color: var(--rd-muted); font-size: 0.72rem; font-family: inherit; border: 1px solid var(--rd-border); border-radius: 6px; padding: 3px 8px; white-space: nowrap; }
    .rd2-hero-btns { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
    .rd2-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 200px; padding: 13px 24px; border-radius: 10px; font-size: 1rem; font-weight: 600; text-decoration: none; transition: all 0.2s ease; }
    .rd2-btn.contained { background: linear-gradient(135deg, var(--rd-primary), var(--rd-primary-dark)); color: #fff; box-shadow: 0 10px 24px rgba(0,167,111,0.3); }
    .rd2-btn.contained:hover { filter: brightness(1.12); transform: scale(1.04); }
    .rd2-btn.outlined { background: transparent; color: var(--rd-primary); border: 1px solid var(--rd-primary); }
    .rd2-btn.outlined:hover { background: var(--rd-primary); color: #fff; transform: scale(1.04); }
    .rd2-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 2.5rem; }
    .rd2-chip { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; background: var(--rd-neutral); color: var(--rd-text); text-decoration: none; transition: all 0.2s; }
    .rd2-chip:hover { background: var(--rd-paper); box-shadow: 0 6px 20px rgba(0,0,0,0.4); transform: translateY(-2px); }
    .rd2-chip svg { width: 22px; height: 22px; stroke: var(--rd-primary); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .rd2-chip span { font-size: 0.78rem; font-weight: 600; }

    /* HERO ART */
    .rd2-art { position: relative; height: 480px; display: none; }
    @media (min-width: 900px) { .rd2-hero-inner { grid-template-columns: 1fr 1fr; } .rd2-art { display: block; } }
    .rd2-art::before { content: ''; position: absolute; inset: 0;
      background: radial-gradient(420px 420px at 50% 45%, rgba(0,167,111,0.18), transparent 65%),
        radial-gradient(280px 280px at 20% 85%, rgba(34,197,94,0.12), transparent 65%);
      border-radius: 50%; }
    .rd2-art .hero-card { position: absolute; top: 20px; right: 40px; width: 330px; background: var(--rd-paper); border: 1px solid var(--rd-border); border-radius: 18px; overflow: hidden; box-shadow: 0 30px 70px rgba(0,0,0,0.5); animation: floaty 6s ease-in-out infinite; z-index: 2; }
    .rd2-art .hero-card .thumb { position: relative; height: 168px; background: linear-gradient(135deg, #004b50, #007867); }
    .rd2-art .hero-card .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .rd2-art .hero-card .thumb .play { position: absolute; inset: 0; margin: auto; width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,0.95); display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.4); }
    .rd2-art .hero-card .thumb .play svg { width: 22px; height: 22px; fill: #00a76f; margin-left: 3px; }
    .rd2-art .hero-card .off { position: absolute; top: 12px; left: 12px; background: #ff5630; color: #fff; font-size: 0.72rem; font-weight: 800; padding: 5px 9px; border-radius: 8px; letter-spacing: 0.04em; }
    .rd2-art .hero-card .free { position: absolute; top: 12px; right: 12px; background: #22c55e; color: #fff; font-size: 0.72rem; font-weight: 800; padding: 5px 9px; border-radius: 8px; }
    .rd2-art .hero-card .body { padding: 14px 16px 16px; }
    .rd2-art .hero-card .body h4 { font-size: 0.95rem; font-weight: 700; color: #fff; line-height: 1.35; margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .rd2-art .hero-card .meta { display: flex; align-items: center; gap: 8px; color: var(--rd-muted); font-size: 0.76rem; margin-bottom: 12px; }
    .rd2-art .hero-card .meta .stars { color: #ffab00; font-weight: 700; }
    .rd2-art .hero-card .price { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .rd2-art .hero-card .price b { font-size: 1.05rem; color: #22c55e; }
    .rd2-art .hero-card .price s { color: var(--rd-muted); font-size: 0.85rem; }
    .rd2-art .hero-card .get { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; background: #00a76f; color: #fff; font-weight: 700; font-size: 0.86rem; padding: 11px; border-radius: 10px; }
    .rd2-art .hero-card .get svg { width: 18px; height: 18px; }
    .rd2-art .badge-chip { position: absolute; top: 30px; right: 0; background: var(--rd-paper); border: 1px solid var(--rd-border); border-radius: 12px; padding: 8px 14px; display: flex; align-items: center; gap: 8px; box-shadow: 0 14px 34px rgba(0,0,0,0.4); animation: floaty 5s ease-in-out infinite; z-index: 3; }
    .rd2-art .badge-chip.green { top: 360px; right: 60px; animation-delay: -2.5s; }
    .rd2-art .badge-chip .ico { width: 26px; height: 26px; border-radius: 7px; display: flex; align-items: center; justify-content: center; }
    .rd2-art .badge-chip .ico.g { background: rgba(34,197,94,0.18); color: var(--rd-green); }
    .rd2-art .badge-chip .ico.p { background: var(--rd-primary-soft); color: var(--rd-primary); }
    .rd2-art .badge-chip svg { width: 15px; height: 15px; }
    .rd2-art .badge-chip span { font-size: 0.78rem; font-weight: 700; color: var(--rd-text); }
    .rd2-art .badge-chip small { font-size: 0.66rem; color: var(--rd-muted); font-weight: 500; display: block; line-height: 1.2; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes floaty { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }

    /* ===== SECTION HEADERS ===== */
    .rd2-head { text-align: center; max-width: 640px; margin: 0 auto 3rem; }
    .rd2-head h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 0.75rem; color: #fff; }
    .rd2-head p { color: var(--rd-muted); font-size: 0.95rem; line-height: 1.6; margin: 0; }

    /* ===== COURSE CARDS ===== */
    .rd2-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    @media (max-width: 1024px) { .rd2-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .rd2-grid { grid-template-columns: 1fr; } }
