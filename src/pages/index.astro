</div>

<script>
  (function () {
    const input = document.querySelector<HTMLInputElement>('#rd2Search input[data-typewriter]');
    if (!input) return;

    const inputEl = input;
    const raw = inputEl.getAttribute('data-typewriter');
    if (!raw) return;

    let words: string[] = [];
    try {
      const parsed: unknown = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.every((item): item is string => typeof item === 'string')) {
        words = parsed;
      }
    } catch (e) {
      return;
    }

    if (!words.length) return;

    let wordIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const word = words[wordIndex];
      if (!word) return;
      if (!deleting) {
        charIndex++;
        inputEl.setAttribute('placeholder', word.substring(0, charIndex));
        if (charIndex === word.length) { deleting = true; setTimeout(tick, 1500); return; }
        setTimeout(tick, 25);
      } else {
        charIndex--;
        inputEl.setAttribute('placeholder', word.substring(0, charIndex));
        if (charIndex === 0) { deleting = false; wordIndex = (wordIndex + 1) % words.length; }
        setTimeout(tick, 18);
      }
    }

    setTimeout(tick, 400);
  })();

  (function () {
    const btn = document.getElementById('rd2LoadMore') as HTMLButtonElement | null;
    if (!btn) return;
    const grid = document.getElementById('rd2Featured');
    if (!grid) return;
    const hidden = Array.prototype.filter.call(grid.querySelectorAll('.rd2-card'), function (c: Element) { return c.classList.contains('rd2-hidden'); });
    btn.addEventListener('click', function () {
      for (let i = 0; i < 6 && hidden.length; i++) {
        hidden.shift()?.classList.remove('rd2-hidden');
      }
      if (!hidden.length) btn.style.display = 'none';
    });
  })();

  (function () {
    const btn = document.getElementById('rd2TopicLoadMore') as HTMLButtonElement | null;
    if (!btn) return;
    const grid = document.getElementById('rd2Topics');
    if (!grid) return;
    const hidden = Array.prototype.filter.call(grid.querySelectorAll('.rd2-topic'), function (c: Element) { return c.classList.contains('rd2-topic-hidden'); });
    btn.addEventListener('click', function () {
      for (let i = 0; i < 3 && hidden.length; i++) {
        hidden.shift()?.classList.remove('rd2-topic-hidden');
      }
      if (!hidden.length) btn.style.display = 'none';
    });
  })();
 </script>

