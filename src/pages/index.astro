---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import DealCard from "../components/DealCard.astro";
import { getCollection } from "astro:content";

import { readDeals } from "../lib/store";
import { formatStringWIB, toISODateWIB, formatDateWIB } from "../lib/date";

const allDeals = await readDeals();
const todayStr = toISODateWIB(new Date());
const todayDeals = allDeals.filter((d) => {
  const dDate = toISODateWIB(new Date(d.updatedAt ?? d.createdAt ?? d.expiresAt ?? 0));
  return dDate === todayStr;
});
const activeCount = todayDeals.length || allDeals.length;
const now = new Date();
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());
const heroDeal = sortedDeals[0];
const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = (d.category || "Other").trim(); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const topicCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const t = (d.subcategory || "").trim(); if (t) acc[t] = (acc[t] || 0) + 1; return acc; }, {});
const sortedTopics = Object.entries(topicCounts).sort((a, b) => b[1] - a[1]).slice(0, 18);
const uniqueInstructors = [...new Set(allDeals.filter(d => d.instructor).map(d => d.instructor))].length;
const monthYear = formatStringWIB(new Date(), { month: 'long', year: 'numeric' });
const dealsWithPrice = allDeals.filter(d => d.originalPrice && d.price && d.originalPrice > d.price);
const avgDiscount = dealsWithPrice.length > 0 ? Math.round(dealsWithPrice.reduce((sum, d) => sum + (1 - (d.price ?? 0) / (d.originalPrice ?? 1)) * 100, 0) / dealsWithPrice.length) : 0;
const uniqueLanguages = [...new Set(allDeals.map(d => d.language).filter(Boolean))];
const langFlags: Record<string, string> = { English: "us", Spanish: "es", French: "fr", German: "de", Portuguese: "br", Japanese: "jp", Chinese: "cn", Korean: "kr", Russian: "ru", Arabic: "sa", Hindi: "in", Turkish: "tr", Italian: "it", Dutch: "nl", Polish: "pl", Indonesian: "id", Vietnamese: "vn", Thai: "th" };
const normalizedLangs = [...new Map(uniqueLanguages.map(l => {
  const lower = l.toLowerCase();
  if (lower.startsWith("engl")) return ["english", { name: "English", kw: "english", cc: "us" }];
  if (lower === "spanish") return ["spanish", { name: "Spanish", kw: "spanish", cc: "es" }];
  const key = Object.keys(langFlags).find(k => k.toLowerCase() === lower);
  if (key) return [lower, { name: key, kw: lower, cc: langFlags[key] }];
  return null;
}).filter(Boolean) as [string, { name: string; kw: string; cc: string }][]).values()];

const allPosts = await getCollection("blog");
const recentPosts = allPosts.sort((a, b) => {
  const dateA = a.data.updatedAt || a.data.pubDate;
  const dateB = b.data.updatedAt || b.data.pubDate;
  return dateB.getTime() - dateA.getTime();
}).slice(0, 3);

const pageTitle = `100% Off Udemy Coupons ${monthYear} | Free Udemy Courses`;
const pageDescription = `Get verified 100% off Udemy coupons updated daily for ${monthYear}. Access free premium courses in programming, data science, web development & more. No signup required.`;

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }
function desc(s: string) { return String(s || "").replace(/<[^>]*>/g, "").slice(0, 120); }

const heroTitle = heroDeal ? clean(heroDeal.title) : "";
const heroDesc = heroDeal ? desc(heroDeal.description) : "";
const heroSlug = heroDeal?.slug || "";
const heroPrice = typeof heroDeal?.price === "number" ? heroDeal.price : 0;
const heroOrigPrice = typeof heroDeal?.originalPrice === "number" && heroDeal.originalPrice > 0 ? heroDeal.originalPrice : null;
const heroIsFree = heroPrice === 0;
const heroExpiry = heroDeal?.expiresAt || "";

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn"], "description": "Free Udemy coupon directory with verified 100% off codes updated daily." },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "inLanguage": "en-US" },
    { "@type": "EducationalOrganization", "@id": "https://courseswyn.com/#educational", "name": "CoursesWyn", "url": "https://courseswyn.com", "description": "Verified 100% off Udemy coupon directory.", "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Free Udemy Courses", "itemListElement": sortedCats.slice(0, 10).map(([cat]) => ({ "@type": "Offer", "itemOffered": { "@type": "Course", "name": cat + " Courses", "url": `https://courseswyn.com/categories/${cat.toLowerCase().replace(/ & /g, "-and-").replace(/ /g, "-").replace(/&/g, "and")}` } })) } },
    { "@type": "AggregateRating", "@id": "https://courseswyn.com/#rating", "itemReviewed": { "@type": "Organization", "name": "CoursesWyn" }, "ratingValue": "4.8", "bestRating": "5", "ratingCount": "2850", "reviewCount": "2850" },
    { "@type": "Review", "@id": "https://courseswyn.com/#review", "itemReviewed": { "@type": "Organization", "name": "CoursesWyn" }, "author": { "@type": "Person", "name": "Andrew Derek" }, "reviewRating": { "@type": "Rating", "ratingValue": "5" }, "reviewBody": "CoursesWyn is the most reliable source for 100% off Udemy coupons. Every deal is verified and updated daily. I've saved thousands on premium courses." },
    { "@type": "HowTo", "name": "How to Get Free Udemy Courses with CoursesWyn", "description": "Three simple steps to enroll in any Udemy course for free using verified coupon codes.", "step": [
      { "@type": "HowToStep", "position": 1, "name": "Browse", "text": "Browse thousands of verified 100% off Udemy coupons by category, topic, or instructor." },
      { "@type": "HowToStep", "position": 2, "name": "Claim", "text": "Click any deal card to claim your free Udemy coupon code — pre-applied at checkout." },
      { "@type": "HowToStep", "position": 3, "name": "Enroll", "text": "Log in with a free Udemy account and confirm the price shows $0.00. Start learning for free." }
    ], "totalTime": "PT2M" },
    { "@type": "ItemList", "name": "Popular Course Categories", "description": "Browse free Udemy courses by category.", "itemListElement": sortedCats.slice(0, 12).map(([cat, count], i) => ({ "@type": "ListItem", "position": i + 1, "item": { "@type": "Course", "name": cat + " Courses", "numberOfStudents": count, "url": `https://courseswyn.com/categories/${cat.toLowerCase().replace(/ & /g, "-and-").replace(/ /g, "-").replace(/&/g, "and")}` } })) },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <style>
    :root { --brand: #ff5a2c; --brand-dim: rgba(255,90,44,0.08); --brand-glow: rgba(255,90,44,0.3); --radius: 16px; --radius-sm: 10px; }
    .wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .section { padding: 5rem 0; }
    .section-alt { background: var(--card); padding: 5rem 0; }
    @media (max-width: 768px) { .section, .section-alt { padding: 3rem 0; } }

    .hdr { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; gap: 1rem; flex-wrap: wrap; }
    .hdr-c { justify-content: center; text-align: center; flex-direction: column; align-items: center; }
    .hdr h2 { font-size: 1.6rem; font-weight: 800; color: var(--text); margin: 0; letter-spacing: -0.03em; line-height: 1.25; }
    .hdr p { font-size: 0.92rem; color: var(--muted); margin: 0.35rem 0 0; max-width: 560px; }
    @media (max-width: 768px) { .hdr h2 { font-size: 1.3rem; } }

    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    @media (max-width: 768px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .grid-3, .grid-2 { grid-template-columns: 1fr; } }

    .card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: all 0.35s ease; }
    .card:hover { border-color: var(--brand-glow); transform: translateY(-4px); box-shadow: 0 16px 40px -12px rgba(0,0,0,0.5); }

    .more-link { color: var(--brand); font-size: 0.88rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; flex-shrink: 0; }
    .more-link:hover { gap: 0.6rem; }

    /* HERO */
    .hero { display: flex; gap: 3rem; align-items: flex-start; padding: 4rem 0 3rem; }
    .hero-left { flex: 1; min-width: 0; }
    .hero-right { width: 420px; flex-shrink: 0; position: relative; }
    @media (max-width: 960px) { .hero { flex-direction: column; gap: 2rem; } .hero-right { width: 100%; } }
    .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--brand-dim); border: 1px solid rgba(255,90,44,0.15); border-radius: 999px; padding: 0.35rem 1rem; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand); margin-bottom: 1.25rem; }
    .hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; color: var(--text); margin: 0 0 0.75rem; letter-spacing: -0.03em; line-height: 1.12; }
    .hero h1 em { font-style: normal; background: linear-gradient(135deg, var(--brand), #ff9a6a); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .hero p { font-size: 0.95rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.5rem; max-width: 540px; }
    .hero-search { max-width: 480px; margin-bottom: 1.5rem; }
    .hero-search form { display: flex; border-radius: 999px; border: 2px solid var(--border); background: var(--card); overflow: hidden; }
    .hero-search form:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-dim); }
    .hero-search input { flex: 1; background: transparent; border: none; outline: none; color: var(--text); font-size: 0.88rem; padding: 0.7rem 1rem 0.7rem 1.2rem; }
    .hero-search button { border-radius: 999px; margin: 0.2rem; padding: 0.5rem 1.35rem; font-size: 0.85rem; font-weight: 700; background: var(--brand); color: #fff; border: none; cursor: pointer; transition: box-shadow 0.2s; }
    .hero-search button:hover { box-shadow: 0 0 20px var(--brand-glow); }
    .hero-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 0.7rem 1.5rem; border-radius: 999px; font-size: 0.88rem; font-weight: 700; text-decoration: none; background: var(--brand); color: #fff; }
    .btn-primary:hover { box-shadow: 0 0 24px var(--brand-glow); }
    .btn-ghost { display: inline-flex; align-items: center; gap: 8px; padding: 0.7rem 1.5rem; border-radius: 999px; font-size: 0.88rem; font-weight: 700; text-decoration: none; border: 2px solid var(--border); color: var(--text); background: transparent; }
    .btn-ghost:hover { border-color: var(--brand); color: var(--brand); }
    .hero-stats { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .hero-stat { display: flex; align-items: center; gap: 10px; padding: 0.65rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; color: var(--muted); transition: all 0.25s; }
    .hero-stat:hover { border-color: var(--brand-glow); }
    .hero-stat svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--brand); opacity: 0.7; }
    .hero-stat strong { color: var(--text); font-weight: 800; font-size: 1.05rem; }

    /* FEATURED DEAL CARD */
    .deal-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; position: relative; overflow: hidden; }
    .deal-card::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg, var(--brand), #ff9a6a, var(--brand)); opacity:0.6; }
    .deal-head { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    .deal-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text); }
    .deal-tag .dot { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; }
    .deal-verified { display: inline-flex; align-items: center; gap: 5px; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #4ade80; background: rgba(74,222,128,0.1); border: 1px solid rgba(74,222,128,0.2); border-radius: 6px; padding: 0.15rem 0.55rem; }
    .deal-verified svg { width: 10px; height: 10px; }
    .deal-body { display: flex; gap: 1.25rem; align-items: flex-start; }
    .deal-thumb { width: 120px; height: 120px; flex-shrink: 0; background: var(--bg); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; padding: 0.5rem; overflow: hidden; }
    .deal-thumb img { width: 100%; height: 100%; object-fit: contain; }
    .deal-info { flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }
    .deal-title { font-size: 1.15rem; font-weight: 800; color: var(--text); margin: 0; line-height: 1.3; }
    .deal-title a { color: inherit; text-decoration: none; }
    .deal-title a:hover { color: var(--brand); }
    .deal-meta { display: flex; align-items: center; gap: 0.75rem; font-size: 0.75rem; color: var(--muted); flex-wrap: wrap; }
    .deal-price { display: flex; align-items: baseline; gap: 8px; margin-top: 0.25rem; }
    .deal-price .free { font-size: 1.4rem; font-weight: 900; color: var(--brand); }
    .deal-price .was { font-size: 0.85rem; color: var(--muted); text-decoration: line-through; }
    .deal-desc { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .deal-cta { display: block; width: 100%; text-align: center; padding: 0.75rem 1.5rem; border-radius: 999px; background: var(--brand); color: #fff; font-size: 0.9rem; font-weight: 700; text-decoration: none; border: none; cursor: pointer; transition: box-shadow 0.2s; }
    .deal-cta:hover { box-shadow: 0 0 24px var(--brand-glow); }
    .deal-secure { font-size: 0.7rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }

    /* CATEGORIES */
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; }
    .cat-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.9rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); text-decoration: none; transition: all 0.25s; }
    .cat-item:hover { border-color: var(--brand-glow); transform: translateY(-2px); box-shadow: 0 6px 20px -8px rgba(0,0,0,0.4); }
    .cat-count { font-size: 0.75rem; font-weight: 800; color: var(--brand); background: var(--brand-dim); border-radius: 6px; padding: 0.2rem 0.55rem; line-height: 1; flex-shrink: 0; }
    .cat-name { font-size: 0.85rem; font-weight: 700; color: var(--text); flex: 1; }
    .cat-arrow { width: 14px; height: 14px; color: var(--muted); flex-shrink: 0; transition: transform 0.2s; }
    .cat-item:hover .cat-arrow { color: var(--brand); transform: translateX(3px); }

    /* HOT DEALS */
    .hot-header { display: flex; align-items: center; gap: 0.75rem; }
    .hot-icon { width: 44px; height: 44px; border-radius: var(--radius-sm); background: linear-gradient(135deg, var(--brand), #ff9a6a); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 16px -4px var(--brand-glow); }
    .hot-icon svg { width: 20px; height: 20px; fill: white; }
    .hot-more { display: inline-block; padding: 0.8rem 2rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); text-decoration: none; font-weight: 700; font-size: 0.92rem; transition: all 0.25s; text-align: center; }
    .hot-more:hover { border-color: var(--brand-glow); transform: translateY(-2px); }

    /* ABOUT SECTION */
    .about-wrap { display: flex; flex-direction: column; gap: 1.25rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 2.5rem 3rem; }
    .about-wrap h2 { font-size: 1.35rem; font-weight: 800; color: var(--text); margin: 0; }
    .about-wrap p { font-size: 0.92rem; color: var(--muted); line-height: 1.75; margin: 0; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    @media (max-width: 600px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } .about-wrap { padding: 1.5rem; } }
    .stat-item { text-align: center; padding: 1.25rem 0.75rem; background: var(--card); border-radius: var(--radius-sm); border: 1px solid var(--border); display: flex; flex-direction: column; align-items: center; gap: 0.4rem; transition: all 0.25s; }
    .stat-item:hover { border-color: var(--brand-glow); transform: translateY(-2px); }
    .stat-item svg { width: 22px; height: 22px; color: var(--brand); opacity: 0.6; }
    .stat-val { font-size: 1.5rem; font-weight: 900; color: var(--brand); line-height: 1; }
    .stat-label { font-size: 0.8rem; color: var(--muted); font-weight: 500; }

    /* TRUST INDICATORS */
    .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 768px) { .trust-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .trust-grid { grid-template-columns: 1fr; } }
    .trust-item { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem; transition: all 0.35s; }
    .trust-item:hover { border-color: var(--brand-glow); transform: translateY(-4px); box-shadow: 0 12px 32px -8px rgba(0,0,0,0.4); }
    .trust-item svg { width: 28px; height: 28px; margin-bottom: 0.75rem; color: var(--brand); }
    .trust-item h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; }
    .trust-item p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }

    /* STEPS */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    @media (max-width: 768px) { .steps { grid-template-columns: 1fr; } }
    .step { padding: 2.5rem 1.5rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); text-align: center; transition: all 0.35s; }
    .step:hover { border-color: var(--brand-glow); transform: translateY(-4px); box-shadow: 0 12px 32px -8px rgba(0,0,0,0.4); }
    .step-num { font-size: 2.2rem; font-weight: 900; color: var(--brand); margin-bottom: 0.75rem; line-height: 1; }
    .step h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
    .step p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }

    /* LANGUAGES */
    .lang-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 0.65rem; }
    .lang-item { display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); text-decoration: none; transition: all 0.25s; min-height: 44px; }
    .lang-item:hover { border-color: var(--brand-glow); transform: translateY(-2px); }
    .lang-item img { border-radius: 2px; object-fit: cover; flex-shrink: 0; }
    .lang-item span { font-size: 0.85rem; font-weight: 600; color: var(--text); }

    /* PLATFORMS */
    /* TOPICS */
    .topic-wrap { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .topic-item { display: inline-block; padding: 0.5rem 1.1rem; background: var(--card); border: 1px solid var(--border); border-radius: 999px; font-size: 0.82rem; font-weight: 600; color: var(--text); text-decoration: none; transition: all 0.25s; }
    .topic-item:hover { border-color: var(--brand-glow); color: var(--brand); transform: translateY(-2px); }

    /* CTA */
    .cta-card { background: var(--card); border: 1px solid var(--border); border-top: 3px solid var(--brand); border-radius: var(--radius); padding: 3rem 2.5rem; text-align: center; }
    .cta-card h2 { font-size: clamp(1.4rem, 2.5vw, 1.9rem); font-weight: 800; color: var(--text); margin: 0 0 1rem; line-height: 1.3; }
    .cta-card p { font-size: 0.92rem; color: var(--muted); max-width: 550px; margin: 0 auto 1.25rem; line-height: 1.65; }
    .cta-features { display: flex; gap: 1.5rem 2rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem; }
    .cta-features span { font-size: 0.84rem; color: var(--muted); display: flex; align-items: center; gap: 6px; }
    .cta-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); flex-shrink: 0; }

    /* FAQ */
    .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .faq-item { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card); overflow: hidden; }
    .faq-q { width: 100%; padding: 1.1rem 1.25rem; font-size: 0.92rem; font-weight: 700; color: var(--text); background: none; border: none; text-align: left; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .faq-q:hover { color: var(--brand); }
