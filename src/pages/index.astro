---
import Layout from "../layouts/Layout.astro";
import { readDeals } from "../lib/store";
import { toISODateWIB } from "../lib/date";
import { normName, slugifyCategory } from "../lib/utils";

const allDeals = await readDeals();
const now = new Date();
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());

const last24h = sortedDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 24 * 3600000; }).length;
const last7d = sortedDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 7 * 24 * 3600000; }).length;

const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = normName(d.category); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const topCats = sortedCats.slice(0, 5).map(([name, count]) => ({ name, count, slug: slugifyCategory(name) }));

const featuredPool = [...sortedDeals].slice(0, 36);
const featuredDeals = featuredPool.slice(0, 6);
const poolPrimary = new Set<string>();
sortedDeals.slice(0, 8).forEach((d) => poolPrimary.add(String(d.slug)));
const poolSet = new Set<string>(poolPrimary);
for (const c of topCats) {
  sortedDeals.filter((d) => normName(d.category) === c.name).slice(0, 6).forEach((d) => poolSet.add(String(d.slug)));
}
const poolDeals = sortedDeals.filter((d) => poolSet.has(String(d.slug)));

const discountPcts = allDeals
  .filter((d): d is typeof d & { price: number; originalPrice: number } => typeof d.price === "number" && typeof d.originalPrice === "number" && d.originalPrice > d.price && d.price > 0)
  .map((d) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;
const liveCount = allDeals.length;

const cat90Off: Record<string, number> = {};
for (const d of allDeals) {
  const c = normName(d.category) || "Other";
  if (typeof d.price === "number" && typeof d.originalPrice === "number" && d.originalPrice > d.price && d.price > 0) {
    if (Math.round(100 - (d.price / d.originalPrice) * 100) >= 90) cat90Off[c] = (cat90Off[c] || 0) + 1;
  }
}

const totalStudents = activeDeals.reduce((acc, d) => acc + (typeof d.students === "number" && d.students > 0 ? d.students : genStudents(String(d.slug || d.title || ""))), 0);

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }
function formatCompact(n: number): string { if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M'; if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K'; return n.toLocaleString(); }
function genStudents(key: string): number { let h = 0; for (let i = 0; i < key.length; i++) { h = (h * 31 + key.charCodeAt(i)) & 0x7fffffff; } return 1000 + (h % 50000); }
function timeAgo(d?: string | Date): string {
  if (!d) return "now";
  const t = typeof d === "string" ? new Date(d).getTime() : d.getTime();
  if (isNaN(t)) return "now";
  const m = Math.floor(Math.max(0, Date.now() - t) / 60000);
  if (m < 1) return "now";
  if (m < 60) return m + "m ago";
  const h = Math.floor(m / 60);
  if (h < 24) return h + "h ago";
  return Math.floor(h / 24) + "d ago";
}

const faqs = [
  { q: "Does it cost anything to use CoursesWyn?", a: "No. CoursesWyn is completely free to use — no signup, no account, no credit card. Every coupon we list gets you the course at a heavily discounted price, often up to " + maxDiscountPct + "% off. You only need a free Udemy account to enroll." },
  { q: "How frequently are new deals added?", a: "New coupons are added throughout the day as soon as they go live on Udemy. We recommend checking back daily or visiting the latest deals page to catch fresh discounts before they expire." },
  { q: "What happens if a coupon expires before I enroll?", a: "Coupons have limited redemptions and fixed expiry dates. If a coupon expires, the course returns to full price. We remove expired deals from our listings daily — just check back for new discounts in the same category." },
  { q: "Do discounted courses include a certificate?", a: "Yes. Enrolling through a CoursesWyn coupon gives you the same certificate of completion as a full-price student — plus lifetime access to materials, future updates, and instructor Q&A. Nothing is held back." },
  { q: "Can I watch discounted courses on my phone?", a: "Absolutely. Any course you claim through a CoursesWyn coupon is fully accessible on the Udemy mobile app (iOS and Android). You can stream or download lectures for offline learning." },
  { q: "How does CoursesWyn pick which courses to list?", a: "We prioritize courses with strong ratings, reputable instructors, and current curriculum. Our automated pipeline checks every deal against quality signals (rating, reviews, instructor history) before publishing — so a big discount doesn't mean low quality." }
];

const pageTitle = `Verified Udemy Coupon Codes ${new Date().getFullYear()} - Get Premium Courses for Less | CoursesWyn`;
const pageDescription = `Get premium Udemy courses for less. Find verified coupon codes and discounts, save up to ${maxDiscountPct}% on top courses — new deals added daily.`;

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "inLanguage": "en-US", "publisher": { "@id": "https://courseswyn.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn", "https://medium.com/@coursewyn"], "description": `Verified working Udemy coupon and discount directory with up to ${maxDiscountPct}% off codes, updated daily.` },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "mainEntityOfPage": { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage" }, "dateModified": toISODateWIB(new Date()), "datePublished": toISODateWIB(new Date()), "inLanguage": "en-US", "about": { "@id": "https://courseswyn.com/#organization" }, "primaryImageOfPage": { "@type": "ImageObject", "url": "https://courseswyn.com/assets/images/og-default.svg" }, "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".rd2-sub", ".hp-faq-q", ".hp-faq-a"] } },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] },
    {
      "@type": "ItemList", "numberOfItems": featuredDeals.length, "itemListElement": featuredDeals.slice(0, 10).map((d, i) => ({
        "@type": "ListItem", "position": i + 1, "item": {
          "@type": "Course", "name": clean(d.title), "url": "https://courseswyn.com/coupon/" + d.slug,
          "description": clean(d.description), "provider": { "@type": "Organization", "name": d.provider || "Udemy", "sameAs": "https://www.udemy.com" },
          "aggregateRating": { "@type": "AggregateRating", "ratingValue": (d.rating && d.rating > 0 ? d.rating : 4.5).toFixed(1), "bestRating": 5, "reviewCount": typeof d.students === "number" && isFinite(d.students) ? Math.max(100, Math.round(d.students * 0.05)) : 500 },
          "offers": { "@type": "Offer", "price": d.price && d.price > 0 ? d.price : (d.originalPrice || 0), "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://courseswyn.com/coupon/" + d.slug }
        }
      }))
    },
    { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  ]
};

const heroChips = [
  { name: "Python", q: "Python", icon: '<path d="M13 2L4 13h5l-2 9 9-11h-5l2-9z" />' },
  { name: "ChatGPT", q: "ChatGPT", icon: '<circle cx="12" cy="12" r="3" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3" />' },
  { name: "AWS", q: "AWS", icon: '<path d="M6 6L3 12l3 6M18 6l3 6-3 6M13 4l-2 16" />' },
  { name: "Excel", q: "Excel", icon: '<path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm5 3v8m3-8l6 8m0-8l-6 8" />' },
  { name: "React", q: "React", icon: '<circle cx="12" cy="12" r="2" /><ellipse cx="12" cy="12" rx="10" ry="4.5" /><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)" /><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(-60 12 12)" />' },
  { name: "Machine Learning", q: "Machine Learning", icon: '<path d="M12 2a10 10 0 1 0 10 10M12 2v20M2 12h20" />' }
];
const typewriterWords = [
  "Search for discounted Udemy courses...",
  `${last24h} new deals added in last 24 hours`,
  `${last7d} new deals added in last 7 days`,
  'Try: "Python programming", "Web design", "Business"',
  `Over ${liveCount.toLocaleString()}+ coupon deals available!`
];
const typewriterJson = JSON.stringify(typewriterWords);
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content="https://courseswyn.com" slot="head" />
  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content="/assets/images/og-default.svg" slot="head" />
  <meta property="og:image:secure_url" content="https://courseswyn.com/assets/images/og-default.svg" slot="head" />
  <meta property="og:image:type" content="image/svg+xml" slot="head" />
  <meta property="og:image:width" content="1200" slot="head" />
  <meta property="og:image:height" content="630" slot="head" />
  <meta property="og:image:alt" content="CoursesWyn - Verified Udemy Coupon Codes" slot="head" />
  <meta property="og:site_name" content="CoursesWyn" slot="head" />
  <meta property="og:locale" content="en_US" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:url" content="https://courseswyn.com" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:image" content="/assets/images/og-default.svg" slot="head" />
  <meta name="twitter:image:alt" content="CoursesWyn - Verified Udemy Coupon Codes" slot="head" />
  <meta name="twitter:site" content="@CoursesWyn" slot="head" />
  <meta name="keywords" content="udemy coupon code, udemy discount, verified udemy coupons, free udemy courses, udemy coupon, udemy discount code, learn udemy, online course discount" slot="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <style is:global>
    :root {
      --hp-ink: #12203A;
      --hp-ink2: #1B2E52;
      --hp-paper: #F5F1E6;
      --hp-paper2: #EDE7D6;
      --hp-bg: #12203A;
      --hp-bg2: #EDE7D6;
      --hp-line: #D8D0BC;
      --hp-muted: #5B564C;
      --hp-ink-text: #12203A;
      --hp-graphite: #2B2B28;
      --hp-brand: #1F7A4D;
      --hp-green: #1F7A4D;
      --hp-green-bg: #E4F1E9;
      --hp-red: #C13B2E;
      --hp-red-bg: #F7E7E4;
      --hp-gold: #B8901F;
      --hp-gold-bg: #F5EDD8;
      --font-display: 'Space Grotesk', 'Nunito Sans', Inter, ui-sans-serif, system-ui, sans-serif;
      --font-mono: 'IBM Plex Mono', 'Nunito Sans', Consolas, 'Courier New', monospace;
    }
    .rd2-home {
      background: var(--bg);
      color: var(--hp-graphite);
      font-family: 'Nunito Sans', Inter, ui-sans-serif, system-ui, sans-serif;
      padding-bottom: 60px;
    }
    .hp-wrap { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

    @keyframes blip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
    @media (prefers-reduced-motion: reduce) { .hp-eyebrow .blip { animation: none; } }

    /* ===== HERO ===== */
    .hp-hero { position: relative; background: var(--hp-paper); border: 1px solid var(--hp-line); border-radius: 22px; padding: 46px 40px 34px; margin-top: 30px; text-align: center; box-shadow: 0 24px 48px -28px rgba(15, 23, 42, 0.28); }
    .hp-hero::before, .hp-hero::after { content: ""; position: absolute; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; background: var(--bg); border: 1px solid var(--hp-line); border-radius: 50%; }
    .hp-hero::before { left: -13px; } .hp-hero::after { right: -13px; }
    .hp-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; color: var(--hp-green); background: var(--hp-green-bg); border: 1px solid rgba(22, 163, 74, 0.25); border-radius: 999px; padding: 6px 13px; margin-bottom: 18px; }
    .hp-eyebrow .blip { width: 6px; height: 6px; border-radius: 50%; background: var(--hp-green); animation: blip 1.6s infinite; }
    .rd2-home h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.02em; margin: 0 auto 10px; max-width: 760px; color: var(--hp-ink); }
    .rd2-home h1 span { color: var(--hp-ink); -webkit-text-fill-color: var(--hp-ink); }
    .rd2-hero-claim { font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 800; color: var(--hp-ink); margin: 0 auto 12px; line-height: 1.3; letter-spacing: -0.01em; }
    .rd2-sub { color: var(--hp-muted); font-size: 0.98rem; line-height: 1.7; margin: 0 auto 22px; max-width: 620px; }
    .hp-search { display: flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--hp-line); border-radius: 12px; padding: 0 16px; height: 54px; max-width: 520px; margin: 0 auto 8px; box-shadow: 0 8px 28px -18px rgba(18, 32, 58, 0.4); transition: border-color 0.2s, box-shadow 0.2s; }
    .hp-search:focus-within { border-color: var(--hp-brand); box-shadow: 0 8px 32px -14px rgba(31, 122, 77, 0.4); }
    .hp-search svg { width: 20px; height: 20px; color: var(--hp-muted); flex-shrink: 0; }
    .hp-search input { flex: 1; background: transparent; border: none; outline: none; color: var(--hp-ink-text); font-size: 0.95rem; font-family: inherit; }
    .hp-search kbd { color: var(--hp-muted); font-size: 0.72rem; font-family: inherit; border: 1px solid var(--hp-line); border-radius: 6px; padding: 3px 8px; white-space: nowrap; }
    .hp-ctas { display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 20px; }
    .rd2-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 200px; padding: 13px 24px; border-radius: 10px; font-size: 1rem; font-weight: 600; text-decoration: none; transition: all 0.2s ease; }
    .rd2-btn.contained { background: var(--hp-ink); color: #fff; box-shadow: 0 10px 24px rgba(18, 32, 58, 0.4); }
    .rd2-btn.contained:hover { background: var(--hp-ink2); transform: translateY(-1px); }
    .rd2-btn.outlined { background: transparent; color: var(--hp-ink2); border: 1px solid var(--hp-ink2); }
    .rd2-btn.outlined:hover { background: var(--hp-ink2); color: #fff; }
    .rd2-trust { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; justify-content: center; margin-top: 20px; }
    .rd2-trust span { display: inline-flex; align-items: center; gap: 7px; color: var(--hp-muted); font-size: 0.82rem; font-weight: 600; }
    .rd2-trust svg { width: 16px; height: 16px; color: var(--hp-brand); flex-shrink: 0; }
    .rd2-chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 22px; }
    .rd2-chip { display: flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 10px; background: var(--hp-paper2); border: 1px solid var(--hp-line); color: var(--hp-ink-text); text-decoration: none; transition: all 0.2s; }
    .rd2-chip:hover { background: var(--hp-paper); border-color: var(--hp-brand); box-shadow: 0 8px 22px -12px rgba(18, 32, 58, 0.45); transform: translateY(-2px); }
    .rd2-chip svg { width: 20px; height: 20px; stroke: var(--hp-brand); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .rd2-chip span { font-size: 0.78rem; font-weight: 600; }
    .hp-ledger { display: flex; margin-top: 26px; background: var(--hp-bg2); border: 1px solid var(--hp-line); border-radius: 14px; overflow: hidden; flex-wrap: wrap; }
    .hp-ledger-cell { flex: 1 1 150px; padding: 16px 18px; border-right: 1px solid var(--hp-line); }
    .hp-ledger-cell:last-child { border-right: none; }
    .hp-ledger-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: var(--hp-muted); margin-bottom: 4px; }
    .hp-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--hp-ink); }

    /* ===== SECTION HEADINGS ===== */
    .hp-sec-heading { font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--hp-ink); margin: 52px 0 6px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .hp-sec-heading .tag { font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; color: var(--hp-muted); border: 1px solid var(--hp-line); padding: 4px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; }
    .hp-sec-desc { font-size: 13.5px; color: var(--hp-muted); margin: 0 0 18px; max-width: 680px; line-height: 1.6; }
    .hp-card { background: #fff; border: 1px solid var(--hp-line); border-radius: 16px; padding: 26px; box-shadow: 0 10px 30px -18px rgba(15, 23, 42, 0.16); }

    /* ===== VERIFICATION FLOW ===== */
    .hp-vflow { display: grid; grid-template-columns: 1fr; gap: 0; counter-reset: hvf; }
    @media (min-width: 900px) { .hp-vflow { grid-template-columns: repeat(5, 1fr); } }
    .hp-vf { padding: 16px 0; border-top: 1px dotted var(--hp-line); position: relative; }
    .hp-vf:first-child { border-top: none; }
    @media (min-width: 900px) {
      .hp-vf { border-top: none; border-left: 1px dotted var(--hp-line); padding: 2px 16px; }
      .hp-vf:first-child { border-left: none; padding-left: 0; }
    }
    .hp-vf-num { counter-increment: hvf; font-family: var(--font-mono); font-weight: 600; font-size: 11px; color: #fff; background: var(--hp-ink); width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 9px; }
    .hp-vf-num::before { content: counter(hvf); }
    .hp-vf-title { font-weight: 700; font-size: 13.5px; color: var(--hp-ink); margin-bottom: 4px; }
    .hp-vf-desc { font-size: 12px; color: var(--hp-muted); line-height: 1.55; }
    .hp-vf-status { display: inline-block; margin-top: 8px; font-family: var(--font-mono); font-size: 9.5px; font-weight: 600; color: var(--hp-green); background: var(--hp-green-bg); border-radius: 5px; padding: 2px 8px; }

    /* ===== CATEGORY BAR + DEAL TABLE ===== */
    .hp-catbar { position: sticky; top: 0; z-index: 40; margin-top: 16px; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(6px); border: 1px solid var(--hp-line); border-radius: 12px; padding: 9px 10px; display: flex; gap: 6px; overflow-x: auto; }
    .hp-catbar a { flex: 0 0 auto; font-family: var(--font-mono); font-size: 11.5px; font-weight: 500; color: var(--hp-muted); padding: 7px 13px; border-radius: 8px; white-space: nowrap; text-decoration: none; }
    .hp-catbar a.active { background: var(--hp-brand); color: #fff; }
    .hp-catbar a:hover:not(.active) { background: var(--hp-paper2); color: var(--hp-ink); }
    .hp-table-wrap { background: #fff; border: 1px solid var(--hp-line); border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(15, 23, 42, 0.16); margin-top: 16px; }
    .hp-table tr:hover td { background: var(--hp-paper2); }
    table.hp-table { width: 100%; border-collapse: collapse; }
    .hp-table thead th { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: var(--hp-muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--hp-line); background: var(--hp-bg2); }
    .hp-table td { padding: 12px 14px; border-bottom: 1px dotted var(--hp-line); vertical-align: middle; }
    .hp-table tr:last-child td { border-bottom: none; }
    .hp-table tr:hover td { background: var(--hp-paper2); }
    .hp-dt-course { display: flex; align-items: center; gap: 12px; }
    .hp-dt-thumb { width: 52px; height: 38px; border-radius: 6px; flex: 0 0 auto; background-size: cover; background-position: center; background-color: var(--hp-ink2); }
    .hp-dt-title { font-size: 13px; font-weight: 700; color: var(--hp-ink); line-height: 1.3; text-decoration: none; }
    .hp-dt-title:hover { color: var(--hp-brand); }
    .hp-dt-meta { font-family: var(--font-mono); font-size: 10.5px; color: var(--hp-muted); margin-top: 2px; }
    .hp-dt-price { font-family: var(--font-mono); font-size: 12.5px; color: var(--hp-red); font-weight: 600; white-space: nowrap; }
    .hp-dt-price s { color: var(--hp-muted); text-decoration: line-through; font-weight: 400; margin-left: 4px; }
