---
import Layout from "../layouts/Layout.astro";
import LedgerRow from "../components/LedgerRow.astro";
import { readDeals } from "../lib/store";
import { toISODateWIB } from "../lib/date";
import { normName, slugifyCategory } from "../lib/utils";
import { parseInstructors, createInstructorSlug } from "../lib/instructors";
import { getInstructorImage } from "../lib/instructorProfiles";

const allDeals = await readDeals();
const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = now.toLocaleDateString("en-US", { month: "long" });
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());

const last24h = allDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 24 * 3600000; }).length;

function catBlurb(name: string) {
  const c = name.toLowerCase();
  if (c.includes("it") || c.includes("software") || c.includes("inform")) return "Networks, security, certs and the tooling teams actually run on.";
  if (c === "development" || c.includes("program") || c.includes("desarrollo")) return "Code, apps and shipping software — from first script to deploy.";
  if (c.includes("business") || c.includes("negocio")) return "Lead teams, read numbers and grow something that lasts.";
  if (c.includes("design") || c.includes("dis")) return "Interfaces, visuals and the craft behind good-looking products.";
  if (c.includes("market")) return "Traffic, funnels and campaigns that pay for themselves.";
  if (c.includes("data") || c.includes("office") || c.includes("productiv") || c.includes("excel")) return "Sheets, dashboards and data skills used in real jobs.";
  if (c.includes("teach") || c.includes("academ")) return "Languages, exams and classroom-tested study paths.";
  if (c.includes("finance") || c.includes("account")) return "Money skills: accounting basics through investing logic.";
  if (c.includes("photo") || c.includes("video") || c.includes("music")) return "Creative production — shoot, edit and publish with confidence.";
  if (c.includes("personal")) return "Habits, focus and soft skills that compound over a career.";
  return "Hand-picked courses in this field at a fraction of list price.";
}

const catCounts = allDeals.reduce<Record<string, number>>((acc, d) => { const c = normName(d.category); if (c) acc[c] = (acc[c] || 0) + 1; return acc; }, {});
const topCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([name, count]) => ({ name, count, slug: slugifyCategory(name), blurb: catBlurb(name) }));
const topCats5 = topCats.slice(0, 5);

const poolPrimary = new Set<string>();
sortedDeals.slice(0, 8).forEach((d) => poolPrimary.add(String(d.slug)));
const poolSet = new Set<string>(poolPrimary);
for (const c of topCats5) {
  sortedDeals.filter((d) => normName(d.category) === c.name).slice(0, 6).forEach((d) => poolSet.add(String(d.slug)));
}
const poolDeals = sortedDeals.filter((d) => poolSet.has(String(d.slug)));
const latestSix = sortedDeals.slice(0, 6);

// Trending skills from real catalog depth (subcategory frequency)
const subcatCounts = new Map<string, number>();
for (const d of allDeals) {
  const s = (d.subcategory || "").trim();
  if (!s) continue;
  subcatCounts.set(s, (subcatCounts.get(s) ?? 0) + 1);
}
const trendingSkills = [...subcatCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12).map(([name, count]) => ({ name, count }));

// Learner favorites: highest rated with real enrollment weight
const popularPicks = [...activeDeals].filter((d) => (d.rating ?? 0) >= 4.5).sort((a, b) => ((b.rating ?? 0) - (a.rating ?? 0)) || ((b.students ?? 0) - (a.students ?? 0))).slice(0, 6);

// Deepest cuts: top-rated courses at 90%+ off — anti-duplikat rel latest.
// Selalu 6 kartu: prioritas 90%+, backfill dari favorit 4.5★ lalu diskon terbesar.
const latestSlugs = new Set(latestSix.map((d) => String(d.slug)));
const deepCuts: typeof popularPicks = [];
const pickedSlugs = new Set<string>();
for (const d of popularPicks) {
  if (deepCuts.length >= 6) break;
  const s = String(d.slug);
  if (pctOf(d) >= 90 && !latestSlugs.has(s) && !pickedSlugs.has(s)) { deepCuts.push(d); pickedSlugs.add(s); }
}
for (const d of popularPicks) {
  if (deepCuts.length >= 6) break;
  const s = String(d.slug);
  if (!latestSlugs.has(s) && !pickedSlugs.has(s)) { deepCuts.push(d); pickedSlugs.add(s); }
}
if (deepCuts.length < 6) {
  const byPct = [...sortedDeals].sort((a, b) => pctOf(b) - pctOf(a));
  for (const d of byPct) {
    if (deepCuts.length >= 6) break;
    const s = String(d.slug);
    if (!latestSlugs.has(s) && !pickedSlugs.has(s)) { deepCuts.push(d); pickedSlugs.add(s); }
  }
}
const deepCutsCount = sortedDeals.filter((d) => pctOf(d) >= 90).length;

// Instructors with the deepest bench in this catalog
const instructorCounts = new Map<string, { name: string; count: number; slug: string }>();
for (const d of allDeals) {
  if (!d.instructor) continue;
  for (const n of parseInstructors(d.instructor)) {
    const slug = createInstructorSlug(n);
    if (!slug) continue;
    const e = instructorCounts.get(slug);
    if (e) e.count++;
    else instructorCounts.set(slug, { name: n, count: 1, slug });
  }
}
const topInstructors = [...instructorCounts.values()].sort((a, b) => b.count - a.count).slice(0, 8);
const instructorImages = new Map<string, string>();
for (const ins of topInstructors) {
  const img = await getInstructorImage(ins.slug);
  if (img) instructorImages.set(ins.slug, img);
}

const discountPcts = allDeals
  .filter((d): d is typeof d & { price: number; originalPrice: number } => typeof d.price === "number" && typeof d.originalPrice === "number" && d.originalPrice > d.price && d.price > 0)
  .map((d) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;
const avgDiscount = discountPcts.length ? Math.round(discountPcts.reduce((a, b) => a + b, 0) / discountPcts.length) : 0;
const liveCount = activeDeals.length;
const totalCount = allDeals.length;
const uniqueInstructors = new Set(allDeals.map((d) => (d.instructor || "").trim()).filter(Boolean)).size;

const spotlight = [...sortedDeals].sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0))[0];
function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }
function pctOf(d: any) {
  if (typeof d?.price === "number" && typeof d?.originalPrice === "number" && d.originalPrice > d.price && d.price > 0) {
    return Math.round(100 - (d.price / d.originalPrice) * 100);
  }
  return 0;
}

const faqs = [
  { q: "Is CoursesWyn free to use?", a: "Yes — browsing CoursesWyn costs nothing and needs no account. You only need a free Udemy account when you decide to enroll, where discounts of up to " + maxDiscountPct + "% are applied at checkout." },
  { q: "How fresh are the coupons?", a: "Our pipeline re-checks listings around the clock and pulls dead codes fast. The freshest batch is labelled by recency, and the count from the last 24 hours is shown right on this page." },
  { q: "What if a code stops working?", a: "Instructor codes carry redemption caps and expiry dates. If one runs out, the price snaps back to list — pick a sibling deal in the same category or come back tomorrow for the next batch." },
  { q: "Do I still get a certificate?", a: "Yes. A discounted enrollment carries the same certificate, lifetime access, updates and instructor Q&A as a full-price seat." },
  { q: "Can I learn on my phone?", a: "Yes. Every claimed course works in the Udemy iOS and Android apps, including offline downloads for commutes and flights." },
  { q: "How do you choose what to list?", a: "We rank candidates by rating depth, instructor track record and curriculum freshness before they go live — a steep cut alone is never enough to get listed." }
];

const pageTitle = `CoursesWyn — Verified Udemy Coupons Up to ${maxDiscountPct}% Off (Checked Daily)`;
const pageDescription = `Start at CoursesWyn: hand-picked verified Udemy coupons up to ${maxDiscountPct}% off for ${currentMonth} ${currentYear}. Browse today's top markdowns, top-rated picks and categories — every code re-checked daily.`;

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "inLanguage": "en-US", "publisher": { "@id": "https://courseswyn.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn", "https://medium.com/@coursewyn"], "description": `Verified Udemy coupons with savings up to ${maxDiscountPct}%, refreshed daily.` },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "author": { "@type": "Person", "name": "Andrew Derek", "url": "https://courseswyn.com/about" }, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "datePublished": toISODateWIB(new Date()), "inLanguage": "en-US" },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] },
    { "@type": "ItemList", "numberOfItems": latestSix.length, "itemListElement": latestSix.slice(0, 10).map((d, i) => ({ "@type": "ListItem", "position": i + 1, "item": { "@type": "Course", "name": clean(d.title), "url": "https://courseswyn.com/coupon/" + d.slug, "description": clean(d.description), "provider": { "@type": "Organization", "name": d.provider || "Udemy", "sameAs": "https://www.udemy.com" }, "offers": { "@type": "Offer", "price": d.price && d.price > 0 ? d.price : (d.originalPrice || 0), "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://courseswyn.com/coupon/" + d.slug } } })) },
    { "@type": "ItemList", "name": "Deepest verified Udemy discounts", "numberOfItems": deepCuts.length, "itemListElement": deepCuts.map((d, i) => ({ "@type": "ListItem", "position": i + 1, "item": { "@type": "Course", "name": clean(d.title), "url": "https://courseswyn.com/coupon/" + d.slug, "provider": { "@type": "Organization", "name": "Udemy", "sameAs": "https://www.udemy.com" }, "offers": { "@type": "Offer", "price": d.price && d.price > 0 ? d.price : (d.originalPrice || 0), "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://courseswyn.com/coupon/" + d.slug } } })) },
    { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  ]
};

const heroChips = [
  { name: "Python", q: "Python" },
  { name: "Web Dev", q: "Web development" },
  { name: "AWS", q: "AWS" },
  { name: "Excel", q: "Excel" },
  { name: "Design", q: "Design" },
  { name: "Business", q: "Business" },
];
const typewriterWords = [
  "Search discounted Udemy courses...",
  `${last24h} fresh finds in the last 24 hours`,
  'Try "Python", "Excel" or "AWS"',
  `Over ${totalCount.toLocaleString()} coupons tracked`,
];
const typewriterJson = JSON.stringify(typewriterWords);

const whyItems = [
  { t: "Keep more of your budget", d: "List prices on Udemy climb past $100 fast. Our tracked codes routinely cut 80–95%, so a month of serious upskilling can cost less than lunch." },
  { t: "Browse first, sign up never", d: "No CoursesWyn account, no newsletter hostage-taking. Open the directory, filter by what you want to learn, and only sign in on Udemy when you enroll." },
  { t: "Skills employers pay for", d: "We overweight IT, development, data, business and design — the categories hiring managers actually screen for — instead of filler catalog padding." },
];
const trustItems = [
  { t: "Re-checked at checkout", d: "Listings pass an automated pass plus a final check when you click through, so the price you see is the price Udemy shows." },
  { t: "Quality gate before price", d: "Ratings, review depth, instructor history and syllabus freshness decide what gets published — not how big the percentage looks." },
  { t: "Dead codes get buried", d: "Expired or capped-out coupons are pruned on a loop instead of lingering for months to waste your evening." },
  { t: "Same seat, smaller bill", d: "Discounted seats include the identical certificate, lifetime access, downloads and Q&A as full-price enrollments." },
  { t: "No CoursesWyn paywall", d: "Every filter, every category, every code is open. There is no premium tier holding the good stuff back." },
  { t: "Instructor-sourced supply", d: "A large share of codes comes straight from creators promoting launches and seasonal pushes — legitimate supply, not scraped guesses." },
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <meta property="og:type" content="website" slot="head" />
  <meta property="og:url" content="https://courseswyn.com" slot="head" />
  <meta property="og:title" content={pageTitle} slot="head" />
  <meta property="og:description" content={pageDescription} slot="head" />
  <meta property="og:image" content="/assets/images/og-default.svg" slot="head" />
  <meta property="og:site_name" content="CoursesWyn" slot="head" />
  <meta property="og:locale" content="en_US" slot="head" />
  <meta name="twitter:card" content="summary_large_image" slot="head" />
  <meta name="twitter:title" content={pageTitle} slot="head" />
  <meta name="twitter:description" content={pageDescription} slot="head" />
  <meta name="twitter:site" content="@CoursesWyn" slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .section-wrapper { width: 100%; padding: 3.5rem 1rem; }
  .container { max-width: 1200px; margin: 0 auto; width: 100%; }
  .prose-section h2 { font-size: clamp(1.4rem, 2.5vw, 1.8rem); font-weight: 700; color: var(--text); margin-bottom: 1rem; }
  .prose-section h3 { font-size: 1.15rem; font-weight: 600; color: var(--text); margin: 1.5rem 0 0.5rem; }
  .prose-section p { color: var(--muted); line-height: 1.75; font-size: 1rem; margin-bottom: 1rem; }
  .prose-section a { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }
  .community-btn:hover { border-color: var(--brand) !important; background: var(--brand) !important; color: #FFFFFF !important; transform: translateY(-2px); }
  @media (max-width: 768px) { h1 { font-size: 2.4rem !important; } .section-wrapper { padding: 2.5rem 1rem; } .featured-grid { grid-template-columns: 1fr !important; } .stat-grid { grid-template-columns: repeat(2, 1fr) !important; } }
  html { scroll-behavior: smooth; }
</style>

  <!-- 1. HERO -->
  <section class="hero" aria-label="Hero — Udemy coupon codes">
    <div class="container">
      <div class="hero-content anim-up">
        <div style={{ display: "inline-flex", alignItems: "center", gap: "0.4rem", padding: "0.35rem 1rem", borderRadius: "9999px", fontSize: "0.75rem", fontWeight: 700, textTransform: "uppercase", letterSpacing: "0.06em", background: "var(--brand-soft)", color: "var(--brand)", border: "1px solid rgba(11,122,85,0.3)", marginBottom: "1rem" }}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          {totalCount.toLocaleString()} verified coupons tracked
        </div>
        <h1>
          <span style="display:block">Verified Udemy Coupons</span>
          <span class="hero-gradient-text" style="display:block;font-size:clamp(2.5rem,6vw,4.5rem)">{currentMonth} {currentYear}</span>
          <span style="display:block">Hand-Picked Daily by CoursesWyn</span>
        </h1>
        <p>Today's top verified Udemy coupons and discount codes for {currentMonth} {currentYear} — up to {maxDiscountPct}% off development, IT, business, design and data. Open the <a href="/udemy-coupon-code" style={{ color: "var(--brand)", fontWeight: 600 }}>full coupon catalog</a> or claim a pick below.</p>
        <div style={{ display: "flex", justifyContent: "center", marginBottom: "2rem" }}>
          <form action="/search" method="GET" role="search" aria-label="Search discounted Udemy courses" style={{ position: "relative", width: "100%", maxWidth: "700px" }}>
            <div style={{ display: "flex", alignItems: "center", borderRadius: "9999px", border: "2px solid var(--border)", padding: "0.25rem 0.25rem 0.25rem 1.25rem", boxShadow: "0 8px 32px rgba(0,0,0,0.15)", height: "56px", background: "var(--card)" }}>
              <svg style={{ width: "1.2rem", height: "1.2rem", flexShrink: 0, color: "#9ca3af" }} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              <input type="search" name="q" id="hpSearchInput" data-typewriter={typewriterJson} style={{ flex: 1, background: "transparent", border: "none", outline: "none", color: "var(--text)", fontSize: "0.95rem", height: "100%", fontWeight: 500, padding: "0 0.75rem" }} placeholder="Try Python, Excel, AWS..." autocomplete="off" aria-label="Search discounted courses" />
              <button type="submit" class="btn btn-primary" style={{ borderRadius: "9999px", padding: "0.6rem 1.5rem", fontSize: "0.9rem" }}>Find deals</button>
            </div>
          </form>
        </div>
        <p style={{ fontSize: "0.82rem", color: "var(--text-secondary)", marginTop: "0.5rem" }}>{totalCount.toLocaleString()} coupons &middot; up to {maxDiscountPct}% off &middot; {uniqueInstructors.toLocaleString()} instructors tracked</p>
        <div class="hero-cta">
          <a href="/udemy-coupon-code" class="btn btn-primary btn-lg" style={{ borderRadius: "999px", padding: "1rem 2.5rem", fontSize: "1.05rem" }}>Explore today's drops</a>
          <a href="/how-to-redeem-coupon" class="btn btn-ghost btn-lg" style={{ borderRadius: "999px", padding: "1rem 2.5rem", color: "var(--brand)", borderColor: "var(--brand)" }}>How claiming works</a>
        </div>
        <div style={{ display: "flex", flexWrap: "wrap", gap: "10px", justifyContent: "center", marginTop: "22px" }}>
          {heroChips.map((c) => (<a href={"/search?q=" + encodeURIComponent(c.q)} class="pill">{c.name}</a>))}
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section style={{ paddingBottom: "2rem" }}>
    <div class="container">
      <div class="stat-grid" style={{ gridTemplateColumns: "repeat(4, 1fr)" }}>
        <div class="stat-box"><div class="stat-icon"><span class="stat-value">{totalCount.toLocaleString()}</span></div><div class="stat-label">Total coupons</div></div>
        <div class="stat-box"><div class="stat-icon"><span class="stat-value">{last24h.toLocaleString()}</span></div><div class="stat-label">Fresh in 24h</div></div>
        <div class="stat-box"><div class="stat-icon"><span class="stat-value">{uniqueInstructors.toLocaleString()}</span></div><div class="stat-label">Instructors covered</div></div>
        <div class="stat-box"><div class="stat-icon"><span class="stat-value">{maxDiscountPct}%</span></div><div class="stat-label">Biggest cut</div></div>
      </div>
    </div>
  </section>

  <!-- TRENDING UDEMY TOPICS -->
  <section class="section" aria-label="Trending Udemy course topics" style="padding-top:0;padding-bottom:0">
    <div class="container">
      <span class="section-title">Trending now</span>
      <h2 class="section-heading" style={{ marginBottom: "0.25rem" }}>Trending <span style={{ color: "var(--brand)" }}>Udemy course topics</span></h2>
      <p style={{ color: "var(--text-secondary)", fontSize: "0.85rem", lineHeight: 1.5, margin: "0 0 1rem", maxWidth: "560px" }}>The most stocked topics in our verified Udemy coupon catalog — ranked by live coupon count.</p>
      <div style={{ display: "flex", flexWrap: "wrap", gap: "10px" }}>
        {trendingSkills.map((t) => (<a href={"/search?q=" + encodeURIComponent(t.name)} class="pill" title={"Udemy coupons for " + t.name}>{t.name} ({t.count})</a>))}
      </div>
    </div>
  </section>

  <!-- 2. LATEST DEALS -->
  <section class="section" aria-label="Latest Udemy coupons and discounts" style="padding-top:2.5rem;padding-bottom:0">
    <div class="container">
      <div style={{ display: "flex", alignItems: "flex-end", justifyContent: "space-between", marginBottom: "0.5rem", flexWrap: "wrap", gap: "0.5rem" }}>
        <div>
          <span class="section-title">Fresh drops</span>
          <h2 class="section-heading" style={{ marginBottom: "0.25rem" }}>Latest <span style={{ color: "var(--brand)" }}>Udemy coupons</span></h2>
          <p style={{ color: "var(--text-secondary)", fontSize: "0.85rem", lineHeight: 1.5, margin: 0, maxWidth: "480px" }}>Newly verified Udemy coupon codes for {currentMonth}. Open any card to claim the discount on Udemy.</p>
        </div>
        <a href="/udemy-coupon-code" style={{ color: "#0B7A55", textDecoration: "none", fontWeight: 600, fontSize: "0.95rem", display: "flex", alignItems: "center", gap: "0.5rem", padding: "0.75rem 1.5rem", background: "rgba(11,122,85,0.1)", borderRadius: "12px", border: "1px solid rgba(11,122,85,0.3)" }}>
          All {totalCount.toLocaleString()} coupons
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
        </a>
      </div>
      <div class="grid">
        {latestSix.map((deal) => (<LedgerRow deal={deal} variant="grid" />))}
      </div>
    </div>
  </section>

  <!-- DEEPEST CUTS: 90%+ OFF UDEMY COURSES -->
  <section class="section" aria-label="90 percent off Udemy courses" style="padding-top:2.5rem;padding-bottom:0">
    <div class="container">
      <div style={{ display: "flex", alignItems: "flex-end", justifyContent: "space-between", marginBottom: "0.5rem", flexWrap: "wrap", gap: "0.5rem" }}>
        <div>
          <span class="section-title">Maximum savings</span>
          <h2 class="section-heading" style={{ marginBottom: "0.25rem" }}>90% off <span style={{ color: "var(--brand)" }}>top-rated Udemy courses</span></h2>
          <p style={{ color: "var(--text-secondary)", fontSize: "0.85rem", lineHeight: 1.5, margin: 0, maxWidth: "480px" }}>{deepCutsCount.toLocaleString()} coupons cut 90% or more — below are the highest-rated ones, 4.5★ and up.</p>
        </div>
        <a href="/udemy-coupon-code" style={{ color: "#0B7A55", textDecoration: "none", fontWeight: 600, fontSize: "0.95rem", display: "flex", alignItems: "center", gap: "0.5rem", padding: "0.75rem 1.5rem", background: "rgba(11,122,85,0.1)", borderRadius: "12px", border: "1px solid rgba(11,122,85,0.3)" }}>
          All {totalCount.toLocaleString()} Udemy coupons
