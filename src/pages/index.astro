    if (!words.length) return;
    var wi = 0, ci = 0, del = false;
    function tick() {
      var w = words[wi];
      if (!w) return;
      if (!del) { ci++; input.setAttribute('placeholder', w.substring(0, ci)); if (ci === w.length) { del = true; setTimeout(tick, 1500); return; } setTimeout(tick, 25); }
      else { ci--; input.setAttribute('placeholder', w.substring(0, ci)); if (ci === 0) { del = false; wi = (wi + 1) % words.length; } setTimeout(tick, 18); }
    }
    setTimeout(tick, 400);
  })();
</script>

</Layout>
