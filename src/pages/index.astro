  .sx-h2-light { color: #E4E4E7; }
  .sx-pp-sub { color: #C9C9CF; line-height: 1.7; margin: 0 0 1.1rem; }
  .sx-pp-points { list-style: none; margin: 0 0 1.5rem; padding: 0; display: flex; flex-direction: column; gap: 0.55rem; font-size: 0.92rem; color: #C9C9CF; font-weight: 500; }
