<script>
  (function () {
    const input = document.querySelector<HTMLInputElement>('#rd2Search input[data-typewriter]');
    if (!input) return;

    const inputEl = input;
    const raw = inputEl.getAttribute('data-typewriter');
    if (!raw) return;

    let words: string[] = [];
    try {
      const parsed: unknown = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.every((item): item is string => typeof item === 'string')) {
        words = parsed;
      }
    } catch (e) {
      return;
    }

    if (!words.length) return;

    let wordIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const word = words[wordIndex];
      if (!word) return;
      if (!deleting) {
        charIndex++;
        inputEl.setAttribute('placeholder', word.substring(0, charIndex));
        if (charIndex === word.length) { deleting = true; setTimeout(tick, 1500); return; }
        setTimeout(tick, 25);
      } else {
        charIndex--;
        inputEl.setAttribute('placeholder', word.substring(0, charIndex));
        if (charIndex === 0) { deleting = false; wordIndex = (wordIndex + 1) % words.length; }
        setTimeout(tick, 18);
      }
    }

    setTimeout(tick, 400);
  })();

  (function () {
    const bar = document.querySelector<HTMLElement>('.hp-catbar');
    const count = document.querySelector<HTMLElement>('.hp-deal-count');
    if (!bar) return;
    const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('a'));
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.hp-table tbody tr'));
    if (!links.length || !rows.length) return;

    function currentFilter(): string {
      const m = /#cat=([^&]+)/.exec(window.location.hash);
      return m ? decodeURIComponent(m[1]) : 'all';
    }

    function apply(filter: string) {
      let n = 0;
      for (const row of rows) {
        const show = filter === 'all' ? row.getAttribute('data-primary') === '1' : row.getAttribute('data-cat') === filter;
        row.style.display = show ? 'table-row' : 'none';
        if (show) n++;
      }
      for (const a of links) {
        a.classList.toggle('active', a.getAttribute('data-filter') === filter);
      }
      if (count) count.textContent = 'Showing ' + n + ' of ' + rows.length + ' fresh coupons';
    }

    for (const a of links) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = a.getAttribute('data-filter') || 'all';
        apply(filter);
        try { window.history.pushState(null, '', '#cat=' + encodeURIComponent(filter)); } catch (err) {}
      });
    }
    window.addEventListener('popstate', () => apply(currentFilter()));
    apply(currentFilter());
  })();
</script>

</Layout>
