        </div>
        <a href="/udemy-certification-vouchers" class="lg-link">All vouchers →</a>
      </div>
      <div class="sx-vouchers">
        {voucherCards.map((v) => (
          <a class="sx-voucher" href={v.href}>
            <span class="sx-v-media">
              <img src={v.logo} alt={`${v.name} exam vouchers`} width="480" height="270" loading="lazy" />
