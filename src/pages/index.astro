---
import Layout from "../layouts/Layout.astro";
import CouponGrid from "../components/CouponGrid.astro";
import { readDeals } from "../lib/store";
import { toISODateWIB, formatDateWIB } from "../lib/date";
import { slugifyCategory, slugifyTopic } from "../lib/utils";
import { parseInstructors, createInstructorSlug } from "../lib/instructors";
import { getInstructorImage } from "../lib/instructorProfiles";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const allDeals = await readDeals();
const now = new Date();
const currentYear = now.getFullYear();
const currentMonth = now.toLocaleDateString("en-US", { month: "long" });
const activeDeals = allDeals.filter((d) => !d.expiresAt || new Date(d.expiresAt) > now);
const sortedDeals = [...activeDeals].sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime());

const last24h = allDeals.filter((d) => { const t = new Date(d.updatedAt ?? d.createdAt ?? 0).getTime(); return now.getTime() - t < 24 * 3600000; }).length;

// Fresh grid mirrors CourseDuck's "Recently updated", but one instructor
// rarely drops six coupons in a day — spread the picks across educators so
// the row reads as a real batch, then fill any remaining slots by recency.
const freshPicks: typeof sortedDeals = [];
const freshInstructors = new Set<string>();
for (const d of sortedDeals) {
  if (freshPicks.length >= 6) break;
  const first = parseInstructors(d.instructor)[0];
  if (!first || !freshInstructors.has(first)) {
    freshPicks.push(d);
    if (first) freshInstructors.add(first);
  }
}
for (const d of sortedDeals) {
  if (freshPicks.length >= 6) break;
  if (!freshPicks.includes(d)) freshPicks.push(d);
}
const latestSix = freshPicks;

// Homepage headline counts show the FULL catalog (every coupon we track),
// not just non-expired ones. Discount math below still uses LIVE deals
// only — expired entries must never feed "up to X%" headlines.
const totalCoupons = allDeals.length;
const paidActive = activeDeals.filter((d) => typeof d.price === "number" && d.price > 0);
const discountPcts = paidActive
  .filter((d): d is typeof d & { price: number; originalPrice: number } => typeof d.price === "number" && typeof d.originalPrice === "number" && d.originalPrice > d.price && d.price > 0)
  .map((d) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 90;
const avgDiscount = discountPcts.length ? Math.round(discountPcts.reduce((a, b) => a + b, 0) / discountPcts.length) : 0;

// Top categories with live counts — server-rendered anchors distribute
// homepage authority to money pages (body links, not just nav).
const CAT_DESC: Record<string, string> = {
  "IT & Software": "Certifications, network & security, and cloud.",
  "Development": "Web dev, software testing, and AI agents.",
  "Business": "Management, finance, and entrepreneurship.",
  "Teaching & Academics": "Engineering, math, and languages.",
  "Office Productivity": "Excel, SAP, and collaboration tools.",
  "Finance & Accounting": "Investing, trading, and crypto.",
  "Design": "UI/UX, 3D, and GenAI design.",
  "Programming Languages": "Python, Java, and more.",
  "Marketing": "Digital marketing and growth.",
  "Photography & Video": "Shooting and editing.",
  "Music": "Theory and production.",
  "Personal Development": "Career and productivity.",
};
const CAT_ICON: Record<string, string> = {
  "IT & Software": "M12 22h8a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h4m0-3h6m-6 0H9m3 0V9m0 10v-4",
  "Development": "M8 9l-4 3 4 3m8-6l4 3-4 3M14 5l-4 14",
  "Business": "M3 21h18M6 21V9l6-4 6 4v12M10 21v-5h4v5",
  "Teaching & Academics": "M22 10L12 5 2 10l10 5 10-5zM6 12v5c0 1 2.7 3 6 3s6-2 6-3v-5",
  "Office Productivity": "M4 4h16v16H4zM4 10h16M10 10v10",
  "Finance & Accounting": "M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
  "Design": "M12 3l2.5 5.5L20 11l-5.5 2.5L12 19l-2.5-5.5L4 11l5.5-2.5L12 3z",
  "Programming Languages": "M8 6l-5 6 5 6m8-12l5 6-5 6M13 4l-2 16",
  "Marketing": "M3 11v2a1 1 0 0 0 1 1h2l4 4V6L6 10H4a1 1 0 0 0-1 1zM16 8a5 5 0 0 1 0 8M19 5a9 9 0 0 1 0 14",
  "Photography & Video": "M3 7h4l2-2h6l2 2h4v12H3zM12 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z",
  "Music": "M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z",
  "Personal Development": "M12 21s-7-4.5-9-9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c-2 4.5-9 9-9 9z",
};
const catCounts = new Map<string, { name: string; count: number }>();
for (const d of activeDeals) {
  const name = String((d as any).category || "").trim();
  if (!name) continue;
  const e = catCounts.get(name) ?? { name, count: 0 };
  e.count++;
  catCounts.set(name, e);
}
const topCats = [...catCounts.values()].sort((a, b) => b.count - a.count).slice(0, 8).map((c) => ({
  ...c,
  slug: slugifyCategory(c.name),
  desc: CAT_DESC[c.name] ?? "Verified coupon deals.",
  icon: CAT_ICON[c.name] ?? "M4 6h16M4 12h16M4 18h10",
}));

// Top topics — compact chip block, one click to long-tail pages.
const topicCounts = new Map<string, number>();
for (const d of activeDeals) {
  const name = String((d as any).subcategory || "").trim();
  if (!name) continue;
  topicCounts.set(name, (topicCounts.get(name) ?? 0) + 1);
}
const topTopics = [...topicCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12).map(([name, count]) => ({
  name, count, slug: slugifyTopic(name),
}));

// ── Top rated: students rate these highest (CourseDuck "Courses students
// rate highest"). A minimum audience keeps a 5.0 from twelve buyers from
// outranking a 4.8 from 60,000 — thresholds widen only if the catalog is thin.
const rated = activeDeals.filter((d) => typeof d.rating === "number" && d.rating > 0 && (d.students ?? 0) > 0);
const byRating = (a: typeof rated[number], b: typeof rated[number]) => (b.rating ?? 0) - (a.rating ?? 0) || (b.students ?? 0) - (a.students ?? 0);
const topRated = [1000, 300, 100]
  .map((min) => rated.filter((d) => (d.students ?? 0) >= min).sort(byRating).slice(0, 6))
  .find((list) => list.length >= 6)
  ?? rated.sort(byRating).slice(0, 6);
const topRatedGrid = topRated;

// ── Instructors students trust most (CourseDuck "Most reviewed") — ranked
// by verified coupon count, with student reach as the tiebreaker.
type InstAgg = { name: string; slug: string; coupons: number; students: number; ratingSum: number; ratingN: number; img?: string };
const instMap = new Map<string, InstAgg>();
for (const d of activeDeals) {
  for (const raw of parseInstructors(d.instructor)) {
    const name = raw.replace(/[\p{Cc}\p{Cf}]/gu, "").trim();
    if (!name) continue;
    const slug = createInstructorSlug(name);
    if (!slug) continue;
    const e = instMap.get(slug) ?? { name, slug, coupons: 0, students: 0, ratingSum: 0, ratingN: 0 };
    e.coupons += 1;
    e.students += typeof d.students === "number" ? d.students : 0;
    if (typeof d.rating === "number" && d.rating > 0) { e.ratingSum += d.rating; e.ratingN += 1; }
    instMap.set(slug, e);
  }
}
const rankedInstructors = [...instMap.values()]
  .sort((a, b) => b.coupons - a.coupons || b.students - a.students)
  .slice(0, 8);
const topInstructors = await Promise.all(rankedInstructors.map(async (i) => ({ ...i, img: await getInstructorImage(i.slug) })));
const instructorTotal = instMap.size;

// ── From the blog: 3 newest guides (CourseDuck "Guides and comparisons").
const blogPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.updatedAt ?? b.data.pubDate ?? 0).getTime() - new Date(a.data.updatedAt ?? a.data.pubDate ?? 0).getTime())
  .slice(0, 3);

function fmtStudents(n: number) {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}
function initials(name: string) {
  return name.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
}

// Blog frontmatter stores either a source-relative path or a URL; the public
// copy of every cover lives under /assets/images (same resolver as /blog).
function resolveImage(imagePath: string | undefined): string | null {
  if (!imagePath) return null;
  if (imagePath.startsWith("http")) return imagePath;
  const filename = imagePath.split("/").pop();
  return filename ? `/assets/images/${filename}` : null;
}

function clean(s: string) { return String(s || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/\s{2,}/g, " ").trim(); }

// Homepage = brand + curation positioning. The exact-match listing keyword
// ("udemy coupon code") belongs to /udemy-coupon-code — this title leads
// with the brand to avoid cannibalizing it.
const pageTitle = `CoursesWyn: Verified Udemy Coupons & Promo Codes (${currentMonth} ${currentYear})`;
const pageDescription = `CoursesWyn tracks ${totalCoupons.toLocaleString()} verified Udemy coupons & promo codes for ${currentMonth} ${currentYear} — save up to ${maxDiscountPct}% on top-rated courses. Every code re-checked daily; dead codes pulled before you see them.`;

const faqs = [
  { q: "Are CoursesWyn's Udemy coupons legitimate?", a: "Yes. Every coupon comes from Udemy's official affiliate program or the course instructor directly. Each code is re-checked against Udemy daily, and dead codes are pulled from the site before you see them." },
  { q: "How do I claim a Udemy promo code here?", a: "Open any deal and continue to Udemy — the instructor coupon applies automatically at checkout, no typing needed. If a course needs a manual code, its deal page shows the code with copy-and-paste instructions." },
  { q: "Why do Udemy coupon codes stop working?", a: "Instructor coupons carry an expiry date, a redemption cap, or both. Free open coupons last 5 days for up to 10 students; targeted ones run up to 31 days for 100 students. Once either limit is hit, Udemy rejects the code. That is why we re-check every deal daily and only list live ones." },
  { q: "Should I wait for a Udemy sale instead?", a: "Instructor coupons often beat sitewide sale prices with deeper, course-specific cuts. If no coupon fits your course, Udemy runs sitewide sales every few weeks as a fallback — the sale price then applies automatically at checkout." },
  { q: "Do discounted courses include a certificate?", a: "Yes. A course claimed with a coupon is identical to full price: same videos, same instructor Q&A, same certificate of completion, and lifetime access on individually purchased courses." },
  { q: "Can I use a coupon in the Udemy mobile app?", a: "No. Udemy does not support coupon codes in its iOS/Android apps due to app-store payment rules. Open the course in a desktop or mobile browser to redeem the code." },
  { q: "Can I stack two Udemy codes on one course?", a: "No. Udemy applies one discount per course — either the coupon or the automatic sale price, whichever is lower. You can use different codes across different courses in the same cart." },
  { q: "Can I get a refund after using a coupon?", a: "Yes. Udemy's 30-day money-back guarantee applies to coupon purchases on eligible courses. Request it from your Purchase History; app-store purchases follow Apple/Google refund rules." },
];

const jsonLd = {
  "@context": "https://schema.org", "@graph": [
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "description": pageDescription, "inLanguage": "en-US", "publisher": { "@id": "https://courseswyn.com/#organization" }, "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } },
    { "@type": "Organization", "@id": "https://courseswyn.com/#organization", "name": "CoursesWyn", "url": "https://courseswyn.com", "logo": { "@type": "ImageObject", "url": "https://courseswyn.com/logo.svg", "width": 200, "height": 60 }, "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn", "https://medium.com/@coursewyn"], "description": `Verified Udemy coupons with savings up to ${maxDiscountPct}%, refreshed daily.` },
    { "@type": "WebPage", "@id": "https://courseswyn.com/#webpage", "url": "https://courseswyn.com", "name": pageTitle, "description": pageDescription, "author": { "@type": "Person", "name": "Andrew Derek", "url": "https://courseswyn.com/about" }, "isPartOf": { "@id": "https://courseswyn.com/#website" }, "dateModified": toISODateWIB(new Date()), "datePublished": toISODateWIB(new Date()), "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".sx-sub"] }, "inLanguage": "en-US" },
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }] },
    { "@type": "ItemList", "numberOfItems": latestSix.length, "itemListElement": latestSix.slice(0, 10).map((d, i) => ({ "@type": "ListItem", "position": i + 1, "item": { "@type": "Course", "name": clean(d.title), "url": "https://courseswyn.com/coupon/" + d.slug, "description": clean(d.description), "provider": { "@type": "Organization", "name": d.provider || "Udemy", "sameAs": "https://www.udemy.com" }, "offers": { "@type": "Offer", "price": d.price && d.price > 0 ? d.price : (d.originalPrice || 0), "priceCurrency": "USD", "availability": "https://schema.org/InStock", "url": "https://courseswyn.com/coupon/" + d.slug } } })) },
    { "@type": "FAQPage", "@id": "https://courseswyn.com#faq", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  ]
};

const heroChips = [
  { name: "Python", q: "Python" },
  { name: "Web Dev", q: "Web development" },
  { name: "AWS", q: "AWS" },
  { name: "Excel", q: "Excel" },
  { name: "Design", q: "Design" },
  { name: "Business", q: "Business" },
];

// CourseDuck's "Courses from …" provider strip, in CoursesWyn's own terms:
// Udemy is the marketplace we track, the rest are the comparison guides.
const compareStrip = [
  { name: "Udemy", href: "/udemy-coupon-code" },
  { name: "Coursera", href: "/platforms/udemy-vs-coursera" },
  { name: "edX", href: "/platforms/udemy-vs-edx" },
  { name: "Pluralsight", href: "/platforms/udemy-vs-pluralsight" },
  { name: "Skillshare", href: "/platforms/udemy-vs-skillshare" },
  { name: "LinkedIn Learning", href: "/platforms/udemy-vs-linkedin-learning" },
];

const steps = [
  { n: "1", t: "Search or browse", d: `Type a course or instructor name, or start from ${catCounts.size} categories and ${topicCounts.size} topics ranked by live coupon count.`, href: "/search", cta: "Search courses" },
  { n: "2", t: "Check the discount", d: "Rating, student count, price vs list, level and the last-checked stamp sit on one card — so you know the deal is live before you click.", href: "/udemy-coupons-today", cta: "See today's deals" },
  { n: "3", t: "Enrol on Udemy", d: "Every coupon links straight to the course page, where the instructor discount applies automatically at checkout. Some links earn us a commission, at no cost to you.", href: "/how-to-redeem-coupon", cta: "How to redeem" },
];

const whyCards = [
  { t: "Every live Udemy coupon in one place", d: `${totalCoupons.toLocaleString()} verified codes across ${catCounts.size} categories, compared side by side instead of tab by tab.`, href: "/udemy-coupon-code", cta: "Browse all coupons" },
  { t: `${last24h} codes re-checked in 24 hours`, d: "Our pipeline re-verifies each deal daily and prunes dead codes — providers cannot bury a dead listing here, because it never stays listed.", href: "/how-we-test-and-verify-udemy-coupons", cta: "How we verify" },
  { t: "Details you will not find elsewhere", d: "Price history, last-checked time, level, length, language and certificate status — checked for every course before it goes live.", href: "/faq", cta: "Read the FAQ" },
];

---

<Layout title={pageTitle} description={pageDescription} canonical="https://courseswyn.com">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .section-wrapper { width: 100%; padding: 3rem 1rem; }
  .container { max-width: 1200px; margin: 0 auto; width: 100%; }
  html { scroll-behavior: smooth; }


  /* ── Sales design (sx-) ── */
  .sx-hero { background: linear-gradient(160deg, #0E0E10 0%, #0a0b0d 45%, #101216 100%); padding: 4rem 0 0; text-align: center; position: relative; overflow: hidden; }
  .sx-hero::before { content: ''; position: absolute; top: -190px; left: 50%; transform: translateX(-50%); width: 660px; height: 480px; background: radial-gradient(ellipse, rgba(169, 199, 255,0.14) 0%, transparent 65%); pointer-events: none; }
  .sx-hero-dots { position: absolute; inset: 0; background-image: radial-gradient(rgba(242, 244, 246,0.1) 1px, transparent 1.6px); background-size: 26px 26px; -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 20%, transparent 70%); mask-image: radial-gradient(ellipse 75% 60% at 50% 0%, #000 20%, transparent 70%); pointer-events: none; }
  .sx-hero .container { position: relative; z-index: 1; padding-bottom: 3rem; }
  .sx-ticket { position: relative; z-index: 1; }
  .sx-ticket-line { border-top: 2px dashed rgba(169, 199, 255,0.45); }
  .sx-ticket-edge { height: 14px; background-image: radial-gradient(circle at 50% 0%, #ffffff 9px, transparent 10px); background-size: 28px 14px; background-repeat: repeat-x; }

  .sx-blink { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; flex-shrink: 0; }
  .sx-hero h1 { font-size: clamp(2.2rem, 4.6vw, 3.4rem); font-weight: 800; line-height: 1.1; color: #f2f4f6; margin: 0 0 0.9rem; letter-spacing: -0.02em; }
  .sx-gold { background: linear-gradient(135deg, #D6E4FF 0%, #D6E4FF 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .sx-sub { font-size: 1.15rem; color: rgba(242, 244, 246,0.78); max-width: 640px; margin: 0 auto 1.75rem; line-height: 1.6; }
  .sx-search { display: flex; gap: 8px; max-width: 640px; margin: 0 auto; background: #fff; border-radius: 14px; padding: 6px; box-shadow: 0 20px 50px -12px rgba(0,0,0,0.45); }
  .sx-search input { flex: 1; border: none; outline: none; font-size: 0.95rem; padding: 12px 16px; min-width: 0; color: #111; background: transparent; font-family: inherit; }
  .sx-search button { font-weight: 800; color: #0a0b0d; background: linear-gradient(135deg, #D6E4FF 0%, #A9C7FF 100%); border: none; border-radius: 10px; padding: 0 28px; cursor: pointer; font-size: 0.95rem; font-family: inherit; }
  .sx-search button:hover { filter: brightness(1.1); }
  .sx-chips { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 1.1rem; }
  .sx-chip { display: inline-block; padding: 7px 16px; border-radius: 999px; background: rgba(242, 244, 246,0.07); border: 1px solid rgba(242, 244, 246,0.18); color: #f2f4f6; text-decoration: none; font-size: 0.82rem; font-weight: 600; }
  .sx-chip:hover { background: rgba(242, 244, 246,0.14); border-color: rgba(169, 199, 255,0.5); }
  .sx-proof { margin: 1.75rem auto 0; font-family: var(--font-mono); font-size: 0.78rem; color: rgba(242, 244, 246,0.62); display: flex; gap: 10px; justify-content: center; align-items: baseline; flex-wrap: wrap; }
  .sx-proof b { color: #f2f4f6; font-variant-numeric: tabular-nums; }
  .sx-proof .sx-dot { color: #A9C7FF; }
  .sx-eyebrow-sec { display: inline-block; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #A9C7FF; margin: 0 0 0.5rem; }
  .sx-h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 800; margin: 0 0 0.5rem; color: #f2f4f6; line-height: 1.2; letter-spacing: -0.01em; }
  .sx-h2 span { color: #A9C7FF; }
  .sx-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #f2f4f6; background: rgba(242, 244, 246,0.08); border: 1px solid rgba(242, 244, 246,0.2); border-radius: 999px; padding: 7px 16px; margin: 0 0 1.1rem; }
  .sx-band { background: #161619; border-top: 1px solid #22262d; border-bottom: 1px solid #22262d; }
  .sx-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .sx-cta { background: linear-gradient(135deg, #0a0b0d 0%, #101216 130%); border-radius: 24px; padding: clamp(2rem, 5vw, 3.5rem); text-align: center; color: #f2f4f6; position: relative; overflow: hidden; margin-top: 1.75rem; }
  .sx-cta::before { content: ''; position: absolute; top: -80px; left: 50%; transform: translateX(-50%); width: 480px; height: 240px; background: radial-gradient(ellipse, rgba(169, 199, 255,0.18) 0%, transparent 65%); pointer-events: none; }
  .sx-cta h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; margin: 0 0 0.6rem; position: relative; }
  .sx-cta p { color: rgba(242, 244, 246,0.75); margin: 0 0 1.5rem; position: relative; }
  .sx-cta-row { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; position: relative; }
  .sx-cta-btn { display: inline-block; background: #D6E4FF; color: #1a1040; font-weight: 800; padding: 0.9rem 2.2rem; border-radius: 12px; text-decoration: none; }
  .sx-cta-btn:hover { filter: brightness(1.05); }
  .sx-cta-ghost { align-self: center; color: rgba(242, 244, 246,0.8); font-weight: 600; font-size: 0.9rem; }

  /* ── Compare strip (CourseDuck "Courses from …") ── */
  .sx-strip { display: flex; align-items: center; justify-content: center; gap: 0.75rem 1rem; flex-wrap: wrap; padding: 1.4rem 1rem 0; }
  .sx-strip-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .sx-strip-links { display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; }
  .sx-strip-links a { font-size: 0.85rem; font-weight: 700; color: var(--text); padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); text-decoration: none; transition: border-color 0.2s, color 0.2s; }
  .sx-strip-links a:hover { border-color: var(--brand); color: var(--brand); }
  .sx-strip-links a.sx-strip-more { border-style: dashed; color: var(--brand); }

  /* ── Category grid ── */
  .hp-cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; margin-top: 1.75rem; }
  .hp-cat { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.15rem 1.2rem; text-decoration: none; display: flex; flex-direction: column; gap: 0.3rem; transition: transform 0.2s, border-color 0.2s; }
  .hp-cat:hover { transform: translateY(-3px); border-color: var(--brand); }
