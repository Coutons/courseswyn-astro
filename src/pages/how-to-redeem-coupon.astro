---
import Layout from "../layouts/Layout.astro";
import AuthorBox from "../components/AuthorBox.astro";
import { Image } from "astro:assets";
import { formatDateWIB, toISODateWIB } from "../lib/date";

const siteUrl = "https://courseswyn.com";
const canonicalUrl = `${siteUrl}/how-to-redeem-coupon/`;
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const pageTitle = `How to Redeem a Udemy Coupon Code (${currentYear}): 5 Steps + Fixes`;
const pageDescription = `Step-by-step guide to redeeming a Udemy coupon code in ${currentYear}: where to click, how to check the price, what to do if the code fails, and when you need to pay.`;
const lastModified = toISODateWIB();

const ogImage = `${siteUrl}/assets/images/how-to-redeem-udemy-coupon-2026.jpg`;
const featuredImage = "/assets/images/how-to-redeem-udemy-coupon-2026.jpg";
const stepsImage = "/assets/images/how-to-redeem-udemy-coupon-steps-2026.jpg";
const priceImage = "/assets/images/udemy-coupon-price-check-2026.jpg";
const troubleImage = "/assets/images/udemy-coupon-troubleshooting-2026.jpg";

const faqs = [
  {
    q: "Why is my Udemy coupon not working?",
    a: "Usually because the coupon expired or hit its redemption cap. Other causes: you opened Udemy directly instead of through the deal link, you skipped a code that must be typed manually, or you already own the course. Reopen the deal link in a fresh browser tab first; if the price is still full, the coupon is likely dead."
  },
  {
    q: "Why does Udemy still show the full price after I clicked the link?",
    a: "The coupon is likely expired, capped, or no longer valid for that course. Refresh the page or try a private window. If the full price persists, return to the live list and choose a newer deal. Udemy applies only one discount per purchase."
  },
  {
    q: "Do I need to type the coupon code manually?",
    a: "Usually not. Most instructor coupons are embedded in the deal link and apply automatically. Some deals show a code that must be copied at checkout; the deal page tells you which. The Udemy mobile app has no coupon field, so use a browser."
  },
  {
    q: "Can I use a coupon if I already own the course?",
    a: "No. Udemy won't apply a coupon to a course already in your library. Check My Learning — you already have access, so there is nothing more to buy."
  },
  {
    q: "What do I get with a coupon vs buying at full price?",
    a: "The same course access: videos, resources, Q&A, updates, and the certificate when the course offers one. Udemy does not mark or limit coupon enrollments."
  },
  {
    q: "Can I redeem a Udemy coupon in the mobile app?",
    a: "No. The iOS and Android apps do not have a coupon field. Open the course in Safari, Chrome, Firefox, or Edge, sign in, and complete checkout there. The course then appears in the app."
  },
  {
    q: "Do paid coupons require a credit card?",
    a: "Yes, if the coupon is a paid discount. You pay the discounted price at checkout. A 100% off coupon drops the price to $0.00 and requires no payment method."
  },
  {
    q: "How long do Udemy coupons last?",
    a: "It varies. Instructor coupons are time-limited and redemption-capped; popular free coupons can disappear within hours. Always check the last-checked date on the deal card and confirm the price at checkout."
  }
];

const troubleshootItems = [
  {
    problem: "Full price still showing",
    causes: "The coupon expired, hit its redemption cap, or you opened Udemy directly instead of through the deal link.",
    fix: "Reopen the deal link in a fresh tab. If the full price persists, the coupon is dead — return to the live list and pick a newer deal."
  },
  {
    problem: '"Coupon not found" or "Invalid coupon"',
    causes: "The code was typed incorrectly, revoked by the instructor, or fully redeemed.",
    fix: "Copy the code exactly from the deal page and check for extra spaces. If it still fails, the coupon is gone; look for a newer listing."
  },
  {
    problem: "Discount applied but less than expected",
    causes: "The coupon is a partial discount, or Udemy's automatic sale price is already lower than the code.",
    fix: "Check the price advertised on the deal card. Udemy applies only one discount per purchase; if the current sale price is already lower, the coupon may not reduce it further."
  },
  {
    problem: '"You already own this course"',
    causes: "You enrolled previously, possibly with an older coupon.",
    fix: "Open My Learning — the course is already in your library. There is no need to re-enroll."
  },
  {
    problem: "Coupon link opens a different course",
    causes: "The instructor changed the course URL or removed the course from Udemy.",
    fix: "Search for the course title on Udemy directly. If it is gone, report the deal through our contact page."
  },
  {
    problem: "Mobile app won't apply the coupon",
    causes: "The iOS and Android apps do not have a coupon field.",
    fix: "Open Udemy in a browser, sign in, and complete checkout there. The course then appears in the app."
  }
];

const verifyItems = [
  { icon: "✅", label: "Good sign", text: "The price shows the expected discounted amount — or $0.00 for a 100% off code." },
  { icon: "✅", label: "Good sign", text: "The original price has a strikethrough next to the lower price." },
  { icon: "✅", label: "Good sign", text: "The price box shows the reduced price — some checkouts also display a “Coupon applied” message." },
  { icon: "❌", label: "Problem", text: "The full price appears with no strikethrough — the coupon did not apply." },
  { icon: "❌", label: "Problem", text: "“Coupon not found” or “Invalid coupon” — expired, capped, or the wrong code." },
  { icon: "❌", label: "Problem", text: "“You already own this course” — you are enrolled; check My Learning." }
];

const features = [
  { icon: "♾️", title: "Lifetime access", desc: "Course content never expires. Return to rewatch lessons anytime — even years later." },
  { icon: "📱", title: "Mobile app", desc: "Watch on iOS or Android. Coupon checkout still has to happen in a browser." },
  { icon: "⬇️", title: "Downloadable resources", desc: "Source code, PDFs, exercises, and supplementary files the instructor provides." },
  { icon: "❓", title: "Q&A and community", desc: "Ask questions directly to the instructor and interact with other students in the discussion section." },
  { icon: "🏆", title: "Certificate of completion", desc: "Shareable PDF certificate awarded when you complete the required content, when the course offers one." },
  { icon: "🔄", title: "Course updates", desc: "You receive all future updates to courses you own at no extra cost." }
];

const beforeItems = [
  {
    title: "A live deal",
    text: "Start from the current coupon list, not a screenshot or an old bookmark. Check the price and the last-checked date."
  },
  {
    title: "A free Udemy account",
    text: "You need an account to enroll. Creating one takes about 30 seconds, and you can use the same account for every course."
  },
  {
    title: "A browser",
    text: "Use Chrome, Safari, Firefox, or Edge. The iOS and Android apps do not accept coupon codes."
  }
];

const toc = [
  ["#quick-answer", "Quick answer"],
  ["#before-you-start", "Before you start"],
  ["#steps", "5 steps to redeem"],
  ["#verify", "Verify the price"],
  ["#troubleshooting", "Troubleshooting"],
  ["#after-enrollment", "After enrolling"],
  ["#faq", "FAQs"]
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="article"
  image={ogImage}
  imageWidth={1200}
  imageHeight={630}
  pubDate={new Date("2026-03-04")}
  updatedDate={new Date(lastModified)}
>
  <meta name="author" content="Andrew Derek" slot="head" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "@id": `${canonicalUrl}#article`,
        "url": canonicalUrl,
        "headline": pageTitle,
        "description": pageDescription,
        "image": [
          ogImage,
          `${siteUrl}/assets/images/how-to-redeem-udemy-coupon-steps-2026.jpg`,
          `${siteUrl}/assets/images/udemy-coupon-price-check-2026.jpg`
        ],
        "datePublished": "2026-03-04",
        "dateModified": lastModified,
        "inLanguage": "en-US",
        "author": { "@type": "Person", "name": "Andrew Derek", "url": `${siteUrl}/about` },
        "publisher": {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "CoursesWyn",
          "url": siteUrl,
          "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.svg` }
        },
        "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
        "isPartOf": { "@id": siteUrl }
      },
      {
        "@type": "HowTo",
        "@id": `${canonicalUrl}#howto`,
        "name": "How to Redeem a Udemy Coupon Code",
        "description": "Step-by-step instructions to redeem a Udemy coupon on CoursesWyn, including how to verify the price before enrolling.",
        "image": [ogImage, `${siteUrl}/assets/images/how-to-redeem-udemy-coupon-steps-2026.jpg`],
        "totalTime": "PT2M",
        "supply": [
          { "@type": "HowToSupply", "name": "Free Udemy account" },
          { "@type": "HowToSupply", "name": "Valid Udemy coupon from a live CoursesWyn listing" },
          { "@type": "HowToSupply", "name": "Web browser" }
        ],
        "step": [
          {
            "@type": "HowToStep", "position": 1,
            "name": "Find a live Udemy deal",
            "text": "Browse the current CoursesWyn coupon list and check the price, original price, and last-checked date."
          },
          {
            "@type": "HowToStep", "position": 2,
            "name": "Open the deal link",
            "text": "Click Redeem Coupon or Get Deal. Most coupons apply automatically; if a code is shown, copy it before continuing."
          },
          {
            "@type": "HowToStep", "position": 3,
            "name": "Check the price on Udemy",
            "text": "A 100% off code shows $0.00; a paid coupon shows the discounted amount. If the full price remains, the coupon is expired or capped."
          },
          {
            "@type": "HowToStep", "position": 4,
            "name": "Sign in to Udemy",
            "text": "Log in or create a free account in the same browser session."
          },
          {
            "@type": "HowToStep", "position": 5,
            "name": "Enroll and confirm",
            "text": "Click Enroll Now, pay the discounted price if applicable, and confirm the course appears in My Learning."
          }
        ],
        "inLanguage": "en-US",
        "datePublished": "2026-03-04",
        "dateModified": lastModified,
        "author": { "@type": "Person", "name": "Andrew Derek", "url": `${siteUrl}/about` }
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${canonicalUrl}#breadcrumb`,
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
          { "@type": "ListItem", "position": 2, "name": "How to Redeem Coupon", "item": canonicalUrl }
        ]
      },
      {
        "@type": "FAQPage",
        "@id": `${canonicalUrl}#faq`,
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": { "@type": "Answer", "text": faq.a }
        }))
      }
    ]
  })} />

  <div class="p-root">
    <article class="p-article">

      <header class="p-hdr">
        <p class="p-eyebrow">Udemy Coupon Guide</p>
        <h1>How to Redeem a Udemy Coupon Code <span class="p-h1-sub">{currentYear} Step-by-Step</span></h1>
        <p class="p-meta">
          <span>By <a href="/about">Andrew Derek</a></span>
          <span>·</span>
          <span>Updated <time datetime={lastModified}>{formatDateWIB(new Date(), {year:'numeric',month:'long',day:'numeric'})}</time></span>
          <span>·</span>
          <span>7 min read</span>
        </p>
        <p class="p-intro">
          This guide shows exactly where to click, how to confirm the discount before you enroll,
          and what to do when a code fails. It works for paid instructor coupons and 100% off codes.
        </p>
      </header>

      <figure class="p-fig p-hero-fig">
        <Image
          src={featuredImage}
          alt="How to redeem a Udemy coupon code in 2026 — five-step checkout guide"
          width={1200}
          height={630}
          loading="eager"
          fetchpriority="high"
          inferSize={false}
        />
        <figcaption>Redeeming a Udemy coupon takes about two minutes — the key is checking the price before you enroll.</figcaption>
      </figure>

      <section id="quick-answer" class="p-quick">
        <div class="p-sec-hdr"><h2>Quick Answer</h2></div>
        <p>
          To redeem a Udemy coupon: open the deal through CoursesWyn, check that the price changed on
          Udemy, sign in, and enroll. Most instructor coupons apply automatically; some need the code
          copied from the deal page. Use a browser — the Udemy mobile app does not accept coupon codes.
        </p>
        <div class="p-quick-grid">
          <div><strong>Time needed</strong><span>About 2 minutes</span></div>
          <div><strong>Payment</strong><span>Only for paid coupons</span></div>
          <div><strong>Works on</strong><span>Desktop or mobile browser</span></div>
        </div>
      </section>

      <nav class="p-toc" aria-label="On this page">
        <p class="p-toc-title">On this page</p>
        <ol>
          {toc.map(([href, label]) => (
            <li><a href={href as string}>{label as string}</a></li>
          ))}
        </ol>
      </nav>

      <section id="before-you-start">
        <div class="p-sec-hdr"><h2>Before You Start: 3 Things You Need</h2></div>
        <ul class="p-checklist">
          {beforeItems.map(item => (
            <li>
              <strong>{item.title}.</strong> {item.text}
            </li>
          ))}
        </ul>
      </section>

      <section id="steps">
        <div class="p-sec-hdr"><h2>5 Steps to Redeem a Udemy Coupon</h2></div>
        <p>
          Most CoursesWyn deals embed the coupon in the link, so the discount applies automatically.
          If a deal shows a code instead, copy it before you continue. Here is the full process:
        </p>

        <ol class="p-steps">
          <li><span class="p-step-num">1</span>
            <div>
              <strong>Find a live deal</strong>
              <p>
                Browse the <a href="/udemy-coupon-code">current Udemy coupon list</a> or
                <a href="/udemy-coupons-today">today's deals</a> and pick a course you actually want.
                Check the current price, original price, and last-checked date. Most coupons are paid
                discounts; 100% off codes are rarer and sell out fast.
              </p>
            </div>
          </li>
          <li><span class="p-step-num">2</span>
            <div>
              <strong>Open the deal link</strong>
              <p>
                Click <strong>Redeem Coupon</strong> or <strong>Get Deal</strong> on the deal page.
                Most links open Udemy with the coupon already applied. If the deal page shows a code,
                copy it — you will paste it at checkout.
              </p>
              <div class="p-callout"><strong>Important:</strong> open Udemy through the deal link. If you navigate to the course directly, the coupon may not apply.</div>
            </div>
          </li>
          <li><span class="p-step-num">3</span>
            <div>
              <strong>Check the price before you sign in</strong>
              <p>
                On Udemy, look at the purchase box. A 100% off code shows <strong>$0.00</strong>; a
                paid coupon shows the discounted amount. If the full price is still there, stop — the
                code is expired or has hit its redemption cap.
              </p>
            </div>
          </li>
          <li><span class="p-step-num">4</span>
            <div>
              <strong>Sign in or create a free Udemy account</strong>
              <p>
                Log in with your existing account or create one. Stay in the same browser session;
                switching browsers or accounts can lose the coupon from the URL.
              </p>
            </div>
          </li>
          <li><span class="p-step-num">5</span>
            <div>
              <strong>Complete enrollment and check My Learning</strong>
              <p>
                Click <strong>Enroll Now</strong>. For a 100% off coupon, no payment is needed. For a
                paid coupon, pay the discounted price shown at checkout. The course then appears in
                <strong>My Learning</strong>.
              </p>
              <div class="p-callout p-callout-ok"><strong>Done:</strong> coupon enrollments get the same course access as full-price enrollments — videos, resources, Q&amp;A, updates, and the certificate when the course offers one.</div>
            </div>
          </li>
        </ol>

        <figure class="p-fig">
          <Image
            src={stepsImage}
            alt="Five steps to redeem a Udemy coupon: find a deal, open the link, check the price, sign in, and enroll"
            width={1200}
            height={675}
            loading="lazy"
            decoding="async"
            inferSize={false}
          />
          <figcaption>The five-step flow: find a live deal, open the link, verify the price, sign in, and enroll.</figcaption>
        </figure>
      </section>

      <section id="verify">
        <div class="p-sec-hdr"><h2>How to Verify the Coupon Was Applied</h2></div>
        <p>
          After the deal link opens Udemy, check the purchase box before you enroll. This is the
          difference between a working coupon and a dead one:
        </p>

        <figure class="p-fig">
          <Image
            src={priceImage}
            alt="Udemy checkout price comparison: coupon applied showing $12.99 versus full price $129.99"
            width={1200}
            height={675}
            loading="lazy"
            decoding="async"
            inferSize={false}
          />
          <figcaption>Illustration: a working coupon changes the price. If the full price remains, the code did not apply.</figcaption>
        </figure>

        <div class="p-verify">
          {verifyItems.map(item => (
            <div class="p-verify-item" data-type={item.icon === '✅' ? 'ok' : 'bad'}>
              <span class="p-verify-icon">{item.icon}</span>
              <div>
                <span class="p-verify-lbl">{item.label}</span>
                <p>{item.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="p-callout"><strong>Rule of thumb:</strong> if the price did not change, do not enroll. Return to the live list and pick a newer deal.</div>
      </section>

      <section id="troubleshooting">
        <div class="p-sec-hdr"><h2>Troubleshooting: When the Coupon Doesn't Work</h2></div>
        <p>
          Udemy coupons can expire or hit their redemption cap within hours. Match the symptom below
          to the likely cause and fix:
        </p>

        <figure class="p-fig">
          <Image
            src={troubleImage}
            alt="Udemy coupon troubleshooting chart: full price, coupon not found, already owned, and mobile app issues"
            width={1200}
            height={675}
            loading="lazy"
            decoding="async"
            inferSize={false}
          />
          <figcaption>Most coupon failures are expiry or redemption caps — not browser problems.</figcaption>
        </figure>

        <div class="p-trouble">
          {troubleshootItems.map(item => (
            <details class="p-accordion">
              <summary><span class="p-trouble-icon">🔧</span> {item.problem}</summary>
              <div class="p-accordion-body">
                <p class="p-cause"><strong>Likely cause:</strong> {item.causes}</p>
                <p class="p-fix"><strong>Fix:</strong> {item.fix}</p>
              </div>
            </details>
          ))}
        </div>
        <div class="p-callout"><strong>General rule:</strong> if a coupon is not working, expiry or a filled redemption cap is the most likely cause. Return to the live list and choose a fresher deal.</div>
      </section>

      <section id="after-enrollment">
        <div class="p-sec-hdr"><h2>What You Get After Enrolling</h2></div>
        <p>
          Enrolling with a coupon gives you the same course access as paying full price. Udemy does
          not mark or limit coupon enrollments.
        </p>
        <div class="p-feats">
          {features.map(f => (
            <div class="p-feat">
              <div class="p-feat-icon">{f.icon}</div>
              <strong>{f.title}</strong>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="faq">
        <div class="p-sec-hdr"><h2>Udemy Coupon Redemption FAQs <span class="p-faq-count">{faqs.length} questions</span></h2></div>
        <div class="p-faqs">
          {faqs.map(faq => (
            <div class="p-faq-card">
              <h3 class="p-faq-q">{faq.q}</h3>
              <p class="p-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="p-cta">
        <h2>Ready to redeem your first coupon?</h2>
        <p>Browse live Udemy coupons — each listing shows its price and last-checked date, so you know what you're getting before you click.</p>
        <div class="p-cta-actions">
          <a href="/udemy-coupon-code" class="p-btn">Browse Live Coupons →</a>
          <a href="/udemy-coupons-today" class="p-btn p-btn-ghost">See Today's Deals</a>
        </div>
      </div>

      <section class="p-related">
        <div class="p-sec-hdr"><h2>Keep Reading</h2></div>
        <ul>
          <li><a href="/udemy-coupons-guide">Udemy Coupons Guide: how coupons work and why they expire</a></li>
          <li><a href="/how-we-test-and-verify-udemy-coupons">How we test and verify Udemy coupons</a></li>
          <li><a href="/udemy-coupon-code">All live Udemy coupon codes</a></li>
        </ul>
      </section>

      <AuthorBox image="/images/author.jpg" />

    </article>
  </div>

  <style>
    .p-root { padding: 3rem 1rem 4rem; }
    .p-article { max-width: 48rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; }

    .p-hdr { }
    .p-eyebrow { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--brand); margin: 0 0 0.6rem; }
    .p-hdr h1 { font-size: 1.75rem; font-weight: 700; color: var(--text); margin: 0; line-height: 1.15; }
    .p-hdr h1 .p-h1-sub { display: block; color: var(--muted); font-weight: 500; font-size: 0.68em; margin-top: 0.35rem; }
    .p-meta { font-size: 0.82rem; color: var(--muted); margin: 0.5rem 0 0; display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .p-meta a { color: var(--brand); text-decoration: none; }
    .p-meta a:hover { text-decoration: underline; }
    .p-meta strong { color: var(--text); }

    .p-intro p, .p-intro { font-size: 0.95rem; color: var(--muted); line-height: 1.7; margin: 1rem 0 0; }

    .p-fig { margin: 0; }
    .p-fig img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border); background: var(--card); }
    .p-fig figcaption { font-size: 0.78rem; color: var(--muted); line-height: 1.55; margin-top: 0.6rem; text-align: center; }
    .p-hero-fig { margin-top: 0.25rem; }

    .p-quick { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem 1.35rem; gap: 0.75rem; }
    .p-quick .p-sec-hdr { border-top: none; border-bottom: none; padding: 0; }
    .p-quick p { font-size: 0.92rem; color: var(--muted); line-height: 1.7; margin: 0; }
    .p-quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 0.25rem; }
    .p-quick-grid div { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 0.65rem 0.75rem; }
    .p-quick-grid strong { display: block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand); margin-bottom: 0.2rem; }
    .p-quick-grid span { font-size: 0.82rem; color: var(--text); line-height: 1.4; }

    .p-toc { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.25rem; }
    .p-toc-title { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin: 0 0 0.6rem; }
    .p-toc ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 1.25rem; counter-reset: toc; }
    .p-toc li { counter-increment: toc; }
    .p-toc a { font-size: 0.85rem; color: var(--brand); text-decoration: none; display: inline-flex; gap: 0.45rem; line-height: 1.5; }
    .p-toc a::before { content: counter(toc) "."; color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; }
    .p-toc a:hover { text-decoration: underline; }

    .p-checklist { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.55rem; }
    .p-checklist li { position: relative; padding-left: 1.5rem; font-size: 0.9rem; color: var(--muted); line-height: 1.65; }
    .p-checklist li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--brand); font-weight: 700; }
    .p-checklist strong { color: var(--text); }
    .p-checklist a { color: var(--brand); }

    section { display: flex; flex-direction: column; gap: 0.75rem; }

    .p-sec-hdr { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.5rem 0; margin: 0; }
    .p-sec-hdr h2 { font-size: 0.92rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text); margin: 0; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .p-faq-count { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0.2rem 0.6rem; white-space: nowrap; }

    section p { font-size: 0.9rem; color: var(--muted); line-height: 1.65; margin: 0; }
    section p a { color: var(--brand); }

    .p-callout { border-left: 3px solid var(--brand); background: var(--card); padding: 0.75rem 1rem; font-size: 0.85rem; color: var(--muted); line-height: 1.6; border-radius: 0 6px 6px 0; margin-top: 0.5rem; }
    .p-callout strong { color: var(--text); }
    .p-callout-warn { border-left-color: #A9C7FF; }
    .p-callout-warn strong { color: #A9C7FF; }
    .p-callout-ok { border-left-color: var(--brand); }
    .p-callout-ok strong { color: var(--brand); }

    /* Steps */
    .p-steps { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
    .p-steps li { display: flex; gap: 0.85rem; align-items: flex-start; }
    .p-step-num { background: var(--brand); color: #fff; font-size: 0.75rem; font-weight: 800; width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
    .p-steps li > div { flex: 1; }
    .p-steps li > div > strong { display: block; font-size: 0.9rem; color: var(--text); margin-bottom: 0.3rem; }
    .p-steps li > div > p { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0; }
    .p-steps li > div > p a { color: var(--brand); }

    /* Verify */
    .p-verify { display: flex; flex-direction: column; gap: 0.4rem; }
    .p-verify-item { display: flex; gap: 0.65rem; align-items: flex-start; padding: 0.6rem 0.85rem; border: 1px solid var(--border); border-radius: 6px; }
    .p-verify-item[data-type="ok"] { background: rgba(34,197,94,0.04); }
    .p-verify-item[data-type="bad"] { background: rgba(239,68,68,0.04); }
    .p-verify-icon { font-size: 0.85rem; flex-shrink: 0; margin-top: 1px; }
    .p-verify-lbl { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; }
    .p-verify-item[data-type="ok"] .p-verify-lbl { color: var(--brand); }
    .p-verify-item[data-type="bad"] .p-verify-lbl { color: #A9C7FF; }
    .p-verify-item p { font-size: 0.82rem; color: var(--muted); line-height: 1.5; margin: 2px 0 0; }

    /* Troubleshooting accordion */
    .p-trouble { display: flex; flex-direction: column; gap: 0.4rem; }
    .p-accordion { border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .p-accordion summary { padding: 0.75rem 1rem; cursor: pointer; font-size: 0.85rem; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 0.5rem; list-style: none; transition: background 0.15s; }
    .p-accordion summary:hover { background: var(--card-hover); }
    .p-accordion summary::-webkit-details-marker { display: none; }
    .p-trouble-icon { font-size: 0.9rem; }
    .p-accordion-body { padding: 0 1rem 0.75rem; font-size: 0.82rem; color: var(--muted); line-height: 1.6; border-top: 1px solid var(--border); margin-top: 0; padding-top: 0.65rem; }
    .p-accordion-body p { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.3rem; }
    .p-accordion-body p:last-child { margin-bottom: 0; }
    .p-accordion-body strong { color: var(--text); }
    .p-cause strong { color: var(--text); }
    .p-fix strong { color: var(--brand); }

    /* FAQ grid */
    .p-faqs { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .p-faq-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.15rem; }
    .p-faq-card:hover { border-color: var(--muted); }
    .p-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
    .p-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }

    /* Features grid */
    .p-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem; }
    .p-feat { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; }
    .p-feat-icon { font-size: 1.3rem; margin-bottom: 0.4rem; }
    .p-feat strong { font-size: 0.85rem; color: var(--text); display: block; margin-bottom: 0.25rem; }
    .p-feat p { font-size: 0.8rem; color: var(--muted); line-height: 1.55; margin: 0; }

    /* CTA */
    .p-cta { border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; text-align: center; }
    .p-cta h2 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; }
    .p-cta p { font-size: 0.85rem; color: var(--muted); margin: 0 0 1rem; }
    .p-cta-actions { display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap; }
    .p-btn { display: inline-block; padding: 0.65rem 1.5rem; background: var(--brand); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 700; font-size: 0.85rem; transition: opacity 0.15s; }
    .p-btn:hover { opacity: 0.9; }
    .p-btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
    .p-btn-ghost:hover { border-color: var(--brand); color: var(--brand); opacity: 1; }

    /* Related */
    .p-related ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
    .p-related a { color: var(--brand); font-size: 0.88rem; text-decoration: none; }
    .p-related a:hover { text-decoration: underline; }

    @media (max-width: 640px) {
      .p-root { padding: 2rem 1rem 3rem; }
      .p-hdr h1 { font-size: 1.5rem; }
      .p-steps li { flex-direction: column; gap: 0.4rem; }
      .p-feats { grid-template-columns: 1fr 1fr; }
      .p-faqs { grid-template-columns: 1fr; }
      .p-quick-grid { grid-template-columns: 1fr; }
      .p-toc ol { grid-template-columns: 1fr; }
      .p-cta-actions { flex-direction: column; }
      .p-btn { width: 100%; }
    }
  </style>
</Layout>
