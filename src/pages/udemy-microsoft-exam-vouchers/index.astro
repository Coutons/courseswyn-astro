---
import Layout from "../../layouts/Layout.astro";
import CouponGrid from "../../components/CouponGrid.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import VoucherHero from "../../components/VoucherHero.astro";
import VoucherGrid from "../../components/VoucherGrid.astro";
import { getDeals } from "../../lib/store.js";
import { formatDateWIB, toISODateWIB } from "../../lib/date";
import { MICROSOFT_GROUPS, countVouchers, voucherAffUrl, voucherCatalogAffUrl } from "../../lib/vouchers.js";

const canonicalUrl = "https://courseswyn.com/udemy-microsoft-exam-vouchers/";
const pageTitle = "Microsoft Exam Voucher 2026: Udemy Prices & 10% Off";
const pageDescription =
  "Microsoft exam vouchers on Udemy (2026): AZ-900, DP-900, AZ-104, AZ-305 and more — Udemy advertises 10% off, Retake Assurance on role-based exams, and 9+ month validity.";
const publishedISO = "2026-09-20";
const lastModified = toISODateWIB();
const now = new Date();
const dateFull = formatDateWIB(now, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
const catalogUrl = voucherCatalogAffUrl();
const total = countVouchers(MICROSOFT_GROUPS);
const allVouchers = MICROSOFT_GROUPS.flatMap((g) => g.items);
const availableVouchers = allVouchers.filter((v) => !v.catalogOnly);
const totalAvailable = availableVouchers.length;

const examLevels = [
  {
    level: "Fundamentals",
    fee: "US$99*",
    exams: "AZ-900 (Azure Fundamentals), DP-900 (Azure Data Fundamentals) — both sold on Udemy. Also AI-900, MS-900, PL-900.",
    coverage: "Exam-specific — one voucher per exam",
  },
  {
    level: "Associate",
    fee: "US$165",
    exams: "AZ-104 (Administrator), AZ-500 (Security), AI-102 (AI Engineer), AZ-800 (Windows Server Hybrid), MD-102 (Endpoint) — all five sold on Udemy.",
    coverage: "Exam-specific — one voucher per exam",
  },
  {
    level: "Expert",
    fee: "US$165",
    exams: "AZ-305 (Azure Solutions Architect Expert) — sold on Udemy. AZ-400 (DevOps Engineer Expert) is also Expert-level.",
    coverage: "Exam-specific — one voucher per exam",
  },
];

const voucherPicks = [
  {
    level: "Fundamentals (AZ-900 / DP-900)",
    best: "First cloud certification",
    body: "Pick AZ-900 for a general cloud foundation or DP-900 if you work with data. Neither requires experience. Note: the Fundamentals voucher pages on Udemy do NOT offer Retake Assurance.",
  },
  {
    level: "Associate (AZ-104, AZ-500, AI-102, AZ-800, MD-102)",
    best: "Most popular level",
    body: "Role-based and hands-on. Retake Assurance is available on all five Udemy pages when bought with the voucher. Choose the exam that matches your job: administration, security, AI, hybrid server or endpoint.",
  },
  {
    level: "Expert (AZ-305)",
    best: "Senior architects",
    body: "For designing end-to-end Azure solutions. Retake Assurance available on the Udemy page. Best taken after Associate-level experience or AZ-104.",
  },
];

const comparisonRows = [
  {
    label: "Price",
    udemy: "Udemy advertises “save 10%” on every Microsoft voucher page (checked 4 Nov 2026). Final price is shown at checkout and varies by country and promotion.",
    aws: "Microsoft price per exam page — typically US$99 (Fundamentals) and US$165 (Associate/Expert), priced per country and region.",
  },
  {
    label: "Retake",
    udemy: "Retake Assurance, bought together with the voucher. Role-based exams only — NOT on Fundamentals (AZ-900, DP-900). One extra attempt; non-refundable.",
    aws: "Pay again after the waiting period: 24 hours after the first attempt, then 14 days between later attempts (max 5 attempts per 12 months).",
  },
  {
    label: "Validity",
    udemy: "At least 9 months from purchase. The expiry date cannot be extended.",
    aws: "No voucher to expire — you pay when you schedule the exam.",
  },
  {
    label: "Refund",
    udemy: "Non-refundable and non-transferable. No refund if you pass first time; no-shows forfeit the voucher.",
    aws: "Microsoft does not refund failed exams or missed appointments either. Reschedule or cancel at least 24 hours before or forfeit the fee/voucher.",
  },
  {
    label: "Region",
    udemy: "Valid only in the country of purchase. Availability varies by country.",
    aws: "Priced per country and region with local-currency pricing in many markets; book wherever you are eligible to test.",
  },
  {
    label: "Support",
    udemy: "Udemy handles the voucher code; Pearson VUE handles scheduling and delivery.",
    aws: "Pearson VUE handles scheduling; Microsoft issues the certification.",
  },
  {
    label: "Best for",
    udemy: "Buying a retake safety net together with your prep course, at a small discount.",
    aws: "Direct payment, local pricing, and no expiry date hanging over you.",
  },
];

const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: "How much does a Microsoft exam cost in 2026?",
    a: "Microsoft's exam FAQ states that Associate and Expert exams typically cost US$165, priced according to currency values in specific countries and regions; prices are subject to change and taxes may apply. Fundamentals exams (AZ-900, DP-900) are typically US$99. The price shown on the Microsoft Learn exam page and at Pearson VUE checkout is the one that applies to you.",
  },
  {
    q: "How much is a Udemy Microsoft exam voucher in 2026?",
    a: "Udemy advertises “save 10%” on every Microsoft exam voucher page (verified on 4 November 2026 across az-900, dp-900, az-104, az-500, ai-102, az-800, md-102 and az-305). Udemy does not publish a fixed price table — the amount at checkout varies by country and promotion, and can be above or below the Microsoft price. Compare the live checkout price with the Microsoft price on the exam page before buying; don't assume a flat 10% off the US list price.",
  },
  {
    q: "Which Microsoft vouchers include Retake Assurance?",
    a: "Only role-based vouchers: AZ-104, AZ-500, AI-102, AZ-800 and MD-102 (Associate) and AZ-305 (Expert) show the Retake Assurance section on Udemy. The Fundamentals pages for AZ-900 and DP-900 do not offer it. Retake Assurance must be bought together with the voucher — it cannot be added later — and it covers one extra attempt.",
  },
  {
    q: "How do I schedule my Microsoft exam with a voucher?",
    a: "Log in to your Microsoft account and you will be directed to Pearson VUE to pick an appointment — online proctored or in person — up to 90 days in advance. You can have a maximum of two Microsoft exams scheduled at a time. Enter the voucher code at checkout; it is also stored in My learning → Certifications. Vouchers are only valid in the country of purchase.",
  },
  {
    q: "How long is a Microsoft voucher valid?",
    a: "At least 9 months from the date of purchase, whether bought alone or as an Exam Voucher + Retake bundle. Vouchers are non-refundable, non-transferable, and an expired voucher's value is forfeited. Reschedule or cancel at least 24 hours before your appointment or the fee/voucher is forfeited.",
  },
  {
    q: "Can one voucher cover multiple exams?",
    a: "No. Udemy's Microsoft voucher pages state the voucher is valid only for the specified exam and provider. Unlike AWS vouchers (which cover every exam at a level), a Microsoft voucher covers one exam code only — an AZ-104 voucher cannot pay for AZ-305, for example.",
  },
  {
    q: "What happens if I fail the exam?",
    a: "You must wait 24 hours after the first attempt, then 14 days between subsequent attempts, up to 5 attempts in a 12-month period from the first attempt. You cannot retake an exam you have passed until your certification expires. Each retake costs the exam fee unless you bought Retake Assurance with the voucher — and even then, Microsoft's waiting periods still apply.",
  },
  {
    q: "Is there a free way to retake a Microsoft exam?",
    a: "There is no general free retake. Your options are the Retake Assurance bundle on the Udemy role-based voucher pages (one extra attempt, non-refundable) or Microsoft Exam Replay, sold through Pearson VUE's Mindhub store — one exam plus one retake for role-based exams within 12 months, excluding Fundamentals, Office Specialist and beta exams. Students may qualify for academic pricing through Microsoft Learn.",
  },
  {
    q: "Are Microsoft certifications renewable for free?",
    a: "Yes. Eligible role-based certifications can be renewed every year at no cost by passing a short online assessment on Microsoft Learn. You pay the exam fee once; keeping the certification current does not cost extra. Fundamentals certifications do not expire.",
  },
  {
    q: "Are Udemy Microsoft exam vouchers legitimate?",
    a: "Yes. Udemy sells the voucher on udemy.com, Pearson VUE delivers and proctors the exam, and Microsoft issues the certification. The code is redeemed in the Pearson VUE checkout flow through your Microsoft account, not on Udemy. Buy only from the official voucher pages and keep your receipt.",
  },
  {
    q: "Can I use a Udemy coupon on a Microsoft voucher?",
    a: "No. Udemy coupons and promo codes never apply to exam vouchers — but Udemy credits can be applied at checkout, and coupons do apply to the prep courses below, which is usually the cheapest way to get exam-ready.",
  },
  {
    q: "Can I get a refund on a Microsoft voucher?",
    a: "No. Microsoft exam vouchers, including the Retake Assurance portion, are non-refundable and non-transferable, and forfeited if missed. If you pass on the first attempt, nothing is refunded for the retake part. Cancel or reschedule at least 24 hours before the appointment.",
  },
  {
    q: "Do students get a discount on Microsoft exams?",
    a: "Microsoft offers academic pricing — you verify your student status through your Microsoft account (verification lasts 12 months). Microsoft Office Specialist (MOS) exams are handled through Certiport. See the student discounts page on Microsoft Learn for current eligibility and terms.",
  },
  {
    q: "Which should I take first: AZ-900 or DP-900?",
    a: "Take AZ-900 if you want a broad cloud foundation, or DP-900 if your focus is data. Both are Fundamentals with no prerequisites and neither offers Retake Assurance. If you already work with Azure, skip straight to AZ-104 — it is the most common next step.",
    html: `Take AZ-900 if you want a broad cloud foundation, or DP-900 if your focus is data. Both are Fundamentals with no prerequisites and neither offers Retake Assurance. If you already work with Azure, skip straight to AZ-104 — or see our <a href="/blog/cloud-computing-courses-udemy-2026/">cloud computing courses guide</a> for a full study path.`,
  },
];

const allDeals = await getDeals();
const msRe = /(azure|microsoft|az-900|az-104|az-500|microsoft 365|intune|windows server)/i;
const starRe = /(scott duffy)/i;
const prepDeals = allDeals
  .filter((d: any) => msRe.test(`${d.title || ""} ${d.subcategory || ""} ${d.category || ""}`))
  .sort((a: any, b: any) => {
    const sa = starRe.test(`${a.instructor || ""}`) ? 0 : 1;
    const sb = starRe.test(`${b.instructor || ""}`) ? 0 : 1;
    if (sa !== sb) return sa - sb;
    return new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime();
  })
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "en-US",
      datePublished: publishedISO,
      dateModified: lastModified,
      isPartOf: { "@id": "https://courseswyn.com/#website" },
      about: { "@type": "Thing", name: "Microsoft Certification exam vouchers and discounts" },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      author: { "@type": "Person", name: "Andrew Derek", url: "https://courseswyn.com/about" },
      publisher: { "@id": "https://courseswyn.com/#organization" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://courseswyn.com/" },
        { "@type": "ListItem", position: 2, name: "Certification Vouchers", item: "https://courseswyn.com/udemy-certification-vouchers/" },
        { "@type": "ListItem", position: 3, name: "Microsoft Exam Vouchers", item: canonicalUrl },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#vouchers`,
      name: "Microsoft Exam Vouchers on Udemy",
      numberOfItems: totalAvailable,
      itemListElement: availableVouchers.map((v, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `https://www.udemy.com/certification-vouchers/${v.slug}/`,
        name: `${v.name} Exam Voucher`,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="article"
  pubDate={new Date(publishedISO)}
  updatedDate={now}
>
  <meta name="author" content="Andrew Derek" slot="head" />
  <meta
    name="keywords"
    content="udemy microsoft exam voucher, microsoft exam voucher 2026, az-900 voucher, az-104 voucher, az-305 voucher, retake assurance microsoft, pearson vue microsoft exam, microsoft certification voucher discount"
    slot="head"
  />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="cv-wrap">
    <VoucherHero
      badgeHref="/how-we-test-and-verify-udemy-coupons"
      badgeText={`Checked · ${total} Microsoft vouchers`}
      titleA="Microsoft"
      titleAccent="Exam Vouchers"
      titleB="2026"
      subHtml={`All <strong>${total} official Microsoft exam vouchers</strong> on Udemy — AZ-900, DP-900, AZ-104, AZ-500, AI-102, AZ-800, MD-102 and AZ-305. Udemy advertises <strong>save 10%</strong> on every voucher, valid ≥9 months. Retake Assurance is available on role-based vouchers — not on Fundamentals. Updated ${dateFull}.`}
      stats={[
        { val: `${total}`, label: "official vouchers" },
        { val: "10%", label: "off every exam (advertised)" },
        { val: "≥9 mo", label: "validity" },
      ]}
      primary={{ href: catalogUrl, text: "Browse Microsoft Vouchers →", external: true }}
      secondary={{ href: "#exam-fees", text: "See Exam Fees" }}
      noteHtml={`Sponsored — CoursesWyn may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a>`}
      termLines={MICROSOFT_GROUPS.flatMap((g) => g.items).slice(0, 6).map((v) => ({ href: voucherAffUrl(v.slug), code: v.code ?? v.tag, name: `${v.name} Voucher` }))}
    />
    <div class="cv-meta">
      <span>By <a href="/about">Andrew Derek</a></span>
      <span class="cv-dot">·</span>
      <span>Updated <time datetime={lastModified}>{dateFull}</time></span>
      <span class="cv-dot">·</span>
      <span>
        Checked against{" "}
        <a href="https://learn.microsoft.com/en-us/credentials/certifications/frequently-asked-questions" target="_blank" rel="noopener noreferrer">Microsoft exam FAQ</a>{" "}
        and <a href="https://www.udemy.com/all-certification-vouchers/" target="_blank" rel="noopener noreferrer">Udemy voucher listings</a>
      </span>
    </div>

    <nav class="cv-toc" aria-label="On this page">
      <span class="cv-toc-label">On this page</span>
      <a href="#quick-answer">Quick answer</a>
      <a href="#exam-fees">Exam fees</a>
      <a href="#vouchers">All vouchers</a>
      <a href="#which-voucher">Which voucher</a>
      <a href="#how-to-redeem">How to redeem</a>
      <a href="#retake-assurance">Retake Assurance</a>
      <a href="#microsoft-offers">Ways to save</a>
      <a href="#voucher-vs-direct">Udemy vs direct</a>
      <a href="#worth-it">Is it worth it?</a>
      <a href="#faq">FAQ</a>
    </nav>

    <section class="cv-block cv-answer" id="quick-answer" aria-labelledby="quick-answer-title">
      <h2 id="quick-answer-title">Microsoft exam vouchers on Udemy: the short answer</h2>
      <p>
        A Microsoft exam voucher is a prepaid code for one attempt at one specific exam. Udemy advertises{" "}
        <strong>save 10%</strong> on every Microsoft voucher page (verified 4 November 2026), sells them for the{" "}
        <strong>exact exam code</strong> — not by level like AWS — and they are valid for at least{" "}
        <strong>9 months</strong> from purchase.
      </p>
      <p>
        Prices are set per country and region and are subject to change, so compare the live checkout price with the
        price on the Microsoft Learn exam page before you buy. Udemy's price is not tied to the Microsoft list price —
        it can be lower or higher.
      </p>
      <ul class="cv-check">
        <li><strong>Want the simplest saving?</strong> Udemy advertises 10% off every Microsoft voucher — check the live price against the Microsoft price for your region.</li>
        <li><strong>Role-based exams (AZ-104 to AZ-305)?</strong> You can bundle Retake Assurance with the voucher for one extra attempt — it cannot be added later.</li>
        <li><strong>Fundamentals (AZ-900, DP-900)?</strong> No Retake Assurance on those pages — buy expecting only the discount.</li>
        <li><strong>Already certified?</strong> Renewals are free — the annual assessment costs nothing.</li>
      </ul>
    </section>

    <section class="cv-block" id="exam-fees" aria-labelledby="fees-title">
      <h2 id="fees-title">How much does a Microsoft exam cost in 2026?</h2>
      <p>
        Microsoft prices exams by level, not per exam code, and sets prices per country and region. Microsoft's exam
        FAQ states that Associate and Expert exams typically cost <strong>US$165</strong>; Fundamentals exams are
        typically <strong>US$99</strong>. Prices are subject to change and taxes may apply — the price on the Microsoft
        Learn exam page and at Pearson VUE checkout is the current one.
      </p>
      <div class="cv-table-wrap">
        <table class="cv-table">
          <caption>Microsoft certification exam levels — US typical pricing (USD)</caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Exams at this level</th>
              <th scope="col">Microsoft US typical price</th>
              <th scope="col">Udemy voucher</th>
            </tr>
          </thead>
          <tbody>
            {examLevels.map((row) => (
              <tr>
                <th scope="row">{row.level}</th>
                <td>{row.exams}</td>
                <td><strong>{row.fee}</strong></td>
                <td>{row.coverage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cv-note">
        *Fundamentals pricing per Microsoft exam FAQ guidance — confirm on the AZ-900 or DP-900 exam page, since Microsoft
        does not publish a single global USD table and prices vary by country/region. Udemy advertises “save 10%” on the
        voucher page; that discount applies to Udemy's own price, not necessarily to the Microsoft list price. Checked
        against <a href="https://learn.microsoft.com/en-us/credentials/certifications/frequently-asked-questions" target="_blank" rel="noopener noreferrer">Microsoft's exam FAQ</a> on 4 November 2026.
      </p>
      <p>
        What you actually pay on Udemy varies by region and promotion. We do not quote assumed checkout prices here —
        open the voucher page, note the price, and compare it with the Microsoft price for your country before paying.
      </p>
    </section>

    <section class="cv-block" id="vouchers" aria-labelledby="vouchers-title">
      <h2 id="vouchers-title">Compare all {total} Microsoft exam vouchers on Udemy</h2>
      <p>
        Udemy lists {total} Microsoft voucher products. Each is valid for <strong>one specific exam code</strong> and
        the advertised discount on every page we checked (4 November 2026) is <strong>save 10%</strong>. Retake
        Assurance is offered on the role-based pages (Associate and Expert) — never on Fundamentals.
      </p>
      <VoucherGrid groups={MICROSOFT_GROUPS} />
      <p class="cv-note">
        Prices, stock and promotions change, and Udemy's catalog may show a different offer than the checkout. Confirm
        the live price, the expiry date and the exam code on the product page before paying.
      </p>
    </section>

    <section class="cv-block" id="which-voucher" aria-labelledby="which-title">
      <h2 id="which-title">Which Microsoft exam voucher do you need?</h2>
      <p>
        Choose the voucher that matches the exact exam you plan to sit — Microsoft vouchers are exam-specific, and
        buying the wrong one is an expensive, non-refundable mistake.
      </p>
      <div class="cv-pick-grid">
        {voucherPicks.map((pick) => (
          <article class="cv-pick">
            <span class="cv-pick-tag">{pick.best}</span>
            <h3>{pick.level}</h3>
            <p>{pick.body}</p>
          </article>
        ))}
      </div>
      <p class="cv-note">
        Still deciding? Start with our <a href="/blog/cloud-computing-courses-udemy-2026/">cloud computing courses guide</a> or
        browse <a href="/topics/microsoft-azure/">Microsoft Azure courses</a> before you buy.
      </p>
    </section>

    <section class="cv-block" id="how-to-redeem" aria-labelledby="redeem-title">
      <h2 id="redeem-title">How to buy and redeem a Microsoft exam voucher</h2>
      <p>
        Buying the voucher and booking the exam are two separate steps. Udemy sells the code; Microsoft and Pearson VUE
        run the exam. Follow this order so you don't lose time or buy the wrong code.
      </p>
      <ol class="cv-steps">
        <li><strong>Pick the exact exam.</strong> Each voucher is valid only for its own exam code — confirm the code on the voucher page matches the exam you intend to sit.</li>
        <li><strong>Choose voucher-only or Exam Voucher + Retake (role-based only).</strong> Retake Assurance cannot be added after checkout.</li>
        <li><strong>Pay on Udemy.</strong> A card or Udemy credits work. Udemy coupons do not apply to vouchers.</li>
        <li><strong>Get your code from My learning → Certifications.</strong> Udemy also emails it, but your account is the source of truth.</li>
        <li><strong>Sign in to your Microsoft account.</strong> You'll be directed to Pearson VUE to schedule — up to 90 days in advance; a maximum of two Microsoft exams can be scheduled at a time.</li>
        <li><strong>Pick online proctored or a test centre, then paste the voucher code at checkout.</strong> Valid only in the country where you bought it.</li>
        <li><strong>Reschedule or cancel at least 24 hours before the appointment.</strong> Miss that window and the fee or voucher is forfeited — it cannot be extended.</li>
      </ol>
      <div class="cv-callout">
        <strong>Before you pay, check:</strong> the exam code, the expiry date (at least 9 months), Retake Assurance if
        you want it, your country's eligibility, and that the name on your Microsoft account matches your ID. An
        organization (work/school) account's exam records are lost if you leave the organization — register with a
        personal Microsoft account.
      </div>
      <p class="cv-cta-line">
        <a class="cv-btn" href={catalogUrl} target="_blank" rel="sponsored noopener noreferrer">Browse Microsoft Vouchers →</a>
      </p>
    </section>

    <section class="cv-block cv-warn" id="retake-assurance" aria-labelledby="retake-title">
      <h2 id="retake-title">Retake Assurance: only for role-based vouchers</h2>
      <p>
        Retake Assurance is an add-on sold by Udemy with Microsoft exam vouchers: your first attempt plus{" "}
        <strong>one extra attempt at the same exam if you fail</strong>. It is not a Microsoft programme, and it is not
        available on every page.
      </p>
      <ul class="cv-check">
        <li><strong>Where it exists:</strong> the Associate and Expert voucher pages we checked (AZ-104, AZ-500, AI-102, AZ-800, MD-102, AZ-305) show a Retake Assurance section.</li>
        <li><strong>Where it doesn't:</strong> the Fundamentals pages (AZ-900, DP-900) do not offer it — don't expect it there.</li>
        <li><strong>How to buy it:</strong> select Exam Voucher + Retake with the voucher itself. It cannot be added after purchase, and it covers one extra attempt only.</li>
        <li><strong>The catch:</strong> non-refundable and non-transferable — including if you pass first try. You acknowledge Microsoft Certification exam policies when you buy.</li>
        <li><strong>Waiting periods still apply:</strong> 24 hours after your first fail, then 14 days between later attempts (max 5 in 12 months). Retake Assurance does not waive these.</li>
      </ul>
      <p class="cv-note">
        Sources: Udemy voucher pages checked 4 November 2026,{" "}
        <a href="https://learn.microsoft.com/en-us/credentials/support/retake-policy" target="_blank" rel="noopener noreferrer">Microsoft exam retake policy</a>,{" "}
        <a href="https://learn.microsoft.com/en-us/credentials/certifications/certification-exam-policies" target="_blank" rel="noopener noreferrer">Microsoft certification exam policies</a>.
      </p>
    </section>

    <section class="cv-block" id="microsoft-offers" aria-labelledby="offers-title">
      <h2 id="offers-title">Ways to lower the cost that aren't Udemy coupons</h2>
      <ul class="cv-check">
        <li><strong>Udemy's advertised 10%:</strong> applied automatically at the voucher page price — no code needed. Check it against the Microsoft price for your region.</li>
        <li><strong>Retake Assurance (role-based only):</strong> bundles one retake with the voucher. Compare the bundle price against paying for two attempts separately.</li>
        <li><strong>Microsoft Exam Replay:</strong> sold through Pearson VUE's Mindhub store — one exam plus one retake within 12 months, for role-based exams only (not Fundamentals, MOS or beta exams).</li>
        <li><strong>Student / academic pricing:</strong> verify your student status in your Microsoft account (lasts 12 months) for discounted exam prices; MOS exams go through Certiport.</li>
        <li><strong>Free renewal:</strong> eligible role-based certifications renew every year at no cost with a short online assessment — you never pay to keep them current.</li>
      </ul>
