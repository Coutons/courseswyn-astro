---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import LedgerRow from "../../components/LedgerRow.astro";
import { readDeals } from "../../lib/store";
import { toISODateWIB } from "../../lib/date";
import { slugifyCategory } from "../../lib/utils";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allDeals = await readDeals();
  return paginate(allDeals, { pageSize: 36 });
}

const { page } = Astro.props as { page: any };
const allDeals = await readDeals();
const now = new Date();

const currentItems = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const startIndex = page.start;

const activeDeals = allDeals.filter((d: any) => !d.expiresAt || new Date(d.expiresAt) > now);
const totalActive = activeDeals.length;

const todayStr = toISODateWIB(now);
const todayAdded = allDeals.filter((d: any) => {
  const raw = d.updatedAt || d.createdAt || '';
  if (!raw) return false;
  return toISODateWIB(new Date(raw)) === todayStr;
}).length;

const decodeHtml = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

const topicCounts: Record<string, number> = {};
for (const d of allDeals) {
  const sub = d.subcategory ? decodeHtml(d.subcategory) : '';
  if (sub) {
    topicCounts[sub] = (topicCounts[sub] || 0) + 1;
  }
}
const totalTopics = Object.keys(topicCounts).length;

const selectedLanguage = Astro.url.searchParams.get('language');

const siteUrl = "https://courseswyn.com";
const baseDealsUrl = `${siteUrl}/udemy-coupon-code`;
const langQuery = selectedLanguage ? `?language=${encodeURIComponent(selectedLanguage)}` : "";
const currentUrl = currentPage === 1 ? `${baseDealsUrl}${langQuery}` : `${baseDealsUrl}/${currentPage}${langQuery}`;
const prevUrl = page.url.prev ? `${page.url.prev}${langQuery}` : null;
const nextUrl = page.url.next ? `${page.url.next}${langQuery}` : null;

const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const discountPcts = allDeals
  .filter((d: any) => d.price && d.originalPrice && d.originalPrice > d.price)
  .map((d: any) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;

const pageTitle = currentPage === 1
  ? `All Verified Udemy Coupon Codes - Live Catalog (${maxDiscountPct}% Off) ${currentMonth} ${currentYear} | CoursesWyn`
  : `All Verified Udemy Coupon Codes - Live Catalog (${maxDiscountPct}% Off) ${currentMonth} ${currentYear} - Page ${currentPage} of ${totalPages} | CoursesWyn`;

const pageDescription = currentPage === 1
  ? `Get premium Udemy courses for less. ${totalActive} verified coupon codes & ${todayAdded} added today - save up to ${maxDiscountPct}% on top courses. Updated daily.`
  : `Page ${currentPage} of ${totalPages}: ${currentItems.length} more verified Udemy coupon codes - save up to ${maxDiscountPct}% on premium courses. Updated daily.`;

const pageKeywords = [
  "udemy coupon code", "udemy coupon codes", "free udemy coupon", "udemy discount",
  "udemy free course", "udemy promo code", "udemy deals", "udemy sale",
  "coupon code", "udemy courses", "verified udemy coupons"
].join(", ");

const currentDeals = currentItems.filter((d: any) => d.price > 0 || d.price == null);

const featuredDeals = activeDeals
  .filter((d: any) => d.rating && d.rating >= 4.5)
  .sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0))
  .slice(0, 6);

const catCounts = allDeals.reduce<Record<string, number>>((acc, d: any) => {
  const c = (d.category || "Other").trim();
  if (c) acc[c] = (acc[c] || 0) + 1;
  return acc;
}, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const subcatsByCat = allDeals.reduce<Record<string, Set<string>>>((acc, d: any) => {
  const c = (d.category || "Other").trim();
  const s = (d.subcategory || "").trim();
  if (c && s) { (acc[c] = acc[c] || new Set()).add(s); }
  return acc;
}, {});



const faqs = [
  { q: "Are these Udemy coupon codes legitimate and safe?", a: "Yes! All Udemy coupons listed on CoursesWyn are 100% legitimate. We source codes directly from Udemy's official affiliate program and verified course instructors. Each coupon is manually tested by our team before listing." },
  { q: "How do I use a Udemy coupon code?", a: "Browse our deals page and find a course you want, click the deal card, and you'll be redirected to Udemy with the coupon pre-applied. Verify the discounted price at checkout and click 'Enroll Now'." },
  { q: "How often are new Udemy coupons added?", a: "We update our database every single day with fresh Udemy coupon codes. Bookmark this page and check back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes! When you enroll in a Udemy course using our coupons, you receive the same certificate as students who paid full price — lifetime access included." },
  { q: "Why do some Udemy coupons say 'This coupon has expired'?", a: "Udemy coupons have two expiration triggers: time limit (usually 3-7 days) OR redemption limit (typically 1,000 students). Once either limit is hit, the coupon stops working. Return to CoursesWyn — we refresh our listings multiple times daily." },
  { q: "Is there a catch? Why do instructors offer coupons?", a: "No catch! Instructors offer coupons for strategic marketing: building student numbers, generating reviews for new courses, and boosting algorithm rankings. You get premium education at a discount — a win-win." },
];

const jsonLd: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "All Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "datePublished": currentDate.toISOString().split('T')[0],
      "dateModified": currentDate.toISOString().split('T')[0],
      "inLanguage": "en-US",
      "mainEntity": { "@id": `${currentUrl}#itemlist` },
    },
    {
      "@type": "ItemList",
      "@id": `${currentUrl}#itemlist`,
      "name": `Verified Udemy Coupons — ${currentMonth} ${currentYear}`,
      "numberOfItems": totalActive,
      "itemListElement": currentItems.slice(0, 20).map((d: any, i: number) => ({
        "@type": "ListItem",
        "position": startIndex + i + 1,
        "url": `${siteUrl}/coupon/${d.slug}`,
        "item": {
          "@type": "Course",
          "name": d.title,
          "url": `${siteUrl}/coupon/${d.slug}`,
          "image": d.image,
          "provider": { "@type": "Organization", "name": "Udemy", "url": "https://www.udemy.com" },
          "offers": {
            "@type": "Offer",
            "price": String(d.price ?? "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
          },
        },
      })),
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    }] : []),
  ],
};

const pageItems: ({ type: 'page'; value: number } | { type: 'ellipsis'; id: string })[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - windowSize && p <= currentPage + windowSize;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
  hideBreadcrumbs={true}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {currentPage > 1 && <>
      <meta name="robots" content="noindex, follow" />
      <meta name="googlebot" content="noindex, follow" />
      <meta name="bingbot" content="noindex, follow" />
    </>}
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span> {totalActive.toLocaleString()} coupons verified live right now</span>
            <span class="cc-folio">Page {currentPage} / {totalPages}</span>
          </div>
          <h1 class="cc-title">All Verified <span class="cc-accent">Udemy Coupon Codes</span>{currentPage > 1 && <span class="cc-page-label">Page {currentPage}</span>}</h1>
          <p class="cc-subtitle">Every code below is checked against Udemy before listing — save up to <strong>{maxDiscountPct}%</strong> on programming, design, business and more. New deals added daily.</p>
          <div class="cc-toolbar">
            <form action="/search" method="GET" role="search" aria-label="Search courses" class="cc-hero-search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="search" name="q" placeholder="Search for discounted Udemy courses..." autocomplete="off" aria-label="Search courses" />
              <kbd>? + K</kbd>
            </form>
            <a class="cc-hero-btn" href="#latest">Browse All Coupons</a>
            <a class="cc-hero-btn ghost" href="/categories">Browse by Category</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Verified coupons</div><div class="cc-ledger-value">{totalActive.toLocaleString()}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Added today</div><div class="cc-ledger-value">{todayAdded}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Topics</div><div class="cc-ledger-value">{totalTopics}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Save up to</div><div class="cc-ledger-value">{maxDiscountPct}%</div></div>
          </div>
        </div>
      </header>

      {currentPage === 1 && (
      <section class="cc-featured" aria-label="Featured Udemy coupons">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Highest rated this week <span class="cc-tag">Verified coupons</span></h2>
          <p class="cc-sec-desc">Top-rated courses with verified coupon codes — refreshed automatically as new deals appear.</p>
        </div>
        <div class="cc-ledger-wrap">
          <table class="cc-ledger-table">
            <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
            <tbody>
              {featuredDeals.map((deal: any) => <LedgerRow deal={deal} />)}
            </tbody>
          </table>
        </div>
      </section>
      )}

      <section class="cc-deals-section" id="latest">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Live coupon feed <span class="cc-tag">Streaming from the verification database</span></h2>
          <p class="cc-sec-desc">{currentItems.length} coupons on this page — every code checked against Udemy before listing</p>
        </div>
        <div class="cc-ledger-wrap">
          <table class="cc-ledger-table">
            <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
            <tbody>
              {currentDeals.map((deal: any) => <LedgerRow deal={deal} />)}
            </tbody>
          </table>
          <div class="cc-deal-more"><span class="cc-deal-count">{currentItems.length} coupons on this page — verified before listing</span><a href="/udemy-coupons-today">See today's new coupons →</a></div>
        </div>

          {totalPages > 1 && (
            <nav class="cc-pagination" aria-label="Pagination">
              {prevUrl ? (
                <a href={prevUrl} class="cc-page-link cc-page-prev">← Prev</a>
              ) : (
                <span class="cc-page-link cc-page-disabled">← Prev</span>
              )}
              <div class="cc-page-numbers">
                {pageItems.map((item: any) => {
                  if (item.type === 'ellipsis') {
                    return <span class="cc-page-ellipsis">...</span>;
                  }
                  const isActive = item.value === currentPage;
                  const href = item.value === 1 ? `/udemy-coupon-code${langQuery}` : `/udemy-coupon-code/${item.value}${langQuery}`;
                  return isActive
                    ? <span class="cc-page-num cc-page-active">{item.value}</span>
                    : <a href={href} class="cc-page-num">{item.value}</a>;
                })}
              </div>
              {nextUrl ? (
                <a href={nextUrl} class="cc-page-link cc-page-next">Next →</a>
              ) : (
                <span class="cc-page-link cc-page-disabled">Next →</span>
              )}
            </nav>
          )}
        </section>

        <section class="cc-seo-section">
            <h2 class="cc-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              How CoursesWyn verifies Udemy coupons
            </h2>
            <p>Since <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's coupon policy update</a>, most coupons are limited to about 10 to 100 redemptions or expire within days. CoursesWyn checks every coupon against Udemy in near real time. When a coupon runs out, it disappears from this list automatically.</p>
            <p>New coupons are added throughout the day. Browse <a href="/udemy-coupons-today">today's latest deals</a> or explore <a href="/udemy-coupon-code">all verified coupons</a>.</p>
          </section>

          {currentPage === 1 && (
          <section class="cc-category" aria-label="Browse Udemy coupon codes by category">
            <div class="cc-deals-header">
              <h2 class="cc-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Popular Categories
                <span class="cc-tag">{sortedCats.length} categories</span>
              </h2>
              <p class="cc-deals-desc">Find verified coupon codes in your field — from AI and coding to design and cloud computing.</p>
            </div>
            <nav class="cc-cat-grid" aria-label="Course categories">
              {sortedCats.slice(0, 12).map(([cat, count]) => {
                const slug = slugifyCategory(cat);
                const subCount = (subcatsByCat[cat] || new Set()).size;
                return (
                  <a href={`/categories/${slug}`} class="cc-cat" title={`Browse ${cat} courses with Udemy coupons`}>
                    <div class="cc-cat-num">{count}</div>
                    <div class="cc-cat-label">{cat}</div>
                    <div class="cc-cat-count">{subCount} Subcategor{subCount === 1 ? "y" : "ies"}</div>
                  </a>
                );
              })}
            </nav>
          </section>
          )}

          {currentPage === 1 && (
          <section class="cc-section cc-faq">
            <h2 class="cc-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Frequently asked questions
            </h2>
            <div class="cc-faq-grid">
              {faqs.map((faq: any) => (
                <div class="cc-faq-card">
                  <h6 class="cc-faq-q">{faq.q}</h6>
                  <p class="cc-faq-a">{faq.a}</p>
                </div>
              ))}
            </div>
          </section>
          )}

          <section class="cc-cta">
            <p class="cc-cta-eyebrow">Catalog complete</p>
            <p class="cc-cta-text">Every coupon on this page was checked against Udemy before listing. Check back tomorrow — fresh verified codes are added daily.</p>
            <a class="cc-hero-btn" href="/udemy-coupons-today">See today's new coupons →</a>
          </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(18, 32, 58, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #1F7A4D; background: #E4F1E9; border: 1px solid rgba(31, 122, 77, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #1F7A4D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; color: #5B564C; border: 1px dashed #B9B29B; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: #12203A; line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #C13B2E; }
  .cc-page-label { display: inline-flex; align-items: center; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #1F7A4D; background: #E4F1E9; border: 1px solid rgba(31, 122, 77, 0.25); border-radius: 999px; padding: 4px 10px; margin-left: 0.6rem; vertical-align: middle; }
  .cc-subtitle { color: #5B564C; font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: #12203A; font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-search { display: flex; align-items: center; gap: 10px; flex: 1 1 300px; max-width: 460px; min-width: 240px; background: #fff; border: 1px solid #D8D0BC; border-radius: 10px; padding: 0 14px; height: 48px; box-shadow: 0 8px 24px -18px rgba(18, 32, 58, 0.4); transition: border-color 0.2s, box-shadow 0.2s; }
  .cc-hero-search:focus-within { border-color: #1F7A4D; box-shadow: 0 8px 28px -14px rgba(31, 122, 77, 0.4); }
  .cc-hero-search svg { color: #5B564C; flex-shrink: 0; }
  .cc-hero-search input { flex: 1; border: none; outline: none; background: transparent; color: #12203A; font-size: 0.93rem; padding: 0; min-width: 0; }
  .cc-hero-search kbd { font-size: 0.7rem; color: #5B564C; background: transparent; border: 1px solid #D8D0BC; border-radius: 5px; padding: 2px 7px; white-space: nowrap; }
  .cc-hero-btn { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #12203A; color: #fff; box-shadow: 0 10px 24px rgba(18, 32, 58, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #1B2E52; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: #1B2E52; border: 1px solid #1B2E52; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #1B2E52; color: #fff; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #B9B29B; padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #D8D0BC; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: #5B564C; margin-bottom: 4px; }
  .cc-ledger-value { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-weight: 700; font-size: 22px; color: #12203A; }

  /* ===== SECTION HEADS ===== */
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: #12203A; margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; font-weight: 500; color: #5B564C; border: 1px solid #D8D0BC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: #6E6A5E; margin: 0; }

  /* ===== LEDGER TABLE (matches homepage deal table) ===== */
  .cc-featured { margin-top: 3.25rem; }
  .cc-deals-section { margin-top: 3.25rem; }
