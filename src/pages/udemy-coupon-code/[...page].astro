---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import CouponGrid from "../../components/CouponGrid.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import { readDeals } from "../../lib/store";
import { toISODateWIB } from "../../lib/date";
import { slugifyCategory } from "../../lib/utils";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allDeals = await readDeals();
  // 48 kartu/halaman: cakupan kata kunci per halaman lebih tebal & lebih banyak CTA
  // dalam satu layar (DesiDime ~85). Gambar kartu di bawah fold sudah loading="lazy".
  return paginate(allDeals, { pageSize: 48 });
}

const { page } = Astro.props as { page: any };
const allDeals = await readDeals();
const now = new Date();

const currentItems = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const startIndex = page.start;

const activeDeals = allDeals.filter((d: any) => !d.expiresAt || new Date(d.expiresAt) > now);
const totalActive = activeDeals.length;

const todayStr = toISODateWIB(now);
const todayAdded = allDeals.filter((d: any) => {
  const raw = d.updatedAt || d.createdAt || '';
  if (!raw) return false;
  return toISODateWIB(new Date(raw)) === todayStr;
}).length;

const selectedLanguage = Astro.url.searchParams.get('language');

const siteUrl = "https://courseswyn.com";
const baseDealsUrl = `${siteUrl}/udemy-coupon-code`;
const langQuery = selectedLanguage ? `?language=${encodeURIComponent(selectedLanguage)}` : "";
const currentUrl = currentPage === 1 ? `${baseDealsUrl}${langQuery}` : `${baseDealsUrl}/${currentPage}${langQuery}`;
const prevUrl = page.url.prev ? `${page.url.prev}${langQuery}` : null;
const nextUrl = page.url.next ? `${page.url.next}${langQuery}` : null;

const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const lastChecked = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Jakarta', month: 'long', day: 'numeric', year: 'numeric' }).format(now);

// Counts: hero/SEO claims use live (non-expired) deals only — never the full
// catalog with expired entries. This page lists paid discounts; 100% off
// (free) coupons live on /udemy-coupons-today.
const totalCoupons = allDeals.length;
const paidActiveDeals = activeDeals.filter((d: any) => typeof d.price === "number" && d.price > 0);
const freeActiveCount = activeDeals.filter((d: any) => d.price === 0).length;
const catsSet = new Set<string>();
allDeals.forEach((d: any) => { if (d.category) catsSet.add((d.category as string).trim()); });
const categories = Array.from(catsSet).sort();

const feedTime = (raw?: string) => {
  const t = raw ? new Date(raw) : now;
  const mins = Math.floor((now.getTime() - t.getTime()) / 60000);
  if (mins < 1) return 'now';
  if (mins < 60) return `${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h`;
  return `${Math.floor(hrs / 24)}d`;
};
const chFeedLines = [...activeDeals]
  .sort((a, b) => new Date((b as any).updatedAt || (b as any).createdAt || 0).getTime() - new Date((a as any).updatedAt || (a as any).createdAt || 0).getTime())
  .slice(0, 7)
  .map((d: any) => ({
    time: feedTime(d.updatedAt || d.createdAt),
    cat: String(d.category || 'Udemy').split(' ')[0].slice(0, 8) || 'Udemy',
    title: String(d.title || '').length > 42 ? `${String(d.title).slice(0, 42)}…` : String(d.title || ''),
    save: d.originalPrice && d.price ? `−${Math.round(100 - (d.price / d.originalPrice) * 100)}%` : 'DEAL',
  }));

// "Up to X%" is the max over currently available paid deals — not an
// outlier from expired entries, not a typical saving.
const discountPcts = paidActiveDeals
  .filter((d: any) => d.originalPrice && d.originalPrice > d.price)
  .map((d: any) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 90;

/* ==================== EDITORIAL DATA (angka nyata dari katalog hidup) ====================
   Semua klaim di seksi panduan di bawah dihitung dari activeDeals pada build,
   bukan angka hard-coded — begitu katalog berubah, teks ikut berubah. */
const AI_RE = /\b(ai|artificial intelligence|machine learning|deep learning|generative|genai|chatgpt|gpt|llm|claude|gemini|prompt engineering|agentic|neural|data science|computer vision|nlp)\b/i;
const aiDeals = activeDeals.filter((d: any) => AI_RE.test(`${d.title || ""} ${d.subcategory || ""} ${d.category || ""}`));
const aiCount = aiDeals.length;

const ratedDeals = activeDeals.filter((d: any) => typeof d.rating === "number" && d.rating >= 4.5);
const totalStudents = activeDeals.reduce((a: number, d: any) => a + (typeof d.students === "number" ? d.students : 0), 0);
const underTenCount = paidActiveDeals.filter((d: any) => d.price <= 9.99).length;

const byStudents = (a: any, b: any) => (b.students || 0) - (a.students || 0);
const topStudentsDeals = [...paidActiveDeals].sort(byStudents).slice(0, 6);
const topRatedDeals = [...ratedDeals].sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0) || byStudents(a, b)).slice(0, 6);
const topAiDeals = [...aiDeals].sort(byStudents).slice(0, 6);
const expiringDeals = [...paidActiveDeals]
  .filter((d: any) => d.expiresAt && new Date(d.expiresAt) > now)
  .sort((a: any, b: any) => new Date(a.expiresAt).getTime() - new Date(b.expiresAt).getTime())
  .slice(0, 6);

const pctOff = (d: any) =>
  d.originalPrice && d.originalPrice > d.price && d.price > 0 ? Math.round(100 - (d.price / d.originalPrice) * 100) : 0;

const fmtExp = (iso?: string) => {
  if (!iso) return "—";
  const t = new Date(iso);
  if (isNaN(t.getTime())) return "—";
  return t.toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "Asia/Jakarta" });
};

// Baris tabel "live coupons per kategori" — hitung ulang dari activeDeals.
const catAgg = new Map<string, { name: string; count: number; maxPct: number }>();
for (const d of activeDeals) {
  const name = String(d.category || "").trim();
  if (!name) continue;
  const e = catAgg.get(name) ?? { name, count: 0, maxPct: 0 };
  e.count++;
  e.maxPct = Math.max(e.maxPct, pctOff(d));
  catAgg.set(name, e);
}
const catRows = [...catAgg.values()].sort((a, b) => b.count - a.count).slice(0, 8);

const pageTitle = currentPage === 1
  ? `Udemy Coupon Code (${currentMonth} ${currentYear}): 100% Off Free Courses | CoursesWyn`
  : `Udemy Coupon Codes — Page ${currentPage} of ${totalPages} | CoursesWyn`;

const pageDescription = currentPage === 1
  ? `Udemy coupon code for ${currentMonth} ${currentYear}: ${totalActive.toLocaleString()} verified promo codes, including 100% off free courses. Open a deal to reveal its code — most apply automatically on Udemy. Up to ${maxDiscountPct}% off, checked ${lastChecked}.`
  : `Page ${currentPage} of ${totalPages} — more verified Udemy coupon codes & course discounts for ${currentMonth} ${currentYear}, up to ${maxDiscountPct}% off. Checked ${lastChecked}.`;

const pageKeywords = [
  "udemy coupon code", "udemy coupon codes", "udemy coupons discounts", "udemy promo code",
  "udemy discount", "udemy instructor coupon", "udemy sale",
  "verified udemy coupons", "udemy courses discount", "free udemy coupon",
  "udemy 100% off coupon", "free udemy courses", "udemy free courses coupon",
  "udemy coupon code today", "udemy coupon code 2026"
].join(", ");

const currentDeals = currentItems.filter((d: any) => d.price > 0 || d.price == null);

const faqs = [
  { q: "Where is the actual coupon code — do I need to type it?", a: "Each card below is a discounted course with its own instructor coupon. Click any deal to open its page and reveal the code. Most codes apply automatically when you continue to Udemy through our link — no typing needed. If a course needs a manual code, the deal page shows it with copy and paste instructions." },
  { q: "Are these Udemy coupon codes legitimate and safe?", a: "Yes! All Udemy coupons listed on CoursesWyn are 100% legitimate. We source codes directly from Udemy's official affiliate program and verified course instructors. Each coupon is manually tested by our team before listing." },
  { q: "How do I use a Udemy coupon code?", a: "Browse our deals page and find a course you want, click the deal card, and you'll be redirected to Udemy with the coupon pre-applied. Verify the discounted price at checkout and click 'Enroll Now'." },
  { q: "How often are new Udemy coupons added?", a: "We update our database every single day with fresh Udemy coupon codes. Bookmark this page and check back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes! When you enroll in a Udemy course using our coupons, you receive the same certificate as students who paid full price — lifetime access included." },
  { q: "Why do some Udemy coupons say 'This coupon has expired'?", a: "Udemy coupons have two expiration triggers: time limit (usually 3-7 days) OR redemption limit (typically 1,000 students). Once either limit is hit, the coupon stops working. Return to CoursesWyn — we refresh our listings multiple times daily." },
  { q: "Is there a catch? Why do instructors offer coupons?", a: "No catch! Instructors offer coupons for strategic marketing: building student numbers, generating reviews for new courses, and boosting algorithm rankings. You get premium education at a discount — a win-win." },
  { q: "Can I use a Udemy coupon code on the Udemy mobile app?", a: "No. Udemy coupon codes can only be applied in a desktop or mobile browser at udemy.com checkout. The Udemy mobile app does not accept coupon codes — open the course page in your browser and log in there instead." },
  { q: "Can I get a refund on a Udemy course if I used a coupon?", a: "Yes. Udemy's 30-day money-back guarantee applies even when you enroll with a coupon code. Request the refund from your Purchase History within 30 days — it returns to your original payment method." },
  { q: "How much can I actually save with Udemy coupons?", a: "Most course coupons bring the price down to $9.99–$19.99 from a retail price of $49.99–$199.99 — savings of up to 95%. Many 100% off coupons are also available, though they sell out fast." },
  { q: "What's the difference between a sitewide Udemy coupon and an instructor coupon code?", a: "Sitewide Udemy coupons auto-apply at checkout during sales, while instructor coupon codes are created by individual teachers for their own courses and entered by hand or opened through a referral link. Instructor codes carry tighter expiry dates and redemption caps — which is why every deal on this page shows a last-checked stamp." },
  { q: "Should I wait for a Udemy sale or use a coupon code now?", a: "Use a coupon code now if one fits — instructor codes often beat sale prices with deeper, course-specific cuts. Udemy's sitewide sales run every few weeks with automatic discounts up to 90% off, so if no code fits your course, add it to your wishlist and you'll get an email the moment it goes on sale." },
  { q: "Can I stack two Udemy discount codes on one purchase?", a: "No. Udemy applies only one discount per purchase — either a coupon code or the automatic sale price, whichever is lower. If a sale already gives you 85% off, entering a weaker code won't add more savings." },
  { q: "Why is my Udemy coupon code not working at checkout?", a: "Usually one of four causes: the code expired or hit its redemption cap, it only applies to specific courses, hidden spaces got pasted with the code, or Udemy's automatic sale price is already lower (Udemy then shows the lower price — that's not a bug). Try incognito mode, and check the last-checked stamp on the deal." },
  { q: "Is there a special Udemy coupon code for new users?", a: "There is no standing 'new user code', but new accounts do get a welcome discount that usually lands courses between $9.99 and $14.99 for the first 24–48 hours, plus a 7-day trial of the Personal Plan. After that window prices reset. The instructor coupons on this page work for new and existing accounts alike, so you don't need to register fresh to claim one." },
  { q: "Does Udemy still offer $10 courses?", a: `The flat $10 coupon is largely gone. Udemy moved to variable floor pricing by country and topic, so the equivalent saving now comes from instructor coupons in the $9.99–$14.99 band — ${underTenCount} of our live coupons sit at $9.99 or below. Sitewide sales such as New Year, Black Friday and Udemy's birthday sale are the other reliable route to that price.` },
  { q: "Can I get Udemy courses completely free?", a: "Yes — a 100% OFF instructor coupon drops a course to $0.00. These are strictly capped: a free open coupon lasts 5 days for up to 10 students, so they disappear within hours. Free coupons aren't listed in the paid grid on this page; they live on our today's deals page where they surface the moment an instructor mints them." },
  { q: "Do Udemy coupons work differently in different countries?", a: "Coupon codes themselves work worldwide, but the price you see is localized. Udemy displays regional pricing, so a $9.99 coupon may show as an equivalent local-currency amount at checkout. The discount percentage stays the same; only the currency figure changes. Always confirm the final total in your own currency before enrolling." },
  { q: "Can I use a Udemy coupon on a course already on sale?", a: "You can try, but Udemy applies only one discount and keeps whichever is lower. If the automatic sale price already beats your coupon, the code is ignored and the sale price stands. This is the most common reason a valid code appears to 'do nothing' — the saving was already applied before you typed anything." },
  { q: "What is Udemy Business and can I get it discounted?", a: "Udemy Business is the team subscription — a curated catalog of 12,000+ courses billed per user per month, aimed at companies rather than individuals. It is not covered by instructor coupons. Some public libraries in the US, UK and Canada do offer free access to a Udemy course selection through a library card, which is the legitimate free route." },
  { q: "How often are new Udemy coupons added to this page?", a: "Daily. Our pipeline re-checks every listing against Udemy each day, pulls codes that have expired or hit their cap, and adds fresh instructor coupons as instructors mint them. The count on this page moves accordingly — it is not a figure that only ever climbs." },
  { q: "Are Udemy certificates still issued when I use a coupon?", a: "Yes, without exception. A course enrolled at a coupon price is the identical product: same videos, same downloadable resources, same instructor Q&A, same certificate of completion, and lifetime access on individually purchased courses. Udemy does not mark or limit coupon enrollments in any way." },
  { q: "Do Udemy coupons work on the mobile app?", a: "No. The Udemy iOS and Android apps have no coupon field — Apple and Google take a cut of in-app purchases, so Udemy disabled manual codes there. Open the course in a mobile or desktop browser, sign in, and the coupon applies normally. The course then shows up in the app too." },
  { q: "What happens after I redeem a coupon — can I get a refund?", a: "Yes. Udemy's 30-day money-back guarantee applies to coupon purchases on eligible courses. Request it from your Purchase History within 30 days and it returns to your original payment method. Courses bought through app-store payments follow Apple's and Google's refund rules instead of Udemy's." },
  { q: "Why did the same course cost more last week?", a: "Because instructor coupons are capped and time-boxed. A teacher mints a code to drive a launch push, it runs at $9.99–$12.99 until the redemption cap fills or the clock runs out, then the course returns to full price. Popular courses can swing from $89 to $12 and back within a single week — which is why the deals here carry a last-checked stamp." },
];

const jsonLd: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "All Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "datePublished": currentDate.toISOString().split('T')[0],
      "dateModified": currentDate.toISOString().split('T')[0],
      "inLanguage": "en-US",
      "mainEntity": { "@id": `${currentUrl}#itemlist` },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".ch-sub"] },
      "author": { "@type": "Person", "name": "Andrew Derek", "url": siteUrl },
    },
    {
      "@type": "ItemList",
      "@id": `${currentUrl}#itemlist`,
      "name": `Verified Udemy Coupons — ${currentMonth} ${currentYear}`,
      "numberOfItems": totalActive,
      "itemListElement": currentItems.slice(0, 20).map((d: any, i: number) => ({
        "@type": "ListItem",
        "position": startIndex + i + 1,
        "url": `${siteUrl}/coupon/${d.slug}`,
        "item": {
          "@type": "Course",
          "name": d.title,
          "url": `${siteUrl}/coupon/${d.slug}`,
          "image": d.image,
          "provider": { "@type": "Organization", "name": "Udemy", "url": "https://www.udemy.com" },
          "offers": {
            "@type": "Offer",
            "price": String(d.price ?? "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
          },
        },
      })),
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
    {
      "@type": "HowTo",
      "@id": `${baseDealsUrl}#howto`,
      "name": "How to Redeem a Udemy Coupon Code",
      "description": "Four simple steps to redeem a Udemy coupon code and unlock your discount.",
      "totalTime": "PT5M",
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Choose your course", "text": "Browse the deals on this page and pick a course you want. Check the rating, review count, and curriculum before you enroll." },
        { "@type": "HowToStep", "position": 2, "name": "Click the deal card", "text": "Click the course card to open its deal page on CoursesWyn, then click the coupon or 'Get deal' button to jump to Udemy with the code pre-applied." },
        { "@type": "HowToStep", "position": 3, "name": "Verify the discounted price", "text": "On Udemy, check that the coupon discount is reflected in the final price before you pay. For codes entered by hand, paste the code into the coupon field and click Apply." },
        { "@type": "HowToStep", "position": 4, "name": "Enroll now", "text": "Click 'Enroll Now' to confirm your enrollment. Your course, certificate, and lifetime access are added immediately." },
      ],
    }] : []),
  ],
};

const pageItems: ({ type: 'page'; value: number } | { type: 'ellipsis'; id: string })[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - windowSize && p <= currentPage + windowSize;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
  hideBreadcrumbs={false}
  robots={currentPage > 1 ? "noindex, follow" : undefined}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Andrew Derek" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <div class="container">

      {currentPage === 1 ? (
        <section class="ch-hero">
          <div class="container">
            <div class="dh-hero-grid">
              <div class="ch-copy">
                <p class="ch-eyebrow"><span class="ch-blink" aria-hidden="true"></span> Checked {lastChecked} · {todayAdded.toLocaleString()} new today</p>
                <h1>Udemy <span>Coupon Code</span> — {currentMonth} {currentYear}: 100% Off <span>Free Courses</span> &amp; Promo Deals</h1>
                <p class="ch-sub">{totalActive.toLocaleString()} verified instructor coupons & promo codes across {categories.length} categories — open any deal and the Udemy discount applies automatically, no typing needed. Save up to <strong>{maxDiscountPct}%</strong> on top-rated online courses.</p>
                <form action="/search" method="GET" role="search" aria-label="Search coupon codes" class="ch-search">
                  <input type="search" name="q" placeholder={"Search " + totalActive.toLocaleString() + " Udemy coupons & discounts..."} autocomplete="off" aria-label="Search coupon codes" />
                  <button type="submit">Search</button>
                </form>
                <p class="ch-note">How codes work here: <strong>open a deal → reveal the code → continue to Udemy</strong> with the discount pre-applied. Manual codes include copy-paste instructions. Looking for 100% off? <a href="/udemy-coupons-today">See today's deals{freeActiveCount > 0 ? ` (${freeActiveCount} free)` : ""}</a>.</p>
                <div class="ch-stats">
                  <div class="ch-stat"><div class="ch-stat-num"><span data-count={totalActive}>0</span>+</div><div class="ch-stat-lab">verified deals live</div></div>
                  <div class="ch-stat"><div class="ch-stat-num"><span data-count={categories.length}>0</span></div><div class="ch-stat-lab">categories · A to Z</div></div>
                  <div class="ch-stat"><div class="ch-stat-num"><span data-count={todayAdded}>0</span>+</div><div class="ch-stat-lab">added today</div></div>
                </div>
                <p class="ch-byline">Compiled &amp; checked by <a href="/about">Andrew Derek</a> · Offers last checked {lastChecked} · <a href="/how-we-test-and-verify-udemy-coupons">How we verify</a></p>
              </div>

              <aside class="ch-term" aria-label="Live coupon feed">
                <div class="cc-term-head">
                  <span class="cc-term-dot" style="background:#ff5f57"></span>
                  <span class="cc-term-dot" style="background:#febc2e"></span>
                  <span class="cc-term-dot" style="background:#28c840"></span>
                  <span class="cc-term-title">courseswyn · live feed</span>
                  <span class="cc-term-live"><span class="lg-blip"></span> live</span>
                </div>
                <div class="cc-term-body">
                  {chFeedLines.length > 0 ? chFeedLines.map(l => (
                    <div class="cc-term-line">
                      <span class="cc-term-time">{l.time}</span>
                      <span class="cc-term-ok">✓</span>
                      <span class="cc-term-cat">{l.cat}</span>
                      <span class="cc-term-title2">{l.title}</span>
                      <span class="cc-term-save">{l.save}</span>
                    </div>
                  )) : <div class="cc-term-line"><span class="cc-term-ok">✓</span><span class="cc-term-title2">Scanning Udemy for new coupons…</span></div>}
                </div>
                <div class="cc-term-foot">last check <b>{lastChecked}</b> · {totalActive.toLocaleString()} codes live</div>
              </aside>
            </div>
          </div>
        </section>
      ) : (
        <div style={{ background: "var(--card)", borderBottom: "1px solid var(--border)", padding: "1.5rem 0", textAlign: "center" }}>
          <div class="container">
            <h1 style={{ fontSize: "1.5rem", fontWeight: 700, color: "var(--text)", margin: "0 0 0.25rem" }}>
              Udemy Coupon Codes & Discounts — Page {currentPage}
            </h1>
            <p style={{ color: "var(--muted)", margin: 0, fontSize: "0.9rem" }}>
              Showing {startIndex + 1}–{Math.min(startIndex + currentItems.length, totalCoupons)} of {totalCoupons.toLocaleString()} verified coupons
            </p>
          </div>
        </div>
      )}

      <section style={{ background: "var(--card)", borderTop: "1px solid var(--border)", padding: "3rem 1.5rem 2rem", textAlign: "center" }}>
        <div class="container" style={{ maxWidth: "1280px" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(169, 199, 255,0.07)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            Browse by Topic
          </div>
          <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.35rem" }}>Udemy Coupons by Category</h2>
          <p style={{ fontSize: "0.85rem", color: "var(--muted)", margin: "0 auto 1rem", maxWidth: "550px", lineHeight: 1.6 }}>
            Jump straight to Udemy deals & promo codes in {categories.length} fields — coding, AI, design, business, marketing and more. Pick a category to filter discounted courses.
          </p>
          <div style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem", justifyContent: "center" }}>
