---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import CouponGrid from "../../components/CouponGrid.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import { readDeals } from "../../lib/store";
import { toISODateWIB } from "../../lib/date";
import { slugifyCategory } from "../../lib/utils";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allDeals = await readDeals();
  return paginate(allDeals, { pageSize: 36 });
}

const { page } = Astro.props as { page: any };
const allDeals = await readDeals();
const now = new Date();

const currentItems = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const startIndex = page.start;

const activeDeals = allDeals.filter((d: any) => !d.expiresAt || new Date(d.expiresAt) > now);
const totalActive = activeDeals.length;

const todayStr = toISODateWIB(now);
const todayAdded = allDeals.filter((d: any) => {
  const raw = d.updatedAt || d.createdAt || '';
  if (!raw) return false;
  return toISODateWIB(new Date(raw)) === todayStr;
}).length;

const selectedLanguage = Astro.url.searchParams.get('language');

const siteUrl = "https://courseswyn.com";
const baseDealsUrl = `${siteUrl}/udemy-coupon-code`;
const langQuery = selectedLanguage ? `?language=${encodeURIComponent(selectedLanguage)}` : "";
const currentUrl = currentPage === 1 ? `${baseDealsUrl}${langQuery}` : `${baseDealsUrl}/${currentPage}${langQuery}`;
const prevUrl = page.url.prev ? `${page.url.prev}${langQuery}` : null;
const nextUrl = page.url.next ? `${page.url.next}${langQuery}` : null;

const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const lastChecked = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Jakarta', month: 'long', day: 'numeric', year: 'numeric' }).format(now);

// Totals use the full catalog (expired included) — listings show checkable deals
const totalCoupons = allDeals.length;
const catsSet = new Set<string>();
allDeals.forEach((d: any) => { if (d.category) catsSet.add((d.category as string).trim()); });
const categories = Array.from(catsSet).sort();

const discountPcts = allDeals
  .filter((d: any) => d.price && d.originalPrice && d.originalPrice > d.price)
  .map((d: any) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;

const pageTitle = currentPage === 1
  ? `Udemy Coupon Codes — Verified Discounts Up to ${maxDiscountPct}% Off | CoursesWyn`
  : `Udemy Coupon Codes — Page ${currentPage} of ${totalPages} | CoursesWyn`;

const pageDescription = currentPage === 1
  ? `Browse ${totalCoupons.toLocaleString()} verified Udemy coupon codes, promo codes & discounts for ${currentMonth} ${currentYear} — save up to ${maxDiscountPct}%. New codes checked daily.`
  : `Page ${currentPage} of ${totalPages} — more verified Udemy coupon codes, promo codes & discounts, savings up to ${maxDiscountPct}%. Checked daily.`;

const pageKeywords = [
  "udemy coupon code", "udemy coupon codes", "free udemy coupon", "udemy discount",
  "udemy free course", "udemy promo code", "udemy deals", "udemy sale",
  "coupon code", "udemy courses", "verified udemy coupons"
].join(", ");

const currentDeals = currentItems.filter((d: any) => d.price > 0 || d.price == null);

const faqs = [
  { q: "Are these Udemy coupon codes legitimate and safe?", a: "Yes! All Udemy coupons listed on CoursesWyn are 100% legitimate. We source codes directly from Udemy's official affiliate program and verified course instructors. Each coupon is manually tested by our team before listing." },
  { q: "How do I use a Udemy coupon code?", a: "Browse our deals page and find a course you want, click the deal card, and you'll be redirected to Udemy with the coupon pre-applied. Verify the discounted price at checkout and click 'Enroll Now'." },
  { q: "How often are new Udemy coupons added?", a: "We update our database every single day with fresh Udemy coupon codes. Bookmark this page and check back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes! When you enroll in a Udemy course using our coupons, you receive the same certificate as students who paid full price — lifetime access included." },
  { q: "Why do some Udemy coupons say 'This coupon has expired'?", a: "Udemy coupons have two expiration triggers: time limit (usually 3-7 days) OR redemption limit (typically 1,000 students). Once either limit is hit, the coupon stops working. Return to CoursesWyn — we refresh our listings multiple times daily." },
  { q: "Is there a catch? Why do instructors offer coupons?", a: "No catch! Instructors offer coupons for strategic marketing: building student numbers, generating reviews for new courses, and boosting algorithm rankings. You get premium education at a discount — a win-win." },
  { q: "Can I use a Udemy coupon code on the Udemy mobile app?", a: "No. Udemy coupon codes can only be applied in a desktop or mobile browser at udemy.com checkout. The Udemy mobile app does not accept coupon codes — open the course page in your browser and log in there instead." },
  { q: "Can I get a refund on a Udemy course if I used a coupon?", a: "Yes. Udemy's 30-day money-back guarantee applies even when you enroll with a coupon code. Request the refund from your Purchase History within 30 days — it returns to your original payment method." },
  { q: "How much can I actually save with Udemy coupons?", a: "Most course coupons bring the price down to $9.99–$19.99 from a retail price of $49.99–$199.99 — savings of up to 95%. Many 100% off coupons are also available, though they sell out fast." },
  { q: "What's the difference between a sitewide Udemy coupon and an instructor coupon code?", a: "Sitewide Udemy coupons auto-apply at checkout during sales, while instructor coupon codes are created by individual teachers for their own courses and entered by hand or opened through a referral link. Instructor codes carry tighter expiry dates and redemption caps — which is why every deal on this page shows a last-checked stamp." },
  { q: "Should I wait for a Udemy sale or use a coupon code now?", a: "Use a coupon code now if one fits — instructor codes often beat sale prices with deeper, course-specific cuts. Udemy's sitewide sales run every few weeks with automatic discounts up to 90% off, so if no code fits your course, add it to your wishlist and you'll get an email the moment it goes on sale." },
  { q: "Can I stack two Udemy discount codes on one purchase?", a: "No. Udemy applies only one discount per purchase — either a coupon code or the automatic sale price, whichever is lower. If a sale already gives you 85% off, entering a weaker code won't add more savings." },
  { q: "Why is my Udemy coupon code not working at checkout?", a: "Usually one of four causes: the code expired or hit its redemption cap, it only applies to specific courses, hidden spaces got pasted with the code, or Udemy's automatic sale price is already lower (Udemy then shows the lower price — that's not a bug). Try incognito mode, and check the last-checked stamp on the deal." },
];

const jsonLd: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "All Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "datePublished": currentDate.toISOString().split('T')[0],
      "dateModified": currentDate.toISOString().split('T')[0],
      "inLanguage": "en-US",
      "mainEntity": { "@id": `${currentUrl}#itemlist` },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".ch-sub"] },
      "author": { "@type": "Person", "name": "Andrew Derek", "url": siteUrl },
    },
    {
      "@type": "ItemList",
      "@id": `${currentUrl}#itemlist`,
      "name": `Verified Udemy Coupons — ${currentMonth} ${currentYear}`,
      "numberOfItems": totalActive,
      "itemListElement": currentItems.slice(0, 20).map((d: any, i: number) => ({
        "@type": "ListItem",
        "position": startIndex + i + 1,
        "url": `${siteUrl}/coupon/${d.slug}`,
        "item": {
          "@type": "Course",
          "name": d.title,
          "url": `${siteUrl}/coupon/${d.slug}`,
          "image": d.image,
          "provider": { "@type": "Organization", "name": "Udemy", "url": "https://www.udemy.com" },
          "offers": {
            "@type": "Offer",
            "price": String(d.price ?? "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
          },
        },
      })),
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
    {
      "@type": "HowTo",
      "@id": `${baseDealsUrl}#howto`,
      "name": "How to Redeem a Udemy Coupon Code",
      "description": "Four simple steps to redeem a Udemy coupon code and unlock your discount.",
      "totalTime": "PT5M",
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Choose your course", "text": "Browse the deals on this page and pick a course you want. Check the rating, review count, and curriculum before you enroll." },
        { "@type": "HowToStep", "position": 2, "name": "Click the deal card", "text": "Click the course card to open its deal page on CoursesWyn, then click the coupon or 'Get deal' button to jump to Udemy with the code pre-applied." },
        { "@type": "HowToStep", "position": 3, "name": "Verify the discounted price", "text": "On Udemy, check that the coupon discount is reflected in the final price before you pay. For codes entered by hand, paste the code into the coupon field and click Apply." },
        { "@type": "HowToStep", "position": 4, "name": "Enroll now", "text": "Click 'Enroll Now' to confirm your enrollment. Your course, certificate, and lifetime access are added immediately." },
      ],
    }] : []),
  ],
};

const pageItems: ({ type: 'page'; value: number } | { type: 'ellipsis'; id: string })[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - windowSize && p <= currentPage + windowSize;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
  hideBreadcrumbs={false}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {currentPage > 1 && <>
      <meta name="robots" content="noindex, follow" />
      <meta name="googlebot" content="noindex, follow" />
      <meta name="bingbot" content="noindex, follow" />
    </>}
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Andrew Derek" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
    <div class="container">

      {currentPage === 1 ? (
        <section class="ch-hero">
          <div class="container">
            <p class="ch-eyebrow"><span class="ch-blink" aria-hidden="true"></span> Verified {lastChecked} · {todayAdded.toLocaleString()} new today</p>
            <h1>Udemy Coupon Codes <span>— Up to {maxDiscountPct}% Off, Verified Daily</span></h1>
            <p class="ch-sub">The complete verified catalog — every Udemy coupon code, promo code and discount in one paginated directory across {categories.length} categories. Fresh codes added daily. Save up to <strong>{maxDiscountPct}%</strong>.</p>
            <form action="/search" method="GET" role="search" aria-label="Search coupon codes" class="ch-search">
              <input type="search" name="q" placeholder={"Search " + totalCoupons.toLocaleString() + " Udemy coupon codes..."} autocomplete="off" aria-label="Search coupon codes" />
              <button type="submit">Search</button>
            </form>
            <div class="ch-stats">
              <div class="ch-stat"><div class="ch-stat-num"><span data-count={totalCoupons}>0</span>+</div><div class="ch-stat-lab">coupons listed</div></div>
              <div class="ch-stat"><div class="ch-stat-num"><span data-count={categories.length}>0</span></div><div class="ch-stat-lab">categories · A to Z</div></div>
              <div class="ch-stat"><div class="ch-stat-num"><span data-count={todayAdded}>0</span>+</div><div class="ch-stat-lab">added today</div></div>
            </div>
            <p class="ch-byline">Compiled &amp; checked by <a href="/about">Andrew Derek</a> · Offers last checked {lastChecked} · <a href="/how-we-test-and-verify-udemy-coupons">How we verify</a></p>
          </div>
        </section>
      ) : (
        <div style={{ background: "var(--card)", borderBottom: "1px solid var(--border)", padding: "1.5rem 0", textAlign: "center" }}>
          <div class="container">
            <h1 style={{ fontSize: "1.5rem", fontWeight: 700, color: "var(--text)", margin: "0 0 0.25rem" }}>
              Udemy Coupon Codes & Discounts — Page {currentPage}
            </h1>
            <p style={{ color: "var(--muted)", margin: 0, fontSize: "0.9rem" }}>
              Showing {startIndex + 1}–{Math.min(startIndex + currentItems.length, totalCoupons)} of {totalCoupons.toLocaleString()} verified coupons
            </p>
          </div>
        </div>
      )}

      <section style={{ background: "var(--card)", borderTop: "1px solid var(--border)", padding: "3rem 1.5rem 2rem", textAlign: "center" }}>
        <div class="container" style={{ maxWidth: "1280px" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(37, 99, 235,0.07)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>
            Browse by Topic
          </div>
          <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.35rem" }}>Udemy Coupon Categories</h2>
          <p style={{ fontSize: "0.85rem", color: "var(--muted)", margin: "0 auto 1rem", maxWidth: "550px", lineHeight: 1.6 }}>
            Jump straight to coupons in {categories.length} fields — from coding and AI to design, business and more.
          </p>
          <div style={{ display: "flex", flexWrap: "wrap", gap: "0.4rem", justifyContent: "center" }}>
            <a href="/udemy-coupon-code" style={{ fontSize: "0.78rem", fontWeight: 600, color: "#fff", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--brand)", background: "var(--brand)" }}>All</a>
            {categories.slice(0, 15).map((cat: string) => (
              <a href={`/categories/${slugifyCategory(cat)}`} style={{ fontSize: "0.78rem", fontWeight: 600, color: "var(--muted)", textDecoration: "none", padding: "3px 10px", borderRadius: "100px", border: "1px solid var(--border)", background: "var(--bg)" }}>{cat}</a>
            ))}
          </div>
        </div>
      </section>

      <section id="latest" style={{ padding: "3rem 1.5rem 4rem", maxWidth: "1280px", margin: "0 auto" }}>
        <div style={{ textAlign: "center", marginBottom: "1.5rem" }}>
          <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(37, 99, 235,0.07)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>Fresh Coupons</div>
            <h2 style={{ fontSize: "1.6rem", fontWeight: 800, color: "var(--text)", margin: "0 0 0.3rem" }}>
              Verified Coupons on This Page{currentPage > 1 ? ` — Page ${currentPage}` : ""}
            </h2>
          <p style={{ fontSize: "0.9rem", color: "var(--muted)", maxWidth: "650px", margin: "0 auto", lineHeight: 1.6 }}>
            {currentDeals.length} verified Udemy coupons below ({currentMonth} {currentYear} catalog) with savings up to {maxDiscountPct}% — programming, AI, business, design and more.
          </p>
        </div>
        {selectedLanguage && (
          <div style={{ marginBottom: "1rem", textAlign: "center" }}>
            <a href="/udemy-coupon-code" style={{ display: "inline-flex", alignItems: "center", gap: "0.4rem", padding: "0.3rem 0.75rem", background: "var(--card)", border: "1px solid var(--border)", borderRadius: "6px", color: "var(--muted)", textDecoration: "none", fontSize: "0.8rem", fontWeight: 600 }}>✕ Clear Filter</a>
          </div>
        )}
        <div style={{ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: "1.25rem" }} class="deals-grid">
          {currentDeals.map((deal: any, idx: number) => <CouponGrid deal={deal} eager={idx < 6} priority={idx < 3} />)}
        </div>
        <p style={{ textAlign: "center", fontSize: "0.8rem", color: "var(--muted)", marginTop: "1rem" }}>{currentDeals.length} coupons on this page — each one checked before listing.</p>

        {totalPages > 1 && (
          <nav aria-label="Pagination" style={{ display: "flex", alignItems: "center", justifyContent: "center", gap: "0.75rem", padding: "1.5rem 0", marginTop: "1.5rem", borderTop: "1px solid var(--border)" }}>
            {prevUrl ? (
              <a href={prevUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>← Prev</a>
            ) : (
              <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--muted)", opacity: 0.4, padding: "0.4rem 0.85rem" }}>← Prev</span>
            )}
            <div style={{ display: "flex", alignItems: "center", gap: "4px" }}>
              {pageItems.map((item: any) => {
                if (item.type === 'ellipsis') {
                  return <span style={{ fontSize: "0.85rem", color: "var(--muted)", width: "34px", textAlign: "center" }}>...</span>;
                }
                const isActive = item.value === currentPage;
                const href = item.value === 1 ? `/udemy-coupon-code${langQuery}` : `/udemy-coupon-code/${item.value}${langQuery}`;
                return isActive
                  ? <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "#fff", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--brand)", background: "var(--brand)" }}>{item.value}</span>
                  : <a href={href} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--text)", textDecoration: "none", width: "34px", height: "34px", display: "flex", alignItems: "center", justifyContent: "center", borderRadius: "6px", border: "1px solid var(--border)" }}>{item.value}</a>;
              })}
            </div>
            {nextUrl ? (
              <a href={nextUrl} style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--brand)", textDecoration: "none", padding: "0.4rem 0.85rem", borderRadius: "6px", border: "1px solid var(--border)" }}>Next →</a>
            ) : (
              <span style={{ fontSize: "0.85rem", fontWeight: 700, color: "var(--muted)", opacity: 0.4, padding: "0.4rem 0.85rem" }}>Next →</span>
            )}
          </nav>
        )}
      </section>

      {currentPage === 1 && (
      <section class="ch-about" aria-label="About Udemy coupon codes">
        <div class="container" style={{ maxWidth: "1280px" }}>
          <p class="ch-about-badge">Coupon Guide</p>
          <h2 class="ch-about-title">Udemy Coupon Codes, <span>Explained</span></h2>
          <p class="ch-about-sub">The short course on scoring verified Udemy discounts without the trial and error.</p>
          <div class="ch-about-grid">
            {[
              ["Where do these coupons come from?", "Instructors mint coupon codes inside Udemy to fill launches and seasonal pushes. Each carries an expiry date and a redemption cap — which is why one course can swing from $89 to $12 and back within a week."],
              ["How do I claim one?", "Open any card above to reach its coupon page, then follow the claim link — Udemy opens with the discount pre-applied at checkout. Hit Enroll and the course, certificate and lifetime access land in your library."],
              ["Why trust this directory?", "Every entry carries its receipts: live discount math, learner rating, instructor history and a last-checked stamp. Dead codes are pruned instead of left to rot."],
              ["What do I actually get?", "The identical seat full-price learners get: same videos, same downloads, same instructor Q&A, same completion certificate. The discount changes the receipt — nothing else."],
            ].map(([title, text]) => (
              <article class="ch-about-card">
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
      )}

      {currentPage === 1 && (
      <div class="cc-guide" aria-label="Udemy coupon guide">

        <section class="cc-guide-block" id="how-to-redeem">
          <h2 class="cc-section-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg>
            How to Redeem a Udemy Coupon Code
            <span class="cc-tag">Step-by-step</span>
          </h2>
          <p class="cc-guide-desc">Most coupons on this page apply automatically — click a deal and you're taken to Udemy with the discount pre-applied. For codes you enter by hand, follow these four steps:</p>
          <ol class="cc-steps">
            <li class="cc-step">
              <span class="cc-step-num">1</span>
              <div>
                <h3 class="cc-step-title">Choose your course</h3>
                <p class="cc-step-text">Browse the deals above and pick a course you want. Check the rating, review count, and curriculum before you enroll.</p>
              </div>
            </li>
            <li class="cc-step">
              <span class="cc-step-num">2</span>
              <div>
                <h3 class="cc-step-title">Open the deal page</h3>
                <p class="cc-step-text">Click the course card to open its deal page on CoursesWyn, then click the coupon or "Get deal" button. You'll be redirected to Udemy with the code already applied.</p>
              </div>
            </li>
            <li class="cc-step">
              <span class="cc-step-num">3</span>
              <div>
                <h3 class="cc-step-title">Verify the discounted price</h3>
                <p class="cc-step-text">On Udemy, confirm the coupon discount is reflected in the final price. For manual codes, paste the code into the coupon field at checkout and click Apply — Udemy shows the new total instantly.</p>
              </div>
            </li>
            <li class="cc-step">
              <span class="cc-step-num">4</span>
              <div>
                <h3 class="cc-step-title">Enroll now</h3>
                <p class="cc-step-text">Click "Enroll Now" to confirm. Your course, certificate of completion, and lifetime access are added immediately. Coupons can't be applied in the Udemy mobile app, so redeem in a browser.</p>
              </div>
            </li>
          </ol>
          <p class="cc-guide-note">Full walkthrough with screenshots: <a href="/how-to-redeem-coupon">How to Redeem a Udemy Coupon</a></p>
        </section>

      </div>
      )}

      {currentPage === 1 && (
        <section aria-label="Udemy coupon code FAQs" style={{ background: "var(--bg)", padding: "4rem 1.5rem", maxWidth: "1280px", margin: "0 auto" }}>
          <div style={{ textAlign: "center", marginBottom: "2.5rem" }}>
            <div style={{ display: "inline-flex", alignItems: "center", gap: "0.5rem", background: "rgba(37, 99, 235,0.07)", padding: "0.35rem 0.85rem", borderRadius: "20px", marginBottom: "0.75rem", fontSize: "0.75rem", fontWeight: 700, color: "var(--brand)", textTransform: "uppercase", letterSpacing: "0.06em" }}>Got Questions?</div>
