---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import DealCard from "../../components/DealCard.astro";
import { Image } from "astro:assets";
import { readDeals } from "../../lib/store";
import { toISODateWIB } from "../../lib/date";
import { slugifyCategory } from "../../lib/utils";
import { CATEGORY_ICONS } from "../../lib/categories";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allDeals = await readDeals();
  return paginate(allDeals, { pageSize: 36 });
}

const { page } = Astro.props as { page: any };
const allDeals = await readDeals();
const now = new Date();

const currentItems = page.data;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const startIndex = page.start;
const endIndex = page.end + 1;

const activeDeals = allDeals.filter((d: any) => !d.expiresAt || new Date(d.expiresAt) > now);
const totalCoupons = allDeals.length;
const totalActive = activeDeals.length;

const todayStr = toISODateWIB(now);
const todayAdded = allDeals.filter((d: any) => {
  const dt = d.updatedAt || d.createdAt || '';
  return dt.startsWith(todayStr);
}).length;

const decodeHtml = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

const topicCounts: Record<string, number> = {};
for (const d of allDeals) {
  const sub = d.subcategory ? decodeHtml(d.subcategory) : '';
  if (sub) {
    topicCounts[sub] = (topicCounts[sub] || 0) + 1;
  }
}
const totalTopics = Object.keys(topicCounts).length;

let totalSavings = 0;
for (const d of allDeals) {
  if (d.originalPrice && d.price != null && d.originalPrice > 0) {
    totalSavings += (d.originalPrice - d.price);
  }
}
const savingsFormatted = Math.round(totalSavings).toLocaleString();

const selectedLanguage = Astro.url.searchParams.get('language');

const siteUrl = "https://courseswyn.com";
const baseDealsUrl = `${siteUrl}/udemy-coupon-code`;
const langQuery = selectedLanguage ? `?language=${encodeURIComponent(selectedLanguage)}` : "";
const currentUrl = currentPage === 1 ? `${baseDealsUrl}${langQuery}` : `${baseDealsUrl}/${currentPage}${langQuery}`;
const prevUrl = page.url.prev ? `${page.url.prev}${langQuery}` : null;
const nextUrl = page.url.next ? `${page.url.next}${langQuery}` : null;

const currentDate = new Date();
const monthNames = ["January","February","March","April","May","June",
  "July","August","September","October","November","December"];
const currentMonth = monthNames[currentDate.getMonth()];
const currentYear = currentDate.getFullYear();

const discountPcts = allDeals
  .filter((d: any) => d.price && d.originalPrice && d.originalPrice > d.price)
  .map((d: any) => Math.round(100 - (d.price / d.originalPrice) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;

const pageTitle = currentPage === 1
  ? `Verified Udemy Coupon Codes - Get Premium Courses for Less (${maxDiscountPct}% Off) ${currentMonth} ${currentYear} | CoursesWyn`
  : `Verified Udemy Coupon Codes - Get Premium Courses for Less (${maxDiscountPct}% Off) ${currentMonth} ${currentYear} - Page ${currentPage} of ${totalPages} | CoursesWyn`;

const pageDescription = `Get premium Udemy courses for less. ${totalActive} verified coupon codes & ${todayAdded} added today — save up to ${maxDiscountPct}% on top courses. Updated daily.`;

const currentDeals = currentItems.filter((d: any) => d.price > 0 || d.price == null);

const featuredDeals = activeDeals
  .filter((d: any) => d.rating && d.rating >= 4.5)
  .sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0))
  .slice(0, 6);

const catCounts = allDeals.reduce<Record<string, number>>((acc, d: any) => {
  const c = (d.category || "Other").trim();
  if (c) acc[c] = (acc[c] || 0) + 1;
  return acc;
}, {});
const sortedCats = Object.entries(catCounts).sort((a, b) => b[1] - a[1]);
const subcatsByCat = allDeals.reduce<Record<string, Set<string>>>((acc, d: any) => {
  const c = (d.category || "Other").trim();
  const s = (d.subcategory || "").trim();
  if (c && s) { (acc[c] = acc[c] || new Set()).add(s); }
  return acc;
}, {});



const faqs = [
  { q: "Are these Udemy coupon codes legitimate and safe?", a: "Yes! All Udemy coupons listed on CoursesWyn are 100% legitimate. We source codes directly from Udemy's official affiliate program and verified course instructors. Each coupon is manually tested by our team before listing." },
  { q: "How do I use a Udemy coupon code?", a: "Browse our deals page and find a course you want, click the deal card, and you'll be redirected to Udemy with the coupon pre-applied. Verify the discounted price at checkout and click 'Enroll Now'." },
  { q: "How often are new Udemy coupons added?", a: "We update our database every single day with fresh Udemy coupon codes. Bookmark this page and check back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes! When you enroll in a Udemy course using our coupons, you receive the same certificate as students who paid full price — lifetime access included." },
  { q: "Why do some Udemy coupons say 'This coupon has expired'?", a: "Udemy coupons have two expiration triggers: time limit (usually 3-7 days) OR redemption limit (typically 1,000 students). Once either limit is hit, the coupon stops working. Return to CoursesWyn — we refresh our listings multiple times daily." },
  { q: "Is there a catch? Why do instructors offer coupons?", a: "No catch! Instructors offer coupons for strategic marketing: building student numbers, generating reviews for new courses, and boosting algorithm rankings. You get premium education at a discount — a win-win." },
];

const jsonLd: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "All Coupons", "item": baseDealsUrl },
        ...(currentPage > 1 ? [{ "@type": "ListItem", "position": 3, "name": `Page ${currentPage}`, "item": currentUrl }] : [])
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": currentUrl,
      "url": currentUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": siteUrl },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "dateModified": currentDate.toISOString().split('T')[0],
      "inLanguage": "en-US",
      "mainEntity": {
        "@type": "ItemList",
        "name": `Verified Udemy Coupons — ${currentMonth} ${currentYear}`,
        "numberOfItems": allDeals.length,
        "itemListElement": currentItems.slice(0, 20).map((d: any, i: number) => ({
          "@type": "ListItem",
          "position": startIndex + i + 1,
          "item": {
            "@type": "Course",
            "name": d.title,
            "url": `${siteUrl}/coupon/${d.slug}`,
            "image": d.image,
            "provider": { "@type": "Organization", "name": "Udemy", "url": "https://www.udemy.com" },
            "offers": {
              "@type": "Offer",
              "price": String(d.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock",
            },
          },
        })),
      },
    },
    ...(currentPage === 1 ? [{
      "@type": "FAQPage",
      "@id": `${baseDealsUrl}#faq`,
      "mainEntity": faqs.map((f: any) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    }] : []),
  ],
};

const pageItems: ({ type: 'page'; value: number } | { type: 'ellipsis'; id: string })[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= totalPages; p++) {
  const inWindow = p >= currentPage - windowSize && p <= currentPage + windowSize;
  if (p === 1 || p === totalPages || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={currentUrl}
  hideBreadcrumbs={true}
>
  <Fragment slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {currentPage > 1 && <meta name="robots" content="noindex, follow" />}
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <h1 class="cc-title">
          <span>Verified Udemy Coupon Codes</span>
          {currentPage > 1 && <span class="cc-page-label">Page {currentPage}</span>}
        </h1>
        <h2 class="cc-hero-claim">Get Premium Courses for Less Today!</h2>
        <p class="cc-subtitle">Discover thousands of premium Udemy courses for less with verified coupon codes — save up to <strong>{maxDiscountPct}%</strong> on programming, design, business and more. New deals added daily, every code checked against Udemy before we list it.</p>
        <form action="/search" method="GET" role="search" aria-label="Search courses" class="cc-hero-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="search" name="q" placeholder="Search for discounted Udemy courses..." autocomplete="off" aria-label="Search courses" />
          <kbd>? + K</kbd>
        </form>
        <div class="cc-hero-btns">
          <a class="cc-hero-btn contained" href="#latest">Browse All Coupons</a>
          <a class="cc-hero-btn outlined" href="/categories">Browse by Category</a>
        </div>
        <div class="cc-stats-bar">
          <div class="cc-stat">
            <span class="cc-stat-value">{todayAdded}</span>
            <span class="cc-stat-label">Coupons added today</span>
          </div>
          <div class="cc-stat-divider"></div>
          <div class="cc-stat">
            <span class="cc-stat-value">{totalCoupons}</span>
            <span class="cc-stat-label">Total coupons</span>
          </div>
          <div class="cc-stat-divider"></div>
          <div class="cc-stat">
            <span class="cc-stat-value">{totalTopics}</span>
            <span class="cc-stat-label">Topics</span>
          </div>
          <div class="cc-stat-divider"></div>
          <div class="cc-stat">
            <span class="cc-stat-value">${savingsFormatted}</span>
            <span class="cc-stat-label">Total savings</span>
          </div>
        </div>
      </header>

      {currentPage === 1 && (
      <section class="cc-featured" aria-label="Featured Udemy coupons">
        <div class="cc-deals-header">
          <h2 class="cc-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            Featured Udemy Coupons
          </h2>
          <p class="cc-deals-desc">Handpicked top-rated courses with verified coupon codes — regularly updated with fresh deals.</p>
        </div>
        <div class="cc-deals-grid">
          {featuredDeals.map((deal: any) => (
            <DealCard deal={deal} loading="lazy" />
          ))}
        </div>
      </section>
      )}

      <section class="cc-deals-section" id="latest">
        <div class="cc-deals-header">
          <h2 class="cc-section-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Latest Udemy Coupons
          </h2>
          <p class="cc-deals-desc">{currentItems.length} coupons on this page — fresh deals added daily</p>
        </div>
        <div class="cc-deals-grid">
          {currentDeals.map((deal: any, i: number) => (
            <DealCard deal={deal} loading={i < 3 ? 'eager' : 'lazy'} />
          ))}
        </div>

          {totalPages > 1 && (
            <nav class="cc-pagination" aria-label="Pagination">
              {prevUrl ? (
                <a href={prevUrl} class="cc-page-link cc-page-prev">← Prev</a>
              ) : (
                <span class="cc-page-link cc-page-disabled">← Prev</span>
              )}
              <div class="cc-page-numbers">
                {pageItems.map((item: any) => {
                  if (item.type === 'ellipsis') {
                    return <span class="cc-page-ellipsis">...</span>;
                  }
                  const isActive = item.value === currentPage;
                  const href = item.value === 1 ? `/udemy-coupon-code${langQuery}` : `/udemy-coupon-code/${item.value}${langQuery}`;
                  return isActive
                    ? <span class="cc-page-num cc-page-active">{item.value}</span>
                    : <a href={href} class="cc-page-num">{item.value}</a>;
                })}
              </div>
              {nextUrl ? (
                <a href={nextUrl} class="cc-page-link cc-page-next">Next →</a>
              ) : (
                <span class="cc-page-link cc-page-disabled">Next →</span>
              )}
            </nav>
          )}
        </section>

        <section class="cc-seo-section">
            <h2 class="cc-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              How CoursesWyn verifies Udemy coupons
            </h2>
            <p>Since <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's coupon policy update</a>, most coupons are limited to about 10 to 100 redemptions or expire within days. CoursesWyn checks every coupon against Udemy in near real time. When a coupon runs out, it disappears from this list automatically.</p>
            <p>New coupons are added throughout the day. Browse <a href="/udemy-coupons-today">today's latest deals</a> or explore <a href="/udemy-coupon-code">all verified coupons</a>.</p>
          </section>

          {currentPage === 1 && (
          <section class="cc-category" aria-label="Browse Udemy coupon codes by category">
            <div class="cc-deals-header">
              <h2 class="cc-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Popular Categories
              </h2>
              <p class="cc-deals-desc">Find verified coupon codes in your field — from AI and coding to design and cloud computing.</p>
            </div>
            <nav class="cc-cat-grid" aria-label="Course categories">
              {sortedCats.slice(0, 12).map(([cat]) => {
                const slug = slugifyCategory(cat);
                const subCount = (subcatsByCat[cat] || new Set()).size;
                return (
                  <a href={`/categories/${slug}`} class="cc-cat" title={`Browse ${cat} courses with Udemy coupons`}>
                    <span class="cc-cat-icon" set:html={CATEGORY_ICONS[slug] || CATEGORY_ICONS["development"]}></span>
                    <span class="cc-cat-name">{cat}</span>
                    <span class="cc-cat-count">{subCount} Subcategor{subCount === 1 ? "y" : "ies"}</span>
                  </a>
                );
              })}
            </nav>
          </section>
          )}

          <section class="cc-section cc-faq">
            <h2 class="cc-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Frequently asked questions
            </h2>
            <div class="cc-faq-grid">
              {faqs.map((faq: any) => (
                <div class="cc-faq-card">
                  <h6 class="cc-faq-q">{faq.q}</h6>
                  <p class="cc-faq-a">{faq.a}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="cc-section cc-about" aria-label="About">
            <h2 class="cc-section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              About CoursesWyn
            </h2>
            <div class="cc-about-grid">
              <div class="cc-about-card">
                <div class="cc-about-media">
                  <Image src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=1200&auto=format&fit=crop" alt="Online Learning" loading="lazy" width={1200} height={800} />
                </div>
                <h4 class="cc-about-title">Your Gateway to Learning</h4>
                <p class="cc-about-body">CoursesWyn is your trusted source for the best online course deals and verified coupon codes. We curate high-quality educational content from top platforms like Udemy, making learning accessible and affordable for everyone.</p>
              </div>

              <div class="cc-about-card">
                <div class="cc-about-features">
                  <div class="cc-about-feature">
                    <span class="cc-about-ico">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="m13 21l2-1l2 1v-7h-4m4-5V7l-2 1l-2-1v2l-2 1l2 1v2l2-1l2 1v-2l2-1m1-7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h7v-2H4V5h16v10h-1v2h1a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m-9 5H5V6h6m-2 5H5V9h4m2 5H5v-2h6Z"/></svg>
                    </span>
                    <div>
                      <h6>100% Valid Coupons</h6>
                      <p>All our coupons are verified and updated regularly</p>
                    </div>
                  </div>
                  <div class="cc-about-feature">
                    <span class="cc-about-ico">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M15 4a8 8 0 0 1 8 8a8 8 0 0 1-8 8a8 8 0 0 1-8-8a8 8 0 0 1 8-8m0 2a6 6 0 0 0-6 6a6 6 0 0 0 6 6a6 6 0 0 0 6-6a6 6 0 0 0-6-6m-1 2h1.5v3.78l2.33 2.33l-1.06 1.06L14 12.4zM2 18a1 1 0 0 1-1-1a1 1 0 0 1 1-1h3.83c.31.71.71 1.38 1.17 2zm1-5a1 1 0 0 1-1-1a1 1 0 0 1 1-1h2.05L5 12l.05 1zm1-5a1 1 0 0 1-1-1a1 1 0 0 1 1-1h3c-.46.62-.86 1.29-1.17 2z"/></svg>
                    </span>
                    <div>
                      <h6>Daily Updates</h6>
                      <p>New courses and deals added every 24 hours</p>
                    </div>
                  </div>
                  <div class="cc-about-feature">
                    <span class="cc-about-ico">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3L1 9l11 6l9-4.91V17h2V9M5 13.18v4L12 21l7-3.82v-4L12 17z"/></svg>
                    </span>
                    <div>
                      <h6>Quality Education</h6>
                      <p>Courses from expert instructors worldwide</p>
                    </div>
                  </div>
                  <div class="cc-about-feature">
                    <span class="cc-about-ico">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </span>
                    <div>
                      <h6>Verified Coupons</h6>
                      <p>Every code tested against Udemy before publishing</p>
                    </div>
                  </div>
                </div>
                <p class="cc-about-join">Join thousands of learners who trust CoursesWyn to advance their careers and pursue their passions through online education.</p>
                <p class="cc-about-stats">
                  <span>🌟 {todayAdded}+ coupons added today</span>
                  <span>📚 {totalCoupons}+ verified coupon codes</span>
                  <span>🎓 {totalTopics} topics and categories</span>
                  <span>💰 Save up to {maxDiscountPct}% on courses</span>
                </p>
              </div>
            </div>

            <div class="cc-keywords" aria-label="Related keywords">
              <span>Udemy Coupons</span>
              <span>Free Online Courses</span>
              <span>Course Deals</span>
              <span>Online Learning</span>
              <span>Education Discounts</span>
              <span>Skill Development</span>
              <span>Professional Certificates</span>
              <span>E-Learning Platform</span>
              <span>Career Development</span>
              <span>Digital Skills</span>
            </div>
          </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  .cc-breadcrumb { display: none; }

  .cc-header { text-align: center; margin-bottom: 2rem; }
  .cc-header-icon { display: block; margin: 0 auto 0.75rem; color: var(--brand); }
  .cc-title { font-size: clamp(2.5rem, 4.5vw, 4rem); font-weight: 800; color: var(--text); margin: 0 0 0.75rem; letter-spacing: -0.02em; line-height: 1.25; }
  .cc-title > span:first-child { background: linear-gradient(135deg, var(--brand) 0%, var(--secondary) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .cc-page-label { font-size: 1.1rem; font-weight: 700; color: var(--muted); letter-spacing: normal; margin-left: 0.5rem; }
  .cc-hero-claim { font-size: clamp(1.4rem, 2.5vw, 1.75rem); font-weight: 800; color: var(--text); margin: -0.25rem 0 0.75rem; line-height: 1.3; letter-spacing: -0.01em; }
  .cc-hero-claim span { background: linear-gradient(135deg, var(--brand) 0%, var(--secondary) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .cc-subtitle { font-size: 0.95rem; color: var(--muted); max-width: 640px; margin: 0 auto 1.25rem; line-height: 1.65; }
  .cc-subtitle strong { color: var(--text); font-weight: 700; }

  .cc-hero-search { display: flex; align-items: center; gap: 0.5rem; max-width: 560px; margin: 0 auto 1.25rem; background: var(--card); border: 1px solid var(--border); border-radius: 100px; padding: 0.4rem 0.4rem 0.4rem 1rem; transition: border-color 0.2s; }
  .cc-hero-search:focus-within { border-color: var(--brand); }
  .cc-hero-search svg { color: var(--muted); flex-shrink: 0; }
