---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { readDeals } from '../../lib/store';
import DealCard from '../../components/DealCard.astro';
import { toISODateWIB } from '../../lib/date';

// Function to decode HTML entities
const decodeHtml = (str: string) => str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

export async function getStaticPaths() {
  // Function to decode HTML entities
  const decodeHtml = (str: string) => str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

  const allDeals = await readDeals();

  // Decode subcategories
  allDeals.forEach(deal => {
    if (deal.subcategory) {
      deal.subcategory = decodeHtml(deal.subcategory);
    }
  });

  const topicMap = new Map();
  for (const deal of allDeals) {
    const subcategory = deal.subcategory;
    if (!subcategory || typeof subcategory !== 'string') continue;

    const slug = subcategory.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    if (!topicMap.has(slug)) {
      topicMap.set(slug, subcategory);
    }
  }

  return [...topicMap.entries()].map(([slug, originalTopic]) => ({
    params: { topic: slug },
    props: { originalTopic, allDeals }
  }));
}

const { topic: topicSlug } = Astro.params;
const { originalTopic, allDeals: propAllDeals } = Astro.props;
const urlParams = new URLSearchParams(Astro.url.search);
const page = urlParams.get('page');

// Use allDeals from props, or read if in dev mode
const allDeals = propAllDeals || await readDeals();

// Decode subcategories in deals
allDeals.forEach(deal => {
  if (deal.subcategory && typeof deal.subcategory === 'string') {
    deal.subcategory = decodeHtml(deal.subcategory);
  }
});

// Use originalTopic for exact matching, with fallback for dev mode
let topic = originalTopic;
if (!topic) {
  // Fallback for dev mode or missing props
  const allSubcategories = [...new Set(allDeals.map(deal => deal.subcategory).filter(sub => sub != null && typeof sub === 'string'))];
  const matching = allSubcategories.find(sub => sub.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-') === topicSlug);
  topic = matching || 'Unknown Topic';
}

// Filter deals for this topic (subcategory) - exact match
const topicDeals = allDeals.filter(deal => {
  try {
    if (!deal.subcategory || typeof deal.subcategory !== 'string') return false;
    return deal.subcategory === topic;
  } catch (e) {
    return false;
  }
});

// Pagination
const PAGE_SIZE = 12;
const currentPage = parseInt(page || '1') || 1;
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = topicDeals.slice(startIndex, endIndex);
const totalPages = Math.ceil(topicDeals.length / PAGE_SIZE);

const displayName = topic.replace(/\b\w/g, (l: string) => l.toUpperCase());
const topicName = displayName;

// Generate related searches
const generateRelatedSearches = (topic: string) => {
  const baseSearches = [
    `${topic} Free Course`,
    `${topic} Course Free`,
    `${topic} PDF`,
    `${topic} For Beginners`,
    `${topic} Course for Beginners`,
    `${topic} Course Udemy`,
    `${topic} Course Youtube`,
    `${topic} Course Free with certificate`,
    `Free ${topic} Course with certificate`,
    `${topic} online`,
    `${topic} Course online`,
    `${topic} Course Coupon Code`,
    `${topic} Free`,
    `${topic} Tutorial`,
    `${topic} App`,
    `${topic} download`,
    `Learn ${topic}`,
    `${topic} Mooc`
  ];
  return baseSearches;
};

const relatedSearches = generateRelatedSearches(topicName);

const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const currentDate = toISODateWIB();

// Calculate savings stats
const avgDiscount = topicDeals.length > 0 
  ? Math.round(topicDeals.reduce((acc, deal) => {
      if (deal.originalPrice && deal.price !== undefined && deal.originalPrice > 0) {
        return acc + ((deal.originalPrice - deal.price) / deal.originalPrice) * 100;
      }
      return acc;
    }, 0) / topicDeals.length)
  : 90;

const freeCourses = topicDeals.filter(deal => deal.price === 0 || deal.price === null).length;

// SEO description - optimized
const topicDescription = `Looking for the best ${topicName} courses on Udemy? We ranked ${topicDeals.length}+ verified ${topicName} courses by student rating and coupon availability — save up to ${avgDiscount}% with working codes updated daily. Updated ${currentDate}.`;

// Get all topics for sidebar
const topics = [...new Set(allDeals.map(deal => deal.subcategory).filter(sub => sub != null))];

// Featured image: top-rated course in this topic (like real.discount's per-topic featured image)
const featuredDeal = [...topicDeals].sort((a, b) => (b.rating ?? 0) - (a.rating ?? 0))[0];
const featuredImage = featuredDeal?.image ?? null;

// Other topics for "Discover More"
const GRADIENT_COLORS = [
  { c1: '#0d9488', c2: '#115e59' },
  { c1: '#059669', c2: '#047857' },
  { c1: '#0891b2', c2: '#0e7490' },
  { c1: '#3b82f6', c2: '#1d4ed8' },
  { c1: '#6d28d9', c2: '#5b21b6' },
  { c1: '#b45309', c2: '#92400e' },
  { c1: '#7e22ce', c2: '#6b21a8' },
  { c1: '#0f766e', c2: '#134e4a' }
];

// Rotate the topic list per-page so Discover More differs on every topic page
const hashFor = (s: string) => ((s.split('').reduce((h, ch) => h * 31 + ch.charCodeAt(0), 7) % 100000) + 100000) % 100000;
const rotateOffset = hashFor(topicSlug);

const otherTopics = topics
  .filter(sub => sub != null && typeof sub === 'string')
  .map((sub) => {
    const subDeals = allDeals.filter(deal => deal.subcategory === sub);
    const hashRaw = [...sub].reduce((h, ch) => h * 31 + ch.charCodeAt(0), 7);
    const hash = ((hashRaw % 100000) + 100000) % 100000;
    const grad = GRADIENT_COLORS[hash % GRADIENT_COLORS.length];
    return {
      name: sub.replace(/\b\w/g, (l: string) => l.toUpperCase()),
      slug: sub.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-'),
      count: subDeals.length,
      c1: grad.c1,
      c2: grad.c2,
      s1x: 24 + (hash % 56),
      s1y: 16 + (hash >> 3) % 34,
      s1r: 26 + (hash >> 4) % 26,
      s2x: 200 + (hash >> 2) % 96,
      s2y: 10 + (hash >> 6) % 30,
      s2r: 22 + (hash >> 5) % 22,
      s3x: 280 - (hash >> 7) % 60,
      s3y: 130 + (hash >> 8) % 40,
      s3r: 12 + (hash >> 9) % 14
    };
  })
  .filter(t => t.slug !== topicSlug)
  .sort((a, b) => a.name.localeCompare(b.name))
  .sort((a, b) => ((hashFor(a.slug) - rotateOffset + 100000) % 100000) - ((hashFor(b.slug) - rotateOffset + 100000) % 100000))
  .slice(0, 8)
  .map(t => ({ name: t.name, slug: t.slug, count: t.count, c1: t.c1, c2: t.c2, s1x: t.s1x, s1y: t.s1y, s1r: t.s1r, s2x: t.s2x, s2y: t.s2y, s2r: t.s2r, s3x: t.s3x, s3y: t.s3y, s3r: t.s3r }));

---

<Layout title={`Best ${topicName} Courses on Udemy for ${currentYear} — Ranked & Verified | CoursesWyn`} description={topicDescription} hideBreadcrumbs={true}>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "@id": `https://courseswyn.com/topics/${topicSlug}`,
        "url": `https://courseswyn.com/topics/${topicSlug}`,
        "name": `Best ${topicName} Courses on Udemy for ${currentYear}`,
        "description": topicDescription,
        "inLanguage": "en-US",
        "dateModified": currentDate,
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
            { "@type": "ListItem", "position": 2, "name": "Topics", "item": "https://courseswyn.com/topics" },
            { "@type": "ListItem", "position": 3, "name": topicName, "item": `https://courseswyn.com/topics/${topicSlug}` }
          ]
        },
        "mainEntity": {
          "@type": "ItemList",
          "name": `Best ${topicName} Courses`,
          "numberOfItems": topicDeals.length,
          "itemListElement": topicDeals.slice(0, 10).map((deal, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "item": {
              "@type": "Course",
              "name": deal.title,
              "url": `https://courseswyn.com/coupon/${deal.slug}`,
              "provider": { "@type": "Organization", "name": "Udemy" }
            }
          }))
        }
      }
    ]
  })} />

  <div class="tp2-root">
    <div class="tp2-container">

      <nav aria-label="Breadcrumb" class="tp2-breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList">
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/" itemprop="item"><span itemprop="name">Home</span></a>
            <meta itemprop="position" content="1" />
          </li>
          <li class="tp2-sep">/</li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="/topics" itemprop="item"><span itemprop="name">Topics</span></a>
            <meta itemprop="position" content="2" />
          </li>
          <li class="tp2-sep">/</li>
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="tp2-crumb-current">
            <span itemprop="name">{topicName}</span>
            <meta itemprop="position" content="3" />
          </li>
        </ol>
      </nav>

      {/* Hero */}
      <section class="tp2-hero">
        <div class="tp2-hero-inner">
          <div class="tp2-hero-left">
            <p class="tp2-hero-label">Best of {currentYear} &middot; Ranked &amp; Verified</p>
            <h1>Best <span class="tp2-grad">{topicName}</span> Courses on Udemy for {currentYear}</h1>
            <p class="tp2-claim">We ranked the top {topicName} courses by student rating and coupon availability — every code tested against Udemy before listing.</p>
            <div class="tp2-hero-stats">
              <div class="tp2-stat">
                <span class="tp2-stat-lbl">Courses</span>
                <span class="tp2-stat-val">{topicDeals.length}+</span>
              </div>
              <div class="tp2-stat">
                <span class="tp2-stat-lbl">Avg discount</span>
                <span class="tp2-stat-val">{avgDiscount}%</span>
              </div>
              <div class="tp2-stat">
                <span class="tp2-stat-lbl">Updated</span>
                <span class="tp2-stat-val">{currentYear}</span>
              </div>
            </div>
          </div>
          <div class="tp2-hero-right">
            {featuredImage && (
              <div class="tp2-featured">
                <Image
                  src={featuredImage}
                  alt={`Best ${topicName} courses on Udemy`}
                  width={750}
                  height={422}
                  style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }}
                  inferSize={false}
                  loading="eager"
                />
                <span class="tp2-featured-badge">Top rated</span>
              </div>
            )}
            <p>Ranked by real student ratings and review counts from Udemy, filtered to only courses with <strong class="tp2-em">working verified coupon codes</strong>. New {topicName.toLowerCase()} deals are added every day and checked in near real time — expired coupons disappear automatically.</p>
            <a href="/udemy-coupons-today" class="tp2-hero-link">See today's newest deals &#8594;</a>
          </div>
        </div>
      </section>

      {/* Related searches (plain text, above the cards, like real.discount) */}
      <section class="tp2-related">
        <h2>Related Searches</h2>
        <p class="tp2-related-text">{relatedSearches.join(', ')}</p>
      </section>

      {/* Deals list */}
      <section class="tp2-deals" aria-label={`Best ${topicName} courses on Udemy`}>
        <div class="tp2-deals-head">
          <h2>Discover {topicName} Courses on Udemy Today</h2>
          <p>Looking for the best {topicName} courses available today? You've come to the right place. Our curated collection of top {topicName} courses spans multiple languages including English, Arabic, Dutch and more, giving you access to high-quality educational content at unbeatable prices. Whether you're looking to learn {topicName} from scratch, advance your {topicName} skills, or explore new {topicName} techniques, these courses with verified coupon codes provide an excellent starting point.</p>
        </div>
        <div class="tp2-deals-list">
          {currentItems.length > 0 ? (
            currentItems.map((deal) => (
              <DealCard deal={deal} />
            ))
          ) : (
            <div class="tp2-empty">
              <h3>No courses found in {topicName}</h3>
              <p>We couldn't find any courses in this topic right now. Try browsing our other topics or check back later for fresh deals.</p>
              <a href="/udemy-coupon-code" class="tp2-empty-btn">Browse All Courses</a>
            </div>
          )}
        </div>
      </section>

      {/* Pagination */}
      {totalPages > 1 && (
        <nav class="tp2-pagination" aria-label="Pagination">
          <div class="tp2-pg-btns">
            {currentPage > 1 && (
              <a href={`/topics/${topicSlug}?page=${currentPage - 1}`} class="tp2-pg-btn">&#8592;</a>
            )}
            {Array.from({ length: totalPages }, (_, i) => i + 1)
              .filter(pageNum =>
                pageNum === 1 ||
                pageNum === totalPages ||
                (pageNum >= currentPage - 1 && pageNum <= currentPage + 1)
              )
              .map((pageNum) => (
                <a
                  href={`/topics/${topicSlug}?page=${pageNum}`}
                  class:list={["tp2-pg-btn", { "tp2-pg-active": pageNum === currentPage }]}
                >
                  {pageNum}
                </a>
              ))}
            {currentPage < totalPages && (
              <a href={`/topics/${topicSlug}?page=${currentPage + 1}`} class="tp2-pg-btn">&#8594;</a>
            )}
          </div>
          <div class="tp2-pg-info">
            Showing {startIndex + 1}-{Math.min(endIndex, topicDeals.length)} of {topicDeals.length} courses
          </div>
        </nav>
      )}

      {/* SEO block */}
      <section class="tp2-seo">
        <h2>Why These Are the Best {topicName} Courses on Udemy</h2>
        <p>Every {topicName.toLowerCase()} course below is ranked using real student ratings and review volume from Udemy, then filtered to keep only listings where our <strong>verified coupon code is currently working</strong>. We re-check each deal in near real time, so the discount you see is the price you pay.</p>
        <p>Whether you're a complete beginner or an experienced professional, you'll find top-rated {topicName.toLowerCase()} training with hands-on projects, lifetime access, and a certificate of completion included with every enrollment.</p>

        <h3>Why Choose Online {topicName} Courses?</h3>
        <p>Online courses have become increasingly popular among learners worldwide. They offer flexibility, allowing you to learn at your own pace and on your own schedule. Many of these courses come from reputable platforms and feature experienced instructors who share their expertise. Best of all, verified coupon codes let you enroll at a fraction of the regular price, making them perfect for beginners and lifelong learners alike.</p>

        <h3>How to Get Started with {topicName} Courses</h3>
        <p>Getting started is simple. Browse through our comprehensive list of {topicName.toLowerCase()} courses updated on {currentDate}. Each course listing includes important details like duration, language, and instructor information. Simply click on any course that interests you to access the learning materials. Most courses are self-paced, meaning you can start whenever you're ready and complete them at your convenience.</p>

        <h3>Popular {topicName} Course Categories</h3>
        <p>Our collection covers diverse {topicName.toLowerCase()} topics to suit various learning interests. From beginner fundamentals to advanced techniques, you'll find courses that match your learning goals. Each category features carefully selected courses that provide value and practical knowledge, helping you build skills that matter in today's competitive job market.</p>

        <h3>Discounted Courses vs Paid Courses</h3>
        <p>While paid courses often include certificates and additional resources, discounted courses offer excellent value for those looking to learn without overpaying. Many of these courses provide the same high-quality content as their full-price counterparts, making them an ideal choice for budget-conscious learners. With our verified coupon codes you can learn valuable skills without any financial barrier.</p>

        <h3>Maximize Your Learning Experience</h3>
        <p>To get the most out of these online courses, we recommend setting aside dedicated time for learning, taking notes, and practicing what you learn. Many courses include practical exercises and projects that help reinforce your understanding. Don't forget to check back regularly, as we update our collection daily with new {topicName.toLowerCase()} deals across various subjects.</p>

        <p>Ready to start learning? Explore our collection of {topicName.toLowerCase()} courses available today and begin your educational journey. With {topicDeals.length}+ courses to choose from, you're sure to find something that matches your interests and learning goals. Remember, the best part about verified coupon codes is that you can try multiple subjects at huge discounts, allowing you to discover new passions and expand your knowledge base.</p>
      </section>

      {/* Discover More = related topics */}
      <section class="tp2-related">
        <h2>Discover More Courses in Related Topics</h2>
        <div class="tp2-more-grid">
          {otherTopics.map((t) => (
            <a href={`/topics/${t.slug}`} class="tp2-more-card">
              <div class="tp2-more-media">
                <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" role="img" aria-label={t.name} class="tp2-more-svg">
                  <defs>
                    <linearGradient id={`g-${t.slug}`} x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color={t.c1} />
                      <stop offset="100%" stop-color={t.c2} />
                    </linearGradient>
                  </defs>
                  <rect width="320" height="180" fill={`url(#g-${t.slug})`} />
                  <circle cx={t.s1x} cy={t.s1y} r={t.s1r} fill="rgba(255,255,255,0.14)" />
                  <circle cx={t.s2x} cy={t.s2y} r={t.s2r} fill="rgba(255,255,255,0.10)" />
                  <circle cx={t.s3x} cy={t.s3y} r={t.s3r} fill="rgba(255,255,255,0.18)" />
                  <text x="16" y="112" fill="rgba(255,255,255,0.95)" font-size="30" font-weight="800" font-family="inherit">{t.name}</text>
                  <text x="16" y="148" fill="rgba(255,255,255,0.8)" font-size="16" font-weight="600" font-family="inherit">{t.count} courses</text>
                </svg>
              </div>
              <div class="tp2-more-body">
                <span class="tp2-more-name">Best {t.name} Courses on Udemy for {currentYear}</span>
                <span class="tp2-more-count">{t.count} courses &#8594;</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* FAQ */}
      <section class="tp2-faq">
        <h2>Frequently Asked Questions About Best {topicName} Courses</h2>
        <div class="tp2-faq-list">
          {[
            { q: `What are the best ${topicName} courses on Udemy right now?`, a: `We rank the top ${topicName} courses by student rating and review count, keeping only those with a working verified coupon code. The current ranking above is updated daily — every code is checked against Udemy before it stays listed.` },
            { q: `How do I use a ${topicName} coupon code?`, a: `Simply browse the ranked courses above and click any deal. You'll be redirected to Udemy with the discount pre-applied. Complete enrollment to get lifetime access.` },
            { q: `Do discounted ${topicName} courses include certificates?`, a: `Yes! All Udemy courses accessed through our coupons include a certificate of completion — identical to paid enrollments.` },
            { q: `How often are new ${topicName} courses added?`, a: `New ${topicName} courses and deals are added daily. We recommend bookmarking this page and checking back regularly.` },
            { q: `Are these ${topicName} coupon codes legitimate?`, a: `Absolutely! All coupons are verified and sourced directly from Udemy or authorized instructors. We test every coupon before listing — these are official promotional codes, not hacks or exploits.` },
            { q: `What skill level are these ${topicName} courses for?`, a: `We curate ${topicName} courses for all levels — complete beginners, intermediate learners, and advanced professionals. Each course listing shows the skill level so you can find the perfect match.` }
          ].map((faq) => (
            <details class="tp2-faq-item">
              <summary>
                {faq.q}
                <span class="tp2-faq-plus">+</span>
              </summary>
              <div class="tp2-faq-a">{faq.a}</div>
            </details>
          ))}
        </div>
      </section>

      {/* Back to topics */}
      <section class="tp2-back">
        <h3>Explore More Course Topics</h3>
        <p>Discover courses in other categories — all with verified coupon codes.</p>
        <a href="/topics" class="tp2-back-btn">Browse All Topics &#8594;</a>
      </section>

    </div>
  </div>

<style>
  .tp2-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .tp2-container { max-width: 1200px; margin: 0 auto; }

  .tp2-breadcrumb { margin-bottom: 1.5rem; }
  .tp2-breadcrumb ol { display: flex; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; gap: 0.5rem; font-size: 0.82rem; font-weight: 600; color: var(--muted); }
  .tp2-breadcrumb a { color: inherit; text-decoration: none; }
  .tp2-breadcrumb a:hover { color: var(--brand); }
  .tp2-sep { color: var(--border); }
  .tp2-crumb-current { color: var(--text); }

  .tp2-hero { padding: 2rem 0 3rem; border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }
  @media (min-width: 900px) { .tp2-hero-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: 3rem; align-items: start; } }
  .tp2-hero-label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--brand); margin: 0 0 1rem; }
  .tp2-hero-label::before { content: ''; width: 2rem; height: 3px; background: var(--brand); flex-shrink: 0; }
  .tp2-hero h1 { font-size: clamp(2.2rem, 4.5vw, 3.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: var(--text); margin: 0 0 1.25rem; }
  .tp2-grad { background: linear-gradient(135deg, var(--brand) 0%, var(--secondary) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .tp2-claim { font-size: 1rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.75rem; max-width: 42rem; }
  .tp2-hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--border); border-width: 1px 0; max-width: 26rem; }
  .tp2-stat { padding: 1rem 1.25rem 1rem 0; }
  .tp2-stat + .tp2-stat { border-left: 1px solid var(--border); padding-left: 1.25rem; }
  .tp2-stat-lbl { display: block; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 0.25rem; }
  .tp2-stat-val { font-size: 1.4rem; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
  .tp2-hero-right p { font-size: 0.9rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.25rem; }
  .tp2-em { color: var(--text); font-weight: 700; }
  .tp2-hero-link { color: var(--brand); font-weight: 700; text-decoration: none; font-size: 0.88rem; }
  .tp2-hero-link:hover { text-decoration: underline; }

  .tp2-featured { position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 16 / 9; margin-bottom: 1.25rem; border: 1px solid var(--border); box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.5); }
