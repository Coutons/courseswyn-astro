---
import Layout from '../../layouts/Layout.astro';
import { readDeals } from '../../lib/store';
import { dealTopicNames } from '../../lib/dealStats';
import LedgerRow from '../../components/LedgerRow.astro';
import { toISODateWIB } from '../../lib/date';
import { slugifyTopic } from '../../lib/utils';

// Function to decode HTML entities
const decodeHtml = (str: string) => str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

export async function getStaticPaths() {
  const allDeals = await readDeals();

  const topicMap = new Map();
  for (const deal of allDeals) {
    for (const name of dealTopicNames(deal)) {
      const slug = slugifyTopic(name);
      if (!topicMap.has(slug)) {
        topicMap.set(slug, name);
      }
    }
  }

  return [...topicMap.entries()].map(([slug, originalTopic]) => ({
    params: { topic: slug },
    props: { originalTopic, allDeals }
  }));
}

const { topic: topicSlug } = Astro.params;
const { originalTopic, allDeals: propAllDeals } = Astro.props;
const urlParams = new URLSearchParams(Astro.url.search);
const page = urlParams.get('page');

// Use allDeals from props, or read if in dev mode
const allDeals = propAllDeals || await readDeals();

// Decode subcategories in deals
allDeals.forEach(deal => {
  if (deal.subcategory && typeof deal.subcategory === 'string') {
    deal.subcategory = decodeHtml(deal.subcategory);
  }
});

// Use originalTopic for exact matching, with fallback for dev mode
let topic = originalTopic;
if (!topic) {
  const allNames = [...new Set(allDeals.flatMap(dealTopicNames))];
  const matching = allNames.find(name => slugifyTopic(name) === topicSlug);
  topic = matching || 'Unknown Topic';
}

// Filter deals for this topic (real Udemy tags, fallback subcategory) - exact match
const topicDeals = allDeals.filter(deal => {
  try {
    return dealTopicNames(deal).includes(topic);
  } catch (e) {
    return false;
  }
});

// Pagination
const PAGE_SIZE = 12;
const currentPage = parseInt(page || '1') || 1;
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = topicDeals.slice(startIndex, endIndex);
const totalPages = Math.ceil(topicDeals.length / PAGE_SIZE);

const displayName = topic.replace(/\b\w/g, (l: string) => l.toUpperCase());
const topicName = displayName;

// Generate related searches
const generateRelatedSearches = (topic: string) => {
  const baseSearches = [
    `${topic} Free Course`,
    `${topic} Course Free`,
    `${topic} PDF`,
    `${topic} For Beginners`,
    `${topic} Course for Beginners`,
    `${topic} Course Udemy`,
    `${topic} Course Youtube`,
    `${topic} Course Free with certificate`,
    `Free ${topic} Course with certificate`,
    `${topic} online`,
    `${topic} Course online`,
    `${topic} Course Coupon Code`,
    `${topic} Free`,
    `${topic} Tutorial`,
    `${topic} App`,
    `${topic} download`,
    `Learn ${topic}`,
    `${topic} Mooc`
  ];
  return baseSearches;
};

const relatedSearches = generateRelatedSearches(topicName);

const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const currentDate = toISODateWIB();

// Calculate savings stats
const avgDiscount = topicDeals.length > 0 
  ? Math.round(topicDeals.reduce((acc, deal) => {
      if (deal.originalPrice && deal.price !== undefined && deal.originalPrice > 0) {
        return acc + ((deal.originalPrice - deal.price) / deal.originalPrice) * 100;
      }
      return acc;
    }, 0) / topicDeals.length)
  : 90;

const freeCourses = topicDeals.filter(deal => deal.price === 0 || deal.price === null).length;

// SEO description - optimized
const topicDescription = `Looking for the best ${topicName} courses on Udemy? We ranked ${topicDeals.length}+ verified ${topicName} courses by student rating and coupon availability — save up to ${avgDiscount}% with working codes updated daily. Updated ${currentDate}.`;

// Get all topics for sidebar
const topics = [...new Set(allDeals.flatMap(dealTopicNames).filter(Boolean))];

// Other topics for "Discover More"
const GRADIENT_COLORS = [
  { c1: '#0d9488', c2: '#115e59' },
  { c1: '#059669', c2: '#047857' },
  { c1: '#0891b2', c2: '#0e7490' },
  { c1: '#3b82f6', c2: '#1d4ed8' },
  { c1: '#6d28d9', c2: '#5b21b6' },
  { c1: '#b45309', c2: '#92400e' },
  { c1: '#7e22ce', c2: '#6b21a8' },
  { c1: '#0f766e', c2: '#134e4a' }
];

// Rotate the topic list per-page so Discover More differs on every topic page
const hashFor = (s: string) => ((s.split('').reduce((h, ch) => h * 31 + ch.charCodeAt(0), 7) % 100000) + 100000) % 100000;
const rotateOffset = hashFor(topicSlug);

const otherTopics = topics
  .filter(sub => sub != null && typeof sub === 'string')
  .map((sub) => {
    const subDeals = allDeals.filter(deal => dealTopicNames(deal).includes(sub));
    const hash = hashFor(sub);
    const grad = GRADIENT_COLORS[hash % GRADIENT_COLORS.length];
    return {
      name: sub.replace(/\b\w/g, (l: string) => l.toUpperCase()),
      slug: sub.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-'),
      count: subDeals.length,
      c1: grad.c1,
      c2: grad.c2
    };
  })
  .filter(t => t.slug !== topicSlug)
  .sort((a, b) => a.name.localeCompare(b.name))
  .sort((a, b) => ((hashFor(a.slug) - rotateOffset + 100000) % 100000) - ((hashFor(b.slug) - rotateOffset + 100000) % 100000))
  .slice(0, 8);

const siteUrl = "https://courseswyn.com";
const topicBaseUrl = `${siteUrl}/topics/${topicSlug}`;
const currentUrl = currentPage === 1 ? topicBaseUrl : `${topicBaseUrl}?page=${currentPage}`;

const pageKeywords = [
  `${topicName.toLowerCase()} courses`,
  `best ${topicName.toLowerCase()} courses on udemy`,
  `${topicName.toLowerCase()} udemy coupon`,
  `${topicName.toLowerCase()} course free`,
  `${topicName.toLowerCase()} certification`,
  `learn ${topicName.toLowerCase()}`,
  `free ${topicName.toLowerCase()} course with certificate`,
  "udemy coupon code"
].join(", ");

const faqs = [
  { q: `What are the best ${topicName} courses on Udemy right now?`, a: `We rank the top ${topicName} courses by student rating and review count, keeping only those with a working verified coupon code. The current ranking above is updated daily — every code is checked against Udemy before it stays listed.` },
  { q: `How do I use a ${topicName} coupon code?`, a: `Simply browse the ranked courses above and click any deal. You'll be redirected to Udemy with the discount pre-applied. Complete enrollment to get lifetime access.` },
  { q: `Do discounted ${topicName} courses include certificates?`, a: `Yes! All Udemy courses accessed through our coupons include a certificate of completion — identical to paid enrollments.` },
  { q: `How often are new ${topicName} courses added?`, a: `New ${topicName} courses and deals are added daily. We recommend bookmarking this page and checking back regularly.` },
  { q: `Are these ${topicName} coupon codes legitimate?`, a: `Absolutely! All coupons are verified and sourced directly from Udemy or authorized instructors. We test every coupon before listing — these are official promotional codes, not hacks or exploits.` },
  { q: `What skill level are these ${topicName} courses for?`, a: `We curate ${topicName} courses for all levels — complete beginners, intermediate learners, and advanced professionals. Each course listing shows the skill level so you can find the perfect match.` }
];
---

<Layout
  title={`Best ${topicName} Courses on Udemy for ${currentYear} — Ranked & Verified | CoursesWyn`}
  description={topicDescription}
  canonical={topicBaseUrl}
  hideBreadcrumbs={true}
>
  <Fragment slot="head">
    {currentPage > 1 && <>
      <meta name="robots" content="noindex, follow" />
      <meta name="googlebot" content="noindex, follow" />
      <meta name="bingbot" content="noindex, follow" />
    </>}
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["WebPage", "CollectionPage"],
        "@id": topicBaseUrl,
        "url": topicBaseUrl,
        "name": `Best ${topicName} Courses on Udemy for ${currentYear}`,
        "description": topicDescription,
        "keywords": pageKeywords,
        "inLanguage": "en-US",
        "dateModified": currentDate,
        "isPartOf": { "@id": `${siteUrl}#website` },
        "breadcrumb": {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
            { "@type": "ListItem", "position": 2, "name": "Topics", "item": `${siteUrl}/topics` },
            { "@type": "ListItem", "position": 3, "name": topicName, "item": topicBaseUrl }
          ]
        },
        "mainEntity": { "@id": `${topicBaseUrl}#itemlist` }
      },
      {
        "@type": "ItemList",
        "@id": `${topicBaseUrl}#itemlist`,
        "name": `Best ${topicName} Courses`,
        "numberOfItems": topicDeals.length,
        "itemListElement": topicDeals.slice(0, 20).map((deal, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "url": `${siteUrl}/coupon/${deal.slug}`,
          "item": {
            "@type": "Course",
            "name": deal.title,
            "url": `${siteUrl}/coupon/${deal.slug}`,
            "image": deal.image,
            "provider": { "@type": "Organization", "name": "Udemy" },
            "offers": {
              "@type": "Offer",
              "price": String(deal.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            }
          }
        }))
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  })} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span> Best of {currentYear} Â· Ranked &amp; Verified</span>
            <span class="cc-folio">Updated {currentDate}</span>
          </div>
          <h1 class="cc-title">Best <span class="cc-accent">{topicName}</span> Courses on Udemy for {currentYear}</h1>
          <p class="cc-subtitle">Ranked by student rating and coupon availability — every code tested against Udemy before listing. New {topicName.toLowerCase()} deals are added daily and checked in near real time.</p>
          <div class="cc-toolbar">
            <a class="cc-hero-btn" href="#deals">View all {topicDeals.length} courses</a>
            <a class="cc-hero-btn ghost" href="/topics">Browse all topics</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Courses</div><div class="cc-ledger-value">{topicDeals.length}+</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Avg discount</div><div class="cc-ledger-value">{avgDiscount}%</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Free courses</div><div class="cc-ledger-value">{freeCourses}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Updated</div><div class="cc-ledger-value">{currentYear}</div></div>
          </div>
        </div>
      </header>

      <section class="cc-section cc-chips-section" aria-label="Related searches">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Related searches <span class="cc-tag">{relatedSearches.length} terms</span></h2>
          <p class="cc-sec-desc">Popular ways people look for {topicName} training — each link runs a live search.</p>
        </div>
        <nav class="cc-chip-nav" aria-label="Related searches">
          {relatedSearches.map((s) => (
            <a href={`/search?q=${encodeURIComponent(s)}`} class="cc-chip">
              <span class="cc-chip-arrow">→</span>
              <span class="cc-chip-name">{s}</span>
            </a>
          ))}
        </nav>
      </section>

      <section class="cc-deals-section" id="deals" aria-label={`Best ${topicName} courses on Udemy`}>
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Discover {topicName} Courses on Udemy Today <span class="cc-tag">{topicDeals.length} courses</span></h2>
          <p class="cc-sec-desc">Looking for the best {topicName} courses available today? You've come to the right place. Our curated collection of top {topicName} courses spans multiple languages including English, Arabic, Dutch and more, giving you access to high-quality educational content at unbeatable prices. Whether you're looking to learn {topicName} from scratch, advance your {topicName} skills, or explore new {topicName} techniques, these courses with verified coupon codes provide an excellent starting point.</p>
        </div>

        {currentItems.length > 0 ? (
          <div class="cc-ledger-wrap">
            <table class="cc-ledger-table">
              <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
              <tbody>
                {currentItems.map((deal) => <LedgerRow deal={deal} />)}
              </tbody>
            </table>
            <div class="cc-deal-more"><span class="cc-deal-count">Showing {startIndex + 1}-{Math.min(endIndex, topicDeals.length)} of {topicDeals.length} courses</span><a href="/udemy-coupons-today">See today's new coupons →</a></div>
          </div>
        ) : (
          <div class="cc-empty">
            <h3>No courses found in {topicName}</h3>
            <p>We couldn't find any courses in this topic right now. Try browsing our other topics or check back later for fresh deals.</p>
            <a href="/udemy-coupon-code" class="cc-hero-btn">Browse All Courses →</a>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="cc-pagination" aria-label="Pagination">
            {currentPage > 1 ? (
              <a href={`/topics/${topicSlug}?page=${currentPage - 1}`} class="cc-page-link cc-page-prev">← Prev</a>
            ) : (
              <span class="cc-page-link cc-page-disabled">← Prev</span>
            )}
            <div class="cc-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1)
                .filter(pageNum => pageNum === 1 || pageNum === totalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                .map((pageNum) => (
                  pageNum === currentPage ? (
                    <span class="cc-page-num cc-page-active">{pageNum}</span>
                  ) : (
                    <a href={`/topics/${topicSlug}?page=${pageNum}`} class="cc-page-num">{pageNum}</a>
                  )
                ))}
            </div>
            {currentPage < totalPages ? (
              <a href={`/topics/${topicSlug}?page=${currentPage + 1}`} class="cc-page-link cc-page-next">Next →</a>
            ) : (
              <span class="cc-page-link cc-page-disabled">Next →</span>
            )}
          </nav>
        )}
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">Why These Are the Best {topicName} Courses on Udemy</h2>
        <p>Every {topicName.toLowerCase()} course below is ranked using real student ratings and review volume from Udemy, then filtered to keep only listings where our <strong>verified coupon code is currently working</strong>. We re-check each deal in near real time, so the discount you see is the price you pay.</p>
        <p>Whether you're a complete beginner or an experienced professional, you'll find top-rated {topicName.toLowerCase()} training with hands-on projects, lifetime access, and a certificate of completion included with every enrollment.</p>

        <h3>Why Choose Online {topicName} Courses?</h3>
        <p>Online courses have become increasingly popular among learners worldwide. They offer flexibility, allowing you to learn at your own pace and on your own schedule. Many of these courses come from reputable platforms and feature experienced instructors who share their expertise. Best of all, verified coupon codes let you enroll at a fraction of the regular price, making them perfect for beginners and lifelong learners alike.</p>

        <h3>How to Get Started with {topicName} Courses</h3>
        <p>Getting started is simple. Browse through our comprehensive list of {topicName.toLowerCase()} courses updated on {currentDate}. Each course listing includes important details like duration, language, and instructor information. Simply click on any course that interests you to access the learning materials. Most courses are self-paced, meaning you can start whenever you're ready and complete them at your convenience.</p>

        <h3>Popular {topicName} Course Categories</h3>
        <p>Our collection covers diverse {topicName.toLowerCase()} topics to suit various learning interests. From beginner fundamentals to advanced techniques, you'll find courses that match your learning goals. Each category features carefully selected courses that provide value and practical knowledge, helping you build skills that matter in today's competitive job market.</p>

        <h3>Discounted Courses vs Paid Courses</h3>
        <p>While paid courses often include certificates and additional resources, discounted courses offer excellent value for those looking to learn without overpaying. Many of these courses provide the same high-quality content as their full-price counterparts, making them an ideal choice for budget-conscious learners. With our verified coupon codes you can learn valuable skills without any financial barrier.</p>

        <h3>Maximize Your Learning Experience</h3>
        <p>To get the most out of these online courses, we recommend setting aside dedicated time for learning, taking notes, and practicing what you learn. Many courses include practical exercises and projects that help reinforce your understanding. Don't forget to check back regularly, as we update our collection daily with new {topicName.toLowerCase()} deals across various subjects.</p>

        <p>Ready to start learning? Explore our collection of {topicName.toLowerCase()} courses available today and begin your educational journey. With {topicDeals.length}+ courses to choose from, you're sure to find something that matches your interests and learning goals. Remember, the best part about verified coupon codes is that you can try multiple subjects at huge discounts, allowing you to discover new passions and expand your knowledge base.</p>
      </section>

      {otherTopics.length > 0 && (
        <section class="cc-section" aria-labelledby="more-topics-title">
          <div class="cc-sec-head">
            <h2 id="more-topics-title" class="cc-sec-title">Discover More Courses in Related Topics <span class="cc-tag">{otherTopics.length} topics</span></h2>
            <p class="cc-sec-desc">Keep exploring — every topic below is ranked and verified the same way.</p>
          </div>
          <nav class="cc-cat-grid" aria-label="Related topics">
            {otherTopics.map((t) => (
              <a href={`/topics/${t.slug}`} class="cc-cat" title={`Best ${t.name} Courses on Udemy for ${currentYear}`}>
                <div class="cc-cat-num">{t.count}</div>
                <div class="cc-cat-label">Best {t.name} for {currentYear}</div>
                <div class="cc-cat-count">courses</div>
              </a>
            ))}
          </nav>
        </section>
      )}

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions about Best {topicName} Courses
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">More topics to explore</p>
        <p class="cc-cta-text">Discover courses in other categories — all with verified coupon codes.</p>
        <a class="cc-hero-btn" href="/topics">Browse All Topics →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(18, 32, 58, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #1F7A4D; background: #E4F1E9; border: 1px solid rgba(31, 122, 77, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #1F7A4D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; color: #5B564C; border: 1px dashed #B9B29B; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: #12203A; line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #C13B2E; }
  .cc-subtitle { color: #5B564C; font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: #12203A; font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #12203A; color: #fff; box-shadow: 0 10px 24px rgba(18, 32, 58, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #1B2E52; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: #1B2E52; border: 1px solid #1B2E52; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #1B2E52; color: #fff; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #B9B29B; padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #D8D0BC; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: #5B564C; margin-bottom: 4px; }
  .cc-ledger-value { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-weight: 700; font-size: 22px; color: #12203A; }

  /* ===== SECTION HEADS ===== */
  .cc-section { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: #12203A; margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; font-weight: 500; color: #5B564C; border: 1px solid #D8D0BC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
