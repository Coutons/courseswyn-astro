---
import Layout from "../layouts/Layout.astro";
import { readDeals } from "../lib/store";

function normName(raw?: string | null) {
  if (!raw) return undefined;
  let v = String(raw).trim();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/\s+/g, " ");
  return v || undefined;
}

function slugifyCategory(name: string) {
  if (name === "Uncategorized") return "uncategorized";
  let v = name.toLowerCase();
  v = v.replace(/&amp;/gi, "&");
  v = v.replace(/&/g, " and ");
  v = v.replace(/[^\w\s-]/g, "");
  v = v.trim();
  v = v.replace(/\s+/g, "-");
  v = v.replace(/-+/g, "-");
  return v;
}

const CATEGORY_ICONS: Record<string, string> = {
  "development": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  "it-and-software": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
  "business": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>',
  "design": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg>',
  "marketing": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="12" y1="7" x2="12" y2="13"/></svg>',
  "data-science": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  "personal-development": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>',
  "photography-and-video": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>',
  "music": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  "teaching-and-academics": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>',
  "office-productivity": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>',
  "finance-and-accounting": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>',
  "programming-languages": '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>',
};

const CATEGORY_DESCRIPTIONS: Record<string, string> = {
  "development": "Web development, mobile apps, game dev, and software engineering courses.",
  "it-and-software": "IT fundamentals, cybersecurity, cloud computing, and networking certifications.",
  "business": "Entrepreneurship, management, finance, and business strategy courses.",
  "design": "Graphic design, UI/UX, illustration, and digital art with pro tools.",
  "marketing": "Digital marketing, SEO, social media, email campaigns, and growth hacking.",
  "data-science": "Machine learning, Python, data analytics, statistics, and AI fundamentals.",
  "personal-development": "Productivity, leadership, communication, and career advancement skills.",
  "photography-and-video": "Photography techniques, video production, editing, and post-processing.",
  "music": "Music theory, production, audio engineering, and instrument learning.",
  "teaching-and-academics": "Academic subjects, test prep, language learning, and teaching methods.",
  "office-productivity": "Microsoft Office, Google Workspace, project management, and workflow tools.",
  "finance-and-accounting": "Accounting, investing, financial modeling, cryptocurrency, and budgeting.",
  "programming-languages": "Python, JavaScript, Java, C++, Rust, Go, and other coding languages.",
};

const deals = await readDeals();
const cats = new Map<string, { name: string; count: number; subs: Map<string, number> }>();

for (const d of deals) {
  const cName = normName(d.category);
  if (!cName) continue;
  const cKey = cName.toLowerCase();
  if (!cats.has(cKey)) cats.set(cKey, { name: cName, count: 0, subs: new Map() });
  const bucket = cats.get(cKey)!;
  bucket.count++;
  const sName = normName(d.subcategory);
  if (sName && sName.toLowerCase() !== cKey) {
    bucket.subs.set(sName, (bucket.subs.get(sName) || 0) + 1);
  }
}

const listRaw = Array.from(cats.values()).sort((a, b) => b.count - a.count);

const list = listRaw.map((c) => {
  const slug = slugifyCategory(c.name);
  const description = CATEGORY_DESCRIPTIONS[slug] ?? `Browse ${c.count} ${c.name} courses with verified Udemy coupons and discounts.`;
  return { ...c, slug, description };
});

const faqs = [
  {
    q: "Are all courses in each category really free?",
    a: "Coupons listed on CoursesWyn apply a discount at checkout. The price shown on each deal card reflects the coupon price at time of verification — some may be heavily discounted or free."
  },
  {
    q: "How often are categories updated?",
    a: "New courses are added to categories daily as we source and verify fresh Udemy coupons. Each category page shows only deals with currently active coupons."
  },
  {
    q: "Can I browse subcategories?",
    a: "Yes — each category page includes subcategory filters so you can narrow down results. For example, within Development you can filter by Web Development, Mobile Development, Game Development, and more."
  },
  {
    q: "Which categories have the most courses?",
    a: `The largest categories on CoursesWyn are currently ${list.slice(0, 3).map(c => c.name).join(", ")} — reflecting the most popular learning topics on Udemy.`
  },
  {
    q: "Do category pages include all Udemy courses?",
    a: "Category pages show only courses with currently active verified coupons. This ensures you only see deals that actually work. We remove expired coupons daily to maintain quality."
  },
  {
    q: "Can I filter categories by language?",
    a: "Yes! You can filter courses by language within each category. We support English, Spanish, Portuguese, French, German, Japanese, Chinese, and many other languages, making learning accessible globally."
  }
];

const totalCategories = list.length;
const totalCourses = deals.length;

const pageTitle = `${totalCategories}+ Udemy Course Categories — Coupons by Subject | CoursesWyn`;
const pageDescription = `Explore ${totalCategories} course categories with verified Udemy coupon codes. Python, web development, data science, AI, design, business & more — updated daily.`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": "https://courseswyn.com/categories#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
        { "@type": "ListItem", "position": 2, "name": "Course Categories", "item": "https://courseswyn.com/categories" }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": "https://courseswyn.com/categories",
      "url": "https://courseswyn.com/categories",
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": "https://courseswyn.com" },
      "breadcrumb": { "@id": "https://courseswyn.com/categories#breadcrumb" },
      "dateModified": new Date().toISOString().split("T")[0],
      "inLanguage": "en-US",
      "about": {
        "@type": "Thing",
        "name": "Udemy Course Categories",
        "description": "Browse course categories with verified Udemy coupons and discounts for online learning"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Learners worldwide seeking discounted online courses by category",
        "geographicArea": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
      },
      "mainEntity": {
        "@type": "ItemList",
        "name": "Udemy Course Categories on CoursesWyn",
        "description": `${totalCategories} categories with ${totalCourses}+ verified coupon deals`,
        "numberOfItems": totalCategories,
        "itemListElement": list.map((c, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "ItemList",
            "name": `${c.name} Courses`,
            "description": c.description,
            "url": `https://courseswyn.com/categories/${c.slug}`,
            "numberOfItems": c.count,
            "areaServed": ["United States", "United Kingdom", "India", "Canada", "Australia", "Germany", "France", "Brazil", "Japan", "Global"]
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://courseswyn.com/categories#faq",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} hideBreadcrumbs={true}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <style>
    .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
    .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

    /* ===== REGISTER / LEDGER HEADER ===== */
    .cc-register { position: relative; background: var(--card); border: 1px solid #E2E6EC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
    .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(11, 107, 74, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
    .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #0B6B4A; animation: ccBlip 1.6s infinite; }
    @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
    .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.6875rem; color: var(--muted); border: 1px dashed #D5DCE2; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
    .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
    .cc-title .cc-accent { color: #CF6F59; }
    .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
    .cc-subtitle strong { color: var(--text); font-weight: 700; }

    .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .cc-hero-btn { font-family: 'Space Grotesk', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #0B6B4A; color: #fff; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
    .cc-hero-btn:hover { background: #0B6B4A; transform: translateY(-1px); }
    .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #0B6B4A; box-shadow: none; }
    .cc-hero-btn.ghost:hover { background: #0B6B4A; color: #fff; }

    .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #D5DCE2; padding-top: 20px; flex-wrap: wrap; }
    .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #E2E6EC; }
    .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
    .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
    .cc-ledger-value { font-family: 'Space Grotesk', Inter, sans-serif; font-weight: 700; font-size: 1.375rem; color: var(--text); }

    /* ===== SECTION HEADS ===== */
    .cc-section { margin-top: 3.25rem; }
    .cc-sec-head { margin-bottom: 0.9rem; }
    .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
    .cc-sec-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #E2E6EC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
    .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

    /* ===== CATEGORY BOXES ===== */
    .cc-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
    .cc-cat { background: var(--card); border: 1px solid #E2E6EC; border-radius: 12px; padding: 16px; text-align: left; text-decoration: none; display: block; transition: all 0.2s; }
    .cc-cat:hover { transform: translateY(-2px); border-color: #0B6B4A; box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.35); }
    .cc-cat-num { font-family: 'Space Grotesk', Inter, sans-serif; font-weight: 700; font-size: 1.25rem; color: var(--text); }
    .cc-cat-label { font-size: 0.75rem; color: var(--muted); margin-top: 3px; font-weight: 600; }
    .cc-cat-count { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.65625rem; color: var(--brand); margin-top: 6px; font-weight: 500; }

    /* ===== GENERIC SECTION HEADS (seo/faq) ===== */
    .cc-section-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.3rem; display: flex; align-items: center; gap: 0.6rem; letter-spacing: -0.01em; flex-wrap: wrap; }
    .cc-section-title svg { color: var(--brand); flex-shrink: 0; }
    .cc-section-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #E2E6EC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }

    .cc-seo-section { background: var(--card); border: 1px solid #E2E6EC; border-radius: 14px; padding: 1.5rem; margin: 3.25rem 0 0; }
    .cc-seo-section h2 { font-size: 1.15rem; font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .cc-seo-section p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.75rem; }
    .cc-seo-section p:last-child { margin-bottom: 0; }
    .cc-seo-section a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .cc-seo-section a:hover { text-decoration: underline; }

    .cc-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    @media (max-width: 768px) { .cc-faq-grid { grid-template-columns: 1fr; } }
    .cc-faq-card { background: var(--card); border: 1px solid #E2E6EC; border-radius: 12px; padding: 1.1rem 1.15rem; }
    .cc-faq-card:hover { border-color: #6E7686; }
    .cc-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
    .cc-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }
    .cc-faq-a a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .cc-faq-a a:hover { text-decoration: underline; }

    .cc-cta { background: var(--card); border: 1px solid #E2E6EC; color: var(--text); border-radius: 16px; padding: 30px 32px; text-align: center; margin: 3.25rem 0 0; }
    .cc-cta-eyebrow { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
    .cc-cta-text { font-size: 0.95rem; line-height: 1.6; margin: 0 auto 18px; max-width: 480px; color: var(--muted); }
    .cc-cta .cc-hero-btn { background: #0B6B4A; color: #fff; box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5); }
    .cc-cta .cc-hero-btn:hover { background: #0B6B4A; transform: translateY(-1px); }

    @media (max-width: 768px) {
      .cc-title { font-size: 1.9rem; }
      .cc-register { padding: 26px 20px 22px; }
      .cc-ledger-cell { border-left: none; padding: 8px 0; }
    }
    @media (max-width: 480px) {
      .cc-title { font-size: 1.7rem; }
      .cc-hero-btn { padding: 11px 16px; font-size: 0.85rem; }
    }
  </style>

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span> Course categories</span>
            <span class="cc-folio">{totalCategories} categories &middot; {totalCourses.toLocaleString()} coupons</span>
          </div>
          <div style="font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;color:var(--brand);display:flex;align-items:center;gap:10px;margin-bottom:0.6rem;">Catalog index<span style="flex:1;border-top:1px solid var(--ledger);" aria-hidden="true"></span></div>
          <h1 class="cc-title">{totalCategories}+ Udemy <span class="cc-accent">Course Categories</span></h1>
          <p class="cc-subtitle">Browse <strong>{totalCategories} learning categories</strong> with {totalCourses.toLocaleString()}+ verified Udemy coupon codes — updated daily.</p>
          <div class="cc-toolbar">
            <a class="cc-hero-btn" href="#categories">Browse categories</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupon-code">Browse all coupons</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Categories</div><div class="cc-ledger-value">{totalCategories}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Active coupons</div><div class="cc-ledger-value">{totalCourses.toLocaleString()}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Verified</div><div class="cc-ledger-value">100%</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Fresh updates</div><div class="cc-ledger-value">Daily</div></div>
          </div>
        </div>
      </header>

      <section id="categories" class="cc-section" aria-labelledby="cat-title">
        <div class="cc-sec-head">
          <h2 id="cat-title" class="cc-sec-title">All {totalCategories} Course Categories &amp; Subcategories <span class="cc-tag">{totalCourses.toLocaleString()} total coupons</span></h2>
          <p class="cc-sec-desc">Every category below links to a live archive of its courses with currently working coupon codes — ranked by deal count.</p>
        </div>

        {list.length === 0 ? (
          <div style="text-align:center;padding:3rem;background: var(--card);border-radius:14px;border:1px solid #E2E6EC;">
            <h3 style="color: var(--text);margin-bottom:1rem;">No categories found</h3>
            <p style="color: var(--muted);margin-bottom:1.5rem;">We loaded {deals.length} deals but couldn't group them into categories.</p>
          </div>
        ) : (
          <nav class="cc-cat-grid" aria-label="Course categories">
            {list.map((c) => (
