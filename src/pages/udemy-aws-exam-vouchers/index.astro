---
import Layout from "../../layouts/Layout.astro";
import CouponGrid from "../../components/CouponGrid.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import VoucherHero from "../../components/VoucherHero.astro";
import VoucherGrid from "../../components/VoucherGrid.astro";
import { getDeals } from "../../lib/store.js";
import { formatDateWIB, toISODateWIB } from "../../lib/date";
import { AWS_GROUPS, countVouchers, voucherAffUrl, voucherCatalogAffUrl } from "../../lib/vouchers.js";

const canonicalUrl = "https://courseswyn.com/udemy-aws-exam-vouchers/";
const pageTitle = "AWS Exam Voucher Discount 2026: Udemy Prices & 50% Off";
const pageDescription =
  "Compare Udemy AWS exam voucher prices for 2026, voucher-only vs Second Chance, plus the 50% AWS discount voucher you get after passing.";

const publishedISO = "2026-09-20";
const lastModified = toISODateWIB();
const now = new Date();
const dateFull = formatDateWIB(now, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
const catalogUrl = voucherCatalogAffUrl();
const total = countVouchers(AWS_GROUPS);
const allVouchers = AWS_GROUPS.flatMap((g) => g.items);
const availableVouchers = allVouchers.filter((v) => !v.catalogOnly);
const totalAvailable = availableVouchers.length;

const examLevels = [
  {
    level: "Foundational",
    fee: "$100",
    exams: "Cloud Practitioner (CLF-C02), AI Practitioner (AIF-C01)",
    coverage: "Any AWS Foundational exam",
  },
  {
    level: "Associate",
    fee: "$150",
    exams: "Solutions Architect (SAA-C03), Developer (DVA-C02), Data Engineer (DEA-C01), CloudOps Engineer (SOA-C03), ML Engineer (MLA-C01)",
    coverage: "Any AWS Associate exam",
  },
  {
    level: "Professional",
    fee: "$300",
    exams: "Solutions Architect (SAP-C02), DevOps Engineer (DOP-C02)",
    coverage: "Any AWS Professional or Specialty exam",
  },
  {
    level: "Specialty",
    fee: "$300",
    exams: "Security (SCS-C02), Machine Learning (MLS-C01), Advanced Networking (ANS-C01)",
    coverage: "Any AWS Professional or Specialty exam",
  },
];

const voucherPicks = [
  {
    level: "Foundational",
    best: "First cloud certification",
    body: "Choose this for Cloud Practitioner (CLF-C02) or AI Practitioner (AIF-C01). One voucher covers either exam, so you can decide after you have studied.",
  },
  {
    level: "Associate",
    best: "Most popular level",
    body: "One Associate voucher covers Solutions Architect, Developer, Data Engineer, CloudOps Engineer and ML Engineer. Pick the exam, not a separate voucher for each code.",
  },
  {
    level: "Professional",
    best: "Senior architects and DevOps",
    body: "Covers Solutions Architect Professional (SAP-C02) and DevOps Engineer Professional (DOP-C02). The same voucher also works for Specialty exams.",
  },
  {
    level: "Specialty",
    best: "Focused, advanced roles",
    body: "Use it for Security (SCS-C02), Machine Learning (MLS-C01) or Advanced Networking (ANS-C01). Expect professional-level hands-on experience.",
  },
];

const comparisonRows = [
  {
    label: "Price",
    udemy: "Live Udemy price. Compare it with the AWS list price before checkout.",
    aws: "$100 Foundational, $150 Associate, $300 Professional or Specialty, per attempt.",
  },
  {
    label: "Retake",
    udemy: "Optional Second Chance, bought together with the voucher.",
    aws: "Pay again after the 14-day wait. AWS occasionally runs free-retake promotions.",
  },
  {
    label: "Validity",
    udemy: "At least 9 months from purchase. The expiry date cannot be extended.",
    aws: "No voucher to expire — you pay when you schedule the exam.",
  },
  {
    label: "Refund",
    udemy: "Non-refundable and non-transferable. No refund if you pass first time.",
    aws: "Cancel more than 24 hours before the appointment for a refund under AWS policy.",
  },
  {
    label: "Region",
    udemy: "Valid only in the country of purchase. Availability varies by country.",
    aws: "Local-currency pricing in many countries; book wherever you are eligible to test.",
  },
  {
    label: "Support",
    udemy: "Udemy handles the voucher code; Pearson VUE handles scheduling.",
    aws: "Pearson VUE handles scheduling and appointment changes for AWS.",
  },
  {
    label: "Best for",
    udemy: "Buying a retake safety net in the same place as your prep course.",
    aws: "Maximum flexibility, direct pricing and no voucher expiry.",
  },
];

const voucherPrices = [
  { exam: "Cloud Practitioner (CLF-C02)", list: "$100", only: "$87.50", bundle: "$115.50", twoAttempts: "$200.00", saving: "$84.50" },
  { exam: "AI Practitioner (AIF-C01)", list: "$100", only: "$105.00", bundle: "$138.60", twoAttempts: "$200.00", saving: "$61.40" },
  { exam: "Solutions Architect – Associate (SAA-C03)", list: "$150", only: "$131.25", bundle: "$177.80", twoAttempts: "$300.00", saving: "$122.20" },
  { exam: "Developer – Associate (DVA-C02)", list: "$150", only: "$157.50", bundle: "$213.36", twoAttempts: "$300.00", saving: "$86.64" },
  { exam: "Security – Specialty (SCS-C02)", list: "$300", only: "—", bundle: "$418.56", twoAttempts: "$600.00", saving: "$181.44" },
];

const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: "How much does an AWS exam cost in 2026?",
    a: "AWS list prices are $100 for Foundational exams (CLF-C02 and AIF-C01), $150 for Associate exams, and $300 for Professional and Specialty exams. Each fee covers one attempt; taxes and local-currency pricing may differ. Udemy's voucher price is shown live and can be higher or lower than the list price.",
  },
  {
    q: "How much is a Udemy AWS exam voucher in 2026?",
    a: "Udemy shows two prices on most AWS voucher pages. On 2 November 2026 we observed Cloud Practitioner voucher-only at $87.50 and + Second Chance at $115.50; Solutions Architect Associate voucher-only at $131.25 and + Second Chance at $177.80. Prices change by country and promotion, so check the live product page before buying.",
  },
  {
    q: "How do I get 50% off my next AWS exam?",
    a: "Pass any AWS certification exam, then open the Benefits section of your AWS Certification Account. AWS issues a 50% discount voucher that you can apply to recertification or another AWS exam. It is an AWS discount voucher, not a Udemy promo code, and it is separate from any voucher you buy.",
  },
  {
    q: "Where can I buy an AWS exam voucher?",
    a: "You can buy AWS vouchers on Udemy's certification voucher pages, from Pearson VUE (AWS's authorized voucher store), or through an employer's bulk voucher programme. Udemy is a reseller: the exam itself is booked and delivered through Pearson VUE.",
  },
  {
    q: "Are Udemy AWS exam vouchers legitimate?",
    a: "Yes. Udemy sells the voucher directly on udemy.com, and the code is redeemed through the official AWS Certification account and Pearson VUE scheduling flow. Udemy is not the exam provider and does not issue the certification; AWS does. Buy only from the official Udemy page and keep your receipt.",
  },
  {
    q: "Do AWS exam vouchers expire?",
    a: "Yes. Udemy vouchers are valid for at least 9 months from purchase, and the expiry date cannot be extended. Second Chance vouchers are valid for at least 9 months from issuance. Check the date in My learning → Certifications and book before it closes.",
  },
  {
    q: "Can one voucher be used for any AWS exam?",
    a: "AWS vouchers are sold by level, not by individual exam. A Foundational voucher can be used for CLF-C02 or AIF-C01; an Associate voucher for any Associate exam; and a Professional or Specialty voucher for any exam at those levels. Udemy lists each voucher under a specific exam name, so confirm the coverage line on the voucher page before buying.",
  },
  {
    q: "How does Udemy Second Chance work?",
    a: "Second Chance is a retake add-on that must be bought with the original voucher. If you fail, open My learning → Certifications, choose Claim Second Chance, and Udemy verifies your result. A new code usually arrives within 7 days and is valid for at least 9 months. You must claim before the original voucher expires, and you get one extra attempt.",
  },
  {
    q: "Can I get a refund on an AWS exam voucher?",
    a: "No. Udemy exam vouchers, Second Chance and Retake Assurance are non-refundable and non-transferable, and the value is forfeited if the voucher expires. If you pass on the first attempt, the Second Chance portion is not refunded. Rescheduling is handled by Pearson VUE, not Udemy.",
  },
  {
    q: "Is a voucher cheaper than paying AWS directly?",
    a: "Not always. In our 2 November 2026 snapshot, Cloud Practitioner voucher-only was $87.50 against the $100 AWS list price, but AI Practitioner was $105 against $100 and Developer Associate was $157.50 against $150. Compare the live voucher-only price with the AWS list price. The + Second Chance bundle is a separate calculation because it covers two attempts.",
  },
  {
    q: "Can I use a Udemy coupon or Udemy credits on an AWS voucher?",
    a: "Udemy coupons and promo codes do not apply to exam vouchers. Udemy credits can be applied at checkout. Coupons do apply to AWS prep courses, which is why pairing a discounted course with a voucher is usually cheaper than buying either at full price.",
  },
  {
    q: "Can I use an AWS voucher for an online proctored exam?",
    a: "Yes. AWS exams can be taken at a Pearson VUE test centre or online with a proctor, and the voucher can be used for either format. You still need a compatible computer, a stable connection and valid ID for online proctoring.",
  },
  {
    q: "What happens if I fail and did not buy Second Chance?",
    a: "You can retake the exam after the AWS waiting period (currently 14 days) and pay the exam fee again. AWS sometimes runs limited-time free-retake or discount promotions, but they are not permanent. If a retake is likely, compare the Second Chance bundle before booking.",
  },
  {
    q: "Which AWS certification should I take first?",
    a: "If you are new to cloud, start with Cloud Practitioner (CLF-C02) or AI Practitioner (AIF-C01). If you already work in IT, Solutions Architect – Associate (SAA-C03) is the most common next step. Read our AWS certification guide for a full study path.",
    html: `If you are new to cloud, start with Cloud Practitioner (CLF-C02) or AI Practitioner (AIF-C01). If you already work in IT, Solutions Architect – Associate (SAA-C03) is the most common next step. Read our <a href="/blog/best-aws-certification-courses-2026/">AWS certification guide</a> for a full study path.`,
  },
  {
    q: "Are Udemy AWS vouchers available in my country?",
    a: "Availability and pricing vary by country, and the voucher is only valid in the country where you bought it. Udemy's launch excluded Japan; check the live voucher page for your country before paying.",
  },
];

const allDeals = await getDeals();
const awsRe = /(aws|amazon web services|cloud practitioner|solutions architect|sysops|cloudops)/i;
const starRe = /(stephane maarek)/i;
const prepDeals = allDeals
  .filter((d: any) => awsRe.test(`${d.title || ""} ${d.subcategory || ""} ${d.category || ""}`))
  .sort((a: any, b: any) => {
    const sa = starRe.test(`${a.instructor || ""}`) ? 0 : 1;
    const sb = starRe.test(`${b.instructor || ""}`) ? 0 : 1;
    if (sa !== sb) return sa - sb;
    return new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime();
  })
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "en-US",
      datePublished: publishedISO,
      dateModified: lastModified,
      isPartOf: { "@id": "https://courseswyn.com/#website" },
      about: { "@type": "Thing", name: "AWS Certification exam vouchers and discounts" },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      author: { "@type": "Person", name: "Andrew Derek", url: "https://courseswyn.com/about" },
      publisher: { "@id": "https://courseswyn.com/#organization" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://courseswyn.com/" },
        { "@type": "ListItem", position: 2, name: "Certification Vouchers", item: "https://courseswyn.com/udemy-certification-vouchers/" },
        { "@type": "ListItem", position: 3, name: "AWS Exam Vouchers", item: canonicalUrl },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#vouchers`,
      name: "AWS Exam Vouchers on Udemy",
      numberOfItems: totalAvailable,
      itemListElement: availableVouchers.map((v, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `https://www.udemy.com/certification-vouchers/${v.slug}/`,
        name: `${v.name} Exam Voucher`,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="article"
  pubDate={new Date(publishedISO)}
  updatedDate={now}
>
  <meta name="author" content="Andrew Derek" slot="head" />
  <meta
    name="keywords"
    content="udemy aws exam voucher, udemy aws voucher price, aws exam voucher discount, aws 50% discount voucher, aws cloud practitioner voucher clf-c02, aws solutions architect voucher saa-c03, udemy second chance aws, pearson vue aws voucher"
    slot="head"
  />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="cv-wrap">
    <VoucherHero      badgeHref="/how-we-test-and-verify-udemy-coupons"      badgeText={`Checked · ${total} AWS vouchers`}      titleA="AWS"      titleAccent="Exam Voucher Discount"      titleB="2026: Udemy Prices & 50% Off"      subHtml={`See what Udemy charges for <strong>voucher-only</strong> and <strong>+ Second Chance</strong> — Cloud Practitioner, Solutions Architect and more. Compare both with AWS list prices, and see how the <strong>50% AWS discount voucher</strong> works after you pass. The 50% comes from AWS, not a Udemy promo code. Updated ${dateFull}.`}      stats={[        { val: `${total}`, label: "vouchers compared" },        { val: "$87.50", label: "lowest voucher-only seen" },        { val: "50%", label: "AWS discount after you pass" },      ]}      primary={{ href: catalogUrl, text: "Compare AWS Vouchers →", external: true }}      secondary={{ href: "#voucher-prices", text: "See Voucher Prices" }}      noteHtml={`Sponsored — CoursesWyn may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a>`}      termLines={AWS_GROUPS.flatMap((g) => g.items).slice(0, 6).map((v) => ({ href: voucherAffUrl(v.slug), code: v.code, name: `${v.name} Voucher` }))}    />
    <div class="cv-meta">
      <span>By <a href="/about">Andrew Derek</a></span>
      <span class="cv-dot">·</span>
      <span>Updated <time datetime={lastModified}>{dateFull}</time></span>
      <span class="cv-dot">·</span>
      <span>
        Checked against{" "}
        <a href="https://aws.amazon.com/certification/policies/before-testing/#Exam_pricing" target="_blank" rel="noopener noreferrer">AWS exam pricing</a>{" "}
        and <a href="https://www.udemy.com/all-certification-vouchers/" target="_blank" rel="noopener noreferrer">Udemy voucher listings</a>
      </span>
    </div>

    <nav class="cv-toc" aria-label="On this page">
      <span class="cv-toc-label">On this page</span>
      <a href="#quick-answer">Quick answer</a>
      <a href="#voucher-prices">Voucher prices</a>
      <a href="#aws-50-percent">50% AWS discount</a>
      <a href="#aws-exam-fees">Exam fees</a>
      <a href="#vouchers">All vouchers</a>
      <a href="#which-voucher">Which voucher</a>
      <a href="#how-to-redeem">How to redeem</a>
      <a href="#second-chance">Second Chance</a>
      <a href="#worth-it">Is it worth it?</a>
      <a href="#faq">FAQ</a>
    </nav>

    <section class="cv-block cv-answer" id="quick-answer" aria-labelledby="quick-answer-title">
      <h2 id="quick-answer-title">AWS exam vouchers on Udemy: the short answer</h2>
      <p>
        An AWS exam voucher is a prepaid code for one exam attempt. Udemy sells them by level:{" "}
        <strong>Foundational ($100 AWS list)</strong>, <strong>Associate ($150)</strong>, and{" "}
        <strong>Professional or Specialty ($300)</strong>. Udemy's own price is set by Udemy, varies by country, and
        is not always lower than the AWS list price: we observed Cloud Practitioner voucher-only at $87.50, but
        AI Practitioner at $105 against a $100 list price.
      </p>
      <p>
        The optional <strong>Second Chance</strong> bundle adds a second attempt if you fail. It must be bought with
        the original voucher, covers one retake, and is not refunded if you pass first time. It is priced separately
        from voucher-only, so compare both before checkout.
      </p>
      <ul class="cv-check">
        <li><strong>Want the lowest single-exam price?</strong> Compare the voucher-only price with the AWS list price. If it is higher, book direct.</li>
        <li><strong>Already certified?</strong> Check the 50% AWS discount voucher in your Certification Account before buying — it can beat Udemy's price.</li>
        <li><strong>Want a safety net?</strong> Buy the + Second Chance bundle and claim it before the original voucher expires.</li>
        <li><strong>Not sure which exam?</strong> The voucher is level-based, so start with the level that matches your experience.</li>
      </ul>
    </section>

    <section class="cv-block" id="voucher-prices" aria-labelledby="prices-title">
      <h2 id="prices-title">Udemy AWS voucher prices: voucher-only vs Second Chance</h2>
      <p>
        Udemy shows two products on most AWS voucher pages: a <strong>voucher-only</strong> option for one attempt and
        a <strong>+ Second Chance</strong> bundle for two. The difference matters because the bundle is not a discount
        on a single exam — it is a prepayment for a retake you may never use.
      </p>
      <div class="cv-table-wrap">
        <table class="cv-table">
          <caption>Udemy AWS voucher prices observed on 2 November 2026 (USD)</caption>
          <thead>
            <tr>
              <th scope="col">Exam</th>
              <th scope="col">AWS list (1 attempt)</th>
              <th scope="col">Udemy voucher-only</th>
              <th scope="col">Udemy + Second Chance</th>
              <th scope="col">Saving vs 2 AWS attempts</th>
            </tr>
          </thead>
          <tbody>
            {voucherPrices.map((row) => (
              <tr>
                <th scope="row">{row.exam}</th>
                <td>{row.list}</td>
                <td>{row.only}</td>
                <td>{row.bundle}</td>
                <td><strong>{row.saving}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cv-note">
        Observed on Udemy's US product pages and voucher catalogue. Udemy rotates prices by country and promotion, and
        the catalogue and checkout can show different offers at the same time, so these are a snapshot, not a quote.
        Taxes may apply. “—” means we did not see a voucher-only price for that exam at the time of checking.
      </p>
      <p>
        Compare the voucher-only column with the <strong>AWS list price</strong>. In our snapshot, Cloud Practitioner
        and Solutions Architect Associate were cheaper on Udemy, while AI Practitioner and Developer Associate were
        slightly more expensive. The bundle only wins if you actually need the second attempt.
      </p>
    </section>

    <section class="cv-block cv-warn" id="aws-50-percent" aria-labelledby="fifty-title">
      <h2 id="fifty-title">The 50% AWS discount voucher most Udemy guides miss</h2>
      <p>
        Udemy is not the only way to cut the exam fee. AWS gives certified individuals a{" "}
        <strong>50% discount voucher</strong> for recertification or any other AWS exam. It sits in the Benefits
        section of your AWS Certification Account, and it is separate from anything you buy on Udemy.
      </p>
      <ul class="cv-check">
        <li><strong>How to earn it:</strong> pass an AWS certification exam, then open your AWS Certification Account → Benefits.</li>
        <li><strong>What it covers:</strong> 50% off recertification or another AWS exam, subject to AWS terms.</li>
        <li><strong>Why it matters:</strong> a 50% voucher on SAA-C03 takes the $150 fee down to $75 — less than the $131.25 voucher-only price we observed on Udemy.</li>
        <li><strong>Check first:</strong> if you already hold an AWS certification, look in Benefits before buying any voucher.</li>
      </ul>
      <p class="cv-note">
        Source: <a href="https://aws.amazon.com/certification/benefits/" target="_blank" rel="noopener noreferrer">AWS Certification benefits</a>{" "}
        and <a href="https://aws.amazon.com/certification/faqs/" target="_blank" rel="noopener noreferrer">AWS Certification FAQs</a>,
        checked 2 November 2026. The 50% discount voucher is issued by AWS, not Udemy, and cannot be bought.
      </p>
    </section>

    <section class="cv-block" id="aws-exam-fees" aria-labelledby="fees-title">
      <h2 id="fees-title">How much does an AWS exam cost in 2026?</h2>
      <p>
        AWS sets the price by exam level, not by individual certification. Every exam at a level costs the same, and
        the fee covers one attempt. The table below uses the 2026 USD list prices and shows which exams each Udemy
        voucher can cover.
      </p>
      <div class="cv-table-wrap">
        <table class="cv-table">
          <caption>AWS Certification exam fees and Udemy voucher coverage (USD)</caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Exams at this level</th>
              <th scope="col">AWS list price</th>
              <th scope="col">Udemy voucher covers</th>
            </tr>
          </thead>
          <tbody>
            {examLevels.map((row) => (
              <tr>
                <th scope="row">{row.level}</th>
                <td>{row.exams}</td>
                <td><strong>{row.fee}</strong></td>
                <td>{row.coverage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cv-note">
        Source: <a href="https://aws.amazon.com/certification/policies/before-testing/#Exam_pricing" target="_blank" rel="noopener noreferrer">AWS Certification exam pricing</a>,
        checked 2 November 2026. Taxes and local-currency prices may differ. Udemy's voucher price is separate from
        the AWS list price — see the <a href="#voucher-prices">voucher price table</a> for the observed voucher-only
        and bundle prices.
      </p>
    </section>

    <section class="cv-block" id="vouchers" aria-labelledby="vouchers-title">
      <h2 id="vouchers-title">Compare all {total} AWS exam vouchers on Udemy</h2>
      <p>
        Udemy currently lists {total} AWS voucher products; {totalAvailable} product pages were live at our last
        check. The product names are exam-specific, but the coverage line on each page says the voucher can be used
        for <strong>all exams at that level</strong>. That means you do not need a separate voucher for Developer and
        Solutions Architect — both are Associate-level.
      </p>
      <VoucherGrid groups={AWS_GROUPS} />
      <p class="cv-note">
        The ML Engineer – Associate card opens the Udemy catalog because its dedicated listing was not live at our
        last check — the Associate voucher still covers MLA-C01. Prices and stock change, so confirm the live price,
        expiry and coverage before paying.
      </p>
    </section>

    <section class="cv-block" id="which-voucher" aria-labelledby="which-title">
      <h2 id="which-title">Which AWS exam voucher do you need?</h2>
      <p>
        Choose the level that matches the exam you plan to sit, not the Udemy course you are studying. The voucher is
        not tied to a course, and buying the wrong level is an expensive mistake because vouchers are non-refundable.
      </p>
      <div class="cv-pick-grid">
        {voucherPicks.map((pick) => (
          <article class="cv-pick">
            <span class="cv-pick-tag">{pick.best}</span>
            <h3>{pick.level}</h3>
            <p>{pick.body}</p>
          </article>
        ))}
      </div>
      <p class="cv-note">
        Still deciding? Read the <a href="/blog/best-aws-certification-courses-2026/">AWS certification guide</a> or
        browse <a href="/topics/amazon-aws/">Amazon AWS courses</a> before you buy.
      </p>
    </section>

    <section class="cv-block" id="how-to-redeem" aria-labelledby="redeem-title">
      <h2 id="redeem-title">How to buy and redeem an AWS exam voucher</h2>
      <p>
        Buying the voucher and booking the exam are two separate steps. Udemy sells the code; AWS and Pearson VUE run
        the exam. Follow this order so you do not lose time or buy the wrong level.
      </p>
      <ol class="cv-steps">
        <li><strong>Choose the right level.</strong> Use the table above. Check that the voucher page says it can be used for all AWS exams at that level.</li>
        <li><strong>Choose voucher-only or + Second Chance.</strong> Second Chance cannot be added later, so decide before checkout.</li>
        <li><strong>Pay on Udemy.</strong> A card or Udemy credits work. Udemy coupons do not apply to vouchers.</li>
        <li><strong>Copy the code from My learning → Certifications.</strong> Udemy also emails it, but your account is the source of truth.</li>
        <li><strong>Create or sign in to your AWS Certification Account.</strong> Use <a href="https://aws.training/Certification" target="_blank" rel="noopener noreferrer">aws.training/Certification</a>. This is separate from your AWS console account.</li>
        <li><strong>Schedule with Pearson VUE.</strong> Choose an online proctored slot or a test centre, then paste the voucher code at checkout.</li>
        <li><strong>Book early enough to reschedule.</strong> You can reschedule up to 24 hours before the appointment, twice. The voucher expiry cannot be extended.</li>
      </ol>
      <div class="cv-callout">
        <strong>Before you pay, check:</strong> the exam level, the expiry date, your country's eligibility, whether
        Second Chance is included, and that the name on your AWS Certification Account matches your ID. The voucher is
        only valid in the country where you bought it.
