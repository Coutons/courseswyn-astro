---
import { readDeals } from '../../lib/store';

// Dynamic rendering in dev mode, static in production

// In production, pre-generate static paths
export async function getStaticPaths() {
  const allDeals = await readDeals();
  const paths = [];
  const generated = new Set();

  for (const deal of allDeals) {
    // Skip deals whose slug already ends with .amp (they'll be handled by the normal [slug].astro page)
    if (!deal.slug.endsWith('.amp') && !generated.has(deal.slug)) {
      generated.add(deal.slug);
      paths.push({
        params: { slug: deal.slug },
        props: { deal }
      });
    }
  }
  return paths;
}

let { deal } = Astro.props as { deal: any };

if (!deal) {
  // SSR / Dev mode fallback
  const { slug } = Astro.params;
  const allDeals = await readDeals();
  deal = allDeals.find((d) => d.slug === slug);
}

if (!deal) {
  return new Response('Deal not found', { status: 404 });
}

const discountPercentage = deal.originalPrice && deal.price && deal.originalPrice > deal.price
  ? Math.round(((deal.originalPrice - deal.price) / deal.originalPrice) * 100)
  : 0;

const metaDescription = (deal.seoDescription || `${deal.title} is available with a verified coupon and ${discountPercentage > 0 ? `up to ${discountPercentage}% off` : "a discount"}${deal.students ? `, taken by ${deal.students.toLocaleString("en-US")} students` : ""}${deal.duration ? `, covering about ${deal.duration} of video content` : ""}. ${deal.category ? `This ${deal.category} course walks you through real-world skills` : "Explore the course overview"} and learning objectives before you enroll.`).trim();
---

<!doctype html>
<html ⚡ lang="en">
<head>
  <meta charset="utf-8">
  <script async src="https://cdn.ampproject.org/v0.js"></script>
  <script async custom-element="amp-img" src="https://cdn.ampproject.org/v0/amp-img-0.1.js"></script>
  <script async custom-element="amp-analytics" src="https://cdn.ampproject.org/v0/amp-analytics-0.1.js"></script>
  <script async custom-element="amp-sidebar" src="https://cdn.ampproject.org/v0/amp-sidebar-0.1.js"></script>

  <title>{deal.title} | {discountPercentage}% Off Udemy (Coupon) - CoursesWyn</title>
  <meta name="description" content={metaDescription}>
  <link rel="canonical" href={`https://courseswyn.com/coupon/${deal.slug}`}>
  <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- AMP Boilerplate -->
  <style amp-boilerplate>body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}</style><noscript><style amp-boilerplate>body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}</style></noscript>

  <style amp-custom>
    body {
      font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      padding: 0;
      background: #f4f6f8;
      color: #161a20;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem;
    }

    .header {
      background: #ffffff;
      padding: 2rem 0;
      text-align: center;
      border-bottom: 1px solid #e2e6ec;
    }

    h1 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 1rem;
      color: #161a20;
      text-shadow: 0 2px 4px rgba(0,0,0,0.08);
    }

    .price-section {
      background: #ffffff;
      border: 1px solid #e2e6ec;
      border-radius: 8px;
      padding: 1.5rem;
      margin: 2rem 0;
      text-align: center;
    }

    .price {
      font-size: 2rem;
      font-weight: 800;
      color: #161a20;
      margin-bottom: 0.5rem;
    }

    .discount {
      color: #d14343;
      font-weight: 700;
      font-size: 1.1rem;
    }

    .cta-button {
      display: inline-block;
      background: #00a76f;
      color: #fff;
      padding: 1rem 2rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      margin-top: 1rem;
    }

    .content {
      margin: 2rem 0;
      line-height: 1.7;
    }

    .related {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #e2e6ec;
    }

    .related h2 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #161a20;
    }

    .amp-img {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="container">
      <h1>{deal.title}</h1>
      <p>{deal.description}</p>
    </div>
  </header>

  <main class="container">
    <section class="price-section">
      <div class="price">
        ${deal.price}
        {discountPercentage > 0 && <span class="discount"> ({discountPercentage}% OFF)</span>}
      </div>
      <a href={deal.url} class="cta-button" target="_blank" rel="noopener noreferrer">
        Get Course Now
      </a>
    </section>

    {deal.image && (
      <amp-img
        src={deal.image}
        alt={deal.title}
        width="400"
        height="190"
        layout="responsive"
        class="amp-img"
      ></amp-img>
    )}

    <div class="content">
      <h2>About This Course</h2>
      <div>{(deal.description || '').replace(/<[^>]*>/g, '')}</div>

      {deal.learn && deal.learn.length > 0 && (
        <div>
          <h3>What you'll learn:</h3>
          <ul>
            {deal.learn.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </div>

    <div class="related">
      <h2>More Course Deals</h2>
      <p>Check out more discounted courses on CoursesWyn.</p>
      <a href="/udemy-coupon-code" class="cta-button">Browse All Deals</a>
    </div>
  </main>

  <!-- AMP Analytics -->
  <amp-analytics type="googleanalytics">
    <script type="application/json">
    {
      "vars": {
        "account": "G-VPY4HMMKBH"
      },
      "triggers": {
        "trackPageview": {
          "on": "visible",
          "request": "pageview"
        }
      }
    }
    </script>
  </amp-analytics>
</body>
</html>
