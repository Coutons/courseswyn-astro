---
import Layout from "../../layouts/Layout.astro";
import { getDealById, readDeals } from "../../lib/store";
import { slugifyCategory } from "../../lib/utils";
import DealPage from "../../components/DealPage";
import type { Deal } from "../../types/deal.d.ts";

export async function getStaticPaths() {
  const allDeals = await readDeals();
  const paths = [];
  const generated = new Set();

  for (const deal of allDeals) {
    const s = deal.slug || deal.id;
    if (!s.endsWith('.amp') && !generated.has(s)) {
      generated.add(s);
      paths.push({
        params: { slug: s },
        props: { deal, allDeals }
      });
    }
  }

  return paths;
}

const { deal: propDeal, allDeals: propAllDeals } = Astro.props as {
  deal?: Deal;
  allDeals?: Deal[];
};

let deal: Deal;
let allDeals: Deal[];

if (import.meta.env.PROD) {
  if (!propDeal || !propAllDeals) {
    throw new Error('Missing props in production mode');
  }
  deal = propDeal;
  allDeals = propAllDeals;
} else {
  const { slug } = Astro.params;
  allDeals = await readDeals();
  const foundDeal = allDeals.find((d) => d.id === slug || d.slug === slug);

  if (!foundDeal) {
    return new Response(null, {
      status: 302,
      headers: { 'Location': '/' }
    });
  }

  deal = foundDeal;
}

const relatedDeals = allDeals
  .filter((d) => {
    if (d.id === deal.id) return false;
    if (deal.subcategory && d.subcategory) {
      return d.subcategory === deal.subcategory;
    }
    return d.category === deal.category;
  })
  .slice(0, 6);

const discountPercentage = deal.originalPrice && deal.price && deal.originalPrice > deal.price
  ? Math.round(((deal.originalPrice - deal.price) / deal.originalPrice) * 100)
  : 0;

const siteUrl = "https://courseswyn.com";
const dealUrl = `${siteUrl}/coupon/${deal.slug || deal.id}`;
const orgName = "CoursesWyn";
const totalDeals = allDeals.length;
const avgRating = totalDeals > 0
  ? (allDeals.reduce((sum, d) => sum + (d.rating || 0), 0) / allDeals.filter(d => d.rating).length).toFixed(1)
  : "4.5";
---

<Layout
    title={`${deal.title} - ${discountPercentage}% OFF Udemy Coupon`}
    description={(deal.seoDescription || deal.description)?.slice(0, 155) + ((deal.seoDescription || deal.description)?.length > 155 ? '...' : '')}
    image={deal.seoOgImage || deal.image}
    canonical={dealUrl}
>
    <script type="application/ld+json" set:html={
        JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": `${siteUrl}/#organization`,
                    "name": orgName,
                    "url": siteUrl,
                    "logo": {
                        "@type": "ImageObject",
                        "url": `${siteUrl}/logo.svg`
                    },
                    "sameAs": [
                        "https://www.facebook.com/courseswyn",
                        "https://twitter.com/courseswyn"
                    ],
                    "aggregateRating": {
                        "@type": "AggregateRating",
                        "ratingValue": avgRating,
                        "bestRating": "5",
                        "ratingCount": totalDeals,
                        "reviewCount": totalDeals
                    }
                },
                {
                    "@type": "WebSite",
                    "@id": `${siteUrl}/#website`,
                    "url": siteUrl,
                    "name": orgName,
                    "description": "Find the best Udemy coupon codes and course deals. Save up to 100% on thousands of courses updated daily.",
                    "publisher": { "@id": `${siteUrl}/#organization` },
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${siteUrl}/search?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    },
                    "inLanguage": "en-US"
                },
                {
                    "@type": "Course",
                    "@id": `${dealUrl}#course`,
                    "name": deal.title,
                    "description": deal.seoDescription || deal.description || `${deal.title} - Learn from expert instructors with verified coupons`,
                    "url": dealUrl,
                    "image": deal.seoOgImage || deal.image || `${siteUrl}/logo.svg`,
                    "provider": {
                        "@type": "Organization",
                        "name": deal.provider || "Udemy",
                        "url": deal.provider === "Udemy" ? "https://www.udemy.com" : siteUrl
                    },
                    "instructor": deal.instructor ? {
                        "@type": "Person",
                        "name": deal.instructor,
                        "jobTitle": "Course Instructor",
                        "affiliation": {
                            "@type": "Organization",
                            "name": deal.provider || "Udemy"
                        }
                    } : undefined,
                    "offers": {
                        "@type": "Offer",
                        "price": deal.price || 0,
                        "priceCurrency": "USD",
                        "availability": "https://schema.org/InStock",
                        "validThrough": deal.expiresAt || undefined,
                        "url": deal.url || dealUrl,
                        "seller": { "@id": `${siteUrl}/#organization` },
                        "hasMerchantReturnPolicy": {
                            "@type": "MerchantReturnPolicy",
                            "merchantReturnDays": 30,
                            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow"
                        }
                    },
                    "aggregateRating": deal.rating ? {
                        "@type": "AggregateRating",
                        "ratingValue": deal.rating,
                        "ratingCount": deal.students || 1,
                        "bestRating": 5,
                        "worstRating": 1
                    } : undefined,
                    "timeRequired": deal.duration ? `PT${deal.duration.replace(/[^\d]/g, '')}H` : undefined,
                    "inLanguage": deal.language || "en",
                    "teaches": deal.learn ? deal.learn.map((l) => l.replace(/\r$/, '')).join(", ") : (deal.skills?.length ? deal.skills.join(", ") : undefined),
                    "educationalLevel": deal.level || "Beginner to Advanced",
                    "educationalUse": "Professional Development",
                    "datePublished": deal.createdAt ? new Date(deal.createdAt).toISOString() : new Date().toISOString(),
                    "dateModified": deal.updatedAt ? new Date(deal.updatedAt).toISOString() : new Date().toISOString(),
                    "hasCourseInstance": {
                        "@type": "CourseInstance",
                        "courseMode": "online",
                        "instructor": deal.instructor ? {
                            "@type": "Person",
                            "name": deal.instructor
                        } : undefined,
                        "location": { "@type": "Place", "name": "Online" }
                    }
                },
                {
                    "@type": "Product",
                    "@id": `${dealUrl}#product`,
                    "name": `${deal.title} - ${discountPercentage}% OFF`,
                    "description": deal.seoDescription || deal.description || `${deal.title} Udemy coupon deal`,
                    "image": deal.seoOgImage || deal.image || `${siteUrl}/logo.svg`,
                    "brand": {
                        "@type": "Brand",
                        "name": deal.provider || "Udemy"
                    },
                    "offers": {
                        "@type": "Offer",
                        "price": deal.price || 0,
                        "priceCurrency": "USD",
                        "priceValidUntil": deal.expiresAt || undefined,
                        "availability": "https://schema.org/InStock",
                        "url": deal.url || dealUrl,
                        "seller": { "@id": `${siteUrl}/#organization` },
                        "hasMerchantReturnPolicy": {
                            "@type": "MerchantReturnPolicy",
                            "merchantReturnDays": 30,
                            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow"
                        },
                        "discount": `${discountPercentage}%`,
                        "discountCode": deal.coupon
                    },
                    "aggregateRating": deal.rating ? {
                        "@type": "AggregateRating",
                        "ratingValue": deal.rating,
                        "reviewCount": deal.students || 1,
                        "bestRating": 5,
                        "worstRating": 1
                    } : undefined
                },
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
                        { "@type": "ListItem", "position": 2, "name": "Deals", "item": siteUrl },
                        ...(deal.category ? [{ "@type": "ListItem", "position": 3, "name": deal.category, "item": `${siteUrl}/categories/${slugifyCategory(deal.category)}` }] : []),
                        { "@type": "ListItem", "position": deal.category ? 4 : 3, "name": deal.title, "item": dealUrl }
                    ]
                },
                ...(deal.faqs?.length ? [{
                    "@type": "FAQPage",
                    "@id": `${dealUrl}#faq`,
                    "mainEntity": deal.faqs.slice(0, 5).map((faq) => ({
                        "@type": "Question",
                        "name": faq.q,
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": faq.a.replace(/<[^>]*>/g, '').trim()
                        }
                    }))
                }] : []),
                {
                    "@type": "WebPage",
                    "@id": `${dealUrl}#webpage`,
                    "url": dealUrl,
                    "name": `${deal.title} - Udemy Coupon & Discount Code`,
                    "description": `Get ${deal.title} with ${discountPercentage > 0 ? discountPercentage + '% off' : 'a discount'} using verified coupon code. ${deal.students ? deal.students.toLocaleString() + ' students enrolled.' : ''} Limited time offer.`,
                    "inLanguage": "en-US",
                    "isPartOf": { "@id": `${siteUrl}/#website` },
                    "datePublished": deal.createdAt ? new Date(deal.createdAt).toISOString() : new Date().toISOString(),
                    "dateModified": deal.updatedAt ? new Date(deal.updatedAt).toISOString() : new Date().toISOString(),
                    "publisher": { "@id": `${siteUrl}/#organization` },
                    "speakable": {
                        "@type": "SpeakableSpecification",
                        "cssSelector": ["h1", "p", ".prose"]
                    }
                },
                ...(deal.rating ? [{
                    "@type": "Review",
                    "@id": `${dealUrl}#review`,
                    "itemReviewed": { "@id": `${dealUrl}#course` },
                    "reviewRating": {
                        "@type": "Rating",
                        "ratingValue": deal.rating,
                        "bestRating": 5,
                        "worstRating": 1
                    },
                    "author": {
                        "@type": "Organization",
                        "name": orgName,
                        "url": siteUrl
                    },
                    "publisher": { "@id": `${siteUrl}/#organization` },
                    "datePublished": deal.updatedAt ? new Date(deal.updatedAt).toISOString() : new Date().toISOString(),
                    "reviewBody": `${deal.title} has a rating of ${deal.rating} out of 5 based on ${(deal.students || 0).toLocaleString()} student reviews.${deal.instructor ? ` Taught by ${deal.instructor}.` : ''}`
                }] : []),
                {
                    "@type": "HowTo",
                    "@id": `${dealUrl}#howto`,
                    "name": "How to Redeem This Coupon",
                    "description": `Follow these steps to enroll in ${deal.title} at the discounted price.`,
                    "step": [
                        {
                            "@type": "HowToStep",
                            "position": 1,
                            "name": "Click Get Coupon",
                            "text": "Click the 'Get Coupon' button on this page."
                        },
                        {
                            "@type": "HowToStep",
                            "position": 2,
                            "name": "Go to Checkout",
                            "text": `You'll be redirected to ${deal.provider || 'Udemy'} checkout page with the discount auto-applied.`
                        },
                        {
                            "@type": "HowToStep",
                            "position": 3,
                            "name": "Sign In or Sign Up",
                            "text": `Log into your ${deal.provider || 'Udemy'} account or create a free account.`
                        },
                        {
                            "@type": "HowToStep",
                            "position": 4,
                            "name": "Enroll",
                            "text": `Verify the discounted price and click 'Enroll Now' to start learning.`
                        }
                    ],
                    "totalTime": "PT2M",
                    "estimatedCost": {
                        "@type": "MonetaryAmount",
                        "currency": "USD",
                        "value": deal.price || 0
                    },
                    "supply": {
                        "@type": "HowToSupply",
                        "name": `${deal.provider || 'Udemy'} account`
                    }
                }
            ]
        })
    } />

    <DealPage client:load deal={deal} relatedDeals={relatedDeals} />

</Layout>
