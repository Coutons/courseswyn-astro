---
import Layout from "../../layouts/Layout.astro";
import { readDeals } from "../../lib/store";
import { slugifyCategory, slugifyTopic } from "../../lib/utils";
import { maskCoupon } from "../../lib/couponMask";
import { categoryStats, couponFAQs, isDealExpired } from "../../lib/dealStats";
import { parseInstructors, createInstructorSlug } from "../../lib/instructors";
import { getInstructorImage } from "../../lib/instructorProfiles";
import { generateSeoDescription } from "../../lib/seo";
import DealPage from "../../components/DealPage";
import type { Deal } from "../../types/deal.d.ts";

export async function getStaticPaths() {
  const allDeals = await readDeals();
  const paths = [];
  const generated = new Set();

  for (const deal of allDeals) {
    const s = deal.slug;
    if (!generated.has(s)) {
      generated.add(s);
      paths.push({
        params: { slug: s },
        props: { deal, allDeals }
      });
    }
  }

  return paths;
}

const { deal: propDeal, allDeals: propAllDeals } = Astro.props as {
  deal?: Deal;
  allDeals?: Deal[];
};

let deal: Deal;
let allDeals: Deal[];

if (import.meta.env.PROD) {
  if (!propDeal || !propAllDeals) {
    throw new Error('Missing props in production mode');
  }
  deal = propDeal;
  allDeals = propAllDeals;
} else {
  const { slug } = Astro.params;
  allDeals = await readDeals();
  const foundDeal = allDeals.find((d) => d.slug === slug);

  if (!foundDeal) {
    return new Response(null, {
      status: 302,
      headers: { 'Location': '/' }
    });
  }

  deal = foundDeal;
}

const pickedSlugs = new Set<string>([deal.slug]);
const relatedDeals: Deal[] = [];
// 1) same subcategory, 2) same category, 3) top-rated fallback — always fill to 6
for (const d of allDeals) {
  if (relatedDeals.length >= 6) break;
  if (pickedSlugs.has(d.slug)) continue;
  if (deal.subcategory && d.subcategory && d.subcategory === deal.subcategory) {
    relatedDeals.push(d);
    pickedSlugs.add(d.slug);
  }
}
for (const d of allDeals) {
  if (relatedDeals.length >= 6) break;
  if (pickedSlugs.has(d.slug)) continue;
  if (deal.category && d.category && d.category === deal.category) {
    relatedDeals.push(d);
    pickedSlugs.add(d.slug);
  }
}
if (relatedDeals.length < 6) {
  const topRated = [...allDeals]
    .filter((d) => !pickedSlugs.has(d.slug) && (d.rating ?? 0) >= 4.5)
    .sort((a, b) => ((b.rating ?? 0) - (a.rating ?? 0)) || ((b.students ?? 0) - (a.students ?? 0)));
  for (const d of topRated) {
    if (relatedDeals.length >= 6) break;
    relatedDeals.push(d);
    pickedSlugs.add(d.slug);
  }
}

const discountPercentage = deal.originalPrice && deal.price && deal.originalPrice > deal.price
  ? Math.round(((deal.originalPrice - deal.price) / deal.originalPrice) * 100)
  : 0;

const couponFaqList = couponFAQs(deal);
const dealFaqList = deal.faqs || [];
const faqPageEntities = [...couponFaqList, ...dealFaqList]
  .slice(0, 10)
  .map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a.replace(/<[^>]*>/g, '').trim()
    }
  }));

const catStats = categoryStats(deal, allDeals);

const primaryInstructorName = parseInstructors(deal.instructor)[0];
const instructorImage = primaryInstructorName
  ? await getInstructorImage(createInstructorSlug(primaryInstructorName))
  : undefined;
const instructorImages: Record<string, string> = {};
for (const n of parseInstructors(deal.instructor)) {
  const s = createInstructorSlug(n);
  if (s && !instructorImages[s]) {
    const img = await getInstructorImage(s);
    if (img) instructorImages[s] = img;
  }
}

const normalizedTitle = deal.title?.trim() || "Premium Course";
const isFreeCoupon = (deal.price ?? 0) === 0;
const discountLabel = isFreeCoupon ? "FREE" : discountPercentage > 0 ? `${discountPercentage}% OFF` : "Discount";
const seoTitle = `${normalizedTitle} - ${discountLabel} Udemy Coupon`;
const seoDescription = generateSeoDescription(deal);

const siteUrl = "https://courseswyn.com";
const dealUrl = `${siteUrl}/coupon/${deal.slug}`;
const orgName = "CoursesWyn";

const couponMask = maskCoupon(deal.coupon);
const clientDeal: Deal = { ...deal };
delete clientDeal.coupon;

// Expired pages stay published for users (affiliate), but machine-readable
// markup must not claim a dead coupon is in stock.
const dealExpired = isDealExpired(deal);
const offerAvailability = dealExpired ? "https://schema.org/OutOfStock" : "https://schema.org/InStock";

// Robust ISO 8601 duration: "18.5 hours" -> PT18H30M (a naive digit-strip
// would wrongly produce PT185H). Returns undefined when unparseable.
function toISO8601Duration(input?: string): string | undefined {
  if (!input) return undefined;
  const m = input.match(/(\d+(?:[.,]\d+)?)\s*(hours?|hrs?|minutes?|mins?)/i);
  if (!m) return undefined;
  const val = parseFloat(m[1].replace(",", "."));
  if (isNaN(val)) return undefined;
  if (/^min/i.test(m[2])) {
    const h = Math.floor(val / 60);
    const min = Math.round(val % 60);
    if (!h && !min) return undefined;
    return `PT${h > 0 ? `${h}H` : ""}${min > 0 ? `${min}M` : ""}`;
  }
  const h = Math.floor(val);
  const min = Math.round((val - h) * 60);
  return `PT${h}H${min > 0 ? `${min}M` : ""}`;
}

// Stable dates: never fall back to build time (it would shift every deploy).
const datePublished = deal.createdAt ? new Date(deal.createdAt).toISOString() : undefined;
const dateModified = deal.updatedAt ? new Date(deal.updatedAt).toISOString() : datePublished;
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={deal.seoOgImage || deal.image}
    canonical={dealUrl}
    type="website"
>
    <Fragment slot="head">
        <meta property="product:retailer_item_id" content={deal.slug} />
        <meta property="product:price:amount" content={String(deal.price ?? 0)} />
        <meta property="product:price:currency" content="USD" />
    </Fragment>
    <script type="application/ld+json" set:html={
        JSON.stringify({
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": `${siteUrl}/#organization`,
                    "name": orgName,
                    "url": siteUrl,
                    "logo": {
                        "@type": "ImageObject",
                        "url": `${siteUrl}/logo.svg`
                    },
                    "sameAs": [
                        "https://www.facebook.com/courseswyn",
                        "https://twitter.com/courseswyn"
                    ]
                },
                {
                    "@type": "WebSite",
                    "@id": `${siteUrl}/#website`,
                    "url": siteUrl,
                    "name": orgName,
                    "description": `Find the best Udemy coupon codes and course deals. Save up to ${discountPercentage || 95}% on thousands of courses updated daily.`,
                    "publisher": { "@id": `${siteUrl}/#organization` },
                    "potentialAction": {
                        "@type": "SearchAction",
                        "target": {
                            "@type": "EntryPoint",
                            "urlTemplate": `${siteUrl}/search?q={search_term_string}`
                        },
                        "query-input": "required name=search_term_string"
                    },
                    "inLanguage": "en-US"
                },
                {
                    "@type": "Course",
                    "@id": `${dealUrl}#course`,
                    "name": deal.title,
                    "description": generateSeoDescription(deal),
                    "url": dealUrl,
                    "image": deal.seoOgImage || deal.image || `${siteUrl}/logo.svg`,
                    "provider": {
                        "@type": "Organization",
                        "name": deal.provider || "Udemy",
                        "url": deal.provider === "Udemy" ? "https://www.udemy.com" : siteUrl
                    },
                    "instructor": deal.instructor ? parseInstructors(deal.instructor).map((name) => ({
                        "@type": "Person",
                        "name": name,
                        "jobTitle": "Course Instructor",
                        "affiliation": {
                            "@type": "Organization",
                            "name": deal.provider || "Udemy"
                        }
                    })) : undefined,
                    "offers": {
                        "@type": "Offer",
                        "price": deal.price || 0,
                        "priceCurrency": "USD",
                        "availability": offerAvailability,
                        "validThrough": deal.expiresAt || undefined,
                        "url": deal.url || dealUrl,
                        "seller": { "@id": `${siteUrl}/#organization` },
                            "hasMerchantReturnPolicy": {
                                "@type": "MerchantReturnPolicy",
                                "merchantReturnDays": 30,
                                "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow"
                            }
                        },
                        "timeRequired": toISO8601Duration(deal.duration),
                    "inLanguage": deal.language || "en",
                    "teaches": deal.learn ? deal.learn.map((l) => l.replace(/\r$/, '')).join(", ") : (deal.skills?.length ? deal.skills.join(", ") : undefined),
                    "educationalLevel": deal.level || "Beginner to Advanced",
                    "educationalUse": "Professional Development",
                    "datePublished": datePublished,
                    "dateModified": dateModified,
                    "hasCourseInstance": {
                        "@type": "CourseInstance",
                        "courseMode": "online",
                        "instructor": deal.instructor ? parseInstructors(deal.instructor).map((name) => ({
                            "@type": "Person",
                            "name": name
                        })) : undefined,
                        "location": { "@type": "Place", "name": "Online" }
                    }
                },
                {
                    "@type": "Product",
                    "@id": `${dealUrl}#product`,
                    "name": seoTitle,
                    "description": seoDescription,
                    "image": deal.seoOgImage || deal.image || `${siteUrl}/logo.svg`,
                    "brand": {
                        "@type": "Brand",
                        "name": deal.provider || "Udemy"
                    },
                    "offers": {
                        "@type": "Offer",
                        "price": deal.price || 0,
                        "priceCurrency": "USD",
                        "priceValidUntil": deal.expiresAt || undefined,
                        "availability": offerAvailability,
                        "url": deal.url || dealUrl,
                        "seller": { "@id": `${siteUrl}/#organization` },
                        "hasMerchantReturnPolicy": {
                            "@type": "MerchantReturnPolicy",
                            "merchantReturnDays": 30,
                            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow"
                        },
                        "discount": `${discountPercentage}%`
                    }
                },
                {
                    "@type": "BreadcrumbList",
                    "itemListElement": [
                        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
                        { "@type": "ListItem", "position": 2, "name": "Coupons", "item": `${siteUrl}/udemy-coupon-code` },
                        ...(deal.category ? [{ "@type": "ListItem", "position": 3, "name": deal.category, "item": `${siteUrl}/categories/${slugifyCategory(deal.category)}` }] : []),
                        ...(deal.subcategory && deal.subcategory !== deal.category
                            ? [{ "@type": "ListItem", "position": deal.category ? 4 : 3, "name": deal.subcategory, "item": `${siteUrl}/topics/${slugifyTopic(deal.subcategory)}` }]
                            : [{ "@type": "ListItem", "position": deal.category ? 4 : 3, "name": deal.title, "item": dealUrl }])
                    ]
                },
                ...(faqPageEntities.length ? [{
                    "@type": "FAQPage",
                    "@id": `${dealUrl}#faq`,
                    "mainEntity": faqPageEntities
                }] : []),
                {
                    "@type": "WebPage",
                    "@id": `${dealUrl}#webpage`,
                    "url": dealUrl,
                    "name": seoTitle,
                    "description": `${seoDescription} ${deal.students ? `${deal.students.toLocaleString()} students enrolled.` : ''} Limited time offer.`,
                    "inLanguage": "en-US",
                    "isPartOf": { "@id": `${siteUrl}/#website` },
                    "datePublished": datePublished,
                    "dateModified": dateModified,
                    "publisher": { "@id": `${siteUrl}/#organization` },
                    "speakable": {
                        "@type": "SpeakableSpecification",
                        "cssSelector": ["h1", "p", ".prose"]
                    }
                },
                {
                    "@type": "HowTo",
                    "@id": `${dealUrl}#howto`,
                    "name": "How to Redeem This Coupon",
                    "description": `Follow these steps to enroll in ${deal.title} at the discounted price.`,
                    "step": [
                        {
                            "@type": "HowToStep",
                            "position": 1,
                            "name": "Click Get Coupon",
                            "text": "Click the 'Get Coupon' button on this page."
                        },
                        {
                            "@type": "HowToStep",
                            "position": 2,
                            "name": "Go to Checkout",
                            "text": `You'll be redirected to ${deal.provider || 'Udemy'} checkout page with the discount auto-applied.`
                        },
                        {
                            "@type": "HowToStep",
                            "position": 3,
                            "name": "Sign In or Sign Up",
                            "text": `Log into your ${deal.provider || 'Udemy'} account or create a free account.`
                        },
                        {
                            "@type": "HowToStep",
                            "position": 4,
                            "name": "Enroll",
                            "text": `Verify the discounted price and click 'Enroll Now' to start learning.`
                        }
                    ],
                    "totalTime": "PT2M",
                    "estimatedCost": {
                        "@type": "MonetaryAmount",
                        "currency": "USD",
                        "value": deal.price || 0
                    },
                    "supply": {
                        "@type": "HowToSupply",
                        "name": `${deal.provider || 'Udemy'} account`
                    }
                }
            ]
        })
    } />

    <DealPage client:load deal={clientDeal} relatedDeals={relatedDeals} catStats={catStats} instructorImage={instructorImage} instructorImages={instructorImages} couponMask={couponMask} />

</Layout>
