---
import Layout from '../../layouts/Layout.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getDeals } from '../../lib/store.js';
import { formatDateWIB, toISODateWIB } from '../../lib/date';

const allDeals = await getDeals();
const now = new Date();

const todayStr = toISODateWIB(now);
const isUpdatedToday = (d: { updatedAt?: string; createdAt?: string }) => {
  const raw = d.updatedAt || d.createdAt || '';
  if (!raw) return false;
  return toISODateWIB(new Date(raw)) === todayStr;
};

const todayDeals = allDeals.filter(isUpdatedToday);
const activeToday = todayDeals.filter(d => !d.expiresAt || new Date(d.expiresAt) > now);

// Single deduped grid: free+paid sorted freshest first (fix freeDeals unused + duplicate grids)
const todayGridDeals = [...activeToday]
  .sort((a, b) => new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime())
  .slice(0, 48);

const todayAdded = todayDeals.length;
const totalActive = activeToday.length;
const totalCoupons = allDeals.length;
const freeCount = activeToday.filter(d => d.price === 0).length;

const decodeHtml = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

const topicCounts: Record<string, number> = {};
for (const d of activeToday) {
  const sub = d.subcategory ? decodeHtml(d.subcategory) : '';
  if (sub) {
    topicCounts[sub] = (topicCounts[sub] || 0) + 1;
  }
}
const totalTopics = Object.keys(topicCounts).length;
const trendingTopics = Object.entries(topicCounts).sort((a, b) => b[1] - a[1]).slice(0, 12);

const dateFull = formatDateWIB(now, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const latestUpdate = todayDeals.reduce((latest, d) => {
  const t = new Date(d.updatedAt || d.createdAt || 0).getTime();
  return t > latest ? t : latest;
}, 0);
const latestUpdateIso = latestUpdate ? new Date(latestUpdate).toISOString() : now.toISOString();
const diffMs = now.getTime() - latestUpdate;
const diffMin = Math.floor(diffMs / 60000);
let lastVerified;
if (diffMin < 1) lastVerified = 'Just now';
else if (diffMin < 60) lastVerified = `${diffMin}m ago`;
else {
  const diffHr = Math.floor(diffMin / 60);
  lastVerified = diffHr < 24 ? `${diffHr}h ago` : `${Math.floor(diffHr / 24)}d ago`;
}

const expiringCount = activeToday
  .filter(d => d.expiresAt)
  .filter(d => {
    const diff = new Date(d.expiresAt!).getTime() - now.getTime();
    return diff > 0 && diff < 7 * 24 * 3600000;
  }).length;

const discountPcts = activeToday
  .filter(d => d.price && d.originalPrice && d.originalPrice > d.price)
  .map(d => Math.round(100 - (d.price / d.originalPrice!) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;

const siteUrl = "https://courseswyn.com";
const pageUrl = `${siteUrl}/udemy-coupons-today/`;
const shortDate = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Jakarta', year: 'numeric', month: 'long', day: 'numeric' }).format(now);
const pageTitle = todayAdded > 0
  ? `${todayAdded} Verified Udemy Coupons Today — ${shortDate} | Save Up To ${maxDiscountPct}% | CoursesWyn`
  : `Udemy Coupons Today (${shortDate}) — Fresh Verified Deals | CoursesWyn`;
const metaDescription = todayAdded > 0
  ? `${todayAdded} fresh Udemy coupon codes verified today (${shortDate}). ${totalActive} active deals, save up to ${maxDiscountPct}% — checked ${lastVerified}, expires in hours.`
  : `Fresh Udemy coupons updated ${lastVerified} — ${totalActive} verified codes today. No code? Try Udemy Personal Plan with 26,000+ courses.`;
const pageKeywords = [
  "udemy coupons today", "udemy coupon today", "todays udemy coupons",
  "new udemy coupon", "fresh udemy coupon codes today", "udemy deals today",
  "udemy discount today", "free udemy coupon", "verified udemy coupons", "udemy promo code"
].join(", ");

const shareUrl = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(`🔥 ${todayAdded} verified Udemy coupons added today — save up to ${maxDiscountPct}%! Checked by CoursesWyn: `);
const whatsappUrl = `https://wa.me/?text=${shareText}${shareUrl}`;
const xUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;

function slugify(s: string) {
  return s.toLowerCase().replace(/\s+&\s+/g, '-and-').replace(/['\s]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
}

function cleanDesc(s: string) {
  return String(s || "").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim().slice(0, 120);
}

const faqs = [
  { q: "What's the difference between Today's Coupons and the full coupon page?", a: "Today's Coupons highlights only deals added or updated in the last 24 hours — the freshest, most likely to still work. Our <a href='/udemy-coupon-code'>full coupon code page</a> lists every verified deal, sorted by newest first, with category filters and pagination." },
  { q: "Are these Udemy coupons verified today?", a: "Yes. Every coupon on this page was re-verified against Udemy before listing. The timestamp <em>Updated " + lastVerified + " WIB</em> shows the last check; expired codes disappear automatically." },
  { q: "How long do Udemy coupons added today last?", a: "Since Udemy's 2025 policy update most coupons are capped at 10-100 redemptions and expire within days. We recommend enrolling immediately — " + expiringCount + " of today's coupons already expire within 7 days." },
  { q: "How do I redeem a Udemy coupon from today's list?", a: "Click the course card to open its deal page on CoursesWyn, then click 'Claim Coupon'. You'll land on Udemy with the discount pre-applied. Complete enrollment there — no manual code entry needed." },
  { q: "Do discounted courses from today include certificates?", a: "Yes. Courses enrolled via today's coupons include lifetime access, downloadable resources, and an official Udemy completion certificate when you finish the course." },
  { q: "How often are new Udemy coupons added today?", a: "New coupons are added throughout the day as instructors publish them. We check Udemy in near real time and update this list automatically — checking back every few hours shows fresh deals. You can also try <a href='/blog/udemy-personal-plan-review-2026/'>Udemy Personal Plan</a> for unlimited access when no coupon fits." },
  { q: "Why did Udemy change its coupon policy?", a: `In 2025 Udemy updated its coupon policy to improve course quality. Most coupons are now limited to 10-100 redemptions. Read more on <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's instructor blog</a>.` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "description": metaDescription,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "inLanguage": "en-US",
      "datePublished": latestUpdateIso,
      "dateModified": latestUpdateIso,
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "mainEntity": { "@id": `${pageUrl}#itemlist` },
      "author": { "@type": "Person", "name": "Andrew Derek", "url": `${siteUrl}/about` },
      "speakable": { "@type": "SpeakableSpecification", "cssSelector": ["h1", ".cc-subtitle", ".cc-faq-q"] }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Today's Coupons", "item": pageUrl },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#itemlist`,
      "name": `Today's Udemy Coupon Codes — ${shortDate}`,
      "description": metaDescription,
      "numberOfItems": totalActive,
      "itemListElement": todayGridDeals.slice(0, 20).map((d, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `${siteUrl}/coupon/${d.slug}`,
        "item": {
          "@type": "Course",
          "name": d.title,
          "url": `${siteUrl}/coupon/${d.slug}`,
          "description": cleanDesc(d.description),
          "provider": { "@type": "Organization", "name": "Udemy", "sameAs": "https://www.udemy.com" },
          "offers": {
            "@type": "Offer",
            "price": d.price ?? 0,
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
            "url": `${siteUrl}/coupon/${d.slug}`,
            ...(d.expiresAt ? { "priceValidUntil": new Date(d.expiresAt).toISOString() } : {})
          },
        },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={metaDescription} canonical={pageUrl} hideBreadcrumbs={false} pubDate={new Date(latestUpdate || Date.now())} updatedDate={now}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={`${siteUrl}/assets/images/og-default.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span><a href="/how-we-test-and-verify-udemy-coupons">Live &middot; updated {lastVerified} WIB</a></span>
            <span class="cc-folio">{dateFull} · {todayAdded} new</span>
          </div>
          <h1 class="cc-title">Verified <span class="cc-accent">Udemy Coupons Today</span> — {todayAdded} New Deals for {shortDate}</h1>
          <p class="cc-subtitle">{todayAdded} hand-picked deals added in the last 24 hours &mdash; every code re-verified before it's listed. Save up to <strong>{maxDiscountPct}%</strong> on premium courses. <time datetime={latestUpdateIso} style="font-weight:600;color:#1F7A4D">Updated {lastVerified}</time> WIB.</p>
          <div class="cc-byline">
            <a class="cc-byline-badge" href="/about">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              Compiled &amp; checked by Andrew Derek
            </a>
            <span class="cc-byline-date">Updated <time datetime={latestUpdateIso}>{lastVerified}</time> WIB</span>
            <a class="cc-byline-verify" href="/how-we-test-and-verify-udemy-coupons">How we test &amp; verify Udemy coupons</a>
          </div>
          <p class="cc-affiliate">CoursesWyn may earn a commission when you buy through links on this page — at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a></p>
          <div class="cc-toolbar">
            <form action="/search" method="GET" role="search" aria-label="Search courses" class="cc-hero-search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="search" name="q" placeholder="Search today's discounted Udemy courses..." autocomplete="off" aria-label="Search courses" />
              <kbd>? + K</kbd>
            </form>
            <a class="cc-hero-btn" href="#latest">Browse today's deals</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupon-code">Browse all coupon codes</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Added today</div><div class="cc-ledger-value">{todayAdded}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Active today</div><div class="cc-ledger-value">{totalActive}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Free today</div><div class="cc-ledger-value">{freeCount}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Save up to</div><div class="cc-ledger-value">{maxDiscountPct}%</div></div>
          </div>
        </div>
      </header>

      <div class="daily-urgency" role="note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span><strong>Coupons expire fast</strong> &mdash; {todayAdded} added today{expiringCount > 0 ? `, ${expiringCount} expiring within 7 days` : ''}{freeCount > 0 ? `, ${freeCount} free` : ''}. Enroll before they run out.</span>
        <a href="/how-to-redeem-coupon">How to redeem &rarr;</a>
      </div>

      <div class="daily-share" role="region" aria-label="Share today's coupons">
        <span class="daily-share-label">Share today's deals:</span>
        <a class="daily-share-link" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a class="daily-share-link" href={xUrl} target="_blank" rel="noopener" aria-label="Share on X">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a class="daily-share-link" href={facebookUrl} target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
        <button class="daily-share-copy" data-copy-url={pageUrl} type="button" aria-label="Copy link">Copy link</button>
      </div>

      {/* COMPACT PERSONAL PLAN BANNER - high CTR, urgency */}
      <section class="pp-compact" aria-label="Udemy Personal Plan alternative">
        <div class="pp-compact-inner">
          <div class="pp-compact-left">
            <span class="pp-compact-pill"><span class="pp-dot"></span> CoursesWyn readers: 25% OFF — limited time</span>
            <div class="pp-compact-text">
              <strong>No coupon for the course you want?</strong> Get unlimited access to <strong>26,000+ top-rated courses</strong> with Udemy Personal Plan — one flat price, cancel anytime. <a href="/blog/udemy-personal-plan-review-2026/">See 2026 review</a>
            </div>
          </div>
          <a class="pp-compact-cta" href="https://trk.udemy.com/c/6564357/3775958/39854" target="_blank" rel="noopener noreferrer sponsored">
            <span class="pp-compact-cta-main">Claim 25% OFF <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
            <span class="pp-compact-cta-sub">$20/mo · 7-day free trial · Cancel anytime</span>
          </a>
        </div>
        <p class="pp-compact-note">Sponsored — CoursesWyn may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Learn more</a> · <span style="color:#B8901F">⏰ Most coupons cap at 100 redemptions</span></p>
      </section>

      {/* SINGLE GRID - NO DUPLICATES: free+paid combined, freshest first */}
      <section class="cc-deals-section" id="latest">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Today's Verified Udemy Coupons <span class="cc-tag">{totalActive} deals · freshest first</span></h2>
          <p class="cc-sec-desc">One list, no duplicates — {freeCount > 0 ? `${freeCount} free & ` : ''}{totalActive - freeCount} paid coupons added or re-verified today. Sorted by freshest. Expires soon = enroll now.</p>
        </div>
        {todayGridDeals.length > 0 ? (
          <div class="cc-grid">
            {todayGridDeals.map((deal: any, idx: number) => (
              <>
                <LedgerRow deal={deal} variant="grid" eager={idx < 6} priority={idx < 3} />
                {/* In-grid Personal Plan card — dark high-contrast */}
                {idx === 11 && todayGridDeals.length > 14 && (
                  <div class="pp-inline-card">
                    <div class="pp-inline-badge"><span class="pp-dot"></span> Sponsored · Best value</div>
                    <h3 class="pp-inline-title">Coupon expired? Get everything — $20/mo</h3>
                    <p class="pp-inline-desc">3 courses @ $15 = $45. Personal Plan = <strong>$20 unlimited</strong>. Perfect for binge learners.</p>
                    <div class="pp-inline-price"><span class="pp-inline-was">$29.99/mo</span> <span class="pp-inline-now">$20/mo</span> <span class="pp-inline-off">25% OFF</span></div>
                    <ul class="pp-inline-list">
                      <li>26,000+ top-rated courses</li>
                      <li>Cancel anytime · 7-day trial</li>
                      <li>Certificate included</li>
                    </ul>
                    <a class="pp-inline-btn" href="https://trk.udemy.com/c/6564357/3775958/39854" target="_blank" rel="noopener noreferrer sponsored">Get Personal Plan — 25% OFF <span class="pp-inline-arrow">→</span></a>
                    <a class="pp-inline-link" href="/blog/udemy-personal-plan-review-2026/">Read 2026 review →</a>
                  </div>
                )}
              </>
            ))}
          </div>
        ) : (
          <div class="cc-empty">
            <p>No coupons have been verified yet today — fresh deals drop throughout the day.</p>
            <p>Check back in a few hours, or browse every verified code, or try <a href="https://trk.udemy.com/c/6564357/3775958/39854" target="_blank" rel="noopener noreferrer sponsored">Udemy Personal Plan (26k+ courses)</a> while you wait.</p>
          </div>
        )}
        <div class="cc-deal-more"><span class="cc-deal-count">Showing {todayGridDeals.length} of {totalActive} coupons verified today</span><a href="/udemy-coupon-code">Browse all {totalCoupons.toLocaleString()} coupons →</a></div>
      </section>

      {/* PREMIUM PERSONAL PLAN SECTION - dark high-conversion hero */}
      <section class="pp-premium" aria-label="Udemy Personal Plan promotion">
        <div class="pp-premium-bg"></div>
        <div class="pp-premium-inner">
          <span class="pp-premium-badge"><span class="pp-dot"></span> Sponsored — CoursesWyn readers exclusive</span>
          <h2>Stop chasing <span>single coupons</span> — unlock <span>26,000+</span> courses for $20/mo</h2>
          <p class="pp-premium-desc">Today's coupons expire in <strong>~7 hours / 100 redemptions</strong> on average. Instead of hunting one by one, Personal Plan gives you unlimited access to 26,000+ curated courses with certificates — one flat price, cancel anytime. <strong>25% OFF your first year for CoursesWyn readers.</strong></p>

          <div class="pp-premium-compare">
            <div class="pp-compare-col"><span class="pp-compare-label">Buy individually</span><span class="pp-compare-price">$45</span><span class="pp-compare-sub">3 courses × $15</span></div>
            <div class="pp-compare-vs">vs</div>
            <div class="pp-compare-col highlight"><span class="pp-compare-label">Personal Plan</span><span class="pp-compare-price">$20<span>/mo</span></span><span class="pp-compare-sub">26,000+ courses unlimited</span></div>
          </div>

          <div class="pp-premium-grid">
            <div class="pp-premium-point"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.8"><path d="M20 6L9 17l-5-5"/></svg><span><strong>26,000+</strong> top-rated courses</span></div>
            <div class="pp-premium-point"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.8"><path d="M20 6L9 17l-5-5"/></svg><span><strong>$240/yr</strong> ($20/mo) — 25% OFF</span></div>
            <div class="pp-premium-point"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.8"><path d="M20 6L9 17l-5-5"/></svg><span><strong>Cancel anytime</strong> · 7-day trial</span></div>
          </div>

          <a class="pp-premium-btn" href="https://trk.udemy.com/c/6564357/3775958/39854" rel="nofollow sponsored noopener" target="_blank">
            <span>Yes, I Want 25% OFF Personal Plan</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <div class="pp-premium-trust">
