---
import Layout from '../../layouts/Layout.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import { getDeals } from '../../lib/store.js';
import { formatDateWIB, toISODateWIB } from '../../lib/date';

const allDeals = await getDeals();
const now = new Date();
const activeDeals = allDeals.filter(d => !d.expiresAt || new Date(d.expiresAt) > now);

const todayStr = toISODateWIB(now);
const todayAdded = allDeals.filter(d => {
  const raw = d.updatedAt || d.createdAt || '';
  if (!raw) return false;
  return toISODateWIB(new Date(raw)) === todayStr;
}).length;

const paidDeals = activeDeals.filter(d => d.price > 0 || d.price == null).slice(0, 48);
const freeDeals = activeDeals.filter(d => d.price === 0);
const totalActive = activeDeals.length;
const totalCoupons = allDeals.length;

const decodeHtml = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'");

const topicCounts: Record<string, number> = {};
for (const d of allDeals) {
  const sub = d.subcategory ? decodeHtml(d.subcategory) : '';
  if (sub) {
    topicCounts[sub] = (topicCounts[sub] || 0) + 1;
  }
}
const totalTopics = Object.keys(topicCounts).length;
const trendingTopics = Object.entries(topicCounts).sort((a, b) => b[1] - a[1]).slice(0, 12);

const dateFull = formatDateWIB(now, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

const latestUpdate = allDeals.reduce((latest, d) => {
  const t = new Date(d.updatedAt || d.createdAt || 0).getTime();
  return t > latest ? t : latest;
}, 0);
const diffMs = now.getTime() - latestUpdate;
const diffMin = Math.floor(diffMs / 60000);
let lastVerified;
if (diffMin < 1) lastVerified = 'Just now';
else if (diffMin < 60) lastVerified = `${diffMin}m ago`;
else {
  const diffHr = Math.floor(diffMin / 60);
  lastVerified = diffHr < 24 ? `${diffHr}h ago` : `${Math.floor(diffHr / 24)}d ago`;
}

const almostGone = allDeals
  .filter(d => d.expiresAt)
  .filter(d => {
    const diff = new Date(d.expiresAt!).getTime() - now.getTime();
    return diff > 0 && diff < 7 * 24 * 3600000;
  })
  .sort((a, b) => new Date(a.expiresAt!).getTime() - new Date(b.expiresAt!).getTime())
  .slice(0, 3);

const expiringCount = allDeals
  .filter(d => d.expiresAt)
  .filter(d => {
    const diff = new Date(d.expiresAt!).getTime() - now.getTime();
    return diff > 0 && diff < 7 * 24 * 3600000;
  }).length;

const popularDeals = allDeals
  .filter(d => (d.rating ?? 0) >= 4.5)
  .slice(0, 8);

const discountPcts = allDeals
  .filter(d => d.price && d.originalPrice && d.originalPrice > d.price)
  .map(d => Math.round(100 - (d.price / d.originalPrice!) * 100));
const maxDiscountPct = discountPcts.length ? Math.max(...discountPcts) : 95;

const paidCount = paidDeals.length;

const siteUrl = "https://courseswyn.com";
const pageUrl = `${siteUrl}/udemy-coupons-today/`;
const shortDate = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Jakarta', year: 'numeric', month: 'long', day: 'numeric' }).format(now);
const pageTitle = `${todayAdded} New Udemy Coupons Today (${shortDate}) | CoursesWyn`;
const metaDescription = `Fresh Udemy coupon codes added today - ${todayAdded} new deals verified in the last 24 hours. Save up to ${maxDiscountPct}% on premium courses.`;
const pageKeywords = [
  "udemy coupons today", "new udemy coupon", "fresh udemy coupon codes",
  "free udemy coupon", "udemy discount", "udemy promo code",
  "udemy deals today", "verified udemy coupons", "udemy course deals"
].join(", ");

const shareUrl = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(`🔥 ${todayAdded} verified Udemy coupons added today — save up to ${maxDiscountPct}%! Checked by CoursesWyn: `);
const whatsappUrl = `https://wa.me/?text=${shareText}${shareUrl}`;
const xUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;

function slugify(s: string) {
  return s.toLowerCase().replace(/\s+&\s+/g, '-and-').replace(/['\s]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
}

const faqs = [
  { q: "What's the difference between Today's Coupons and the full coupon page?", a: "Today's Coupons highlights only deals added or updated in the last 24 hours — the freshest, most likely to still work. Our full coupon code page lists every verified deal, sorted by newest first, with category filters and pagination." },
  { q: "Are these Udemy coupons verified?", a: "Yes. Every coupon listed is manually verified before publishing. We check each code to ensure it still works and shows the correct discount." },
  { q: "How long do these Udemy coupons last?", a: "Udemy coupons typically expire within a few days or run out of redemptions. We recommend enrolling as soon as you find a course you want. If a code has expired, check our main deals page for the latest listings." },
  { q: "How do I redeem a Udemy coupon?", a: "Click the course card to open its deal page on CoursesWyn, then click the coupon or 'Get deal' button. You'll be taken to Udemy with the discount pre-applied. Complete enrollment there." },
  { q: "Do I get a certificate with discounted Udemy courses?", a: "Yes. Courses enrolled via our coupons include lifetime access, downloadable resources, and an official Udemy completion certificate when you finish the course." },
  { q: "How often are new coupons added?", a: "New coupons are added throughout the day as instructors publish them. We check Udemy in near real time and update this list automatically, so checking back every few hours will show fresh deals." },
  { q: "Why did Udemy change its coupon policy?", a: `In 2025 Udemy updated its coupon policy to improve course quality. Most coupons are now limited to 10-100 redemptions. Read more on <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's instructor blog</a>.` },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "description": metaDescription,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "inLanguage": "en-US",
      "datePublished": new Date(latestUpdate).toISOString().split('T')[0],
      "dateModified": new Date(latestUpdate).toISOString(),
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "mainEntity": { "@id": `${pageUrl}#itemlist` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Today's Coupons", "item": pageUrl },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#itemlist`,
      "name": "Today's Udemy Coupon Codes",
      "description": metaDescription,
      "numberOfItems": totalActive,
      "itemListElement": allDeals.slice(0, 20).map((d, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "item": {
          "@type": "Course",
          "name": d.title,
          "url": `${siteUrl}/coupon/${d.slug}`,
          "description": d.description,
          "provider": { "@type": "Organization", "name": "Udemy" },
          "offers": { "@type": "Offer", "price": d.price ?? 0, "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
        },
      })),
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={metaDescription} canonical={pageUrl} hideBreadcrumbs={true}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span> Live &middot; updated {lastVerified}</span>
            <span class="cc-folio">{dateFull}</span>
          </div>
          <h1 class="cc-title">Today's <span class="cc-accent">Udemy Coupons</span></h1>
          <p class="cc-subtitle">{todayAdded} hand-picked deals added in the last 24 hours &mdash; every code re-verified before it's listed. Save up to <strong>{maxDiscountPct}%</strong> on premium courses.</p>
          <div class="cc-toolbar">
            <form action="/search" method="GET" role="search" aria-label="Search courses" class="cc-hero-search">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="search" name="q" placeholder="Search for discounted Udemy courses..." autocomplete="off" aria-label="Search courses" />
              <kbd>? + K</kbd>
            </form>
            <a class="cc-hero-btn" href="#latest">Browse today's deals</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupon-code">Browse all coupon codes</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Added today</div><div class="cc-ledger-value">{todayAdded}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Save up to</div><div class="cc-ledger-value">{maxDiscountPct}%</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Topics</div><div class="cc-ledger-value">{totalTopics}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Total coupons</div><div class="cc-ledger-value">{totalCoupons}</div></div>
          </div>
        </div>
      </header>

      <div class="daily-urgency" role="note">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span><strong>Coupons expire fast</strong> &mdash; {todayAdded} added today{expiringCount > 0 ? `, ${expiringCount} expiring within 7 days` : ''}. Enroll before they run out.</span>
        <a href="/how-to-redeem-coupon">How to redeem &rarr;</a>
      </div>

      <div class="daily-share" role="region" aria-label="Share today's coupons">
        <span class="daily-share-label">Share today's deals:</span>
        <a class="daily-share-link" href={whatsappUrl} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp
        </a>
        <a class="daily-share-link" href={xUrl} target="_blank" rel="noopener" aria-label="Share on X">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a class="daily-share-link" href={facebookUrl} target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
        <button class="daily-share-copy" data-copy-url={pageUrl} type="button" aria-label="Copy link">Copy link</button>
      </div>

      {almostGone.length > 0 && (
        <section class="cc-featured">
          <div class="cc-sec-head">
            <h2 class="cc-sec-title">Almost gone <span class="cc-tag">expires soon</span></h2>
            <p class="cc-sec-desc">These coupons expire within 7 days &mdash; enroll now before they run out.</p>
          </div>
          <div class="cc-ledger-wrap">
            <table class="cc-ledger-table">
              <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
              <tbody>
                {almostGone.slice(0, 3).map((deal: any) => <LedgerRow deal={deal} />)}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="cc-deals-section" id="latest">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Latest coupons <span class="cc-tag">{paidCount} deals</span></h2>
          <p class="cc-sec-desc">The most recent verified deals, freshest first.</p>
        </div>
        <div class="cc-ledger-wrap">
          <table class="cc-ledger-table">
            <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
            <tbody>
              {paidDeals.map((deal: any) => <LedgerRow deal={deal} />)}
            </tbody>
          </table>
          <div class="cc-deal-more"><span class="cc-deal-count">Showing the {paidCount} most recent of {totalActive} active coupons</span><a href="/udemy-coupon-code">Browse them all →</a></div>
        </div>
      </section>

      {popularDeals.length > 0 && (
        <section class="cc-section">
          <div class="cc-sec-head">
            <h2 class="cc-sec-title">Popular deals <span class="cc-tag">Top-rated</span></h2>
            <p class="cc-sec-desc">Top-rated courses with the highest student reviews.</p>
          </div>
          <div class="cc-ledger-wrap">
            <table class="cc-ledger-table">
              <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
              <tbody>
                {popularDeals.map((deal: any) => <LedgerRow deal={deal} />)}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="cc-section">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Trending topics <span class="cc-tag">{trendingTopics.length} topics</span></h2>
          <p class="cc-sec-desc">Most popular categories among today's coupons.</p>
        </div>
        <nav class="cc-cat-grid" aria-label="Trending topics">
          {trendingTopics.map(([topic, count]) => (
            <a href={`/categories/${slugify(topic)}/`} class="cc-cat">
              <div class="cc-cat-num">{count}</div>
              <div class="cc-cat-label">{topic}</div>
              <div class="cc-cat-count">coupons</div>
            </a>
          ))}
        </nav>
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">Why are today's coupons different from our full list?</h2>
        <p>Since <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's coupon policy update</a>, most coupons are limited to about 10 to 100 redemptions or expire within days, which is why so many coupon sites list codes that no longer work. This page only shows deals added or re-verified in the last 24 hours &mdash; the freshest, most reliable codes available right now.</p>
        <p>CoursesWyn checks every coupon against Udemy in near real time. When a coupon runs out, it disappears from this list automatically. For the complete archive with category filters, browse <a href="/udemy-coupon-code">all verified coupons</a>.</p>
      </section>

      <section class="cc-section cc-faq">
        <h2 class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map(faq => (
            <div class="cc-faq-card">
              <h6 class="cc-faq-q">{faq.q}</h6>
              <p class="cc-faq-a" set:html={faq.a} />
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">New codes drop all day</p>
        <p class="cc-cta-text">Every coupon on this page was checked against Udemy before listing. For the full archive with category filters, browse every verified code.</p>
        <a class="cc-hero-btn" href="/udemy-coupon-code">Browse all verified coupons →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(18, 32, 58, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #1F7A4D; background: #E4F1E9; border: 1px solid rgba(31, 122, 77, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #1F7A4D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; color: #5B564C; border: 1px dashed #B9B29B; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: #12203A; line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #C13B2E; }
  .cc-subtitle { color: #5B564C; font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: #12203A; font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-search { display: flex; align-items: center; gap: 10px; flex: 1 1 300px; max-width: 460px; min-width: 240px; background: #fff; border: 1px solid #D8D0BC; border-radius: 10px; padding: 0 14px; height: 48px; box-shadow: 0 8px 24px -18px rgba(18, 32, 58, 0.4); transition: border-color 0.2s, box-shadow 0.2s; }
  .cc-hero-search:focus-within { border-color: #1F7A4D; box-shadow: 0 8px 28px -14px rgba(31, 122, 77, 0.4); }
  .cc-hero-search svg { color: #5B564C; flex-shrink: 0; }
  .cc-hero-search input { flex: 1; border: none; outline: none; background: transparent; color: #12203A; font-size: 0.93rem; padding: 0; min-width: 0; }
  .cc-hero-search kbd { font-size: 0.7rem; color: #5B564C; background: transparent; border: 1px solid #D8D0BC; border-radius: 5px; padding: 2px 7px; white-space: nowrap; }
  .cc-hero-btn { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #12203A; color: #fff; box-shadow: 0 10px 24px rgba(18, 32, 58, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #1B2E52; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: #1B2E52; border: 1px solid #1B2E52; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #1B2E52; color: #fff; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #B9B29B; padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #D8D0BC; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: #5B564C; margin-bottom: 4px; }
  .cc-ledger-value { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-weight: 700; font-size: 22px; color: #12203A; }

  /* ===== URGENCY + SHARE ===== */
  .daily-urgency { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; background: #F5F1E6; border: 1px solid rgba(184, 144, 31, 0.45); border-radius: 12px; padding: 14px 18px; margin: 24px 0 0; }
  .daily-urgency svg { color: #B8901F; flex-shrink: 0; }
  .daily-urgency span { font-size: 0.9rem; color: #5B564C; line-height: 1.5; flex: 1; }
