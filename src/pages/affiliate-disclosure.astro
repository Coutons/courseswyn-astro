---
import Layout from "../layouts/Layout.astro";

const siteUrl = "https://courseswyn.com";

const faqs = [
  {
    q: "Does using CoursesWyn cost me extra money?",
    a: "No, using CoursesWyn does not cost you anything extra. When you click on our affiliate links and make a purchase, you pay the same price (or often less with our exclusive discounts) as if you went directly to the platform."
  },
  {
    q: "How does CoursesWyn make money?",
    a: "We earn small commissions from qualifying purchases made through our affiliate links. This helps us maintain and improve CoursesWyn at no cost to you. Our affiliate relationships do not influence which courses we recommend."
  },
  {
    q: "Are your course recommendations unbiased?",
    a: "Yes, absolutely. Our editorial independence is paramount. We only recommend courses and platforms we genuinely believe offer value to our users."
  },
  {
    q: "Which platforms does CoursesWyn partner with?",
    a: "We partner with major online learning platforms including Udemy, Coursera, edX, Pluralsight, Skillshare, LinkedIn Learning, Udacity, and Codecademy. All partnerships are clearly disclosed on this page."
  },
  {
    q: "Do I need to create an account to use CoursesWyn?",
    a: "No, you do not need to create an account to browse and access our coupon codes. You only need a free account on the respective platform (like Udemy) to enroll in courses."
  }
];
---

<Layout
  title="Affiliate Disclosure | CoursesWyn"
  description="CoursesWyn is an affiliate marketing platform. We earn commissions when you purchase courses through our links, but this does not affect our recommendations or pricing."
  canonical={`${siteUrl}/affiliate-disclosure`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://courseswyn.com/affiliate-disclosure",
        "url": "https://courseswyn.com/affiliate-disclosure",
        "name": "Affiliate Disclosure | CoursesWyn",
        "description": "CoursesWyn affiliate disclosure. We earn commissions when you purchase courses through our links.",
        "isPartOf": { "@id": "https://courseswyn.com" },
        "dateModified": "2026-07-27",
        "inLanguage": "en-US",
        "mainEntity": { "@type": "WebPage", "name": "Affiliate Disclosure" }
      },
      {
        "@type": "Organization",
        "@id": "https://courseswyn.com/#organization",
        "name": "CoursesWyn",
        "url": "https://courseswyn.com",
        "sameAs": ["https://x.com/CoursesWyn", "https://www.facebook.com/CoursesWyn"]
      },
      {
        "@type": "FAQPage",
        "@id": "https://courseswyn.com/affiliate-disclosure#faq",
        "mainEntity": faqs.map(faq => ({
          "@type": "Question",
          "name": faq.q,
          "acceptedAnswer": { "@type": "Answer", "text": faq.a }
        }))
      }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
      { "@type": "ListItem", "position": 2, "name": "Affiliate Disclosure", "item": "https://courseswyn.com/affiliate-disclosure" }
    ]
  })} />

  <main class="p-root">
    <article class="p-article">

      <header class="p-hdr">
        <h1>Affiliate Disclosure</h1>
        <p class="p-date">Last updated: July 27, 2026</p>
      </header>

      <section class="p-intro">
        <p>CoursesWyn is a participant in various affiliate advertising programs designed to provide a means for sites to earn advertising fees by advertising and linking to partner platforms.</p>
      </section>

      <section>
        <div class="p-sec-hdr"><h2>What This Means for You</h2></div>
        <ul>
          <li><span class="p-bold">No Extra Cost.</span> When you click on our coupon links and make a purchase, you pay the same price (or often less with our exclusive discounts) as if you went directly to the platform.</li>
          <li><span class="p-bold">We Earn Commissions.</span> We may earn a small commission from qualifying purchases made through our affiliate links. This helps us maintain and improve CoursesWyn at no cost to you.</li>
          <li><span class="p-bold">Unbiased Recommendations.</span> Our editorial independence is paramount. We only recommend courses and platforms we genuinely believe offer value to our users.</li>
          <li><span class="p-bold">Transparent Pricing.</span> All prices, discounts, and coupon codes displayed on CoursesWyn are accurate and verified at the time of publication.</li>
        </ul>
      </section>

      <section>
        <div class="p-sec-hdr"><h2>Our Affiliate Partners</h2></div>
        <p>CoursesWyn participates in affiliate programs with the following platforms:</p>
        <div class="p-partners">
          {[
            { name: "Udemy", url: "https://www.udemy.com", color: "#A435F0" },
            { name: "Coursera", url: "https://www.coursera.org", color: "#0056D2" },
            { name: "edX", url: "https://www.edx.org", color: "#02262B" },
            { name: "Pluralsight", url: "https://www.pluralsight.com", color: "#F05A28" },
            { name: "Skillshare", url: "https://www.skillshare.com", color: "#00FF84" },
            { name: "LinkedIn Learning", url: "https://www.linkedin.com/learning", color: "#0A66C2" },
            { name: "Udacity", url: "https://www.udacity.com", color: "#02B3E4" },
            { name: "Codecademy", url: "https://www.codecademy.com", color: "#091D42" }
          ].map((partner) => (
            <a href={partner.url} target="_blank" rel="noopener noreferrer" class="p-partner">
              <span class="p-partner-icon" style={{ background: partner.color }}>{partner.name.charAt(0)}</span>
              <span class="p-partner-name">{partner.name}</span>
            </a>
          ))}
        </div>
      </section>

      <section>
        <div class="p-sec-hdr"><h2>Our Commitment to You</h2></div>
        <p>We are committed to maintaining the highest standards of integrity and transparency. Our affiliate relationships do not influence:</p>
        <ul>
          <li><span class="p-bold">Course Selection.</span> We feature courses based on quality, relevance, and value—not commission rates.</li>
          <li><span class="p-bold">Review Process.</span> Our editorial team independently evaluates and verifies all coupons before publication.</li>
          <li><span class="p-bold">User Experience.</span> We prioritize your learning journey and provide honest, helpful information to help you make informed decisions.</li>
        </ul>
      </section>

      <section>
        <div class="p-sec-hdr"><h2>Questions or Concerns?</h2></div>
        <p>If you have any questions about our affiliate relationships or this disclosure, please do not hesitate to <a href="/contact" class="p-link">contact us</a>.</p>
      </section>

      <section>
        <div class="p-sec-hdr"><h2>Frequently Asked Questions</h2></div>
        <div class="p-faqs">
          {faqs.map((faq) => (
            <details class="p-faq">
              <summary class="p-faq-q">
                <span>{faq.q}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="p-faq-arrow">
                  <path d="M7 10l5 5 5-5z"/>
                </svg>
              </summary>
              <div class="p-faq-a">{faq.a}</div>
            </details>
          ))}
        </div>
      </section>

    </article>
  </main>

  <style>
    .p-root { padding: 3rem 1rem 4rem; }
    .p-article { max-width: 48rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; }

    .p-hdr { }
    .p-hdr h1 { font-size: 1.75rem; font-weight: 700; color: var(--text); margin: 0; line-height: 1.15; }
    .p-date { font-size: 0.85rem; color: var(--muted); margin: 0.5rem 0 0; }

    .p-intro p { font-size: 0.92rem; color: var(--muted); line-height: 1.65; margin: 0; }

    section { display: flex; flex-direction: column; gap: 0.75rem; }

    .p-sec-hdr { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 0.5rem 0; margin: 0; }
    .p-sec-hdr h2 { font-size: 0.92rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text); margin: 0; }

    section p { font-size: 0.9rem; color: var(--muted); line-height: 1.65; margin: 0; }

    section ul { list-style: disc; padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; margin: 0; }
    section li { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }
    .p-bold { font-weight: 600; color: var(--text); }

    .p-link { color: var(--brand); text-decoration: none; font-weight: 600; }
    .p-link:hover { text-decoration: underline; }

    .p-partners { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.5rem; }
    .p-partner { display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem 0.85rem; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; transition: border-color 0.15s; }
    .p-partner:hover { border-color: var(--brand); }
    .p-partner-icon { width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
    .p-partner-name { font-size: 0.85rem; font-weight: 600; color: var(--text); }

    .p-faqs { display: flex; flex-direction: column; gap: 0.5rem; }
    .p-faq { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .p-faq-q { padding: 1rem 1.25rem; cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--text); display: flex; align-items: center; justify-content: space-between; gap: 1rem; list-style: none; transition: background 0.15s; }
    .p-faq-q:hover { background: var(--card-hover); }
    .p-faq-arrow { flex-shrink: 0; color: var(--muted); transition: transform 0.2s; }
    details[open] .p-faq-arrow { transform: rotate(180deg); }
    .p-faq-a { padding: 0 1.25rem 1rem 1.25rem; font-size: 0.85rem; color: var(--muted); line-height: 1.6; border-top: 1px solid var(--border); padding-top: 1rem; }

    @media (max-width: 640px) {
      .p-root { padding: 2rem 1rem 3rem; }
      .p-hdr h1 { font-size: 1.5rem; }
      .p-partners { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
    }
  </style>
</Layout>