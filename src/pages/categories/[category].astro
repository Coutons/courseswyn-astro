---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { readDeals } from '../../lib/store';
import LedgerRow from '../../components/LedgerRow.astro';
import { normName, slugifyCategory, buildHeroFeed } from '../../lib/utils';
import { toISODateWIB } from '../../lib/date';

export async function getStaticPaths() {
  const allDeals = await readDeals();
  const categories = [...new Set(allDeals.map(deal => normName(deal.category)).filter(cat => cat != null))];
  return categories.map(category => ({
    params: { category: slugifyCategory(category!) },
    props: { allDeals }
  }));
}

const { category } = Astro.params;
const { allDeals: propAllDeals } = Astro.props as { allDeals?: any[] };
const selectedLanguage = Astro.url.searchParams.get('language');
const page = Astro.url.searchParams.get('page');

// Use allDeals from props, or read if in dev mode
const allDeals = propAllDeals || await readDeals();

// Filter deals for this category
let categoryDeals = allDeals.filter(deal => {
  if (!deal.category || !category) return false;

  const normalizedDealCategory = normName(deal.category);
  if (!normalizedDealCategory) return false;

  const dealSlug = slugifyCategory(normalizedDealCategory);
  return dealSlug === category;
});

// Further filter by language if selected
if (selectedLanguage) {
  categoryDeals = categoryDeals.filter((d: any) =>
    d.language && d.language.toLowerCase() === selectedLanguage.toLowerCase()
  );
}

// Pagination
const PAGE_SIZE = 12;
const currentPage = parseInt(page || '1') || 1;
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const currentItems = categoryDeals.slice(startIndex, endIndex);
const totalPages = Math.ceil(categoryDeals.length / PAGE_SIZE);

const displayName = categoryDeals.length > 0 ? normName(categoryDeals[0].category) || 'Courses' : 'Courses';
const categoryName = displayName;

// Get related categories for internal linking
const allCategories = [...new Set(allDeals.map(deal => normName(deal.category)).filter(Boolean))].filter(cat => cat !== categoryName);

// Create dynamic meta description with keywords
const langSuffix = selectedLanguage ? ` in ${selectedLanguage}` : "";
const categoryKeywords = `${categoryName.toLowerCase()}, ${categoryName.toLowerCase()} courses, ${categoryName.toLowerCase()} certification, learn ${categoryName.toLowerCase()}, ${categoryName.toLowerCase()} tutorial`;
const metaDescription = `Browse ${categoryDeals.length}+ verified ${categoryName.toLowerCase()} courses${langSuffix} with massive discounts up to 90% off. Learn ${categoryKeywords} from industry experts. Udemy coupons updated daily.`;

const currentDate = toISODateWIB();
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));

const avgDiscount = categoryDeals.length > 0
  ? Math.round(categoryDeals.reduce((acc: number, deal: any) => {
      if (deal.originalPrice && deal.price !== undefined && deal.originalPrice > 0) {
        return acc + ((deal.originalPrice - deal.price) / deal.originalPrice) * 100;
      }
      return acc;
    }, 0) / categoryDeals.length)
  : 90;

const freeCourses = categoryDeals.filter((deal: any) => deal.price === 0 || deal.price === null).length;
const now = new Date();
const heroFeed = buildHeroFeed(categoryDeals, now, 3);

const siteUrl = "https://courseswyn.com";
const baseUrl = `${siteUrl}/categories/${category}`;
const currentUrl = currentPage === 1 ? baseUrl : `${baseUrl}?page=${currentPage}`;
const langQuery = selectedLanguage ? `&language=${encodeURIComponent(selectedLanguage)}` : "";

const pageKeywords = [
  `${categoryName.toLowerCase()} courses`,
  `${categoryName.toLowerCase()} udemy coupon`,
  `${categoryName.toLowerCase()} course free`,
  `${categoryName.toLowerCase()} certification`,
  `learn ${categoryName.toLowerCase()}`,
  `free ${categoryName.toLowerCase()} course with certificate`,
  "udemy coupon code"
].join(", ");

const faqs = [
  { q: `How to get ${categoryName} courses with promo codes?`, a: `You can access premium ${categoryName.toLowerCase()} courses at significant discounts using verified promo codes listed on CoursesWyn. We update our database daily to ensure you get the best savings.` },
  { q: `What will I learn in ${categoryName} courses?`, a: `Our ${categoryName} courses cover everything from beginner fundamentals to advanced professional skills. You'll get hands-on experience with real-world projects and industry-standard tools.` },
  { q: `Do I get certificates for ${categoryName} courses?`, a: `Absolutely! Courses include completion certificates, lifetime access, and all course materials - the same benefits as paid courses.` },
  { q: `How long do ${categoryName} course coupons last?`, a: `Coupon validity varies, but we recommend using them as soon as possible. New deals are added daily, so check back regularly for fresh ${categoryName} course offers.` }
];
---

<Layout
  title={`Get Premium ${categoryName} Courses for Less - Udemy Coupon Codes | CoursesWyn`}
  description={metaDescription}
  canonical={currentUrl}
  hideBreadcrumbs={false}
>
  <Fragment slot="head">
    {currentPage > 1 && <link rel="canonical" href={currentUrl} />}
    {currentPage > 1 && <>
      <meta name="robots" content="noindex, follow" />
      <meta name="googlebot" content="noindex, follow" />
      <meta name="bingbot" content="noindex, follow" />
    </>}
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <!-- Category Collection Schema -->
  <script type="application/ld+json" set:html={JSON.stringify([
    {
      "@context": "https://schema.org",
      "@type": ["WebPage", "CollectionPage"],
      "@id": baseUrl,
      "url": baseUrl,
      "name": `${categoryName} Courses`,
      "description": metaDescription,
      "keywords": pageKeywords,
      "dateModified": currentDate,
      "isPartOf": { "@id": `${siteUrl}#website` },
      "inLanguage": "en-US",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
          { "@type": "ListItem", "position": 2, "name": "Categories", "item": `${siteUrl}/categories` },
          { "@type": "ListItem", "position": 3, "name": categoryName, "item": baseUrl }
        ]
      },
      "mainEntity": {
        "@type": "ItemList",
        "@id": `${baseUrl}#itemlist`,
        "name": `${categoryName} Course Collection`,
        "numberOfItems": categoryDeals.length,
        "itemListElement": categoryDeals.slice(0, 20).map((deal, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `${siteUrl}/coupon/${deal.slug}`,
          "item": {
            "@type": "Course",
            "name": deal.title,
            "url": `${siteUrl}/coupon/${deal.slug}`,
            "image": deal.image,
            "provider": {
              "@type": "Organization",
              "name": deal.provider
            },
            "offers": {
              "@type": "Offer",
              "price": String(deal.price ?? "0"),
              "priceCurrency": "USD",
              "availability": "https://schema.org/InStock"
            }
          }
        }))
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))
    }
  ])} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="dh-hero-grid">
          <div class="dh-hero-left">
            <div class="dh-hero-badge"><span class="lg-blip"></span> Verified coupon codes &middot; updated {currentDate}</div>
            <h1 class="dh-hero-title">{categoryName}{selectedLanguage && <span> in {selectedLanguage}</span>} <span class="cc-accent">Courses for Less</span></h1>
            <p class="dh-hero-sub">Discover <strong>{categoryDeals.length}+ verified {categoryName.toLowerCase()} courses</strong>{langSuffix} with massive discounts. Learn from industry experts and advance your career today.</p>
            <div class="dh-hero-stats">
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={categoryDeals.length}>0</span><span class="lg-plus">+</span></b><span class="dh-stat-label">courses</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={avgDiscount}>0</span><span class="lg-plus">%</span></b><span class="dh-stat-label">avg discount</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={freeCourses}>0</span></b><span class="dh-stat-label">free courses</span></div>
            </div>
          </div>
          <div class="dh-terminal">
            <div class="dh-term-head">
              <span class="dh-term-dot" style="background:#ff5f56"></span>
              <span class="dh-term-dot" style="background:#ffbd2e"></span>
              <span class="dh-term-dot" style="background:#27c93f"></span>
              <span class="dh-term-title">agents@courseswyn: ~/category</span>
              <span class="dh-term-live"><span class="lg-blip"></span> Live</span>
            </div>
            <div class="dh-term-body">
              {heroFeed.map((d) => (
                <a class="dh-term-line" href={"/coupon/" + d.slug}>
                  <span class="dh-term-time">{d.timeLabel}</span>
                  <span class="dh-term-ok">✓</span>
                  <span class="dh-term-cat">{d.cat}</span>
                  <span class="dh-term-title2">{d.title}</span>
                  <span class="dh-term-save">−{d.pct}%</span>
                </a>
              ))}
              <div class="dh-term-line"><span class="dh-term-time">now</span><span class="dh-term-ok">✓</span><span class="dh-term-title2">codes checked by CoursesWyn<span class="caret"></span></span></div>
            </div>
            <div class="dh-term-foot">$ category codes verified <b>{categoryDeals.length}</b></div>
          </div>
        </div>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="#deals">View all {categoryDeals.length} courses</a>
          <a class="cc-hero-btn ghost" href="/categories">Browse all categories</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
        </div>
      </header>

      <section class="cc-deals-section" id="deals" aria-label={`${categoryName} courses on Udemy`}>
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Discover {categoryName} Courses on Udemy Today <span class="cc-tag">{categoryDeals.length} courses</span></h2>
          <p class="cc-sec-desc">Every course below is checked against Udemy before listing — {avgDiscount}% average discount across this category, refreshed daily.</p>
        </div>

        {currentItems.length > 0 ? (
          <>
            <div class="cc-grid">
              {currentItems.map((deal) => <LedgerRow deal={deal} variant="grid" />)}
            </div>
            <div class="cc-deal-more"><span class="cc-deal-count">Showing {startIndex + 1}-{Math.min(endIndex, categoryDeals.length)} of {categoryDeals.length} courses</span><a href="/udemy-coupons-today">See today's new coupons →</a></div>
          </>
        ) : (
          <div class="cc-empty">
            <h3>No {selectedLanguage ? `${selectedLanguage} ` : ''}courses found in {categoryName}</h3>
            <p>We couldn't find any {selectedLanguage ? `${selectedLanguage} ` : ''}courses in this category. Try browsing our other categories or check back later for new courses.</p>
            <a href="/udemy-coupon-code" class="cc-hero-btn">Browse All Courses →</a>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="cc-pagination" aria-label="Pagination">
            {currentPage > 1 ? (
              <a href={`/categories/${category}?page=${currentPage - 1}${langQuery}`} class="cc-page-link cc-page-prev">← Prev</a>
            ) : (
              <span class="cc-page-link cc-page-disabled">← Prev</span>
            )}
            <div class="cc-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1)
                .filter(pageNum => pageNum === 1 || pageNum === totalPages || (pageNum >= currentPage - 1 && pageNum <= currentPage + 1))
                .map((pageNum) => (
                  pageNum === currentPage ? (
                    <span class="cc-page-num cc-page-active">{pageNum}</span>
                  ) : (
                    <a href={`/categories/${category}?page=${pageNum}${langQuery}`} class="cc-page-num">{pageNum}</a>
                  )
                ))}
            </div>
            {currentPage < totalPages ? (
              <a href={`/categories/${category}?page=${currentPage + 1}${langQuery}`} class="cc-page-link cc-page-next">Next →</a>
            ) : (
              <span class="cc-page-link cc-page-disabled">Next →</span>
            )}
          </nav>
        )}
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">About {categoryName} Courses on CoursesWyn</h2>
        <p>Our {categoryName.toLowerCase()} collection is ranked using real student ratings and review volume from Udemy, then filtered to keep only listings where our <strong>verified coupon code is currently working</strong>. We re-check each deal in near real time, so the discount you see is the price you pay.</p>
        <p>Whether you're a complete beginner or an experienced professional, you'll find top-rated {categoryName.toLowerCase()} training with hands-on projects, lifetime access, and a certificate of completion included with every enrollment. New {currentYear} deals are added daily.</p>
        <p>Browse <a href="/udemy-coupon-code">all verified coupons</a>, explore <a href="/topics">specialized learning topics</a>, or check our <a href="/udemy-coupons-today">today's new deals</a>. Every coupon listed is tested daily — if a coupon expires, it's removed from our listings automatically so you never waste time on dead links.</p>
      </section>

      {allCategories.length > 0 && (
        <section class="cc-section" aria-labelledby="more-cats-title">
          <div class="cc-sec-head">
            <h2 id="more-cats-title" class="cc-sec-title">Explore Other Categories <span class="cc-tag">{allCategories.length} categories</span></h2>
            <p class="cc-sec-desc">Keep exploring — every category below is ranked and verified the same way.</p>
          </div>
          <nav class="cc-cat-grid" aria-label="Related categories">
            {allCategories.slice(0, 8).map((cat) => {
              const slug = slugifyCategory(cat!);
              const count = allDeals.filter((d: any) => normName(d.category) === cat).length;
              return (
                <a href={`/categories/${slug}`} class="cc-cat" title={`Browse ${count} ${cat} courses with Udemy coupons`}>
                  <div class="cc-cat-num">{count}</div>
                  <div class="cc-cat-label">{cat}</div>
                  <div class="cc-cat-count">courses</div>
                </a>
              );
            })}
          </nav>
        </section>
      )}

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions about {categoryName}
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Every category verified</p>
        <p class="cc-cta-text">Can't find what you're looking for? Browse our full collection of verified Udemy deals.</p>
        <a class="cc-hero-btn" href="/udemy-coupon-code">Browse All Coupons →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: var(--card); border: 1px solid #232B26; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #FFC94D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
  .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
  .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
  .dh-hero-title .cc-accent { color: var(--brand); }
  .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
  .dh-hero-sub strong { color: var(--text); }
  .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .dh-stat { display: flex; flex-direction: column; }
  .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
  .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
  @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
  .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
  .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
  .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
  .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
  .dh-term-live .lg-blip { background: var(--stamp); }
  .dh-term-body { padding: 4px 0; }
  .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
  a.dh-term-line:hover { background: var(--brand-soft); }
  .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
  .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
  .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
  .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
  .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
  .dh-term-foot b { color: var(--brand); }
  @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .cc-folio { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); border: 1px dashed var(--border); border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #CF6F59; }
  .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: var(--text); font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #FFC94D; color: #0b0e14; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #FFC94D; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #FFC94D; color: #0b0e14; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed var(--border); padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #232B26; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cc-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--text); }

  /* ===== SECTION HEADS ===== */
  .cc-section { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

  /* ===== LEDGER TABLE + GRID ===== */
  .cc-deals-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .cc-ledger-wrap { background: var(--card); border: 1px solid #232B26; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.16); margin-top: 16px; }
  table.cc-ledger-table { width: 100%; border-collapse: collapse; }
