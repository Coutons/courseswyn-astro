---
import Layout from '../../layouts/Layout.astro';
import PageHero from "@/components/PageHero.astro";
import CouponGrid from '../../components/CouponGrid.astro';
import type { Deal } from '../../types/deal.d.ts';
import { readDeals } from '../../lib/store';
import { parseInstructors, createInstructorSlug } from '../../lib/instructors';
import { getInstructorImage } from '../../lib/instructorProfiles';
import { formatDateWIB, toISODateWIB } from '../../lib/date';
import { buildHeroFeed, slugifyCategory, slugifyTopic } from '../../lib/utils';
import { dealTopicNames } from '../../lib/dealStats';

const siteUrl = 'https://courseswyn.com';

export async function getStaticPaths() {
  const deals: Deal[] = await readDeals();
  const slugToName = new Map<string, string>();

  for (const deal of deals) {
    if (!deal.instructor) continue;
    for (const name of parseInstructors(deal.instructor)) {
      const slug = createInstructorSlug(name);
      if (!slug) continue;
      if (!slugToName.has(slug)) {
        slugToName.set(slug, name);
      }
    }
  }

  return Array.from(slugToName.entries()).map(([instructor, instructorName]) => ({
    params: { instructor },
    props: { instructorName, allDeals: deals },
  }));
}

const { instructorName: instructorNameProp, allDeals: propAllDeals } = Astro.props as { instructorName?: string; allDeals?: Deal[] };
const slugParam = Astro.params.instructor ?? '';

const deals: Deal[] = propAllDeals || await readDeals();

function dealMatchesInstructorSlug(deal: Deal, targetSlug: string): boolean {
  if (!deal.instructor) return false;
  return parseInstructors(deal.instructor).some((n) => createInstructorSlug(n) === targetSlug);
}

let instructorName = instructorNameProp;
if (!instructorName && slugParam) {
  for (const deal of deals) {
    if (!deal.instructor) continue;
    for (const n of parseInstructors(deal.instructor)) {
      if (createInstructorSlug(n) === slugParam) {
        instructorName = n;
        break;
      }
    }
    if (instructorName) break;
  }
}

if (!instructorName || !slugParam) {
  return Astro.redirect('/instructors');
}

const instructorCourses = deals
  .filter((d) => dealMatchesInstructorSlug(d, slugParam))
  .sort((a, b) => (b.students ?? 0) - (a.students ?? 0));

if (instructorCourses.length === 0) {
  return Astro.redirect('/instructors');
}

const courseCount = instructorCourses.length;

const currentMonth = new Date().toLocaleDateString('en-US', { month: 'long', timeZone: 'Asia/Jakarta' });
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const currentDate = toISODateWIB();
const lastUpdatedLabel = formatDateWIB(`${currentDate}T00:00:00+07:00`);
const canonicalUrl = `${siteUrl}/instructor/${slugParam}/`;

const instructorImage = await getInstructorImage(slugParam);

// og:image untuk share sosial: utamakan foto instructor, fallback ke gambar course pertama
// (jangan sampai jatuh ke og-default.png yang tidak bisa dirender FB/X/WA).
const ogImage = instructorImage ?? instructorCourses[0]?.seoOgImage ?? instructorCourses[0]?.image;
const isInstructorAvatar = Boolean(instructorImage && ogImage === instructorImage);

function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}

function getAvatarColor(name: string): string {
  const colors = ['#16294d', '#1e3a5f', '#2e4a75', '#2E5AA8', '#7A5C8E', '#4D7A1F', '#8A2E5A'];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return colors[Math.abs(hash) % colors.length];
}

function getDiscountPct(c: Deal): number {
  if (!c.originalPrice || !c.price || c.price >= c.originalPrice) return 0;
  return Math.round(100 - (c.price / c.originalPrice) * 100);
}

function getMaxDiscount(courses: Deal[]): number {
  return Math.max(0, ...courses.map(getDiscountPct));
}

function toISODateTime(value?: string): string | undefined {
  if (!value) return undefined;
  const t = new Date(value);
  return Number.isNaN(t.getTime()) ? undefined : t.toISOString();
}

function isOrganizationName(name: string): boolean {
  return /\b(academy|inc\.?|ltd\.?|llc|group|technologies|solutions|school|university|institute|analytics|labs?|media|studios?|training|company|corp\.?|gmbh|pvt|private|limited|team|hub|careers|classes|courses|by)\b/i.test(name);
}

function cleanLabel(value: string): string {
  return value.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").trim();
}

function hasFree(courses: Deal[]): boolean {
  return courses.some((c) => c.price === 0);
}

const totalStudents = instructorCourses.reduce((s, c) => s + (c.students ?? 0), 0);
const rated = instructorCourses.filter((c) => typeof c.rating === 'number' && isFinite(c.rating!));
const avgRating =
  rated.length > 0
    ? (rated.reduce((s, c) => s + (c.rating as number), 0) / rated.length).toFixed(1)
    : '—';
const provider = instructorCourses[0]?.provider || 'Udemy';
const maxDisc = getMaxDiscount(instructorCourses);
const freeCount = hasFree(instructorCourses) ? instructorCourses.filter((c) => c.price === 0).length : 0;
const topCourses = instructorCourses.slice(0, 5);
const publishedDates = instructorCourses
  .map((c) => toISODateTime(c.createdAt))
  .filter((d): d is string => Boolean(d))
  .sort();
const firstPublished = publishedDates[0];
const now = new Date();
const heroFeed = buildHeroFeed(instructorCourses, now, 3);

// Topik instructor dari subcategory (spesifik) — fallback ke tags bila kosong.
// dipakai untuk title format: "Memi Lavi [Topics] Courses"
const _topicCounts = new Map<string, number>();
for (const c of instructorCourses) {
  const subs = (c.subcategory ? [String(c.subcategory)] : []).map((s) =>
    s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").trim()
  ).filter(Boolean);
  const names = subs.length ? subs : dealTopicNames(c);
  for (const n of names) {
    const t = String(n).trim();
    if (!t) continue;
    // skip label generik kategori agar title tetap spesifik
    if (/^(other\s+.+|it\s*&\s*software|development|business|design)$/i.test(t)) continue;
    _topicCounts.set(t, (_topicCounts.get(t) ?? 0) + 1);
  }
}
function shortTopic(t: string): string {
  // "Certified Information Systems Security Professional (CISSP)" -> "CISSP"
  const m = t.match(/\(([A-Za-z0-9+\- ]{2,12})\)\s*$/);
  if (m) return m[1].trim();
  return t;
}
let instructorTopics = [..._topicCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name]) => shortTopic(name))
  .slice(0, 2);
// guard: kalau gabungan masih kepanjangan, pakai 1 topik saja
if (instructorTopics.join(', ').length > 32) instructorTopics = instructorTopics.slice(0, 1);
const topicsLabel = instructorTopics.join(', ');
const topicsSuffix = topicsLabel ? ` ${topicsLabel}` : '';
const monthYear = `${currentMonth} ${currentYear}`;
const monthYearKey = monthYear.toLowerCase();
const cleanName = instructorName.replace(/[\p{Cc}\p{Cf}]/gu, '').trim();
const instructorKey = cleanName.toLowerCase();
const providerKey = provider.toLowerCase();
const instructorSchemaType = isOrganizationName(cleanName) ? 'Organization' : 'Person';
const instructorRole = instructorSchemaType === 'Organization' ? 'course creator' : 'instructor';

// Topik & kategori nyata untuk internal link + entity context (AIO/GEO).
const relatedTopicCounts = new Map<string, number>();
const relatedCategoryCounts = new Map<string, number>();
for (const c of instructorCourses) {
  const sub = c.subcategory ? cleanLabel(String(c.subcategory)) : '';
  if (sub) relatedTopicCounts.set(sub, (relatedTopicCounts.get(sub) ?? 0) + 1);
  const cat = c.category ? cleanLabel(String(c.category)) : '';
  if (cat) relatedCategoryCounts.set(cat, (relatedCategoryCounts.get(cat) ?? 0) + 1);
}
const relatedTopics = [...relatedTopicCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
const relatedCategories = [...relatedCategoryCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4);

const dealWord = courseCount === 1 ? 'Deal' : 'Deals';

// Title unik berbasis data: nama instructor + keyword + jumlah deal + bulan/tahun.
// Varian dipendekkan hanya untuk nama panjang supaya tidak terpotong di SERP.
const titleFull = `${cleanName} ${provider} Coupon Codes: ${courseCount} ${dealWord} for ${monthYear}`;
const titleCompact = `${cleanName} ${provider} Coupon Codes: ${courseCount} ${dealWord}, ${monthYear}`;
const titleBase = `${cleanName} ${provider} Coupon Codes — ${monthYear}`;
const title =
  cleanName.length <= 12 ? titleFull :
  cleanName.length <= 17 ? titleCompact :
  titleBase;

const discountSuffix = maxDisc > 0 ? `, up to ${maxDisc}% off` : '';
// Deskripsi adaptif: buang bagian opsional kalau nama instructor panjang,
// supaya meta description tetap utuh di SERP (≤160 karakter).
const descCore = `${courseCount} ${provider} course${courseCount === 1 ? '' : 's'} from ${cleanName} with verified coupon codes for ${monthYear}`;
const descFull = `${descCore} — compare prices, ratings and savings${discountSuffix}.`;
const descCompact = `${descCore}${discountSuffix}.`;
const descShort = `${courseCount} verified ${provider} coupon code${courseCount === 1 ? '' : 's'} from ${cleanName}${discountSuffix}.`;
const description = descFull.length <= 160 ? descFull : descCompact.length <= 160 ? descCompact : descShort;
const instructorDescription = `${cleanName} is a ${provider} ${instructorRole} with ${courseCount} course${courseCount === 1 ? '' : 's'} tracked by CoursesWyn${topicsLabel ? `, covering ${topicsLabel}` : ''}. Listings currently show ${maxDisc > 0 ? `discounts up to ${maxDisc}% off` : 'standard Udemy prices'}${freeCount > 0 ? ` and ${freeCount} free course${freeCount === 1 ? '' : 's'}` : ''}.`;

// Subhead hero: jawaban langsung + fakta katalog + sinyal verifikasi.
// Sengaja lebih panjang untuk menangkap variasi keyword dan kutipan AI.
const heroFree = freeCount > 0
  ? ` and <strong>${freeCount} free course${freeCount === 1 ? '' : 's'}</strong>`
  : '';
const heroRating = avgRating !== '—'
  ? `the course${courseCount === 1 ? '' : 's'} average${courseCount === 1 ? 's' : ''} <strong>${avgRating}/5</strong>`
  : 'course ratings are not available yet';
const heroEnrollments = totalStudents > 0
  ? ` with ${totalStudents.toLocaleString('en-US')} total enrollments`
  : '';
const heroDeals = maxDisc > 0
  ? `Current deals include <strong>discounts up to ${maxDisc}% off</strong>`
  : 'Current deals are listed at standard Udemy prices';
const heroSubHtml = [
  `<strong>${cleanName}</strong> has <strong>${courseCount} ${provider} course${courseCount === 1 ? '' : 's'} with verified coupon codes</strong> for ${monthYear}, mainly covering ${topicsLabel || 'general online-learning topics'}.`,
  `${heroDeals}${heroFree}; ${heroRating}${heroEnrollments}.`,
  `Every deal is checked against Udemy before listing, and this page was last updated on <strong>${lastUpdatedLabel}</strong>.`,
].join(' ');

const pageKeywords = [...new Set([
  `${instructorKey} ${providerKey} coupon codes`,
  `${instructorKey} ${providerKey} coupon codes ${monthYearKey}`,
  `${instructorKey} coupon codes ${monthYearKey}`,
  `updated ${instructorKey} ${providerKey} coupon codes`,
  `${providerKey} coupon codes ${monthYearKey}`,
  `updated ${providerKey} coupon codes ${monthYearKey}`,
  `${instructorKey} ${providerKey} courses`,
  `${instructorKey} ${providerKey} deals ${monthYearKey}`,
  `who is ${instructorKey}`,
  `${instructorKey} udemy instructor`,
  `${instructorKey} course list`,
  ...(instructorTopics.map((t) => `${instructorKey} ${t.toLowerCase()} course coupon`)),
  ...(relatedCategories.map(([name]) => `${instructorKey} ${name.toLowerCase()} courses`)),
  `${providerKey} promo codes ${monthYearKey}`,
  ...(freeCount > 0 ? [`${instructorKey} free ${providerKey} courses`] : []),
  `${providerKey} coupon code`
])].join(", ");

const discountAnswer = maxDisc > 0
  ? `The largest current discount is ${maxDisc}% off, calculated from the listed original and sale prices. Coupon values can change when Udemy or the instructor updates a promotion.`
  : `No discount is currently listed for courses from ${cleanName}. The price shown on each course page is the current Udemy price.`;

const freeAnswer = freeCount > 0
  ? `Yes. CoursesWyn currently lists ${freeCount} free ${provider} course${freeCount === 1 ? '' : 's'} from ${cleanName}, plus ${courseCount - freeCount} discounted course${courseCount - freeCount === 1 ? '' : 's'}. Free coupons can expire, so check the course page before enrolling.`
  : `No free ${provider} courses from ${cleanName} are listed as of ${lastUpdatedLabel}. The current catalog has ${courseCount} course${courseCount === 1 ? '' : 's'}${maxDisc > 0 ? ` with discounts up to ${maxDisc}% off` : ''}; the exact price is shown on each course page.`;

const faqItems = [
  {
    q: `How many ${provider} courses does ${cleanName} have on CoursesWyn?`,
    a: `CoursesWyn currently tracks ${courseCount} ${provider} course${courseCount === 1 ? '' : 's'} from ${cleanName}, as of ${lastUpdatedLabel}. The list is sorted by enrollment so the most popular courses appear first.`,
  },
  {
    q: `Are the Udemy coupons for ${cleanName} verified?`,
    a: `Yes. Every ${cleanName} deal on CoursesWyn is checked against Udemy before listing, and expired or invalid offers are removed. This page was last checked on ${lastUpdatedLabel}.`,
  },
  {
    q: `What is the maximum discount on courses from ${cleanName}?`,
    a: discountAnswer,
  },
  {
    q: `What topics does ${cleanName} teach on Udemy?`,
    a: topicsLabel
      ? `Courses from ${cleanName} mainly cover ${topicsLabel}. Browse the topic links on this page to see related Udemy coupon pages.`
      : `CoursesWyn tracks ${provider} courses from ${cleanName} across general online-learning topics. Browse the course list above to see the current catalog.`,
  },
  {
    q: `Does ${cleanName} offer free Udemy courses?`,
    a: freeAnswer,
  },
  {
    q: `How do I use a Udemy coupon code for ${cleanName}?`,
    a: `Open a course from the list, copy the coupon code shown on its coupon page, then apply it at Udemy checkout. The discounted price should appear before you pay. If a code does not work, it has likely expired — check the course page for the current offer.`,
  },
  {
    q: `When was the coupon list for ${cleanName} last updated?`,
    a: `This page was last updated on ${lastUpdatedLabel}. CoursesWyn rebuilds the catalog regularly and checks each listing against Udemy before it appears.`,
  },
];

const benefitCards = [
  {
    icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
    color: '#A9C7FF',
    title: 'Verified Coupons',
    text: `Every coupon from ${instructorName} is checked against Udemy before listing. Expired offers are removed.`,
  },
  {
    icon: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
    color: '#A9C7FF',
    title: 'Top-Rated Courses',
    text: `${avgRating !== '—' ? `Courses by ${instructorName} average ${avgRating} stars` : `Courses by ${instructorName} are available at current Udemy prices`}.`,
  },
  {
    icon: '<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>',
    color: '#A9C7FF',
    title: maxDisc > 0 ? `Save up to ${maxDisc}%` : 'Current Udemy Pricing',
    text: maxDisc > 0
      ? `Compare current deals on ${provider} courses by ${instructorName} with discounts up to ${maxDisc}% off.`
      : `Compare current ${provider} prices for courses by ${instructorName}.`,
  },
  {
    icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
    color: '#A9C7FF',
    title: 'Checked Regularly',
    text: `Listings for ${instructorName} are rechecked against Udemy and refreshed when the catalog is rebuilt.`,
  },
];
---

<Layout title={title} description={description} canonical={canonicalUrl} image={ogImage} imageWidth={isInstructorAvatar ? 200 : 1200} imageHeight={isInstructorAvatar ? 200 : 630} twitterCard={isInstructorAvatar ? "summary" : "summary_large_image"} hideBreadcrumbs={false}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </Fragment>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonicalUrl}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
            { '@type': 'ListItem', position: 2, name: 'Instructors', item: `${siteUrl}/instructors/` },
            { '@type': 'ListItem', position: 3, name: cleanName, item: canonicalUrl },
          ],
        },
        {
          '@type': instructorSchemaType,
          '@id': `${canonicalUrl}#instructor`,
          name: cleanName,
          url: canonicalUrl,
          ...(instructorImage ? { image: instructorImage } : {}),
          description: instructorDescription,
          ...(instructorTopics.length ? { knowsAbout: instructorTopics } : {}),
        },
        {
          '@type': ['WebPage', 'CollectionPage'],
          '@id': canonicalUrl,
          url: canonicalUrl,
          name: title,
          description,
          keywords: pageKeywords,
          inLanguage: 'en-US',
          datePublished: firstPublished,
          dateModified: `${currentDate}T00:00:00+07:00`,
          isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website` },
          publisher: { '@type': 'Organization', '@id': `${siteUrl}/#organization` },
          author: { '@type': 'Person', name: 'Andrew Derek', url: `${siteUrl}/about/` },
          about: { '@id': `${canonicalUrl}#instructor` },
          breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
          mainEntity: { '@type': 'ItemList', '@id': `${canonicalUrl}#itemlist` },
        },
        {
          '@type': 'ItemList',
          '@id': `${canonicalUrl}#itemlist`,
          name: `${cleanName}${topicsSuffix} Courses`,
          numberOfItems: instructorCourses.length,
          itemListOrder: 'https://schema.org/ItemListOrderDescending',
          itemListElement: instructorCourses.slice(0, 20).map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: `${siteUrl}/coupon/${c.slug}/`,
            item: {
              '@type': 'Course',
              name: c.title,
              description: (c.description || `${c.title} — ${provider} course by ${instructorName}.`).slice(0, 500),
              url: `${siteUrl}/coupon/${c.slug}/`,
              image: c.image,
              inLanguage: c.language || 'en',
              instructor: { '@type': 'Person', name: cleanName, url: canonicalUrl },
              provider: { '@type': 'Organization', name: c.provider || 'Udemy', sameAs: 'https://www.udemy.com' },
              hasCourseInstance: {
                '@type': 'CourseInstance',
                courseMode: 'online',
                offers: {
                  '@type': 'Offer',
                  price: c.price ?? 0,
                  priceCurrency: 'USD',
                  availability: 'https://schema.org/InStock',
                  url: `${siteUrl}/coupon/${c.slug}/`,
                  ...(c.expiresAt && new Date(c.expiresAt).getTime() > now.getTime() ? { priceValidUntil: c.expiresAt } : {}),
                },
              },
            },
          })),
        },
        {
          '@type': 'FAQPage',
          '@id': `${canonicalUrl}#faq`,
          about: { '@id': `${canonicalUrl}#instructor` },
          mainEntity: faqItems.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ],
    })}
  />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <PageHero
  eyebrow={`${provider} · ${instructorCourses.length} Deal${instructorCourses.length === 1 ? "" : "s"}`}
  titleHtml={title}
  subHtml={heroSubHtml}
  stats={[]}
  feedLines={heroFeed.map((d) => ({ href: "/coupon/" + d.slug, time: d.timeLabel, cat: d.cat, title: d.title, save: "−" + d.pct + "%" }))}
  feedFootHtml={`$ instructor codes verified <b>${instructorCourses.length}</b>`}
  sideImageSrc={instructorImage || undefined}
  sideImageFallback={getInitials(instructorName)}
  sideImageBg={getAvatarColor(instructorName)}
  sideImageAlt={instructorName}
>
</PageHero>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="#course-list">{courseCount === 1 ? 'View the course' : `View all ${courseCount} courses`}</a>
          <a class="cc-hero-btn ghost" href="/instructors">Browse all instructors</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
        </div>
        <p class="cc-byline">Compiled &amp; checked by <a href="/about">Andrew Derek</a> · Last updated <time datetime={currentDate}>{lastUpdatedLabel}</time> · <a href="/how-we-test-and-verify-udemy-coupons">How we verify</a></p>
      </header>

      <section class="cc-section cc-snapshot" aria-labelledby="snapshot-title">
        <div class="cc-sec-head">
          <h2 id="snapshot-title" class="cc-sec-title">Who is {cleanName}?</h2>
          <p class="cc-updated">Last updated <time datetime={currentDate}>{lastUpdatedLabel}</time> · <a href="/how-we-test-and-verify-udemy-coupons">How we verify</a></p>
        </div>
        <p class="cc-snapshot-lead">
          {cleanName} is a {provider} {instructorRole} with {courseCount} course{courseCount === 1 ? '' : 's'} tracked by CoursesWyn{topicsLabel ? `, mainly covering ${instructorTopics[0]}` : ''}. {maxDisc > 0 ? `Current deals include discounts up to ${maxDisc}% off.` : 'Current deals are listed at standard Udemy prices.'}{freeCount > 0 ? ` ${freeCount} course${freeCount === 1 ? ' is' : 's are'} free.` : ''} The average rating across rated courses is {avgRating === '—' ? 'not available' : `${avgRating} out of 5`}.
        </p>
        <dl class="cc-facts">
          <div class="cc-fact"><dt>Instructor</dt><dd>{cleanName}</dd></div>
          <div class="cc-fact"><dt>Platform</dt><dd>{provider}</dd></div>
          <div class="cc-fact"><dt>Courses tracked</dt><dd>{courseCount}</dd></div>
          <div class="cc-fact"><dt>Main topics</dt><dd>{topicsLabel || 'General online courses'}</dd></div>
          <div class="cc-fact"><dt>Average course rating</dt><dd>{avgRating === '—' ? 'Not rated' : `${avgRating} / 5`}</dd></div>
          <div class="cc-fact"><dt>Course enrollments</dt><dd>{totalStudents > 0 ? totalStudents.toLocaleString('en-US') : '—'}</dd></div>
          <div class="cc-fact"><dt>Maximum discount</dt><dd>{maxDisc > 0 ? `${maxDisc}% off` : 'No discount listed'}</dd></div>
          <div class="cc-fact"><dt>Free courses</dt><dd>{freeCount}</dd></div>
        </dl>
        <p class="cc-snapshot-note">Source: CoursesWyn's Udemy catalog, checked on {lastUpdatedLabel}. Prices and coupon availability can change; the price at Udemy checkout is final.</p>
      </section>

      <section class="cc-section" aria-labelledby="why-title">
        <div class="cc-sec-head">
          <h2 id="why-title" class="cc-sec-title">Why {cleanName} <span class="cc-tag">{freeCount > 0 ? `${freeCount} free deal${freeCount === 1 ? '' : 's'}` : `${courseCount} deal${courseCount === 1 ? '' : 's'}`}</span></h2>
          <p class="cc-sec-desc">{cleanName} offers <strong>{courseCount} verified deal{courseCount === 1 ? '' : 's'}</strong> on CoursesWyn{maxDisc > 0 ? <> — browse top-rated courses with discounts up to <strong>{maxDisc}% off</strong>.</> : <> — compare current Udemy prices and course ratings.</>}</p>
        </div>
        <div class="cc-adv-grid">
          {benefitCards.map((b) => (
            <div class="cc-adv-card">
              <div class="cc-adv-icon" style={{ color: b.color }}>
