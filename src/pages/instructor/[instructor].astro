---
import Layout from '../../layouts/Layout.astro';
import LedgerRow from '../../components/LedgerRow.astro';
import type { Deal } from '../../types/deal.d.ts';
import { readDeals } from '../../lib/store';
import { parseInstructors, createInstructorSlug } from '../../lib/instructors';
import { getInstructorImage } from '../../lib/instructorProfiles';
import { toISODateWIB } from '../../lib/date';

const siteUrl = 'https://courseswyn.com';

export async function getStaticPaths() {
  const deals: Deal[] = await readDeals();
  const slugToName = new Map<string, string>();

  for (const deal of deals) {
    if (!deal.instructor) continue;
    for (const name of parseInstructors(deal.instructor)) {
      const slug = createInstructorSlug(name);
      if (!slug) continue;
      if (!slugToName.has(slug)) {
        slugToName.set(slug, name);
      }
    }
  }

  return Array.from(slugToName.entries()).map(([instructor, instructorName]) => ({
    params: { instructor },
    props: { instructorName, allDeals: deals },
  }));
}

const { instructorName: instructorNameProp, allDeals: propAllDeals } = Astro.props as { instructorName?: string; allDeals?: Deal[] };
const slugParam = Astro.params.instructor ?? '';

const deals: Deal[] = propAllDeals || await readDeals();

function dealMatchesInstructorSlug(deal: Deal, targetSlug: string): boolean {
  if (!deal.instructor) return false;
  return parseInstructors(deal.instructor).some((n) => createInstructorSlug(n) === targetSlug);
}

let instructorName = instructorNameProp;
if (!instructorName && slugParam) {
  for (const deal of deals) {
    if (!deal.instructor) continue;
    for (const n of parseInstructors(deal.instructor)) {
      if (createInstructorSlug(n) === slugParam) {
        instructorName = n;
        break;
      }
    }
    if (instructorName) break;
  }
}

if (!instructorName || !slugParam) {
  return Astro.redirect('/instructors');
}

const instructorCourses = deals
  .filter((d) => dealMatchesInstructorSlug(d, slugParam))
  .sort((a, b) => (b.students ?? 0) - (a.students ?? 0));

if (instructorCourses.length === 0) {
  return Astro.redirect('/instructors');
}

const currentMonth = new Date().toLocaleDateString('en-US', { month: 'long', timeZone: 'Asia/Jakarta' });
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const currentDate = toISODateWIB();
const canonicalUrl = `${siteUrl}/instructor/${slugParam}`;

const instructorImage = await getInstructorImage(slugParam);

function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}

function getAvatarColor(name: string): string {
  const colors = ['#1F7A4D', '#C13B2E', '#B8901F', '#2E5AA8', '#7A4D1F', '#4D7A1F', '#8A2E5A'];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return colors[Math.abs(hash) % colors.length];
}

function getMaxDiscount(courses: Deal[]): number {
  return Math.max(
    0,
    ...courses.map((c) => {
      if (!c.originalPrice || !c.price || c.price >= c.originalPrice) return 0;
      return Math.round(100 - (c.price / c.originalPrice) * 100);
    })
  );
}

function hasFree(courses: Deal[]): boolean {
  return courses.some((c) => c.price === 0);
}

const totalStudents = instructorCourses.reduce((s, c) => s + (c.students ?? 0), 0);
const rated = instructorCourses.filter((c) => typeof c.rating === 'number' && isFinite(c.rating!));
const avgRating =
  rated.length > 0
    ? (rated.reduce((s, c) => s + (c.rating as number), 0) / rated.length).toFixed(1)
    : '—';
const provider = instructorCourses[0]?.provider || 'Udemy';
const maxDisc = getMaxDiscount(instructorCourses);
const freeCount = hasFree(instructorCourses) ? instructorCourses.filter((c) => c.price === 0).length : 0;
const title = `${instructorName} — Udemy Coupons & Promo Codes ${currentMonth} ${currentYear} | CoursesWyn`;
const description = `Verified ${instructorCourses.length} Udemy coupon${instructorCourses.length === 1 ? '' : 's'} from ${instructorName}. ${provider} deals updated daily — up to ${maxDisc}% off.`;
const cleanName = instructorName.replace(/[^\x20-\x7E]/g, '').trim();

const pageKeywords = [
  `${instructorName.toLowerCase()} udemy`,
  `${instructorName.toLowerCase()} coupons`,
  `${instructorName.toLowerCase()} promo codes`,
  `${instructorName.toLowerCase()} courses free`,
  `best ${instructorName.toLowerCase()} courses`,
  "udemy coupon code"
].join(", ");

const faqItems = [
  {
    q: `How many courses does ${instructorName} have on CoursesWyn?`,
    a: `${instructorName} currently has ${instructorCourses.length} verified coupon${instructorCourses.length === 1 ? '' : 's'} on CoursesWyn across ${provider}.`,
  },
  {
    q: `Are ${instructorName}'s coupons verified?`,
    a: `Yes. Every coupon from ${instructorName} is manually verified before listing. Expired or invalid deals are removed within hours.`,
  },
  {
    q: `How do I get ${instructorName}'s courses for free?`,
    a: `Browse ${instructorName}'s deals on CoursesWyn and click any coupon that interests you. Many deals offer deep discounts — click through to see the current offer on Udemy.`,
  },
  {
    q: `What is the maximum discount for ${instructorName}'s courses?`,
    a: `The biggest discount available across ${instructorName}'s courses is up to ${maxDisc}% off.`,
  },
];

const benefitCards = [
  {
    icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
    color: '#1F7A4D',
    title: 'Verified Coupons',
    text: `Every coupon from ${instructorName} is manually checked before listing. No expired or fake deals.`,
  },
  {
    icon: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
    color: '#059669',
    title: 'Top-Rated Courses',
    text: `${avgRating !== '—' ? `${instructorName}'s courses average ${avgRating} stars` : `${instructorName}'s courses are available at great discounts`}.`,
  },
  {
    icon: '<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>',
    color: '#1F7A4D',
    title: `Save up to ${maxDisc}%`,
    text: `Get the best deals on ${instructorName}'s ${provider} courses with discounts up to ${maxDisc}% off.`,
  },
  {
    icon: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
    color: '#7C3AED',
    title: 'Updated Daily',
    text: `New coupons added regularly. Deals refresh daily so you never miss a discount from ${instructorName}.`,
  },
];
---

<Layout title={title} description={description} canonical={canonicalUrl} hideBreadcrumbs={true}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
            { '@type': 'ListItem', position: 2, name: 'Instructors', item: `${siteUrl}/instructors` },
            { '@type': 'ListItem', position: 3, name: cleanName, item: canonicalUrl },
          ],
        },
        {
          '@type': ['WebPage', 'CollectionPage'],
          '@id': canonicalUrl,
          url: canonicalUrl,
          name: title,
          description,
          keywords: pageKeywords,
          inLanguage: 'en-US',
          dateModified: currentDate,
          isPartOf: { '@id': `${siteUrl}#website` },
          mainEntity: { '@id': `${canonicalUrl}#itemlist` },
        },
        {
          '@type': 'ItemList',
          '@id': `${canonicalUrl}#itemlist`,
          name: `${instructorName}'s Courses`,
          numberOfItems: instructorCourses.length,
          itemListElement: instructorCourses.slice(0, 20).map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: `${siteUrl}/coupon/${c.slug}`,
            item: {
              '@type': 'Course',
              name: c.title,
              url: `${siteUrl}/coupon/${c.slug}`,
              image: c.image,
              provider: { '@type': 'Organization', name: c.provider || 'Udemy' },
              offers: {
                '@type': 'Offer',
                price: String(c.price ?? '0'),
                priceCurrency: 'USD',
                availability: 'https://schema.org/InStock',
              },
            },
          })),
        },
        {
          '@type': 'FAQPage',
          mainEntity: faqItems.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ],
    })}
  />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-instructor-head">
            {instructorImage ? (
              <div class="cc-avatar cc-avatar-img"><img src={instructorImage} alt={instructorName} loading="lazy" /></div>
            ) : (
              <div class="cc-avatar" style={`background:${getAvatarColor(instructorName)}`}>{getInitials(instructorName)}</div>
            )}
            <div class="cc-register-top">
              <span class="cc-eyebrow"><span class="cc-blip"></span> {provider} &middot; {instructorCourses.length} Coupon{instructorCourses.length === 1 ? '' : 's'}</span>
              <span class="cc-folio">Updated {currentDate}</span>
            </div>
          </div>
          <h1 class="cc-title"><span class="cc-accent">{cleanName}</span> — Udemy Coupons &amp; Promo Codes</h1>
          <p class="cc-subtitle">Verified {instructorCourses.length} coupon{instructorCourses.length === 1 ? '' : 's'} from {instructorName} on {provider} — checked against Udemy before listing, updated {currentMonth} {currentYear}.</p>
          <div class="cc-toolbar">
            <a class="cc-hero-btn" href="#deals">View all {instructorCourses.length} courses</a>
            <a class="cc-hero-btn ghost" href="/instructors">Browse all instructors</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Courses</div><div class="cc-ledger-value">{instructorCourses.length}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Avg rating</div><div class="cc-ledger-value">{avgRating}{avgRating !== '—' ? '★' : ''}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Students</div><div class="cc-ledger-value">{totalStudents.toLocaleString()}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Max discount</div><div class="cc-ledger-value">{maxDisc}%</div></div>
          </div>
        </div>
      </header>

      <section class="cc-section" aria-labelledby="why-title">
        <div class="cc-sec-head">
          <h2 id="why-title" class="cc-sec-title">Why {cleanName} <span class="cc-tag">{freeCount} free deals</span></h2>
          <p class="cc-sec-desc">{cleanName} offers <strong>{instructorCourses.length} verified coupon{instructorCourses.length === 1 ? '' : 's'}</strong> on CoursesWyn — browse top-rated courses with discounts up to <strong>{maxDisc}% off</strong>.</p>
        </div>
        <div class="cc-adv-grid">
          {benefitCards.map((b) => (
            <div class="cc-adv-card">
              <div class="cc-adv-icon" style={{ color: b.color }}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={b.icon} />
              </div>
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-deals-section" id="deals" aria-label={`${instructorName}'s courses`}>
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">All {instructorName} Courses with Verified Coupons <span class="cc-tag">{instructorCourses.length} courses</span></h2>
          <p class="cc-sec-desc">Sorted by enrollment — every code checked against Udemy before listing.</p>
        </div>

        {instructorCourses.length > 0 ? (
          <div class="cc-ledger-wrap">
            <table class="cc-ledger-table">
              <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
              <tbody>
                {instructorCourses.map((deal) => <LedgerRow deal={deal} />)}
              </tbody>
            </table>
            <div class="cc-deal-more"><span class="cc-deal-count">{instructorCourses.length} courses from {instructorName} — verified before listing</span><a href="/udemy-coupons-today">See today's new coupons →</a></div>
          </div>
        ) : (
          <div class="cc-empty">
            <h3>No courses from {instructorName}</h3>
            <p>We couldn't find any courses from this instructor right now. Try browsing our other instructors or check back later for fresh deals.</p>
            <a href="/instructors" class="cc-hero-btn">Browse All Instructors →</a>
          </div>
        )}
      </section>

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions
          <span class="cc-tag">{faqItems.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqItems.map((faq) => (
            <div class="cc-faq-card">
              <h6 class="cc-faq-q">{faq.q}</h6>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">More instructors to explore</p>
        <p class="cc-cta-text">Discover top Udemy instructors — all with verified coupon codes.</p>
        <a class="cc-hero-btn" href="/instructors">Browse All Instructors →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(18, 32, 58, 0.35); }
  .cc-instructor-head { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }
  .cc-avatar { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800; color: #fff; flex-shrink: 0; overflow: hidden; box-shadow: 0 8px 18px -8px rgba(18, 32, 58, 0.4); }
  .cc-avatar-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 0; flex: 1; min-width: 0; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; font-weight: 600; color: #1F7A4D; background: #E4F1E9; border: 1px solid rgba(31, 122, 77, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #1F7A4D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11px; color: #5B564C; border: 1px dashed #B9B29B; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: #12203A; line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #C13B2E; }
  .cc-subtitle { color: #5B564C; font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: #12203A; font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #12203A; color: #fff; box-shadow: 0 10px 24px rgba(18, 32, 58, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #1B2E52; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: #1B2E52; border: 1px solid #1B2E52; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #1B2E52; color: #fff; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #B9B29B; padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #D8D0BC; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: #5B564C; margin-bottom: 4px; }
  .cc-ledger-value { font-family: 'Space Grotesk', 'Nunito Sans', Inter, sans-serif; font-weight: 700; font-size: 22px; color: #12203A; }

  /* ===== SECTION HEADS ===== */
  .cc-section { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: #12203A; margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; font-weight: 500; color: #5B564C; border: 1px solid #D8D0BC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: #6E6A5E; margin: 0; }
  .cc-sec-desc strong { color: #12203A; font-weight: 700; }

  /* ===== BENEFIT CARDS ===== */
  .cc-adv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin-top: 16px; }
  .cc-adv-card { background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 12px; padding: 18px 16px; transition: all 0.2s; }
  .cc-adv-card:hover { border-color: #B8901F; transform: translateY(-2px); box-shadow: 0 10px 28px -16px rgba(18, 32, 58, 0.35); }
  .cc-adv-icon { width: 36px; height: 36px; border-radius: 9px; background: #fff; border: 1px solid #D8D0BC; display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }
  .cc-adv-card h3 { font-size: 0.95rem; font-weight: 700; color: #12203A; margin: 0 0 0.35rem; }
  .cc-adv-card p { font-size: 0.82rem; color: #5B564C; line-height: 1.55; margin: 0; }

  /* ===== LEDGER TABLE ===== */
  .cc-deals-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .cc-ledger-wrap { background: #fff; border: 1px solid #D8D0BC; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(15, 23, 42, 0.16); margin-top: 16px; }
  table.cc-ledger-table { width: 100%; border-collapse: collapse; }
  .cc-ledger-table thead th { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: #5B564C; text-align: left; padding: 12px 14px; border-bottom: 1px solid #D8D0BC; background: #EDE7D6; white-space: nowrap; }
  .cc-deal-more { display: flex; justify-content: center; align-items: center; gap: 14px; flex-wrap: wrap; padding: 16px; background: #EDE7D6; border-top: 1px solid #D8D0BC; }
  .cc-deal-more a { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 12.5px; font-weight: 600; color: #1F7A4D; text-decoration: none; }
  .cc-deal-more a:hover { text-decoration: underline; }
  .cc-deal-count { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 11.5px; color: #5B564C; }

  .cc-empty { text-align: center; padding: 3rem 2rem; background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 16px; margin-top: 16px; }
  .cc-empty h3 { color: #12203A; margin-bottom: 0.75rem; font-size: 1.4rem; }
  .cc-empty p { color: #5B564C; margin-bottom: 1.5rem; line-height: 1.6; max-width: 34rem; margin-left: auto; margin-right: auto; }

  /* ===== GENERIC SECTION HEADS (seo/faq) ===== */
  .cc-section-title { font-size: 1.2rem; font-weight: 700; color: #12203A; margin: 0 0 0.3rem; display: flex; align-items: center; gap: 0.6rem; letter-spacing: -0.01em; flex-wrap: wrap; }
  .cc-section-title svg { color: #1F7A4D; flex-shrink: 0; }
  .cc-section-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 10px; font-weight: 500; color: #5B564C; border: 1px solid #D8D0BC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }

  .cc-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 768px) { .cc-faq-grid { grid-template-columns: 1fr; } }
  .cc-faq-card { background: #F5F1E6; border: 1px solid #D8D0BC; border-radius: 12px; padding: 1.1rem 1.15rem; }
  .cc-faq-card:hover { border-color: #B9B29B; }
