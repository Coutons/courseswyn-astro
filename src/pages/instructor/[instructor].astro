  .dh-term-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #14171c; border-bottom: 1px solid var(--border); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #f2f4f6; }
