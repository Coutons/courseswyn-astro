---
import Layout from '../layouts/Layout.astro';
import { readDeals } from '../lib/store';
import type { Deal } from '../types/deal.d';
import { parseInstructors, createInstructorSlug } from '../lib/instructors';
import { getInstructorImage } from '../lib/instructorProfiles';
import { buildHeroFeed } from '../lib/utils';

interface Instructor {
  name: string;
  courses: Deal[];
  totalStudents: number;
  avgRating: number;
  avgDiscount: number;
  categories: string[];
  totalReviews: number;
  provider: string;
  courseCount: number;
  totalCoupons: number;
}

const deals: Deal[] = await readDeals();
const instructorMap = new Map<string, Instructor>();

deals.forEach((deal: Deal) => {
  if (!deal.instructor) return;
  const instructorNames = parseInstructors(deal.instructor);
  instructorNames.forEach((instructorName) => {
    const clean = instructorName.replace(/[^\x20-\x7E]/g, '').trim() || instructorName.trim();
    if (!instructorMap.has(clean)) {
      instructorMap.set(clean, {
        name: clean, courses: [], totalStudents: 0, avgRating: 0, avgDiscount: 0,
        categories: [], totalReviews: 0, provider: deal.provider || 'Udemy',
        courseCount: 0, totalCoupons: 0,
      });
    }
    const inst = instructorMap.get(clean)!;
    inst.courses.push(deal);
    inst.totalCoupons += 1;
    if (deal.students) inst.totalStudents += deal.students;
    if (deal.rating) {
      inst.avgRating = (inst.avgRating * (inst.courses.length - 1) + deal.rating) / inst.courses.length;
      inst.totalReviews += deal.students || 0;
    }
    if (deal.originalPrice && deal.price < deal.originalPrice) {
      const disc = Math.round(100 - (deal.price / deal.originalPrice) * 100);
      inst.avgDiscount = (inst.avgDiscount * (inst.courses.length - 1) + disc) / inst.courses.length;
    }
    if (deal.category && !inst.categories.includes(deal.category)) {
      inst.categories.push(deal.category);
    }
  });
});

const instructors = Array.from(instructorMap.values())
  .map(inst => ({
    ...inst,
    avgRating: Number(inst.avgRating.toFixed(1)),
    courseCount: inst.courses.length,
  }))
  .sort((a, b) => b.totalCoupons - a.totalCoupons);

const topInstructors = instructors;

const instructorImages = new Map<string, string>();
for (const ins of instructors) {
  const img = await getInstructorImage(createInstructorSlug(ins.name));
  if (img) instructorImages.set(createInstructorSlug(ins.name), img);
}

function getInitials(name: string): string {
  return name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
}

function getAvatarColor(name: string): string {
  const colors = ['#FFC94D', '#FFC94D', '#E3B341', '#E3B341', '#FFC94D', '#FFC94D', '#3E6B8C', '#7A5C8E', '#CF6F59'];
  let hash = 0;
  for (let i = 0; i < name.length; i++) hash = name.charCodeAt(i) + ((hash << 5) - hash);
  return colors[Math.abs(hash) % colors.length];
}

const totalCoupons = deals.length;
const now = new Date();
const heroFeed = buildHeroFeed(deals, now, 3);
const currentMonth = new Date().toLocaleDateString('en-US', { month: 'long', timeZone: 'Asia/Jakarta' });
const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));
const siteUrl = 'https://courseswyn.com';
const canonicalUrl = `${siteUrl}/instructors`;
const title = `Top Instructors — Udemy Coupon Leaderboard ${currentMonth} ${currentYear} | CoursesWyn`;
const description = `Top ${topInstructors.length} instructors ranked by verified coupon submissions. ${totalCoupons.toLocaleString()}+ active deals. Updated daily.`;

const faqs = [
  {
    q: "How are instructors ranked on CoursesWyn?",
    a: "Instructors are ranked by their total number of active, verified coupon deals currently listed on CoursesWyn. This leaderboard updates daily as new coupons are added and expired ones are removed, so you always see the educators giving back most to the community."
  },
  {
    q: "Are the instructor coupon codes on this page verified?",
    a: "Yes. Every coupon linked from an instructor profile is checked against Udemy before listing and re-checked periodically. Deals that expire or hit their redemption limit are removed automatically, so you only see codes that still work."
  },
  {
    q: "How do I find all courses from a specific instructor?",
    a: "Click any instructor name on this page to open their profile. Each profile lists every verified coupon deal from that educator, sorted by enrollment, with the current price, rating, and discount shown up front."
  },
  {
    q: "Do these instructors offer free courses too?",
    a: "Many do. A large share of the coupons we verify are 100% off codes, giving you the full course — including certificate and lifetime access — at no cost. Each deal clearly shows the final price before you click through."
  }
];

const avgDiscountOverall = Math.round(deals.reduce((s, d) => s + (d.originalPrice ? Math.round(100 - (d.price / d.originalPrice) * 100) : 0), 0) / deals.length);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Top Instructors", "item": canonicalUrl }
      ]
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "inLanguage": "en-US",
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": topInstructors.length,
        "itemListElement": topInstructors.slice(0, 20).map((instructor, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "url": `${siteUrl}/instructor/${createInstructorSlug(instructor.name)}`,
          "item": {
            "@type": "Person",
            "name": instructor.name,
            "url": `${siteUrl}/instructor/${createInstructorSlug(instructor.name)}`
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonicalUrl}   hideBreadcrumbs={false}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="dh-hero-grid">
          <div class="dh-hero-left">
            <div class="dh-hero-badge"><span class="lg-blip"></span> Verified instructor directory &middot; {totalCoupons.toLocaleString()} coupons</div>
            <h1 class="dh-hero-title">Top Udemy <span class="cc-accent">Instructors</span></h1>
            <p class="dh-hero-sub">Instructors ranked by <strong>{totalCoupons.toLocaleString()}+ verified coupon deals</strong> shared with the community — every code checked against Udemy before listing.</p>
            <div class="dh-hero-stats">
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={topInstructors.length}>0</span></b><span class="dh-stat-label">instructors</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={totalCoupons}>0</span><span class="lg-plus">+</span></b><span class="dh-stat-label">coupons tracked</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={avgDiscountOverall}>0</span><span class="lg-plus">%</span></b><span class="dh-stat-label">avg discount</span></div>
            </div>
          </div>
          <div class="dh-terminal">
            <div class="dh-term-head">
              <span class="dh-term-dot" style="background:#ff5f56"></span>
              <span class="dh-term-dot" style="background:#ffbd2e"></span>
              <span class="dh-term-dot" style="background:#27c93f"></span>
              <span class="dh-term-title">agents@courseswyn: ~/instructors</span>
              <span class="dh-term-live"><span class="lg-blip"></span> Live</span>
            </div>
            <div class="dh-term-body">
              {heroFeed.map((d) => (
                <a class="dh-term-line" href={"/coupon/" + d.slug}>
                  <span class="dh-term-time">{d.timeLabel}</span>
                  <span class="dh-term-ok">✓</span>
                  <span class="dh-term-cat">{d.cat}</span>
                  <span class="dh-term-title2">{d.title}</span>
                  <span class="dh-term-save">−{d.pct}%</span>
                </a>
              ))}
              <div class="dh-term-line"><span class="dh-term-time">now</span><span class="dh-term-ok">✓</span><span class="dh-term-title2">codes checked by CoursesWyn<span class="caret"></span></span></div>
            </div>
            <div class="dh-term-foot">$ instructors ranked <b>{topInstructors.length}</b></div>
          </div>
        </div>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="#leaderboard">View the leaderboard</a>
          <a class="cc-hero-btn ghost" href="/categories">Browse by category</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
        </div>
      </header>

      <section class="cc-deals-section" id="leaderboard" aria-label="Top instructors leaderboard">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Top Instructors with Verified Coupons <span class="cc-tag">{topInstructors.length} ranked</span></h2>
          <p class="cc-sec-desc">Sorted by active coupon deal count — every code verified against Udemy before listing.</p>
        </div>

        <div class="cc-ledger-wrap">
          <table class="cc-ledger-table">
            <thead>
              <tr>
                <th class="cc-th-rank">#</th>
                <th class="cc-th-name">Instructor</th>
                <th class="cc-th-num">Coupons</th>
                <th class="cc-th-num">Avg Disc</th>
                <th class="cc-th-num">Students</th>
                <th class="cc-th-num">Rating</th>
              </tr>
            </thead>
            <tbody>
              {topInstructors.map((instructor, index) => {
                const slug = createInstructorSlug(instructor.name);
                const isTop3 = index < 3;
                const medal = index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : null;
                const instructorImg = instructorImages.get(slug);

                return (
                  <tr class:list={['cc-row', isTop3 && 'cc-row-top']}>
                    <td class="cc-th-rank">
                      {medal === 'gold' && <svg class="cc-medal" width="16" height="16" viewBox="0 0 24 24" fill="#FFC94D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
                      {medal === 'silver' && <svg class="cc-medal" width="16" height="16" viewBox="0 0 24 24" fill="#94a3b8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
                      {medal === 'bronze' && <svg class="cc-medal" width="16" height="16" viewBox="0 0 24 24" fill="#cd7f32"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>}
                      {!medal && <span class="cc-rank-num">{index + 1}</span>}
                    </td>
                    <td class="cc-name-cell">
                      {instructorImg ? (
                        <div class="cc-avatar cc-avatar-img"><img src={instructorImg} alt={instructor.name} loading="lazy" /></div>
                      ) : (
                        <div class="cc-avatar" style={`background:${getAvatarColor(instructor.name)}`}>
                          {getInitials(instructor.name)}
                        </div>
                      )}
                      <div class="cc-name-info">
                        <a href={`/instructor/${slug}`} class="cc-name-link">{instructor.name}</a>
                        <span class="cc-name-meta">{instructor.categories.slice(0, 2).join(', ') || instructor.provider}</span>
                      </div>
                    </td>
                    <td class="cc-num">{instructor.totalCoupons}</td>
                    <td class="cc-num">{Math.round(instructor.avgDiscount)}%</td>
                    <td class="cc-num">{instructor.totalStudents > 1000 ? (instructor.totalStudents / 1000).toFixed(1) + 'k' : instructor.totalStudents}</td>
                    <td class="cc-num">
                      <span class="cc-rating">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="#FFC94D"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {instructor.avgRating}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">Top Udemy Instructors with Verified Coupon Codes</h2>
        <p>Browse our directory of <strong>{topInstructors.length} instructors</strong> who offer verified Udemy coupon codes and discounts. Each instructor is ranked by their total number of active coupon deals — from industry veterans like <strong>{topInstructors[0]?.name}</strong> to rising experts across development, business, IT, design, and more. Every coupon on this page is verified before listing, so you get real discounts on real courses.</p>
        <p>Whether you are looking for deep discounts on premium courses or want to follow a specific instructor's work, this leaderboard helps you discover the most active educators in the Udemy ecosystem. The average discount across all listed instructors is <strong>{avgDiscountOverall}%</strong>, with top instructors offering dozens of coupon deals each.</p>
        <p>All data is updated daily. Coupons that expire or reach their redemption limit are removed within hours, ensuring you only see deals that actually work. Click any instructor name to view all their available coupon codes and start learning today.</p>
      </section>

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Udemy Instructor FAQs
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Share your coupons</p>
        <p class="cc-cta-text">Help the learning community by submitting verified coupon deals.</p>
        <a class="cc-hero-btn" href="/contact">Contact Us</a>
      </section>

    </div>
  </main>

  <style>
    .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
    .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

    /* ===== REGISTER / LEDGER HEADER ===== */
    .cc-register { position: relative; background: var(--card); border: 1px solid #232B26; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
    .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
    .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #FFC94D; animation: ccBlip 1.6s infinite; }
    @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
    .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
    .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
    .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
    .dh-hero-title .cc-accent { color: var(--brand); }
    .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
    .dh-hero-sub strong { color: var(--text); }
    .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .dh-stat { display: flex; flex-direction: column; }
    .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
    .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
    .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
    @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
    .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
    .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
    .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
    .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
    .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
    .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
    .dh-term-live .lg-blip { background: var(--stamp); }
    .dh-term-body { padding: 4px 0; }
    .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
    a.dh-term-line:hover { background: var(--brand-soft); }
    .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
    .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
    .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
    .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
    .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
    .dh-term-foot b { color: var(--brand); }
    @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
    .cc-folio { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); border: 1px dashed var(--border); border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
    .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
    .cc-title .cc-accent { color: #CF6F59; }
    .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
    .cc-subtitle strong { color: var(--text); font-weight: 700; }

    .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #FFC94D; color: #0b0e14; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
    .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
    .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #FFC94D; box-shadow: none; }
    .cc-hero-btn.ghost:hover { background: #FFC94D; color: #0b0e14; }

    .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed var(--border); padding-top: 20px; flex-wrap: wrap; }
    .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #232B26; }
    .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
    .cc-ledger-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
    .cc-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--text); }

    /* ===== LEADERBOARD TABLE ===== */
    .cc-deals-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
    .cc-sec-head { margin-bottom: 0.9rem; }
    .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
    .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
    .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

    .cc-ledger-wrap { background: var(--card); border: 1px solid #232B26; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.16); margin-top: 16px; }
    table.cc-ledger-table { width: 100%; border-collapse: collapse; }
    .cc-ledger-table thead th { font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid #232B26; background: var(--bg-secondary); white-space: nowrap; }
    .cc-ledger-table td { padding: 12px 14px; border-bottom: 1px dotted #232B26; vertical-align: middle; }
    .cc-ledger-table tr:last-child td { border-bottom: none; }
    .cc-ledger-table tr:hover td { background: var(--card); }
    .cc-th-rank { width: 2.5rem; text-align: center; }
    .cc-th-name { text-align: left; }
    .cc-th-num { text-align: right; }
    .cc-num { text-align: right; font-size: 0.9rem; color: var(--muted); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .cc-row-top td { border-bottom-color: rgba(184, 144, 31, 0.25); }
