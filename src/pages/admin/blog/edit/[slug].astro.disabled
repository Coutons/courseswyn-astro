---
import AdminShell from "../../../../components/admin/AdminShell.astro";
import BlogForm from "../../../../components/admin/BlogForm.astro";
import { readBlogPost } from "../../../../lib/blog";

const slug = Astro.params.slug ?? "";
const post = await readBlogPost(slug);
---

{post ? (
  <AdminShell title="Edit Post" badge={post.slug} parent="Blog" parentHref="/admin/blog">
    <BlogForm post={post} />
  </AdminShell>
) : (
  <AdminShell title="Post Not Found" badge="404" parent="Blog" parentHref="/admin/blog">
    <div class="adm-card adm-empty">
      <p style="font-size:1.05rem;color:#EDE9DC;margin-bottom:1.25rem;">No post found for <strong>"{slug}"</strong>.</p>
      <a class="adm-btn adm-btn-primary" href="/admin/blog">Back to Blog</a>
    </div>
  </AdminShell>
)}
