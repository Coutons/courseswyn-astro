---
import AdminShell from "../../../components/admin/AdminShell.astro";
import { listInstructors } from "../../../lib/instructorProfiles";

const instructors = await listInstructors();
const withPhoto = instructors.filter((i) => i.image).length;
const withoutPhoto = instructors.length - withPhoto;

function getInitials(name: string): string {
  return name.split(' ').filter(Boolean).map((n) => n[0]).join('').toUpperCase().slice(0, 2);
}
---

<AdminShell title="Instructors" desc="Instructor photo registry — one photo applies to every course by that instructor" badge={`${instructors.length} instructors`} parent="Admin" parentHref="/admin">
  <div slot="actions">
    <a class="adm-btn adm-btn-outline" href="/instructors" target="_blank" rel="noopener">View leaderboard</a>
  </div>

  <div class="adm-stats">
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{instructors.length}</div><div class="adm-stat-lbl">Total Instructors</div></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{withPhoto}</div><div class="adm-stat-lbl">With Photo</div></div>
    </div>
    <div class="adm-stat">
      <div class="adm-stat-ic">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      </div>
      <div class="adm-stat-body"><div class="adm-stat-num">{withoutPhoto}</div><div class="adm-stat-lbl">Initials Fallback</div></div>
    </div>
  </div>

  <div class="adm-card">
    <div class="adm-toolbar">
      <input class="adm-input" id="searchBox" type="search" placeholder="Search instructor name, slug…" />
      <span class="adm-count" id="countLabel"></span>
    </div>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>Instructor</th>
            <th>Coupons</th>
            <th style="min-width:300px;">Image URL</th>
            <th style="text-align:right;">Actions</th>
          </tr>
        </thead>
        <tbody id="rows">
          {instructors.map((ins) => (
            <tr data-row
                data-initials={getInitials(ins.name)}
                data-search={[ins.name, ins.slug].join(" ").toLowerCase()}>
              <td>
                <div class="adm-course">
                  {ins.image ? (
                    <img class="adm-avatar" src={ins.image} alt="" loading="lazy" />
                  ) : (
                    <div class="adm-avatar" style="display:grid;place-items:center;background:rgba(255,201,77,.12);color:#ffc94d;border:1px solid rgba(255,201,77,.30);">{getInitials(ins.name)}</div>
                  )}
                  <div style="min-width:0;">
                    <a class="adm-link" href={`/instructor/${ins.slug}`} target="_blank">{ins.name}</a>
                    <div class="adm-chip">{ins.slug}</div>
                  </div>
                </div>
              </td>
              <td class="adm-muted">{ins.count} course{ins.count === 1 ? '' : 's'}</td>
              <td>
                <input class="adm-input code adm-img-input" type="url" data-image-input value={ins.image || ""} placeholder="https://img-b.udemycdn.com/user/…" />
              </td>
              <td>
                <div class="adm-actions" style="justify-content:flex-end;">
                  <button class="adm-btn adm-btn-ghost adm-btn-sm" type="button" data-save data-slug={ins.slug}>Save</button>
                  <button class="adm-btn adm-btn-outline adm-btn-sm" type="button" data-clear data-slug={ins.slug} disabled={!ins.image}>Clear</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="adm-pagination" id="pager"></div>
  </div>
</AdminShell>

<style is:global>
  /* Shared adm styles live in AdminShell (dark theme). Page-specific responsive tweaks only. */
  @media (max-width:860px){
    .adm-table th:nth-child(2),.adm-table td:nth-child(2){display:none;}
    .adm-link{max-width:160px;}
  }
</style>

<script>
  const searchBox = document.getElementById("searchBox") as HTMLInputElement;
  const countLabel = document.getElementById("countLabel") as HTMLElement;
  const pager = document.getElementById("pager") as HTMLElement;
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-row]"));
  const PAGE_SIZE = 100;
  let currentPage = 1;
  let matched: HTMLElement[] = [];

  function applyFilters() {
    const q = searchBox.value.trim().toLowerCase();
    matched = rows.filter((row) => {
      const text = row.dataset.search || "";
      return !q || text.includes(q);
    });
    const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    renderPage();
    countLabel.textContent = `${matched.length} / ${rows.length} instructors`;
    renderPager(totalPages);
  }

  function renderPage() {
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    rows.forEach((row) => { row.style.display = "none"; });
    matched.slice(start, end).forEach((row) => { row.style.display = ""; });
  }

  function makePgBtn(label: string, page: number, opts: { disabled?: boolean; current?: boolean } = {}) {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "adm-pg-btn" + (opts.current ? " current" : "");
    b.textContent = label;
    b.disabled = !!opts.disabled;
    if (!opts.disabled && !opts.current) b.addEventListener("click", () => {
      currentPage = page;
      applyFilters();
    });
    return b;
  }

  function makePgEllipsis() {
    const s = document.createElement("span");
    s.className = "adm-pg-info";
    s.textContent = "…";
    return s;
  }

  function renderPager(totalPages: number) {
    pager.innerHTML = "";
    if (totalPages <= 1) return;
    const info = document.createElement("span");
    info.className = "adm-pg-info";
    info.textContent = `Page ${currentPage} of ${totalPages}`;
    pager.appendChild(info);
    pager.appendChild(makePgBtn("‹ Prev", currentPage - 1, { disabled: currentPage === 1 }));
    const windowSize = 5;
    let startPage = Math.max(1, currentPage - Math.floor(windowSize / 2));
    let endPage = Math.min(totalPages, startPage + windowSize - 1);
    startPage = Math.max(1, endPage - windowSize + 1);
    if (startPage > 1) {
      pager.appendChild(makePgBtn("1", 1, { current: currentPage === 1 }));
      if (startPage > 2) pager.appendChild(makePgEllipsis());
    }
    for (let p = startPage; p <= endPage; p++) {
      pager.appendChild(makePgBtn(String(p), p, { current: p === currentPage }));
    }
    if (endPage < totalPages) {
      if (endPage < totalPages - 1) pager.appendChild(makePgEllipsis());
      pager.appendChild(makePgBtn(String(totalPages), totalPages, { current: currentPage === totalPages }));
    }
    pager.appendChild(makePgBtn("Next ›", currentPage + 1, { disabled: currentPage === totalPages }));
  }

  searchBox.addEventListener("input", () => { currentPage = 1; applyFilters(); });
  applyFilters();

  function setRowAvatar(row: HTMLElement, image: string) {
    const course = row.querySelector<HTMLElement>(".adm-course");
    const old = course?.querySelector(".adm-avatar");
    const clearBtn = row.querySelector<HTMLButtonElement>("[data-clear]");
    if (!course) return;
    if (image) {
      const img = document.createElement("img");
      img.className = "adm-avatar";
      img.src = image;
      img.alt = "";
      img.loading = "lazy";
      if (old) old.replaceWith(img); else course.prepend(img);
      if (clearBtn) clearBtn.disabled = false;
    } else {
      const div = document.createElement("div");
      div.className = "adm-avatar";
      div.style.display = "grid";
      div.style.placeItems = "center";
      div.style.background = "rgba(255,201,77,.12)";
      div.style.color = "#ffc94d";
      div.style.border = "1px solid rgba(255,201,77,.30)";
      div.textContent = row.dataset.initials || "?";
      if (old) old.replaceWith(div); else course.prepend(div);
      if (clearBtn) clearBtn.disabled = true;
    }
  }

  async function saveImage(slug: string, input: HTMLInputElement, btn: HTMLButtonElement, row: HTMLElement) {
    const image = input.value.trim();
    if (image && !/^https?:\/\//i.test(image)) {
      alert("Image must be a valid http(s) URL");
      return;
    }
    btn.disabled = true;
    btn.textContent = "…";
    try {
      const res = await fetch("/api/instructors", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, image }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Save failed");
      setRowAvatar(row, image);
      btn.textContent = image ? "Saved" : "Cleared";
      btn.disabled = false;
      setTimeout(() => { btn.textContent = "Save"; }, 1200);
    } catch (err) {
      btn.disabled = false;
      btn.textContent = "Save";
      alert(`Error: ${(err as Error).message}`);
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-save]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest("tr") as HTMLElement;
      const input = row.querySelector<HTMLInputElement>("[data-image-input]");
      if (!input) return;
      saveImage(btn.dataset.slug || "", input, btn, row);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-clear]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest("tr") as HTMLElement;
      const input = row.querySelector<HTMLInputElement>("[data-image-input]");
      if (input) input.value = "";
      saveImage(btn.dataset.slug || "", input || (row.querySelector("input") as HTMLInputElement), btn, row);
    });
  });
</script>
