---
import Layout from '../layouts/Layout.astro';
import { readDeals } from '../lib/store';
import { toISODateWIB } from '../lib/date';

const allDeals = await readDeals();

const normSub = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").trim();

const categoryOrder = [
  "Development", "IT & Software", "Business", "Teaching & Academics",
  "Personal Development", "Design", "Health & Fitness", "Marketing",
  "Finance & Accounting", "Lifestyle", "Office Productivity", "Music",
  "Photography & Video"
];

const GRADIENT_COLORS = [
  { c1: '#0d9488', c2: '#115e59' },
  { c1: '#059669', c2: '#047857' },
  { c1: '#0891b2', c2: '#0e7490' },
  { c1: '#3b82f6', c2: '#1d4ed8' },
  { c1: '#6d28d9', c2: '#5b21b6' },
  { c1: '#b45309', c2: '#92400e' },
  { c1: '#7e22ce', c2: '#6b21a8' },
  { c1: '#0f766e', c2: '#134e4a' }
];

const hashFor = (s: string) => ((s.split('').reduce((h, ch) => h * 31 + ch.charCodeAt(0), 7) % 100000) + 100000) % 100000;

type TopicCard = { name: string; slug: string; count: number; c1: string; c2: string; s1x: number; s1y: number; s1r: number; s2x: number; s2y: number; s2r: number; s3x: number; s3y: number; s3r: number };

const buildCard = (name: string, count: number): TopicCard => {
  const hash = hashFor(name);
  const grad = GRADIENT_COLORS[hash % GRADIENT_COLORS.length];
  return {
    name,
    slug: name.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-'),
    count,
    c1: grad.c1,
    c2: grad.c2,
    s1x: 24 + (hash % 56),
    s1y: 16 + (hash >> 3) % 34,
    s1r: 26 + (hash >> 4) % 26,
    s2x: 200 + (hash >> 2) % 96,
    s2y: 10 + (hash >> 6) % 30,
    s2r: 22 + (hash >> 5) % 22,
    s3x: 280 - (hash >> 7) % 60,
    s3y: 130 + (hash >> 8) % 40,
    s3r: 12 + (hash >> 9) % 14
  };
};

const grouped: Record<string, { total: number; topics: Record<string, number> }> = {};

allDeals.forEach(deal => {
  const cat = deal.category?.trim() || "Other";
  const sub = deal.subcategory ? normSub(deal.subcategory) : '';
  if (!grouped[cat]) grouped[cat] = { total: 0, topics: {} };
  grouped[cat].total++;
  if (sub) grouped[cat].topics[sub] = (grouped[cat].topics[sub] || 0) + 1;
});

const catGroups = categoryOrder
  .filter(c => grouped[c])
  .map(c => ({
    name: c,
    slug: c.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-'),
    total: grouped[c].total,
    topics: Object.entries(grouped[c].topics)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 12)
      .map(([name, count]) => buildCard(name, count))
  }));

const totalTopics = catGroups.reduce((s, g) => s + g.topics.length, 0);
const totalCategories = catGroups.length;
const totalCourses = allDeals.length;
const avgDiscount = Math.round(allDeals.reduce((s, d) => s + (d.discount ?? (d.originalPrice ? Math.round((1 - d.price / d.originalPrice) * 100) : 0)), 0) / allDeals.length);

const dates = allDeals.map(d => d.updatedAt ?? d.createdAt).filter(Boolean) as string[];
const latestDate = dates.length ? dates.sort().reverse()[0] : null;
const latestStr = latestDate ? new Date(latestDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' }) : '';

const currentYear = new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' });
const currentDate = toISODateWIB();

const title = `Browse ${totalTopics.toLocaleString()}+ Udemy Course Topics with Verified Coupons ${currentYear} | CoursesWyn`;
const description = `Explore ${totalTopics.toLocaleString()} Udemy course topics across ${totalCategories} categories — each with verified coupon codes updated ${latestStr || 'daily'}. Find discounted deals on Python, AI, web dev, cloud & more.`;
const canonicalUrl = "https://courseswyn.com/topics";

const faqs = [
  { q: "What are Udemy course topics on CoursesWyn?", a: "CoursesWyn organizes Udemy courses into specialized topic pages — such as Python, Web Development, Data Science, AI, and Cybersecurity. Each topic page lists verified coupon deals for courses in that subject area, updated daily." },
  { q: "How do I find Udemy courses by topic?", a: "Browse the topic categories above and click on any subject that interests you. You'll see all available courses in that topic with verified discount codes." },
  { q: "Are these Udemy coupons verified?", a: "Yes. Every coupon is tested daily by our team. Each listing clearly shows the final price after coupon and discount percentage." },
  { q: "Which Udemy topics have the most deals?", a: "Programming topics like Python, JavaScript, and Web Development typically have the most deals. AI and Machine Learning topics are also growing rapidly." },
  { q: "How often are new topics and deals added?", a: "New deals are added every single day. We recommend bookmarking your favorite topic pages and checking back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes. All courses accessed through our coupons include full Udemy benefits — completion certificates, lifetime access, all video content, and downloadable resources." }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }, { "@type": "ListItem", "position": 2, "name": "Course Topics", "item": canonicalUrl }] },
    { "@type": "CollectionPage", "@id": canonicalUrl, "url": canonicalUrl, "name": title, "description": description, "isPartOf": { "@id": "https://courseswyn.com" }, ...(latestDate ? { "dateModified": latestDate, "datePublished": latestDate } : {}) },
    { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } }
  ]
};
---

<Layout title={title} description={description} canonical={canonicalUrl} hideBreadcrumbs={true}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="tp3-root">

    <div class="tp3-container">

      {/* Hero */}
      <section class="tp3-hero">
        <div class="tp3-hero-inner">
          <div class="tp3-hero-left">
            <p class="tp3-hero-label">Course taxonomy</p>
            <h1>Browse Udemy by <span class="tp3-grad">what you want to learn.</span></h1>
            <p class="tp3-claim">An independent taxonomy built from what courses actually teach, not their marketing tags. Open any topic to see its courses and their current coupon availability.</p>
            <div class="tp3-hero-stats">
              <div class="tp3-stat">
                <span class="tp3-stat-lbl">Curated topics</span>
                <span class="tp3-stat-val">{totalTopics.toLocaleString()}</span>
              </div>
              <div class="tp3-stat">
                <span class="tp3-stat-lbl">Learning areas</span>
                <span class="tp3-stat-val">{totalCategories}</span>
              </div>
              <div class="tp3-stat">
                <span class="tp3-stat-lbl">Avg discount</span>
                <span class="tp3-stat-val">{avgDiscount}%</span>
              </div>
            </div>
          </div>
          <div class="tp3-hero-right">
            <p>Every topic page is ranked by real student ratings and review counts from Udemy, filtered to only courses with <strong class="tp3-em">working verified coupon codes</strong>. New deals are added every day and checked in near real time — expired coupons disappear automatically.</p>
            <p class="tp3-fresh">Updated {latestStr || 'daily'} &middot; {totalCourses.toLocaleString()} tracked coupons</p>
            <a href="/udemy-coupons-today" class="tp3-hero-link">See today's newest deals &#8594;</a>
          </div>
        </div>
      </section>

      {/* Category nav */}
      <nav class="tp3-nav" aria-label="Topic categories">
        <ol class="tp3-nav-list">
          {catGroups.map((g, i) => (
            <li class="tp3-nav-item">
              <a href={`#cat-${g.slug}`} class="tp3-nav-link">
                <span class="tp3-nav-num">{(i + 1).toString().padStart(2, '0')}</span>
                <span class="tp3-nav-name">{g.name}</span>
                <span class="tp3-nav-arrow">&#8594;</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {/* Category sections */}
      {catGroups.map((g, i) => (
        <section id={`cat-${g.slug}`} class="tp3-cat" aria-labelledby={`cat-title-${g.slug}`}>
          <div class="tp3-cat-head">
            <span class="tp3-cat-num">{(i + 1).toString().padStart(2, '0')}</span>
            <h2 id={`cat-title-${g.slug}`} class="tp3-cat-title">{g.name}</h2>
            <p class="tp3-cat-meta">{g.total.toLocaleString()} tracked courses</p>
            <a href={`/categories/${g.slug}`} class="tp3-cat-link">Browse all {g.topics.length} topics <span class="tp3-cat-link-arrow">&#8594;</span></a>
          </div>
          <div class="tp3-cat-cards">
            {g.topics.map((t) => (
              <a href={`/topics/${t.slug}`} class="tp3-card">
                <div class="tp3-card-media">
                  <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" role="img" aria-label={t.name} class="tp3-card-svg">
                    <defs>
                      <linearGradient id={`lg-${g.slug}-${t.slug}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color={t.c1} />
                        <stop offset="100%" stop-color={t.c2} />
                      </linearGradient>
                    </defs>
                    <rect width="320" height="180" fill={`url(#lg-${g.slug}-${t.slug})`} />
                    <circle cx={t.s1x} cy={t.s1y} r={t.s1r} fill="rgba(255,255,255,0.14)" />
                    <circle cx={t.s2x} cy={t.s2y} r={t.s2r} fill="rgba(255,255,255,0.10)" />
                    <circle cx={t.s3x} cy={t.s3y} r={t.s3r} fill="rgba(255,255,255,0.18)" />
                    <text x="16" y="112" fill="rgba(255,255,255,0.95)" font-size="30" font-weight="800" font-family="inherit">{t.name}</text>
                    <text x="16" y="148" fill="rgba(255,255,255,0.8)" font-size="16" font-weight="600" font-family="inherit">{t.count} courses</text>
                  </svg>
                </div>
                <div class="tp3-card-body">
                  <span class="tp3-card-name">Best {t.name} Courses on Udemy for {currentYear}</span>
                  <span class="tp3-card-count">{t.count} courses &#8594;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      {/* SEO block */}
      <section class="tp3-seo">
        <h2>How CoursesWyn Topic Pages Work</h2>
        <p>Each topic page below is built from the same verified data pipeline as the rest of the site: courses are ranked using real student ratings and review volume from Udemy, then filtered to keep only listings where our <strong>verified coupon code is currently working</strong>. We re-check every deal in near real time, so the discount you see is the price you pay.</p>
        <p>Whether you're a complete beginner or an experienced professional, you'll find top-rated training across {totalCategories} learning areas with hands-on projects, lifetime access, and a certificate of completion included with every enrollment. New {currentYear} deals are added daily, so check back often.</p>
      </section>

      {/* FAQ */}
      <section class="tp3-faq">
        <h2>Frequently Asked Questions About Udemy Course Topics</h2>
        <div class="tp3-faq-list">
          {faqs.map((faq) => (
            <details class="tp3-faq-item">
              <summary>
                {faq.q}
                <span class="tp3-faq-plus">+</span>
              </summary>
              <div class="tp3-faq-a">{faq.a}</div>
            </details>
          ))}
        </div>
      </section>

    </div>
  </div>

<style>
  .tp3-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .tp3-container { max-width: 1200px; margin: 0 auto; }

  .tp3-hero { padding: 2rem 0 3rem; border-bottom: 1px solid var(--border); margin-bottom: 2.5rem; }
  @media (min-width: 900px) { .tp3-hero-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); gap: 3rem; align-items: start; } }
  .tp3-hero-label { display: flex; align-items: center; gap: 0.6rem; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--brand); margin: 0 0 1rem; }
  .tp3-hero-label::before { content: ''; width: 2rem; height: 3px; background: var(--brand); flex-shrink: 0; }
  .tp3-hero h1 { font-size: clamp(2.2rem, 4.5vw, 3.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: var(--text); margin: 0 0 1.25rem; }
  .tp3-grad { background: linear-gradient(135deg, var(--brand) 0%, var(--secondary) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .tp3-claim { font-size: 1rem; color: var(--muted); line-height: 1.7; margin: 0 0 1.75rem; max-width: 42rem; }
  .tp3-hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--border); border-width: 1px 0; max-width: 26rem; }
  .tp3-stat { padding: 1rem 1.25rem 1rem 0; }
  .tp3-stat + .tp3-stat { border-left: 1px solid var(--border); padding-left: 1.25rem; }
  .tp3-stat-lbl { display: block; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 0.25rem; }
  .tp3-stat-val { font-size: 1.4rem; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
  .tp3-hero-right p { font-size: 0.9rem; color: var(--muted); line-height: 1.7; margin: 0 0 0.75rem; }
  .tp3-em { color: var(--text); font-weight: 700; }
  .tp3-fresh { font-size: 0.78rem; color: var(--muted); font-weight: 600; margin-bottom: 1.25rem !important; display: flex; align-items: center; gap: 0.4rem; }
  .tp3-fresh::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--brand); flex-shrink: 0; }
  .tp3-hero-link { color: var(--brand); font-weight: 700; text-decoration: none; font-size: 0.88rem; }
  .tp3-hero-link:hover { text-decoration: underline; }

  .tp3-nav { margin-bottom: 3rem; }
  .tp3-nav-list { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .tp3-nav-link { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.6rem 1rem; background: var(--card); border: 1px solid var(--border); border-radius: 100px; text-decoration: none; transition: all 0.15s; }
  .tp3-nav-link:hover { border-color: var(--brand); }
  .tp3-nav-num { font-size: 0.6rem; font-weight: 800; color: var(--brand); font-variant-numeric: tabular-nums; }
  .tp3-nav-name { font-size: 0.82rem; font-weight: 700; color: var(--text); }
  .tp3-nav-arrow { font-size: 0.7rem; color: var(--muted); opacity: 0; transform: translateX(-0.25rem); transition: all 0.15s; }
  .tp3-nav-link:hover .tp3-nav-arrow { opacity: 1; transform: translateX(0); color: var(--brand); }

  .tp3-cat { margin-bottom: 3rem; scroll-margin-top: 2rem; }
  .tp3-cat-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .tp3-cat-num { font-size: 0.7rem; font-weight: 800; color: var(--brand); font-variant-numeric: tabular-nums; border: 1px solid var(--brand); border-radius: 100px; padding: 0.25rem 0.6rem; }
  .tp3-cat-title { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text); margin: 0; }
  .tp3-cat-meta { font-size: 0.85rem; color: var(--muted); margin: 0; }
  .tp3-cat-link { margin-left: auto; font-size: 0.85rem; font-weight: 700; color: var(--brand); text-decoration: none; }
  .tp3-cat-link:hover { text-decoration: underline; }
  .tp3-cat-link-arrow { display: inline-block; transition: transform 0.15s; }
  .tp3-cat-link:hover .tp3-cat-link-arrow { transform: translateX(0.25rem); }

  .tp3-cat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 1000px) { .tp3-cat-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .tp3-cat-cards { grid-template-columns: 1fr; } }
  .tp3-card { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; text-decoration: none; transition: all 0.2s; }
  .tp3-card:hover { border-color: var(--brand); transform: translateY(-2px); box-shadow: 0 10px 30px -14px rgba(0, 0, 0, 0.4); }
  .tp3-card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; }
  .tp3-card-svg { width: 100%; height: 100%; display: block; }
  .tp3-card-body { display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem 1.15rem; }
  .tp3-card-name { font-weight: 800; font-size: 0.9rem; color: var(--text); line-height: 1.35; }
  .tp3-card-count { font-size: 0.78rem; color: var(--brand); font-weight: 700; }

  .tp3-seo { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 1.75rem 1.5rem; margin-bottom: 2.5rem; }
  .tp3-seo h2 { font-size: 1.3rem; font-weight: 800; color: var(--text); margin: 0 0 0.85rem; }
  .tp3-seo p { font-size: 0.92rem; color: var(--muted); line-height: 1.7; margin: 0 0 0.75rem; }
  .tp3-seo p:last-child { margin-bottom: 0; }
  .tp3-seo strong { color: var(--text); font-weight: 700; }

  .tp3-faq { margin-bottom: 2.5rem; }
  .tp3-faq h2 { font-size: 1.3rem; font-weight: 800; color: var(--text); margin: 0 0 1rem; }
  .tp3-faq-list { display: flex; flex-direction: column; gap: 0.65rem; }
  .tp3-faq-item { background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .tp3-faq-item summary { padding: 1rem 1.25rem; font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 0.98rem; color: var(--text); list-style: none; gap: 0.75rem; }
  .tp3-faq-item summary::-webkit-details-marker { display: none; }
  .tp3-faq-plus { color: var(--brand); font-size: 1.2rem; flex-shrink: 0; transition: transform 0.2s; }
  .tp3-faq-item[open] summary .tp3-faq-plus { transform: rotate(45deg); }
  .tp3-faq-a { padding: 0 1.25rem 1.1rem; color: var(--muted); font-weight: 500; line-height: 1.65; font-size: 0.9rem; }
</style>

</Layout>
