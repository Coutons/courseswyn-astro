---
import Layout from '../layouts/Layout.astro';
import { readDeals } from '../lib/store';
import { dealTopicNames } from '../lib/dealStats';
import { toISODateWIB } from '../lib/date';

const allDeals = await readDeals();

const normSub = (str: string) =>
  str.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").trim();

const categoryOrder = [
  "Development", "IT & Software", "Business", "Teaching & Academics",
  "Personal Development", "Design", "Health & Fitness", "Marketing",
  "Finance & Accounting", "Lifestyle", "Office Productivity", "Music",
  "Photography & Video"
];

const grouped: Record<string, { total: number; topics: Record<string, number> }> = {};

allDeals.forEach(deal => {
  const cat = deal.category?.trim() || "Other";
  const sub = deal.subcategory ? normSub(deal.subcategory) : '';
  if (!grouped[cat]) grouped[cat] = { total: 0, topics: {} };
  grouped[cat].total++;
  const names = dealTopicNames(deal).length ? dealTopicNames(deal) : (sub ? [sub] : []);
  for (const name of names) {
    const t = normSub(name);
    if (t) grouped[cat].topics[t] = (grouped[cat].topics[t] || 0) + 1;
  }
});

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');

const catGroups = categoryOrder
  .filter(c => grouped[c])
  .map(c => ({
    name: c,
    slug: slugify(c),
    total: grouped[c].total,
    topics: Object.entries(grouped[c].topics)
      .sort((a, b) => b[1] - a[1])
      .map(([name, count]) => ({ name, slug: slugify(name), count }))
  }));

const totalTopics = catGroups.reduce((s, g) => s + g.topics.length, 0);
const totalCategories = catGroups.length;

const dates = allDeals.map(d => d.updatedAt ?? d.createdAt).filter(Boolean) as string[];
const latestDate = dates.length ? dates.sort().reverse()[0] : null;
const latestStr = latestDate ? new Date(latestDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Jakarta' }) : '';

const currentYear = new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' });
const currentDate = toISODateWIB();

const title = `Browse ${totalTopics.toLocaleString()}+ Udemy Course Topics with Verified Coupons ${currentYear} | CoursesWyn`;
const description = `Explore ${totalTopics.toLocaleString()} Udemy course topics across ${totalCategories} categories — each with verified coupon codes updated ${latestStr || 'daily'}. Find discounted deals on Python, AI, web dev, cloud & more.`;
const canonicalUrl = "https://courseswyn.com/topics";

const pageKeywords = [
  "udemy topics", "udemy course topics", "udemy courses by topic",
  "python udemy coupon", "ai udemy coupon", "web development coupon",
  "data science coupon", "cybersecurity coupon", "udemy coupon code"
].join(", ");

const faqs = [
  { q: "What are Udemy course topics on CoursesWyn?", a: "CoursesWyn organizes Udemy courses into specialized topic pages — such as Python, Web Development, Data Science, AI, and Cybersecurity. Each topic page lists verified coupon deals for courses in that subject area, updated daily." },
  { q: "How do I find Udemy courses by topic?", a: "Browse the topic categories above and click on any subject that interests you. You'll see all available courses in that topic with verified discount codes." },
  { q: "Are these Udemy coupons verified?", a: "Yes. Every coupon is tested daily by our team. Each listing clearly shows the final price after coupon and discount percentage." },
  { q: "Which Udemy topics have the most deals?", a: "Programming topics like Python, JavaScript, and Web Development typically have the most deals. AI and Machine Learning topics are also growing rapidly." },
  { q: "How often are new topics and deals added?", a: "New deals are added every single day. We recommend bookmarking your favorite topic pages and checking back regularly." },
  { q: "Do discounted Udemy courses include certificates?", a: "Yes. All courses accessed through our coupons include full Udemy benefits — completion certificates, lifetime access, all video content, and downloadable resources." }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" }, { "@type": "ListItem", "position": 2, "name": "Course Topics", "item": canonicalUrl }] },
    { "@type": ["WebPage", "CollectionPage"], "@id": canonicalUrl, "url": canonicalUrl, "name": title, "description": description, "keywords": pageKeywords, "inLanguage": "en-US", "isPartOf": { "@id": "https://courseswyn.com/#website" }, ...(latestDate ? { "dateModified": latestDate, "datePublished": latestDate } : {}) },
    { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
    { "@type": "WebSite", "@id": "https://courseswyn.com/#website", "url": "https://courseswyn.com", "name": "CoursesWyn", "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://courseswyn.com/search?q={search_term_string}" }, "query-input": "required name=search_term_string" } }
  ]
};
---

<Layout title={title} description={description} canonical={canonicalUrl} hideBreadcrumbs={false}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="fd-header">
        <h1 class="fd-title">Find Courses by Topic</h1>
        <p class="fd-sub">Course topics across business, technology, creative arts, and personal development — every topic backed by verified Udemy coupon codes. Filter by category, search, or sort to find your next course.</p>
      </header>

      <section class="fd-wrap" id="finder" aria-label="Find a topic">
        <div class="fd-bar">
          <div class="fd-bar-left">
            <label class="fd-cat-wrap" aria-label="Filter by category">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/></svg>
              <select class="fd-cat" id="fdCat" aria-label="Filter by category">
                <option value="">All categories</option>
                {catGroups.map((g) => (
                  <option value={g.slug}>{g.name} ({g.topics.length})</option>
                ))}
              </select>
            </label>
            <span class="fd-tags" id="fdTags"></span>
          </div>
          <div class="fd-bar-right">
            <div class="fd-search-wrap" role="search">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="search" id="fdSearch" class="fd-search-input" placeholder={`Search ${totalTopics.toLocaleString()} topics…`} autocomplete="off" spellcheck="false" aria-label="Search topics by name" />
            </div>
            <span class="fd-count" id="fdCount"></span>
            <button class="fd-clear-bar" id="fdClear" type="button" hidden>Clear</button>
          </div>
        </div>

        {catGroups.map((g) => (
          <section class="tp-group" data-group={g.slug} id={`topics-${g.slug}`} aria-label={`${g.name} topics`}>
            <h2 class="tp-glabel">{g.name} <span class="tp-gcount">{g.topics.length} topics</span></h2>
            <div class="fd-grid">
              {g.topics.map((t) => (
                <a
                  href={`/topics/${t.slug}`}
                  class="fd-card"
                  data-name={t.name.toLowerCase()}
                  title={`Best ${t.name} Courses on Udemy for ${currentYear}`}
                >
                  <span class="fd-body">
                    <span class="fd-name">{t.name}</span>
                    <span class="fd-meta">{t.count} courses · verified coupons</span>
                    <span class="fd-go">Explore courses →</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))}
        <p class="fd-empty" id="fdEmpty" hidden>No topics match your filters. <button type="button" id="fdEmptyClear">Clear all</button></p>
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">How CoursesWyn Topic Pages Work</h2>
        <p>Each topic page below is built from the same verified data pipeline as the rest of the site: courses are ranked using real student ratings and review volume from Udemy, then filtered to keep only listings where our <strong>verified coupon code is currently working</strong>. We re-check every deal in near real time, so the discount you see is the price you pay.</p>
        <p>Whether you're a complete beginner or an experienced professional, you'll find top-rated training across {totalCategories} learning areas with hands-on projects, lifetime access, and a certificate of completion included with every enrollment. New {currentYear} deals are added daily, so check back often.</p>
      </section>

      <section class="cc-section cc-faq">
        <h2 class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Udemy Course Topic FAQs
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Every topic verified</p>
        <p class="cc-cta-text">Every topic on this page is built from courses with currently working coupon codes. Prefer browsing by category? Start there instead.</p>
        <a class="cc-hero-btn" href="/udemy-coupon-code">Browse all verified coupons →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #2563EB; animation: ccBlip 1.6s infinite; }
    @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
    .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
    .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
    .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
    .dh-hero-title .cc-accent { color: var(--brand); }
    .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
    .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
    .dh-stat { display: flex; flex-direction: column; }
    .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
    .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
    .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
    @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
    .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
    .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
    .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
    .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
    .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
    .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
    .dh-term-live .lg-blip { background: var(--stamp); }
    .dh-term-body { padding: 4px 0; }
    .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
    a.dh-term-line:hover { background: var(--brand-soft); }
    .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
    .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
    .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
    .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
    .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
    .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
    .dh-term-foot b { color: var(--brand); }
    @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .cc-folio { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); border: 1px dashed var(--border); border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #CF6F59; }
  .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: var(--text); font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: var(--brand-gradient); color: #fff; box-shadow: 0 10px 24px -8px rgba(37, 99, 235, 0.5); transition: filter 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid var(--brand); box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: var(--brand-soft); color: var(--brand); }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed var(--border); padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid var(--border); }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cc-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--text); }

  /* ===== CHIP NAV ===== */

  /* ===== SECTION HEADS ===== */
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid var(--border); padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

  .cc-section { margin-top: 3.25rem; scroll-margin-top: 120px; }

  /* ===== FINDER HEADER (like the reference: title + short paragraph) ===== */
  .fd-header { margin-top: 1.5rem; padding: 1.75rem 1.75rem; max-width: none; background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); border-radius: 16px; }
  .fd-title { font-size: clamp(1.7rem, 3.6vw, 2.3rem); font-weight: 800; letter-spacing: -0.02em; color: #fff; margin: 0 0 0.5rem; line-height: 1.15; }
  .fd-sub { font-size: 0.93rem; line-height: 1.65; color: rgba(255, 255, 255, 0.85); margin: 0; max-width: 720px; }

  /* ===== TOPIC FINDER (CourseLegend-style toolbar + cards) ===== */
  .fd-wrap { margin-top: 2.5rem; scroll-margin-top: 90px; }
  .fd-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 12px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
  .fd-bar-left, .fd-bar-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; min-width: 0; }
  .fd-cat-wrap, .fd-sort-wrap, .fd-search-wrap { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); }
  .fd-cat, .fd-sort { font-size: 0.85rem; font-weight: 600; color: var(--text); background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-family: inherit; max-width: 220px; }
  .fd-search-wrap { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 0 10px; }
  .fd-search-input { border: none; background: transparent; outline: none; font-size: 0.85rem; color: var(--text); padding: 8px 0; width: 190px; font-family: inherit; }
  .fd-count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .fd-tags { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .fd-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; color: var(--brand); background: var(--brand-soft); border-radius: 999px; padding: 4px 6px 4px 12px; }
  .fd-tag button { border: none; background: transparent; color: inherit; cursor: pointer; font-size: 0.85rem; line-height: 1; padding: 2px 4px; }
  .fd-clear-bar { border: 1px solid var(--border); background: transparent; color: var(--muted); font-size: 0.78rem; font-weight: 700; border-radius: 8px; padding: 7px 12px; cursor: pointer; font-family: inherit; }
  .fd-clear-bar:hover { color: var(--brand); border-color: var(--brand); }
  .tp-group { margin-top: 2.5rem; scroll-margin-top: 90px; }
  .tp-glabel { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; color: var(--text); margin: 0 0 0.85rem; display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .tp-gcount { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .fd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.85rem; }
  .fd-card { display: block; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1rem 1.1rem; text-decoration: none; transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s; }
  .fd-card:hover { transform: translateY(-2px); border-color: var(--brand); box-shadow: 0 10px 26px -18px rgba(37, 99, 235, 0.4); }
  .fd-body { display: flex; flex-direction: column; gap: 3px; }
  .fd-name { font-size: 0.95rem; font-weight: 700; color: var(--text); line-height: 1.35; }
  .fd-card:hover .fd-name { color: var(--brand); }
  .fd-meta { font-size: 0.78rem; color: var(--muted); }
  .fd-go { margin-top: 6px; font-size: 0.8rem; font-weight: 700; color: var(--brand); }
  .fd-empty { font-size: 0.9rem; color: var(--muted); background: var(--bg-secondary); border: 1px dashed var(--border); border-radius: 12px; padding: 1.5rem; text-align: center; margin-top: 1.25rem; }
  .fd-empty button { border: none; background: none; color: var(--brand); font-weight: 700; cursor: pointer; font-size: inherit; font-family: inherit; }

  /* ===== GENERIC SECTION HEADS (seo/faq) ===== */
  .cc-section-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.3rem; display: flex; align-items: center; gap: 0.6rem; letter-spacing: -0.01em; flex-wrap: wrap; }
  .cc-section-title svg { color: var(--brand); flex-shrink: 0; }
  .cc-section-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid var(--border); padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }

  .cc-seo-section { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1.5rem; margin: 3.25rem 0 0; }
  .cc-seo-section .cc-section-title { font-size: 1.15rem; margin-bottom: 0.75rem; }
  .cc-seo-section p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.75rem; }
  .cc-seo-section p:last-child { margin-bottom: 0; }
  .cc-seo-section a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-seo-section a:hover { text-decoration: underline; }

  .cc-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 768px) { .cc-faq-grid { grid-template-columns: 1fr; } }
  .cc-faq-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.15rem; }
  .cc-faq-card:hover { border-color: var(--muted-light); }
  .cc-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
  .cc-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }
  .cc-faq-a a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-faq-a a:hover { text-decoration: underline; }

  .cc-cta { background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 16px; padding: 30px 32px; text-align: center; margin: 3.25rem 0 0; }
  .cc-cta-eyebrow { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
  .cc-cta-text { font-size: 0.95rem; line-height: 1.6; margin: 0 auto 18px; max-width: 480px; color: var(--muted); }
  .cc-cta .cc-hero-btn { background: var(--brand-gradient); color: #fff; box-shadow: 0 12px 28px -12px rgba(37, 99, 235, 0.55); }
  .cc-cta .cc-hero-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }

  @media (max-width: 768px) {
    .cc-title { font-size: 1.9rem; }
    .cc-register { padding: 26px 20px 22px; }
    .cc-ledger-cell { border-left: none; padding: 8px 0; }
  }
  @media (max-width: 480px) {
    .cc-title { font-size: 1.7rem; }
    .cc-hero-btn { padding: 11px 16px; font-size: 0.85rem; }
  }
  .dh-terminal { background: #fff; }
  .dh-term-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: #f7f7f8; border-bottom: 1px solid var(--border); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #111111; }
  .dh-term-head a { margin-left: auto; font-size: 0.8rem; font-weight: 700; color: #2563EB; text-decoration: none; text-transform: none; letter-spacing: 0; }
  .dh-term-head a:hover { text-decoration: underline; }
  .dh-term-dot, .dh-term-title, .dh-term-live { display: none; }
  .dh-term-line { font-family: inherit; font-size: 0.85rem; color: #111111; }
  .dh-term-ok { color: #16a34a; }
  .dh-term-cat, .dh-term-save { color: #2563EB; }
  .dh-term-foot { background: #f7f7f8; color: #555555; font-family: inherit; }
</style>

<script>
  (function () {
    var catSel = document.getElementById('fdCat') as HTMLSelectElement | null;
    var searchInput = document.getElementById('fdSearch') as HTMLInputElement | null;
    var countEl = document.getElementById('fdCount');
    var emptyEl = document.getElementById('fdEmpty');
    var clearBtn = document.getElementById('fdClear') as HTMLButtonElement | null;
    var emptyClear = document.getElementById('fdEmptyClear');
    var tagsEl = document.getElementById('fdTags');
    var total = document.querySelectorAll('.fd-card').length;
    function isDefault(): boolean {
      return (catSel?.value || '') === '' && (searchInput?.value.trim() || '') === '';
    }
    // NOTE: filter only — never reorders the DOM, so the page can't jump on its own.
    function applyFinder() {
      var cat = catSel?.value || '';
      var q = (searchInput?.value || '').trim().toLowerCase();
      var shown = 0;
      document.querySelectorAll<HTMLElement>('.tp-group').forEach(function (sec) {
        var visible = 0;
        var groupMatch = !cat || sec.dataset.group === cat;
        sec.querySelectorAll<HTMLElement>('.fd-card').forEach(function (card) {
          var hit = groupMatch && (!q || (card.dataset.name || '').includes(q));
          card.style.display = hit ? '' : 'none';
          if (hit) { visible++; shown++; }
        });
        sec.style.display = visible ? '' : 'none';
      });
      if (emptyEl) emptyEl.hidden = shown !== 0;
      if (countEl) countEl.textContent = isDefault() ? total + ' topics' : 'Showing ' + shown + ' of ' + total + ' topics';
      if (clearBtn) clearBtn.hidden = isDefault();
      if (tagsEl) {
        tagsEl.innerHTML = '';
        if (cat && catSel) {
          var label = catSel.options[catSel.selectedIndex]?.text || cat;
          var tag = document.createElement('span');
          tag.className = 'fd-tag';
          tag.textContent = label + ' ';
          var x = document.createElement('button');
          x.type = 'button'; x.textContent = '✕'; x.setAttribute('aria-label', 'Remove category filter');
          x.addEventListener('click', function () { if (catSel) catSel.value = ''; applyFinder(); });
          tag.appendChild(x);
          tagsEl.appendChild(tag);
        }
      }
    }
    function resetFinder() {
      if (catSel) catSel.value = '';
      if (searchInput) searchInput.value = '';
      applyFinder();
    }
    catSel?.addEventListener('change', applyFinder);
    searchInput?.addEventListener('input', applyFinder);
    clearBtn?.addEventListener('click', resetFinder);
    emptyClear?.addEventListener('click', resetFinder);
    applyFinder();
    function animateCount(el: Element): void {
      const target = parseInt(el.getAttribute('data-count') || '0', 10);
      if (isNaN(target)) return;
      const dur = 900;
      let start: number | null = null;
      function step(ts: number): void {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    var counters = document.querySelectorAll('[data-count]');
    if (!('IntersectionObserver' in window)) {
      counters.forEach(animateCount);
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animateCount(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      counters.forEach(function (c) { io.observe(c); });
    }
  })();
</script>

</Layout>
