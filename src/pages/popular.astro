---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import LedgerRow from "../components/LedgerRow.astro";
import { readDeals } from "../lib/store";
import { normName, slugifyCategory, buildHeroFeed } from "../lib/utils";
import { toISODateWIB } from "../lib/date";

const allDeals = await readDeals();
const selectedLanguage = Astro.url.searchParams.get('language');

// ── INTENTIONAL: 4.5+★ rated courses — by design, showing highest-rated ────────
let filteredDeals = allDeals;
if (selectedLanguage) {
  filteredDeals = allDeals.filter((d: any) => 
    d.language && d.language.toLowerCase() === selectedLanguage.toLowerCase()
  );
}

const popularCourses = filteredDeals
  .filter(deal => deal.rating && deal.rating >= 4.5)
  .sort((a, b) => (b.rating || 0) - (a.rating || 0))
  .slice(0, 100);

// ── Stats ─────────────────────────────────────────────────────────────────────
const totalDeals = allDeals.length;
const totalPopular = popularCourses.length;
const avgRating = popularCourses.length > 0
  ? (popularCourses.reduce((sum, c) => sum + (c.rating ?? 0), 0) / popularCourses.filter(c => c.rating).length).toFixed(1)
  : "5.0";
const now = new Date();
const heroFeed = buildHeroFeed(popularCourses, now, 3);

// ── Categories ────────────────────────────────────────────────────────────────
const categoryMap = new Map<string, number>();
allDeals.forEach(deal => {
  const name = normName(deal.category) || "Uncategorized";
  categoryMap.set(name, (categoryMap.get(name) ?? 0) + 1);
});
const categories = Array.from(categoryMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 9)
  .map(([name, count]) => ({ name, count }));

// ── SEO — popular online courses keyword matching URL path ───────
const langSuffix = selectedLanguage ? ` in ${selectedLanguage}` : "";
const pageTitle = `Most Popular Udemy Courses & Top-Rated Online Classes${langSuffix} | CoursesWyn`;
const pageDescription = `Browse top-rated Udemy courses with verified coupon codes${langSuffix}. Discover trending classes in programming, design, marketing & data science — updated daily.`;
const canonicalUrl = selectedLanguage 
  ? `https://courseswyn.com/popular?language=${encodeURIComponent(selectedLanguage)}`
  : "https://courseswyn.com/popular";

const pageKeywords = [
  "popular udemy courses",
  "top rated online courses",
  "best rated udemy courses",
  "trending online classes",
  "popular online courses with certificates",
  "highly rated udemy courses",
  "udemy coupon code"
].join(", ");

const faqs = [
  {
    q: "What are popular online courses on CoursesWyn?",
    a: "CoursesWyn's Popular page showcases trending online courses with 4.5-5.0★ student ratings. These are the most sought-after Udemy courses — where students consistently give high scores and enroll in high numbers."
  },
  {
    q: "Are popular online courses discounted on CoursesWyn?",
    a: "CoursesWyn lists verified coupon codes for all featured courses. Click any course card to see the current coupon and discounted price before enrolling."
  },
  {
    q: "How are popular online courses ranked?",
    a: "Popular courses are ranked by a combination of student rating (4.5-5.0★), enrollment numbers, and recent engagement. This ensures you discover courses that are both high-quality and currently trending among learners."
  },
  {
    q: "Do popular online courses include a completion certificate?",
    a: "Yes. All Udemy courses listed on CoursesWyn include a certificate of completion you can share on LinkedIn or add to your resume."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "description": pageDescription,
      "keywords": pageKeywords,
      "inLanguage": "en-US",
      "dateModified": toISODateWIB(),
      "isPartOf": { "@id": "https://courseswyn.com/#website" },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://courseswyn.com" },
          { "@type": "ListItem", "position": 2, "name": "Popular Courses", "item": canonicalUrl }
        ]
      },
      "mainEntity": { "@id": `${canonicalUrl}#itemlist` }
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#itemlist`,
      "name": "Popular Online Courses",
      "numberOfItems": totalPopular,
      "itemListElement": popularCourses.slice(0, 20).map((course, index) => ({
        "@type": "ListItem",
        "position": index + 1,
          "url": `https://courseswyn.com/coupon/${course.slug}`,
        "item": {
          "@type": "Course",
          "name": course.title,
          "description": course.description || `Popular Udemy course with ${course.rating}★ rating`,
        "url": `https://courseswyn.com/coupon/${course.slug}`,
          "provider": {
            "@type": "Organization",
            "name": course.provider || "Udemy",
            "sameAs": "https://www.udemy.com"
          },
          "offers": {
            "@type": "Offer",
            "price": String(course.price ?? "0"),
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock"
          }
        }
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl}   hideBreadcrumbs={false}>
  <Fragment slot="head">
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="dh-hero-grid">
          <div class="dh-hero-left">
            <div class="dh-hero-badge"><span class="lg-blip"></span> Top-rated collection &middot; avg {avgRating}★</div>
            <h1 class="dh-hero-title">Popular <span class="cc-accent">Udemy Courses</span>{selectedLanguage && <span class="cc-page-label">{selectedLanguage}</span>}</h1>
            <p class="dh-hero-sub">Discover <strong>{totalPopular}+ trending online courses</strong> with exceptional student ratings &amp; verified coupon codes — updated daily.</p>
            <div class="dh-hero-stats">
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={totalPopular}>0</span><span class="lg-plus">+</span></b><span class="dh-stat-label">popular courses</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={categories.length}>0</span></b><span class="dh-stat-label">categories</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={100}>0</span><span class="lg-plus">%</span></b><span class="dh-stat-label">verified codes</span></div>
            </div>
          </div>
          <div class="dh-terminal">
            <div class="dh-term-head">
              <span class="dh-term-dot" style="background:#ff5f56"></span>
              <span class="dh-term-dot" style="background:#ffbd2e"></span>
              <span class="dh-term-dot" style="background:#27c93f"></span>
              <span class="dh-term-title">agents@courseswyn: ~/popular</span>
              <span class="dh-term-live"><span class="lg-blip"></span> Live</span>
            </div>
            <div class="dh-term-body">
              {heroFeed.map((d) => (
                <a class="dh-term-line" href={"/coupon/" + d.slug}>
                  <span class="dh-term-time">{d.timeLabel}</span>
                  <span class="dh-term-ok">✓</span>
                  <span class="dh-term-cat">{d.cat}</span>
                  <span class="dh-term-title2">{d.title}</span>
                  <span class="dh-term-save">−{d.pct}%</span>
                </a>
              ))}
              <div class="dh-term-line"><span class="dh-term-time">now</span><span class="dh-term-ok">✓</span><span class="dh-term-title2">codes checked by CoursesWyn<span class="caret"></span></span></div>
            </div>
            <div class="dh-term-foot">$ top-rated codes live <b>{totalPopular}</b></div>
          </div>
        </div>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="#deals">Browse all {totalPopular} courses</a>
          <a class="cc-hero-btn ghost" href="/categories">Browse by category</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
        </div>
      </header>

      <section class="cc-section cc-chips-section" aria-label="Popular categories">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Popular categories <span class="cc-tag">{categories.length} categories</span></h2>
          <p class="cc-sec-desc">Find top-rated courses in your field — jump straight to the category archive.</p>
        </div>
        <nav class="cc-chip-nav" aria-label="Course categories">
          {categories.map(cat => (
            <a href={`/categories/${slugifyCategory(cat.name)}`} class="cc-chip">
              <span class="cc-chip-arrow">→</span>
              <span class="cc-chip-name">{cat.name}</span>
              <span class="cc-chip-num">{cat.count}</span>
            </a>
          ))}
        </nav>
      </section>

      <section class="cc-deals-section" id="deals" aria-label="Popular Udemy courses">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Popular Udemy Courses with Verified Coupons <span class="cc-tag">4.5★+ rated</span></h2>
          <p class="cc-sec-desc">Sorted by popularity — {popularCourses.length} courses with currently working coupon codes.</p>
        </div>

        {popularCourses.length > 0 ? (
          <div class="cc-ledger-wrap">
            <table class="cc-ledger-table">
              <thead><tr><th>Course</th><th>Price</th><th class="cc-col-hide">Status</th><th>Checked</th></tr></thead>
              <tbody>
                {popularCourses.map((course) => <LedgerRow deal={course} />)}
              </tbody>
            </table>
            <div class="cc-deal-more"><span class="cc-deal-count">{popularCourses.length} top-rated courses — verified before listing</span></div>
          </div>
        ) : (
          <div class="cc-empty">
            <h3>No Popular {selectedLanguage} Courses</h3>
            <p>We don't have any 4.5★+ rated {selectedLanguage} courses at the moment.</p>
            <a href="/popular" class="cc-hero-btn">View All Popular Courses →</a>
          </div>
        )}
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">How CoursesWyn selects popular courses</h2>
        <p>Our Popular page features the highest-rated <strong>Udemy courses with 4.5-5.0★ ratings</strong> — courses that students consistently praise through positive reviews and high enrollment numbers. All {totalPopular}+ featured courses include <strong>verified coupon codes</strong> that are tested and confirmed working by our editorial team. Popular categories on this page include <a href="/categories/development">Development</a>, <a href="/categories/data-science">Data Science</a>, <a href="/categories/ai-and-machine-learning">AI & Machine Learning</a>, and <a href="/categories/it-and-software">IT & Software</a>.</p>
        <p>Courses are ranked using a proprietary scoring system that weighs <strong>student ratings, total enrollment, review quality, and recent engagement metrics</strong>. This means you're always seeing courses that are not only top-rated but currently trending among learners worldwide. Each course card displays the exact rating, student count, instructor name, and course duration — so you can make an informed decision before clicking through.</p>
        <p>Since <a href="https://teach.udemy.com/update-for-instructors-improving-free-coupons-better-targeting-higher-quality-learning/" rel="noopener" target="_blank">Udemy's free coupon policy update</a>, most coupons are limited to a set number of redemptions or expire within days. Our system checks every coupon against Udemy in near real time — expired deals disappear automatically. Browse <a href="/udemy-coupon-code">all verified coupons</a>, explore <a href="/categories">course categories</a>, or check <a href="/udemy-coupons-today">today's latest deals</a> for freshly added discounts.</p>
      </section>

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Popular Udemy Course FAQs
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Catalog complete</p>
        <p class="cc-cta-text">Browse our full collection of <strong>{totalDeals.toLocaleString()}+ verified Udemy deals</strong> — every code checked against Udemy before listing.</p>
        <a class="cc-hero-btn" href="/udemy-coupon-code">Browse All Deals →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: var(--card); border: 1px solid #232B26; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #FFC94D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
  .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
  .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
  .dh-hero-title .cc-accent { color: var(--brand); }
  .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
  .dh-hero-sub strong { color: var(--text); }
  .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .dh-stat { display: flex; flex-direction: column; }
  .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
  .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
  @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
  .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
  .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
  .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
  .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
  .dh-term-live .lg-blip { background: var(--stamp); }
  .dh-term-body { padding: 4px 0; }
  .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
  a.dh-term-line:hover { background: var(--brand-soft); }
  .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
  .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
  .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
  .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
  .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
  .dh-term-foot b { color: var(--brand); }
  @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .cc-folio { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); border: 1px dashed var(--border); border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #CF6F59; }
  .cc-page-label { display: inline-flex; align-items: center; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 4px 10px; margin-left: 0.6rem; vertical-align: middle; }
  .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: var(--text); font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #FFC94D; color: #0b0e14; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #FFC94D; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #FFC94D; color: #0b0e14; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed var(--border); padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #232B26; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cc-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--text); }

  /* ===== SECTION HEADS ===== */
  .cc-section { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

  /* ===== CHIP NAV ===== */
  .cc-chip-nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .cc-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--card); border: 1px solid #232B26; border-radius: 999px; text-decoration: none; transition: all 0.15s; }
  .cc-chip:hover { border-color: var(--brand); }
  .cc-chip-name { font-size: 0.78125rem; font-weight: 600; color: var(--text); }
  .cc-chip-num { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 600; color: var(--muted); background: var(--bg-secondary); border-radius: 999px; padding: 2px 8px; }
  .cc-chip-arrow { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); transition: transform 0.15s; }
  .cc-chip:hover .cc-chip-arrow { color: var(--brand); transform: translateX(3px); }

  /* ===== LEDGER TABLE ===== */
  .cc-deals-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .cc-ledger-wrap { background: var(--card); border: 1px solid #232B26; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.16); margin-top: 16px; }
  table.cc-ledger-table { width: 100%; border-collapse: collapse; }
  .cc-ledger-table thead th { font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid #232B26; background: var(--bg-secondary); white-space: nowrap; }
  .cc-deal-more { display: flex; justify-content: center; align-items: center; gap: 14px; flex-wrap: wrap; padding: 16px; background: var(--bg-secondary); border-top: 1px solid #232B26; }
  .cc-deal-more a { font-family: var(--font-mono); font-size: 0.78125rem; font-weight: 600; color: var(--brand); text-decoration: none; }
  .cc-deal-more a:hover { text-decoration: underline; }
  .cc-deal-count { font-family: var(--font-mono); font-size: 0.71875rem; color: var(--muted); }

