---
import Layout from "../../layouts/Layout.astro";
import CouponGrid from "../../components/CouponGrid.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import VoucherHero from "../../components/VoucherHero.astro";
import VoucherGrid from "../../components/VoucherGrid.astro";
import { getDeals } from "../../lib/store.js";
import { formatDateWIB, toISODateWIB } from "../../lib/date";
import { COMPTIA_GROUPS, countVouchers, voucherAffUrl, voucherCatalogAffUrl } from "../../lib/vouchers.js";

const canonicalUrl = "https://courseswyn.com/udemy-comptia-exam-vouchers/";
const pageTitle = "CompTIA Exam Voucher 2026: Udemy Prices & 10% Off";
const pageDescription =
  "CompTIA exam vouchers on Udemy (2026): Security+ (SY0-701), A+, Network+ (N10-009) and more — Udemy advertises 10% off on the pages we checked, valid ≥9 months, online or in-person.";
const publishedISO = "2026-09-20";
const lastModified = toISODateWIB();
const now = new Date();
const dateFull = formatDateWIB(now, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
const catalogUrl = voucherCatalogAffUrl();
const total = countVouchers(COMPTIA_GROUPS);
const allVouchers = COMPTIA_GROUPS.flatMap((g) => g.items);
const availableVouchers = allVouchers.filter((v) => !v.catalogOnly);
const totalAvailable = availableVouchers.length;

const examFamilies = [
  {
    family: "Fundamentals & A+",
    exams: "Tech+, and A+ (Core 1 & Core 2) — both sold on Udemy.",
    coverage: "One exam per voucher. A+ needs one Core 1 + one Core 2 voucher — an A+ voucher cannot pay for both halves.",
  },
  {
    family: "Networking & Security",
    exams: "Network+ (N10-009), Security+ (SY0-701) — both sold on Udemy.",
    coverage: "Exam-specific — one voucher per exam code",
  },
  {
    family: "Cybersecurity",
    exams: "CySA+, PenTest+, SecurityX — all three sold on Udemy.",
    coverage: "Exam-specific — one voucher per exam",
  },
  {
    family: "Infrastructure & Cloud",
    exams: "Linux+, Cloud+, CloudNetX and Server+ — all four sold on Udemy.",
    coverage: "Exam-specific. CloudNetX is the premium listing (advertised at US$476.50 when we checked) — always verify the live price.",
  },
  {
    family: "Data & Project",
    exams: "Data+, DataSys+, DataAI and Project+ — all four sold on Udemy.",
    coverage: "Exam-specific — one voucher per exam",
  },
];

const voucherPicks = [
  {
    level: "A+ (Core 1 & Core 2)",
    best: "Starting out in IT",
    body: "The standard entry ticket for help desk and IT support. Remember: one voucher covers either Core 1 or Core 2 — budget for two vouchers (and two exams) to finish A+.",
  },
  {
    level: "Security+ (SY0-701)",
    best: "Most popular",
    body: "The baseline cybersecurity certification and the one most employers and government/defense frameworks reference. SY0-701 is the current version — CompTIA has announced Security+ V8 for 17 November 2026, so confirm which code your voucher covers if you buy around the transition.",
  },
  {
    level: "CySA+ / PenTest+ / SecurityX",
    best: "Hands-on security",
    body: "For analyst and offensive roles (CySA+ and PenTest+) and expert-level security architecture (SecurityX). Take Security+ first unless you already work in the field.",
  },
];

const comparisonRows = [
  {
    label: "Price",
    udemy: "Udemy advertises “save 10%” on the Security+, A+ and Network+ pages we checked (4 November 2026); CloudNetX advertises a saving without a fixed percentage. Udemy's price is its own — it is not tied to the CompTIA price and varies by country and promotion.",
    aws: "CompTIA store: each exam is priced separately, per exam and per country, with local-currency pricing in many markets. Prices change — the price on your regional CompTIA store at checkout is the one that applies.",
  },
  {
    label: "Retake",
    udemy: "Retake Assurance (the add-on on the pages that offer it): one extra attempt bundled with the voucher. Must be bought with the voucher; cannot be added later; non-refundable.",
    aws: "A failed attempt means buying a new exam. No retake is included with a standard CompTIA store voucher.",
  },
  {
    label: "Validity",
    udemy: "At least 9 months from purchase, including bundled retake options. Cannot be extended.",
    aws: "12 months from purchase, per CompTIA's store return policy. Cannot be extended either.",
  },
  {
    label: "Refund",
    udemy: "Non-refundable and non-transferable. Expired vouchers are forfeited. No exception if you pass first try.",
    aws: "CompTIA's return policy likewise treats exam vouchers as non-refundable and non-transferable once purchased.",
  },
  {
    label: "Region",
    udemy: "Valid only in the country of purchase.",
    aws: "Also region- and currency-specific; the price you see is for your region.",
  },
  {
    label: "Scheduling",
    udemy: "Redeem on CompTIA's site; exam is booked through Pearson VUE (online proctored or in a test centre). Udemy handles only the voucher.",
    aws: "Same — Pearson VUE delivers the exam. The CompTIA store only sells the voucher.",
  },
  {
    label: "Best for",
    udemy: "Getting a small advertised saving and, where offered, bundling one extra attempt with your prep course.",
    aws: "Direct purchase with a longer (12-month) expiry and CompTIA's standard support.",
  },
];

const faqs: { q: string; a: string; html?: string }[] = [
  {
    q: "How much does a CompTIA exam cost in 2026?",
    a: "CompTIA does not publish a single global USD price list — each exam is priced separately per exam and per country, and prices change. The price on your regional CompTIA store (or at Pearson VUE checkout) is the one that applies to you. Because of that, we do not quote assumed dollar figures on this page.",
  },
  {
    q: "How much is a Udemy CompTIA exam voucher in 2026?",
    a: "Udemy advertises “save 10%” on the Security+, A+ and Network+ voucher pages we checked (4 November 2026). The CloudNetX page advertises a saving without a fixed percentage. Udemy does not publish a fixed price table — the amount at checkout varies by country and promotion. Compare the live checkout price with the CompTIA price for your region before buying; don't assume a flat 10% off.",
  },
  {
    q: "Which CompTIA vouchers include a retake option?",
    a: "Most CompTIA voucher pages on Udemy that mention a retake option sell it as an add-on (shown at checkout). It cannot be added after purchase, covers one extra attempt, and is non-refundable. Not every page offers it — the options shown at your checkout are the ones available to you, and the A+ listing we track advertises validity only, not a retake add-on. Confirm at checkout before paying.",
  },
  {
    q: "How do I schedule my CompTIA exam with a voucher?",
    a: "After payment, copy the code from My learning → Certifications (or the email from Udemy). Then sign in to your CompTIA account, start the scheduling flow, and you will be directed to Pearson VUE to pick online proctored or an in-person appointment. Paste the voucher code at checkout. Vouchers are valid only in the country of purchase, and CompTIA/Pearson VUE — not Udemy — handle scheduling and proctoring.",
  },
  {
    q: "How long is a CompTIA voucher valid?",
    a: "At least 9 months from the date of purchase on Udemy, including any bundled retake option. CompTIA's own store vouchers expire 12 months after purchase. Neither can be extended, and expired vouchers are forfeited. Vouchers are non-refundable and non-transferable.",
  },
  {
    q: "Does one A+ voucher cover both core exams?",
    a: "No. The CompTIA A+ voucher can be used for either the Core 1 or the Core 2 exam — you need a separate voucher for each half. If you are buying A+, budget for two vouchers.",
  },
  {
    q: "What happens if I fail the exam?",
    a: "CompTIA's own retake policy applies between attempts — check the current policy on CompTIA's site before booking. If you bought the retake add-on with your Udemy voucher, one extra attempt is covered; otherwise you purchase a new exam. Waiting periods still apply and are not waived by the add-on.",
  },
  {
    q: "Is there a free way to retake a CompTIA exam?",
    a: "No general free retake exists. Your options are the retake add-on on eligible Udemy voucher pages (one extra attempt, non-refundable) or buying a new exam. CompTIA sometimes runs promotions — check the CompTIA store and certification pages for current offers.",
  },
  {
    q: "Do CompTIA certifications expire?",
    a: "Most CompTIA certifications must be renewed every three years through Continuing Education (CE) — you collect CE credits (training, exams, teaching, publishing) to keep the certification current. Check the individual certification page for its renewal rules.",
  },
  {
    q: "Are Udemy CompTIA exam vouchers legitimate?",
    a: "Yes. Udemy sells and delivers the voucher code; Pearson VUE delivers and proctors the exam; CompTIA owns the certification and issues it. The code is redeemed in the CompTIA → Pearson VUE flow, not inside Udemy. Buy only from the official voucher pages and keep your receipt.",
  },
  {
    q: "Can I use a Udemy coupon on a CompTIA voucher?",
    a: "No. Udemy coupons and promo codes never apply to exam vouchers — but they do apply to the CompTIA prep courses below, which is usually the cheapest way to get exam-ready.",
  },
  {
    q: "Can I get a refund on a CompTIA voucher?",
    a: "No. CompTIA vouchers are non-refundable and non-transferable, and an expired voucher is forfeited. Cancel or reschedule at least 24 hours before the appointment or the voucher is forfeited — the exact window is set by Pearson VUE and CompTIA policy, so confirm before the exam date.",
  },
  {
    q: "Which Security+ version should I buy for: SY0-701 or V8?",
    a: "SY0-701 is the current Security+ exam. CompTIA has announced Security+ V8 for 17 November 2026. A voucher is tied to the exam code it is sold for — if a new version launches near your exam date, confirm with CompTIA (or at Pearson VUE checkout) which code your voucher can be used for before booking.",
  },
  {
    q: "Which CompTIA voucher should I buy first?",
    a: "If you are new to IT, start with A+ (two vouchers: Core 1 and Core 2). If you target networking, Network+ comes next. For a security career, Security+ (SY0-701) is the most requested baseline. From there, pick the specialisation — CySA+, PenTest+ or SecurityX — that matches the job you want.",
    html: `If you are new to IT, start with A+ (two vouchers: Core 1 and Core 2). If you target networking, Network+ comes next. For a security career, Security+ (SY0-701) is the most requested baseline — or see our <a href="/blog/best-udemy-cybersecurity-courses-with-ai-integration-for-2026/">cybersecurity courses guide</a> for a full study path.`,
  },
];

const allDeals = await getDeals();
const comptiaRe = /(comptia|security\+|network\+|cysa|pentest|linux\+|server\+|project\+|cloud\+|cloudnetx|datasys|a\+|tech\+|data\+)/i;
const starRe = /(jason dion|dion training)/i;
const prepDeals = allDeals
  .filter((d: any) => comptiaRe.test(`${d.title || ""} ${d.subcategory || ""} ${d.category || ""}`))
  .sort((a: any, b: any) => {
    const sa = starRe.test(`${a.instructor || ""}`) ? 0 : 1;
    const sb = starRe.test(`${b.instructor || ""}`) ? 0 : 1;
    if (sa !== sb) return sa - sb;
    return new Date(b.updatedAt ?? b.createdAt ?? 0).getTime() - new Date(a.updatedAt ?? a.createdAt ?? 0).getTime();
  })
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "en-US",
      datePublished: publishedISO,
      dateModified: lastModified,
      isPartOf: { "@id": "https://courseswyn.com/#website" },
      about: { "@type": "Thing", name: "CompTIA certification exam vouchers and discounts" },
      mainEntity: { "@id": `${canonicalUrl}#vouchers` },
      author: { "@type": "Person", name: "Andrew Derek", url: "https://courseswyn.com/about" },
      publisher: { "@id": "https://courseswyn.com/#organization" },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://courseswyn.com/" },
        { "@type": "ListItem", position: 2, name: "Certification Vouchers", item: "https://courseswyn.com/udemy-certification-vouchers/" },
        { "@type": "ListItem", position: 3, name: "CompTIA Exam Vouchers", item: canonicalUrl },
      ],
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#vouchers`,
      name: "CompTIA Exam Vouchers on Udemy",
      numberOfItems: totalAvailable,
      itemListElement: availableVouchers.map((v, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `https://www.udemy.com/certification-vouchers/${v.slug}/`,
        name: `${v.name} Exam Voucher`,
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  type="article"
  pubDate={new Date(publishedISO)}
  updatedDate={now}
>
  <meta name="author" content="Andrew Derek" slot="head" />
  <meta
    name="keywords"
    content="udemy comptia exam voucher, comptia exam voucher 2026, security+ voucher sy0-701, comptia a+ voucher core 1 core 2, network+ n10-009 voucher, retake assurance comptia, pearson vue comptia exam"
    slot="head"
  />

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="cv-wrap">
    <VoucherHero
      badgeHref="/how-we-test-and-verify-udemy-coupons"
      badgeText={`Checked · ${total} CompTIA vouchers`}
      titleA="CompTIA"
      titleAccent="Exam Vouchers"
      titleB="2026"
      subHtml={`All <strong>${total} official CompTIA exam vouchers</strong> on Udemy — Security+ (SY0-701), A+, Network+ (N10-009), CySA+, PenTest+ and more. Udemy advertises <strong>save 10%</strong> on the pages we checked, valid ≥9 months. Updated ${dateFull}.`}
      stats={[
        { val: `${total}`, label: "official vouchers" },
        { val: "10%", label: "off Security+/A+/Network+ (checked)" },
        { val: "≥9 mo", label: "validity" },
      ]}
      primary={{ href: catalogUrl, text: "Browse CompTIA Vouchers →", external: true }}
      secondary={{ href: "#exam-fees", text: "See Exam Fees" }}
      noteHtml={`Sponsored — CoursesWyn may earn a commission at no extra cost to you. <a href="/affiliate-disclosure">Affiliate Disclosure</a>`}
      termLines={COMPTIA_GROUPS.flatMap((g) => g.items).slice(0, 6).map((v) => ({ href: voucherAffUrl(v.slug), code: v.code ?? v.tag, name: `${v.name} Voucher` }))}
    />
    <div class="cv-meta">
      <span>By <a href="/about">Andrew Derek</a></span>
      <span class="cv-dot">·</span>
      <span>Updated <time datetime={lastModified}>{dateFull}</time></span>
      <span class="cv-dot">·</span>
      <span>
        Checked against{" "}
        <a href="https://www.udemy.com/certification-vouchers/comptia-security-plus/" target="_blank" rel="noopener noreferrer">Udemy voucher listings</a>{" "}
        and <a href="https://www.comptia.org/en-us/certifications/" target="_blank" rel="noopener noreferrer">CompTIA certification pages</a>
      </span>
    </div>

    <nav class="cv-toc" aria-label="On this page">
      <span class="cv-toc-label">On this page</span>
      <a href="#quick-answer">Quick answer</a>
      <a href="#exam-fees">Exam fees</a>
      <a href="#vouchers">All vouchers</a>
      <a href="#which-voucher">Which voucher</a>
      <a href="#how-to-redeem">How to redeem</a>
      <a href="#retake-assurance">Retake option</a>
      <a href="#comptia-offers">Ways to save</a>
      <a href="#voucher-vs-direct">Udemy vs CompTIA</a>
      <a href="#worth-it">Is it worth it?</a>
      <a href="#faq">FAQ</a>
    </nav>

    <section class="cv-block cv-answer" id="quick-answer" aria-labelledby="quick-answer-title">
      <h2 id="quick-answer-title">CompTIA exam vouchers on Udemy: the short answer</h2>
      <p>
        A CompTIA exam voucher is a prepaid code for one attempt at one specific exam. Udemy advertises{" "}
        <strong>save 10%</strong> on the Security+, A+ and Network+ pages we checked (4 November 2026), sells
        vouchers for the <strong>exact exam</strong> — not by level like AWS — and they are valid for at least{" "}
        <strong>9 months</strong> from purchase.
      </p>
      <p>
        CompTIA sets prices per exam and per country, and its store vouchers expire after 12 months. Udemy's price
        is not tied to the CompTIA price — it can be lower or higher. Compare the live checkout price with the price
        on your regional CompTIA store before you pay.
      </p>
      <ul class="cv-check">
        <li><strong>Want the simplest saving?</strong> Udemy advertises 10% off on the Security+, A+ and Network+ pages we checked — verify the live price at checkout.</li>
        <li><strong>Buying A+?</strong> You need two vouchers — one Core 1 and one Core 2 — for the full certification.</li>
        <li><strong>Want a retake safety net?</strong> Pick the voucher + retake option at checkout where it is offered — it cannot be added later.</li>
        <li><strong>Around 17 November 2026?</strong> Security+ V8 is scheduled then — confirm which exam code your voucher covers before buying.</li>
      </ul>
    </section>

    <section class="cv-block" id="exam-fees" aria-labelledby="fees-title">
      <h2 id="fees-title">How much does a CompTIA exam cost in 2026?</h2>
      <p>
        CompTIA prices each exam separately, per exam and per country — there is no single global USD table, and
        prices change. The price on your regional CompTIA store, or at Pearson VUE checkout, is the one that applies
        to you.
      </p>
      <div class="cv-table-wrap">
        <table class="cv-table">
          <caption>CompTIA exam families sold as Udemy vouchers (2026)</caption>
          <thead>
            <tr>
              <th scope="col">Family</th>
              <th scope="col">Exams at this level</th>
              <th scope="col">Udemy voucher covers</th>
            </tr>
          </thead>
          <tbody>
            {examFamilies.map((row) => (
              <tr>
                <th scope="row">{row.family}</th>
                <td>{row.exams}</td>
                <td>{row.coverage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cv-note">
        CompTIA store vouchers expire 12 months after purchase; Udemy vouchers are valid for at least 9 months.
        Udemy's advertised discount applies to Udemy's own price, not necessarily to the CompTIA price. Check the live
        price on the voucher page and your regional CompTIA store before buying — checked against Udemy voucher pages
        and <a href="https://www.comptia.org/en-us/certifications/" target="_blank" rel="noopener noreferrer">CompTIA certification pages</a> on 4 November 2026.
      </p>
      <p>
        What you actually pay varies by region and promotion. We do not quote assumed checkout prices here — open the
        voucher page, note the price, and compare it with the CompTIA price for your country before paying.
      </p>
    </section>

    <section class="cv-block" id="vouchers" aria-labelledby="vouchers-title">
      <h2 id="vouchers-title">Compare all {total} CompTIA exam vouchers on Udemy</h2>
      <p>
        Udemy lists {total} CompTIA voucher products. Each is valid for <strong>one specific exam</strong> — A+ is the
        one exception that still needs two vouchers (Core 1 + Core 2). The advertised discount we verified is{" "}
        <strong>save 10%</strong> on Security+, A+ and Network+; other listings advertise a saving without a fixed
        percentage.
      </p>
      <VoucherGrid groups={COMPTIA_GROUPS} />
      <p class="cv-note">
        Prices, stock and promotions change, and Udemy's catalog may show a different offer than the checkout. Confirm
        the live price, the expiry date and the exam code on the product page before paying. A+ vouchers are sold per
        core exam — buy two if you are taking full A+.
      </p>
    </section>

    <section class="cv-block" id="which-voucher" aria-labelledby="which-title">
      <h2 id="which-title">Which CompTIA exam voucher do you need?</h2>
      <p>
        Choose the voucher that matches the exact exam you plan to sit — CompTIA vouchers are exam-specific, and
        buying the wrong one is an expensive, non-refundable mistake.
      </p>
      <div class="cv-pick-grid">
        {voucherPicks.map((pick) => (
          <article class="cv-pick">
            <span class="cv-pick-tag">{pick.best}</span>
            <h3>{pick.level}</h3>
            <p>{pick.body}</p>
          </article>
        ))}
      </div>
      <p class="cv-note">
        Still deciding? Start with our <a href="/blog/cloud-computing-courses-udemy-2026/">cloud computing courses guide</a> or{" "}
        <a href="/blog/best-udemy-cybersecurity-courses-with-ai-integration-for-2026/">cybersecurity courses guide</a> before you buy.
      </p>
    </section>

    <section class="cv-block" id="how-to-redeem" aria-labelledby="redeem-title">
      <h2 id="redeem-title">How to buy and redeem a CompTIA exam voucher</h2>
      <p>
        Buying the voucher and booking the exam are two separate steps. Udemy sells the code; CompTIA and Pearson VUE
        run the exam. Follow this order so you don't lose time or buy the wrong code.
      </p>
      <ol class="cv-steps">
        <li><strong>Pick the exact exam.</strong> Each voucher is valid only for its own exam — confirm the code on the voucher page matches the exam you intend to sit (e.g. SY0-701, N10-009).</li>
        <li><strong>Choose voucher-only or the voucher + retake option</strong> where offered. The retake add-on cannot be added after checkout.</li>
        <li><strong>Pay on Udemy.</strong> A card or Udemy credits work. Udemy coupons do not apply to vouchers.</li>
        <li><strong>Get your code from My learning → Certifications.</strong> Udemy also emails it, but your account is the source of truth.</li>
        <li><strong>Sign in to your CompTIA account</strong> and start the scheduling flow — you'll be directed to Pearson VUE to book online proctored or an in-person appointment.</li>
        <li><strong>Paste the voucher code at checkout.</strong> Valid only in the country where you bought it.</li>
        <li><strong>Reschedule or cancel at least 24 hours before the appointment.</strong> Miss the window and the voucher is forfeited — it cannot be extended.</li>
      </ol>
      <div class="cv-callout">
        <strong>Before you pay, check:</strong> the exam code, the expiry date (at least 9 months), the retake option
        if you want it, your country's eligibility, and that the name on your CompTIA account matches your ID. For A+,
        remember you need one voucher per core exam.
      </div>
      <p class="cv-cta-line">
        <a class="cv-btn" href={catalogUrl} target="_blank" rel="sponsored noopener noreferrer">Browse CompTIA Vouchers →</a>
      </p>
    </section>

    <section class="cv-block cv-warn" id="retake-assurance" aria-labelledby="retake-title">
      <h2 id="retake-title">Retake Assurance: the retake option, bought up front</h2>
      <p>
        Udemy's retake add-on — labelled <strong>Retake Assurance</strong> on the pages we checked — bundles your
        first attempt plus <strong>one extra attempt at the same exam if you fail</strong>. It is not a CompTIA
        programme, and it is not offered on every page. Older materials may call it “Second Chance” — it is the same
        idea; the exact wording at your checkout is what counts.
      </p>
      <ul class="cv-check">
        <li><strong>Where it exists:</strong> on the eligible voucher pages that show a retake option at checkout — most of the Security+, Network+ and advanced listings we track.</li>
        <li><strong>Where it may not:</strong> the A+ listing we track advertises validity only — check the checkout options for your exam.</li>
        <li><strong>How to buy it:</strong> select the voucher + retake option with the voucher itself. It cannot be added after purchase, and it covers one extra attempt only.</li>
        <li><strong>The catch:</strong> non-refundable and non-transferable — including if you pass first try.</li>
        <li><strong>Waiting periods still apply:</strong> CompTIA's retake policy governs how soon you can sit again. The add-on does not waive these.</li>
      </ul>
      <p class="cv-note">
        Sources: Udemy voucher pages checked 4 November 2026,{" "}
        <a href="https://help.comptia.org/hc/en-us/search?query=Certification%20Retake%20Policy" target="_blank" rel="noopener noreferrer">CompTIA retake policy (help centre)</a>,{" "}
        <a href="https://www.comptia.org/en-us/certifications/" target="_blank" rel="noopener noreferrer">CompTIA certification pages</a>.
      </p>
    </section>

    <section class="cv-block" id="comptia-offers" aria-labelledby="offers-title">
      <h2 id="offers-title">Ways to lower the cost that aren't Udemy coupons</h2>
      <ul class="cv-check">
