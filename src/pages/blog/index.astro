---
import Layout from "../../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";
import { formatDateWIB, toISODateWIB } from "../../lib/date";

const siteUrl = "https://courseswyn.com";

function resolveImage(imagePath: string | undefined): string | null {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return imagePath;
  const filename = imagePath.split('/').pop();
  if (!filename) return null;
  return `/assets/images/${filename}`;
}

const allPosts = await getCollection("blog");
const posts = allPosts.sort((a: any, b: any) => {
  const dateA = a.data.updatedAt || a.data.pubDate;
  const dateB = b.data.updatedAt || b.data.pubDate;
  return dateB.getTime() - dateA.getTime();
});

const recentPosts = posts.slice(0, 12);

const TOPIC_MAP: Record<string, string> = {
  "Agentic AI": "ai-agents-agentic-ai",
  "AI Agents": "ai-agents-agentic-ai",
  "CrewAI": "ai-agents-agentic-ai",
  "MCP": "ai-agents-agentic-ai",
  "Model Context Protocol": "ai-agents-agentic-ai",
  "Generative AI": "generative-ai-genai",
  "GenAI": "generative-ai-genai",
  "AI": "artificial-intelligence-ai",
  "Artificial Intelligence": "artificial-intelligence-ai",
  "AI Engineering": "artificial-intelligence-ai",
  "AI Courses": "artificial-intelligence-ai",
  "ChatGPT": "chatgpt",
  "ChatGPT Training": "chatgpt",
  "Prompt Engineering": "prompt-engineering",
  "Web Development": "web-development",
  "Web Design": "web-design",
  "Claude Code": "claude-code",
  "Claude": "claude-ai",
  "Python": "python",
  "Data Science": "data-science",
  "Data Analysis": "data-analysis",
  "n8n": "n8n",
  "Cybersecurity": "cybersecurity",
  "Kubernetes": "kubernetes",
  "GitHub Copilot": "github-copilot",
  "Digital Marketing": "digital-marketing",
  "Graphic Design": "graphic-design",
  "Project Management": "project-management",
  "AWS": "amazon-aws",
  "Best AWS Courses": "amazon-aws",
  "AWS Certification": "amazon-aws",
  "Cloud Computing": "amazon-aws",
  "React": "web-development",
  "Next.js": "web-development",
  "UI/UX": "web-design",
};

const tagCounts: Record<string, number> = {};
posts.forEach((post: any) => {
  (post.data.tags || []).forEach((t: string) => {
    if (TOPIC_MAP[t]) tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});

const topicChips = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([name, count]) => ({ name, slug: TOPIC_MAP[name], count }));

const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));

const title = `Best Udemy Course Reviews & Coupon Guides ${currentYear} | CoursesWyn Blog`;
const description = `Expert-reviewed guides to the best Udemy courses with verified coupon codes. Find programming, AI, data science, cloud certification courses and step-by-step career roadmaps. Updated daily with working deals.`;
const canonical = `https://courseswyn.com/blog`;

const pageKeywords = [
  "udemy course reviews",
  "best udemy courses",
  "udemy coupon guides",
  "udemy course comparison",
  "best online courses",
  "udemy course coupon code",
  "udemy review"
].join(", ");

const faqs = [
  {
    q: "Are the Udemy coupon codes on CoursesWyn verified?",
    a: "Yes. Every coupon code we list is manually verified before publishing and re-checked periodically to confirm the codes still work."
  },
  {
    q: "How often are the blog guides updated?",
    a: "Our editorial team reviews and updates every guide at least once per quarter. Courses that change significantly, receive major curriculum updates, or have expiring coupons are refreshed immediately. Each article displays its last updated date at the top."
  },
  {
    q: "Do you review every course on Udemy?",
    a: "No. We selectively review courses that meet our quality bar — high student ratings, reputable instructors, and current curriculum. Out of 200,000+ Udemy courses, we've reviewed approximately 1,300 that represent the best learning value in each subject area."
  },
  {
    q: "Can I request a course review?",
    a: "Absolutely. If there's a Udemy course you'd like us to analyze and find a coupon for, use the search bar on our site or browse our <a href='/categories'>category pages</a>. We add new reviews every week based on learner demand and trending topics."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": canonical }
      ]
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": canonical,
      "url": canonical,
      "name": title,
      "description": description,
      "keywords": pageKeywords,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "inLanguage": "en-US",
      "dateModified": toISODateWIB(posts[0]?.data?.updatedAt || posts[0]?.data?.pubDate || new Date()),
      "mainEntity": { "@id": `${canonical}#itemlist` }
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#itemlist`,
      "name": "Latest Reviews & Guides",
      "numberOfItems": posts.length,
      "itemListElement": posts.slice(0, 12).map((post: any, i: number) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `${siteUrl}/blog/${post.id}/`,
        "item": {
          "@type": "BlogPosting",
          "headline": post.data.title,
          "description": post.data.description,
          "url": `${siteUrl}/blog/${post.id}/`,
          "datePublished": post.data.pubDate.toISOString(),
          "dateModified": (post.data.updatedAt || post.data.pubDate).toISOString(),
          "author": { "@type": "Person", "name": "Andrew Derek" }
        }
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q.replace(/<[^>]*>/g, ''),
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} image="/assets/images/og-default.svg" hideBreadcrumbs={true}>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="cc-register">
          <div class="cc-register-top">
            <span class="cc-eyebrow"><span class="cc-blip"></span> Original research</span>
            <span class="cc-folio">{posts.length} articles &middot; updated {currentYear}</span>
          </div>
          <h1 class="cc-title">Udemy Course <span class="cc-accent">Reviews &amp; Guides</span></h1>
          <p class="cc-subtitle">Guides built from our coupon verification pipeline — every review links to a course we've actually checked against Udemy, with the working discount code at hand.</p>
          <div class="cc-toolbar">
            <a class="cc-hero-btn" href="#latest">Latest reviews &amp; guides</a>
            <a class="cc-hero-btn ghost" href="/categories">Browse by category</a>
            <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's new deals</a>
          </div>
          <div class="cc-ledger">
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Articles</div><div class="cc-ledger-value">{posts.length}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Courses reviewed</div><div class="cc-ledger-value">1,300+</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Topics covered</div><div class="cc-ledger-value">{topicChips.length}</div></div>
            <div class="cc-ledger-cell"><div class="cc-ledger-label">Updated</div><div class="cc-ledger-value">{currentYear}</div></div>
          </div>
        </div>
      </header>

      {topicChips.length > 0 && (
        <section class="cc-section cc-chips-section" aria-label="Browse reviews by topic">
          <div class="cc-sec-head">
            <h2 class="cc-sec-title">Browse reviews by topic <span class="cc-tag">{topicChips.length} topics</span></h2>
            <p class="cc-sec-desc">Jump to the topic archive behind each tag — every link runs a live deal search.</p>
          </div>
          <nav class="cc-chip-nav" aria-label="Topics">
            {topicChips.map(chip => (
              <a href={`/topics/${chip.slug}`} class="cc-chip">
                <span class="cc-chip-arrow">→</span>
                <span class="cc-chip-name">{chip.name}</span>
                <span class="cc-chip-num">{chip.count}</span>
              </a>
            ))}
          </nav>
        </section>
      )}

      <section class="cc-posts" id="latest" aria-label="Latest articles">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Latest Reviews &amp; Guides <span class="cc-tag">Ranked by real data</span></h2>
          <p class="cc-sec-desc">Ranked by real student data and re-checked as coupon codes change.</p>
        </div>

        <div class="bl-grid">
          {recentPosts.map((post: any) => (
            <a href={`/blog/${post.id}`} class="bl-card">
              <div class="bl-card-media">
                <Image
                  src={resolveImage(typeof post.data.image === 'string' ? post.data.image : (post.data.image as any)?.src) || '/assets/images/og-default.svg'}
                  alt={post.data.title}
                  width={480}
                  height={270}
                  loading="lazy"
                  inferSize={false}
                  class="bl-card-img"
                />
                {post.data.tags?.[0] && <span class="bl-badge">{post.data.tags[0]}</span>}
              </div>
              <div class="bl-card-body">
                <h3 class="bl-card-title">{post.data.title}</h3>
                <p class="bl-card-excerpt">{post.data.description}</p>
                <div class="bl-card-footer">
                  <time class="bl-card-date" datetime={toISODateWIB(post.data.updatedAt || post.data.pubDate)}>
                    {formatDateWIB(post.data.updatedAt || post.data.pubDate, { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                  <span class="bl-card-action">Read review →</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        {posts.length > 12 && (
          <div class="cc-more-wrap">
            <a href="/blog/page/2" class="cc-hero-btn">Browse all {posts.length} articles →</a>
          </div>
        )}
      </section>

      <section class="cc-seo-section">
        <h2 class="cc-section-title">Why trust CoursesWyn's Udemy course reviews?</h2>
        <p>Every guide on this blog is built on <strong>real data and hands-on analysis</strong>. We examine each course's curriculum depth, instructor credibility, student review sentiment, and practical outcomes — not just star ratings. Our team of edtech researchers has reviewed 1,300+ Udemy courses across <a href="/categories">every major category</a> to bring you detailed, honest reviews.</p>
        <p>All coupon codes listed in our reviews are <strong>verified, tested, and confirmed working</strong> before publication. Since Udemy's coupon policy update, coupons expire quickly — we monitor every deal and remove expired ones daily. Browse <a href="/udemy-coupon-code">all active coupon codes</a> to start learning today.</p>
      </section>

      <section class="cc-section cc-faq" aria-labelledby="faq-title">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Udemy Course Review FAQs
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a" set:html={faq.a} />
            </div>
          ))}
        </div>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Skip the reviews</p>
        <p class="cc-cta-text">Find discounted courses right now — jump straight to working coupon codes across every topic.</p>
        <a class="cc-hero-btn" href="/topics">Browse All Topics →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  /* ===== REGISTER / LEDGER HEADER ===== */
  .cc-register { position: relative; background: var(--card); border: 1px solid #E2E6EC; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(11, 122, 85, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #0B7A55; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .cc-folio { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.6875rem; color: var(--muted); border: 1px dashed #D5DCE2; border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #CF6F59; }
  .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }
  .cc-subtitle strong { color: var(--text); font-weight: 700; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: 'Space Grotesk', Inter, sans-serif; font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #0B7A55; color: #fff; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #0B7A55; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #0B7A55; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #0B7A55; color: #fff; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed #D5DCE2; padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #E2E6EC; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cc-ledger-value { font-family: 'Space Grotesk', Inter, sans-serif; font-weight: 700; font-size: 1.375rem; color: var(--text); }

  /* ===== SECTION HEADS ===== */
  .cc-section { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #E2E6EC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

  /* ===== CHIP NAV ===== */
  .cc-chip-nav { display: flex; flex-wrap: wrap; gap: 8px; }
  .cc-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--card); border: 1px solid #E2E6EC; border-radius: 999px; text-decoration: none; transition: all 0.15s; }
  .cc-chip:hover { border-color: var(--brand); }
  .cc-chip-name { font-size: 0.78125rem; font-weight: 600; color: var(--text); }
  .cc-chip-num { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; font-weight: 600; color: var(--muted); background: var(--bg-secondary); border-radius: 999px; padding: 2px 8px; }
  .cc-chip-arrow { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.6875rem; color: var(--muted); transition: transform 0.15s; }
  .cc-chip:hover .cc-chip-arrow { color: var(--brand); transform: translateX(3px); }

  /* ===== POST CARDS ===== */
  .cc-posts { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .bl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 16px; }
  @media (max-width: 900px) { .bl-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .bl-grid { grid-template-columns: 1fr; } }

  .bl-card { display: flex; flex-direction: column; background: var(--card); border: 1px solid #E2E6EC; border-radius: 12px; overflow: hidden; text-decoration: none; transition: all 0.2s; }
  .bl-card:hover { transform: translateY(-2px); border-color: #0B7A55; box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.35); }
  .bl-card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #0B7A55; }
  .bl-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
  .bl-card:hover .bl-card-img { transform: scale(1.04); }
  .bl-badge { position: absolute; top: 0.65rem; left: 0.65rem; background: #0B7A55; color: #fff; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.28rem 0.65rem; border-radius: 100px; }
  .bl-card-body { display: flex; flex-direction: column; flex: 1; padding: 14px 16px 16px; }
  .bl-card-title { font-size: 0.92rem; font-weight: 700; color: var(--text); line-height: 1.35; margin: 0 0 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .bl-card:hover .bl-card-title { color: #CF6F59; }
  .bl-card-excerpt { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.85rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bl-card-footer { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-top: 0.6rem; border-top: 1px dashed #E2E6EC; }
  .bl-card-date { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.72rem; color: var(--muted); font-weight: 500; }
  .bl-card-action { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.75rem; font-weight: 600; color: var(--brand); white-space: nowrap; }

  .cc-more-wrap { display: flex; justify-content: center; margin-top: 2rem; }
  .cc-more-wrap .cc-hero-btn { background: #0B7A55; color: #fff; }
  .cc-more-wrap .cc-hero-btn:hover { background: #0B7A55; }

  /* ===== GENERIC SECTION HEADS (seo/faq) ===== */
  .cc-section-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.3rem; display: flex; align-items: center; gap: 0.6rem; letter-spacing: -0.01em; flex-wrap: wrap; }
  .cc-section-title svg { color: var(--brand); flex-shrink: 0; }
  .cc-section-title .cc-tag { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #E2E6EC; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }

  .cc-seo-section { background: var(--card); border: 1px solid #E2E6EC; border-radius: 14px; padding: 1.5rem; margin: 3.25rem 0 0; }
  .cc-seo-section .cc-section-title { font-size: 1.15rem; margin-bottom: 0.75rem; }
  .cc-seo-section p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.75rem; }
  .cc-seo-section p:last-child { margin-bottom: 0; }
  .cc-seo-section strong { color: var(--text); font-weight: 700; }
  .cc-seo-section a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-seo-section a:hover { text-decoration: underline; }

  .cc-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 768px) { .cc-faq-grid { grid-template-columns: 1fr; } }
  .cc-faq-card { background: var(--card); border: 1px solid #E2E6EC; border-radius: 12px; padding: 1.1rem 1.15rem; }
  .cc-faq-card:hover { border-color: #6E7686; }
  .cc-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
  .cc-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }
  .cc-faq-a a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-faq-a a:hover { text-decoration: underline; }

  .cc-cta { background: var(--card); border: 1px solid #E2E6EC; color: var(--text); border-radius: 16px; padding: 30px 32px; text-align: center; margin: 3.25rem 0 0; }
  .cc-cta-eyebrow { font-family: 'IBM Plex Mono', Consolas, 'Courier New', monospace; font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
  .cc-cta-text { font-size: 0.95rem; line-height: 1.6; margin: 0 auto 18px; max-width: 480px; color: var(--muted); }
  .cc-cta .cc-hero-btn { background: #0B7A55; color: #fff; box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5); }
  .cc-cta .cc-hero-btn:hover { background: #0B7A55; transform: translateY(-1px); }

  @media (max-width: 768px) {
    .cc-title { font-size: 1.9rem; }
    .cc-register { padding: 26px 20px 22px; }
