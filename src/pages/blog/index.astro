---
import Layout from "../../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";
import { formatDateWIB, toISODateWIB } from "../../lib/date";

const siteUrl = "https://courseswyn.com";

function resolveImage(imagePath: string | undefined): string | null {
  if (!imagePath) return null;
  if (imagePath.startsWith('http')) return imagePath;
  const filename = imagePath.split('/').pop();
  if (!filename) return null;
  return `/assets/images/${filename}`;
}

const allPosts = await getCollection("blog");
const posts = allPosts.sort((a: any, b: any) => {
  const dateA = a.data.updatedAt || a.data.pubDate;
  const dateB = b.data.updatedAt || b.data.pubDate;
  return dateB.getTime() - dateA.getTime();
});

const recentPosts = posts.slice(0, 10);

const currentYear = Number(new Date().toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Jakarta' }));

const title = `Best Udemy Course Reviews & Coupon Guides ${currentYear} | CoursesWyn Blog`;
const description = `Expert-reviewed guides to the best Udemy courses with verified coupon codes. Find programming, AI, data science, cloud certification courses and step-by-step career roadmaps. Updated daily with working deals.`;
const canonical = `https://courseswyn.com/blog`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": canonical }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonical,
      "url": canonical,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "inLanguage": "en-US",
      "dateModified": toISODateWIB(posts[0]?.data?.updatedAt || posts[0]?.data?.pubDate || new Date()),
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": posts.length,
        "itemListElement": posts.slice(0, 10).map((post: any, i: number) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": {
            "@type": "BlogPosting",
            "headline": post.data.title,
            "description": post.data.description,
            "url": `${siteUrl}/blog/${post.id}/`,
            "datePublished": post.data.pubDate.toISOString(),
            "dateModified": (post.data.updatedAt || post.data.pubDate).toISOString(),
            "author": { "@type": "Person", "name": "Andrew Derek" }
          }
        }))
      }
    }
  ]
};
---

<Layout title={title} description={description} canonical={canonical} image="/assets/images/og-default.svg">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="b-root">
    <div class="b-wrap">

      <div class="b-card">

        <div class="b-hdr">
          <div class="b-hdr-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h8"/><path d="M8 11h6"/></svg>
          </div>
          <h1 class="b-hdr-title">Blog: Course Reviews & Research</h1>
          <p class="b-hdr-sub">Original guides, data, and reviews from our coupon verification pipeline. {posts.length} articles.</p>
        </div>

        <ul class="b-list">
          {recentPosts.map((post: any) => (
            <li class="b-li">
              <a href={`/blog/${post.id}`} class="b-card-link">
                <div class="b-img-wrap">
                  <Image
                    src={resolveImage(typeof post.data.image === 'string' ? post.data.image : (post.data.image as any)?.src) || '/assets/images/og-default.svg'}
                    alt={post.data.title}
                    width={300}
                    height={200}
                    loading="lazy"
                    inferSize={false}
                    class="b-img"
                  />
                </div>
                <div class="b-body">
                  <h2 class="b-title">{post.data.title}</h2>
                  <p class="b-excerpt">{post.data.description}</p>
                  <div class="b-meta">
                    <span class="b-tag">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                      {post.data.tags?.[0] || 'Guide'}
                    </span>
                    <time class="b-date" datetime={toISODateWIB(post.data.updatedAt || post.data.pubDate)}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
                      {formatDateWIB(post.data.updatedAt || post.data.pubDate, { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>

        {posts.length > 10 && (
          <div class="b-more-wrap">
            <a href="/blog/page/2" class="b-more">View All Articles &rarr;</a>
          </div>
        )}

      </div>

      <section class="b-seo">
        <h2>Why trust CoursesWyn's Udemy course reviews?</h2>
        <p>Every guide on this blog is built on <strong>real data and hands-on analysis</strong>. We examine each course's curriculum depth, instructor credibility, student review sentiment, and practical outcomes — not just star ratings. Our team of edtech researchers has reviewed 1,300+ Udemy courses across <a href="/categories">every major category</a> to bring you detailed, honest reviews.</p>
        <p>All coupon codes listed in our reviews are <strong>verified, tested, and confirmed working</strong> before publication. Since Udemy's coupon policy update, coupons expire quickly — we monitor every deal and remove expired ones daily. Browse <a href="/udemy-coupon-code">all active coupon codes</a> to start learning today.</p>
      </section>

      <section class="b-faq">
        <h2>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions
        </h2>
        {[
          {
            q: "Are the Udemy coupon codes on CoursesWyn free?",
            a: "Yes. Every coupon code we list is manually verified before publishing and re-checked periodically to ensure the codes are still valid."
          },
          {
            q: "How often are the blog guides updated?",
            a: "Our editorial team reviews and updates every guide at least once per quarter. Courses that change significantly, receive major curriculum updates, or have expiring coupons are refreshed immediately. Each article displays its last updated date at the top."
          },
          {
            q: "Do you review every course on Udemy?",
            a: "No. We selectively review courses that meet our quality bar — high student ratings, reputable instructors, and current curriculum. Out of 200,000+ Udemy courses, we've reviewed approximately 1,300 that represent the best learning value in each subject area."
          },
          {
            q: "Can I request a course review?",
            a: "Absolutely. If there's a Udemy course you'd like us to analyze and find a coupon for, use the search bar on our site or browse our <a href='/categories'>category pages</a>. We add new reviews every week based on learner demand and trending topics."
          }
        ].map(faq => (
          <div class="b-faq-item">
            <h3 class="b-faq-q">{faq.q}</h3>
            <p class="b-faq-a">{faq.a}</p>
          </div>
        ))}
      </section>

    </div>
  </main>

  <style>
    .b-root { padding: 2rem 0 4rem; }
    .b-wrap { max-width: 56rem; margin: 0 auto; padding: 0 1rem; }

    .b-card { border: 1px solid var(--border); border-radius: 16px; background: var(--bg); overflow: hidden; }

    .b-hdr { text-align: center; padding: 2rem 1.5rem 1.5rem; border-bottom: 1px solid var(--border); }
    .b-hdr-icon { display: flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem; margin: 0 auto 0.75rem; color: var(--brand); }
    .b-hdr-title { font-size: 1.4rem; font-weight: 700; color: var(--text); margin: 0; }
    .b-hdr-sub { font-size: 0.88rem; color: var(--muted); margin: 0.5rem 0 0; }

    .b-list { list-style: none; margin: 0; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .b-li { margin: 0; padding: 0; }

    .b-card-link { display: grid; overflow: hidden; border-radius: 12px; border: 1px solid var(--border); background: var(--card); text-decoration: none; color: var(--text); transition: all 0.3s; }
    .b-card-link:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--brand) 20%, var(--border)); box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
    @media (min-width:768px) { .b-card-link { grid-template-columns: minmax(0,2fr) minmax(0,3fr); } }

    .b-img-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; background: var(--border); }
    @media (min-width:768px) { .b-img-wrap { aspect-ratio: auto; height: 100%; min-height: 16rem; } }
    .b-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
    .b-card-link:hover .b-img { transform: scale(1.025); }

    .b-body { display: flex; flex-direction: column; padding: 1.25rem; min-width: 0; }
    .b-title { font-size: 1.15rem; font-weight: 600; line-height: 1.3; color: var(--text); margin: 0; transition: color 0.2s; }
    .b-card-link:hover .b-title { color: var(--brand); }
    .b-excerpt { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0.5rem 0 0; }
    .b-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; padding-top: 1rem; }
    .b-tag { display: inline-flex; align-items: center; gap: 0.35rem; height: 2rem; padding: 0 0.75rem; border-radius: 9999px; border: 1px solid var(--border); background: var(--bg); font-size: 0.72rem; font-weight: 600; color: var(--text); white-space: nowrap; }
    .b-tag svg { width: 0.85rem; height: 0.85rem; color: var(--muted); flex-shrink: 0; }
    .b-date { display: inline-flex; align-items: center; gap: 0.35rem; height: 2rem; padding: 0 0.75rem; border-radius: 9999px; border: 1px solid var(--border); background: var(--bg); font-size: 0.72rem; font-weight: 600; color: var(--text); white-space: nowrap; }
    .b-date svg { width: 0.85rem; height: 0.85rem; color: var(--muted); flex-shrink: 0; }

    .b-more-wrap { text-align: center; padding: 1.5rem 1rem 2rem; border-top: 1px solid var(--border); }
    .b-more { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.5rem; background: var(--brand); color: var(--bg); border-radius: 8px; font-size: 0.85rem; font-weight: 700; text-decoration: none; transition: opacity 0.2s; }
    .b-more:hover { opacity: 0.9; }

    .b-seo { padding: 2rem 1.5rem; border-top: 1px solid var(--border); }
    .b-seo h2 { font-size: 1rem; font-weight: 700; color: var(--text); margin: 0 0 0.75rem; }
    .b-seo p { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.5rem; }
    .b-seo p:last-child { margin-bottom: 0; }
    .b-seo a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .b-seo a:hover { text-decoration: underline; }

    .b-faq { padding: 1.5rem; border-top: 1px solid var(--border); }
    .b-faq > h2 { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .b-faq > h2 svg { color: var(--brand); flex-shrink: 0; }
    .b-faq-item { border-bottom: 1px solid var(--border); padding: 1rem 0; }
    .b-faq-item:first-of-type { border-top: 1px solid var(--border); }
    .b-faq-q { font-size: 0.85rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; }
    .b-faq-a { font-size: 0.82rem; color: var(--muted); line-height: 1.55; margin: 0; }
    .b-faq-a a { color: var(--brand); text-decoration: none; font-weight: 600; }
    .b-faq-a a:hover { text-decoration: underline; }
  </style>
</Layout>