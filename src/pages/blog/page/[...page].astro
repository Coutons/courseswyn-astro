---
import Layout from "../../../layouts/Layout.astro";
import { Image } from 'astro:assets';
import { getCollection } from "astro:content";
import { formatDateWIB, toISODateWIB } from "../../../lib/date";

export const prerender = true;

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = await getCollection('blog');
  const sortedPosts = posts.sort((a: any, b: any) => {
    const dateA = a.data.updatedAt || a.data.pubDate;
    const dateB = b.data.updatedAt || b.data.pubDate;
    return dateB.getTime() - dateA.getTime();
  });

  return paginate(sortedPosts, { pageSize: 12 });
}

const { page } = Astro.props as { page: any };
const posts: any[] = page?.data ?? [];

if (page.currentPage === 1) {
  return Astro.redirect('/blog');
}

function formatDate(post: any) {
  const isUpdated = !!post.data.updatedAt;
  const date = post.data.updatedAt || post.data.pubDate;
  const formatted = formatDateWIB(date, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
  return isUpdated ? `Updated ${formatted}` : formatted;
}

function resolveImage(imagePath: any): string {
  if (!imagePath) return '/assets/images/og-default.svg';
  if (imagePath?.src) return imagePath.src;
  if (typeof imagePath === 'string') {
    if (imagePath.startsWith('http') || imagePath.startsWith('/')) return imagePath;
    const filename = imagePath.split('/').pop();
    return filename ? `/assets/images/${filename}` : '/assets/images/og-default.svg';
  }
  return '/assets/images/og-default.svg';
}

const title = `Udemy Course Reviews & Learning Guides — Page ${page.currentPage} | CoursesWyn`;
const description = "Browse all Udemy Courses guides, tutorials, comparisons, and reviews. Find the best Udemy Courses for your project.";
const canonical = `https://courseswyn.com/blog/page/${page.currentPage}`;
const siteUrl = "https://courseswyn.com";

const currentPosts = posts.slice(0, 12);
const firstPostDate = currentPosts[0]?.data?.updatedAt || currentPosts[0]?.data?.pubDate;
const now = new Date();
const heroFeed = posts.slice(0, 3).map((p: any) => {
  const t = new Date(p.data.updatedAt ?? p.data.pubDate ?? 0).getTime();
  const mins = Math.max(1, Math.round((now.getTime() - t) / 60000));
  const timeLabel = mins < 60 ? mins + "m ago" : mins < 1440 ? Math.round(mins / 60) + "h ago" : Math.round(mins / 1440) + "d ago";
  return { title: String(p.data.title || ""), href: "/blog/" + p.id, timeLabel };
});

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog` },
        { "@type": "ListItem", "position": 3, "name": `Page ${page.currentPage}`, "item": canonical }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonical,
      "url": canonical,
      "name": title,
      "description": description,
      "isPartOf": { "@id": `${siteUrl}/#website` },
      "inLanguage": "en-US",
      "dateModified": firstPostDate ? toISODateWIB(firstPostDate) : undefined,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": currentPosts.length,
        "itemListElement": currentPosts.map((post: any, i: number) => ({
          "@type": "ListItem",
          "position": i + 1 + (page.currentPage - 1) * 12,
          "item": {
            "@type": "BlogPosting",
            "headline": post.data.title,
            "description": post.data.description,
            "url": `${siteUrl}/blog/${post.id}/`,
            "datePublished": post.data.pubDate.toISOString(),
            "dateModified": (post.data.updatedAt || post.data.pubDate).toISOString(),
            "author": { "@type": "Person", "name": "Andrew Derek" }
          }
        }))
      }
    }
  ]
};

const pageItems: ({ type: 'page'; value: number } | { type: 'ellipsis'; id: string })[] = [];
const windowSize = 2;
let lastAdded = 0;
for (let p = 1; p <= page.lastPage; p++) {
  const inWindow = p >= page.currentPage - windowSize && p <= page.currentPage + windowSize;
  if (p === 1 || p === page.lastPage || inWindow) {
    if (lastAdded > 0 && p - lastAdded > 1) {
      pageItems.push({ type: 'ellipsis', id: `gap-${p}` });
    }
    pageItems.push({ type: 'page', value: p });
    lastAdded = p;
  }
}
---

<Layout title={title} description={description} canonical={canonical} hideBreadcrumbs={false}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.currentPage === 2 ? '/blog' : page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
    <meta name="robots" content="noindex, follow" />
    <meta name="keywords" content="udemy course reviews, best udemy courses, udemy course comparison, udemy coupon guides" />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="dh-hero-grid">
          <div class="dh-hero-left">
            <div class="dh-hero-badge"><span class="lg-blip"></span> Original research &middot; Page {page.currentPage} of {page.lastPage}</div>
            <h1 class="dh-hero-title">Udemy Course <span class="cc-accent">Reviews &amp; Guides</span></h1>
            <p class="dh-hero-sub">Showing articles {page.start + 1}–{page.start + currentPosts.length} of {page.total}. Every guide links to a course we've actually checked against Udemy, with the working discount code at hand.</p>
            <div class="dh-hero-stats">
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={page.total}>0</span></b><span class="dh-stat-label">articles</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={page.lastPage}>0</span></b><span class="dh-stat-label">pages</span></div>
              <div class="dh-stat"><b class="dh-stat-val"><span data-count={currentPosts.length}>0</span></b><span class="dh-stat-label">on this page</span></div>
            </div>
          </div>
          <div class="dh-terminal">
            <div class="dh-term-head">
              <span class="dh-term-dot" style="background:#ff5f56"></span>
              <span class="dh-term-dot" style="background:#ffbd2e"></span>
              <span class="dh-term-dot" style="background:#27c93f"></span>
              <span class="dh-term-title">agents@courseswyn: ~/blog</span>
              <span class="dh-term-live"><span class="lg-blip"></span> Live</span>
            </div>
            <div class="dh-term-body">
              {heroFeed.map((p) => (
                <a class="dh-term-line" href={p.href}>
                  <span class="dh-term-time">{p.timeLabel}</span>
                  <span class="dh-term-ok">✓</span>
                  <span class="dh-term-cat">guide</span>
                  <span class="dh-term-title2">{p.title}</span>
                  <span class="dh-term-save">→</span>
                </a>
              ))}
              <div class="dh-term-line"><span class="dh-term-time">now</span><span class="dh-term-ok">✓</span><span class="dh-term-title2">reviews checked by CoursesWyn<span class="caret"></span></span></div>
            </div>
            <div class="dh-term-foot">$ showing page <b>{page.currentPage}</b></div>
          </div>
        </div>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="/blog">Newest reviews</a>
          <a class="cc-hero-btn ghost" href="/topics">Browse by topic</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupon-code">Live coupon codes</a>
        </div>
      </header>

      {posts.length > 0 ? (
        <section class="cc-posts" aria-label="Articles">
          <div class="cc-sec-head">
            <h2 class="cc-sec-title">More Reviews &amp; Guides <span class="cc-tag">Page {page.currentPage}</span></h2>
            <p class="cc-sec-desc">Ranked by real student data and re-checked as coupon codes change.</p>
          </div>

          <div class="bl-grid">
            {posts.map((post: any) => (
              <a href={`/blog/${post.id}`} class="bl-card">
                <div class="bl-card-media">
                  <Image
                    src={resolveImage(post.data.image)}
                    alt={post.data.title}
                    width={480}
                    height={270}
                    loading="lazy"
                    inferSize={false}
                    class="bl-card-img"
                  />
                  {post.data.tags?.[0] && <span class="bl-badge">{post.data.tags[0]}</span>}
                </div>
                <div class="bl-card-body">
                  <h3 class="bl-card-title">{post.data.title}</h3>
                  <p class="bl-card-excerpt">{post.data.description}</p>
                  <div class="bl-card-footer">
                    <time class="bl-card-date" datetime={toISODateWIB(post.data.updatedAt || post.data.pubDate)}>
                      {formatDate(post)}
                    </time>
                    <span class="bl-card-action">Read review →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="cc-pagination">
            {page.url.prev ? (
              <a href={page.currentPage === 2 ? '/blog' : page.url.prev} class="cc-pg-link">← Prev</a>
            ) : (
              <span class="cc-pg-link cc-pg-disabled">← Prev</span>
            )}
            <div class="cc-pg-numbers">
              {pageItems.map((item: any) => {
                if (item.type === 'ellipsis') {
                  return <span class="cc-pg-ellipsis">...</span>;
                }
                const isActive = item.value === page.currentPage;
                const href = item.value === 1 ? '/blog' : `/blog/page/${item.value}`;
                return isActive
                  ? <span class="cc-pg-num cc-pg-active">{item.value}</span>
                  : <a href={href} class="cc-pg-num">{item.value}</a>;
              })}
            </div>
            {page.url.next ? (
              <a href={page.url.next} class="cc-pg-link">Next →</a>
            ) : (
              <span class="cc-pg-link cc-pg-disabled">Next →</span>
            )}
          </div>
        </section>
      ) : (
        <section class="cc-posts">
          <div class="cc-empty">
            <p>No articles found.</p>
            <a href="/blog" class="cc-hero-btn">Back to Blog</a>
          </div>
        </section>
      )}

      <section class="cc-seo-section">
        <h2 class="cc-section-title">Why trust CoursesWyn's Udemy course reviews?</h2>
        <p>Every guide on this blog is built on <strong>real data and hands-on analysis</strong>. We examine each course's curriculum depth, instructor credibility, student review sentiment, and practical outcomes — not just star ratings. Our team of edtech researchers has reviewed 1,300+ Udemy courses across <a href="/categories">every major category</a> to bring you detailed, honest reviews.</p>
        <p>All coupon codes listed in our reviews are <strong>verified, tested, and confirmed working</strong> before publication. Since Udemy's coupon policy update, coupons expire quickly — we monitor every deal and remove expired ones daily. Browse <a href="/udemy-coupon-code">all active coupon codes</a> to start learning today.</p>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Skip the reviews</p>
        <p class="cc-cta-text">Find discounted courses right now — jump straight to working coupon codes across every topic.</p>
        <a class="cc-hero-btn" href="/topics">Browse All Topics →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

  .cc-register { position: relative; background: var(--card); border: 1px solid #232B26; border-radius: 18px; padding: 30px 34px 28px; margin-top: 24px; box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.35); }
  .cc-register-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .cc-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 600; color: var(--brand); background: rgba(76, 195, 138, 0.12); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 999px; padding: 6px 13px; }
  .cc-blip { width: 6px; height: 6px; border-radius: 50%; background: #FFC94D; animation: ccBlip 1.6s infinite; }
  @keyframes ccBlip { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
  .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
  .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
  .dh-hero-title .cc-accent { color: var(--brand); }
  .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
  .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .dh-stat { display: flex; flex-direction: column; }
  .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
  .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
  @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
  .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
  .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
  .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
  .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
  .dh-term-live .lg-blip { background: var(--stamp); }
  .dh-term-body { padding: 4px 0; }
  .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
  a.dh-term-line:hover { background: var(--brand-soft); }
  .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
  .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
  .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
  .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
  .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
  .dh-term-foot b { color: var(--brand); }
  @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .cc-folio { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muted); border: 1px dashed var(--border); border-radius: 6px; padding: 5px 10px; letter-spacing: .05em; white-space: nowrap; }
  .cc-title { font-size: clamp(2.1rem, 4.6vw, 3.4rem); font-weight: 700; color: var(--text); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 12px; }
  .cc-title .cc-accent { color: #CF6F59; }
  .cc-subtitle { color: var(--muted); font-size: 0.95rem; line-height: 1.7; margin: 0 0 20px; max-width: 640px; }

  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #FFC94D; color: #0b0e14; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #FFC94D; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #FFC94D; color: #0b0e14; }

  .cc-ledger { display: flex; margin-top: 24px; border-top: 1px dashed var(--border); padding-top: 20px; flex-wrap: wrap; }
  .cc-ledger-cell { flex: 1 1 150px; padding: 2px 18px; border-left: 1px solid #232B26; }
  .cc-ledger-cell:first-child { border-left: none; padding-left: 2px; }
  .cc-ledger-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .cc-ledger-value { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--text); }

  .cc-posts { margin-top: 3.25rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }

  .bl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 16px; }
  @media (max-width: 900px) { .bl-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .bl-grid { grid-template-columns: 1fr; } }

  .bl-card { display: flex; flex-direction: column; background: var(--card); border: 1px solid #232B26; border-radius: 12px; overflow: hidden; text-decoration: none; transition: all 0.2s; }
  .bl-card:hover { transform: translateY(-2px); border-color: #FFC94D; box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.35); }
  .bl-card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #FFC94D; }
  .bl-card-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s; }
  .bl-card:hover .bl-card-img { transform: scale(1.04); }
  .bl-badge { position: absolute; top: 0.65rem; left: 0.65rem; background: #FFC94D; color: #0b0e14; font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.28rem 0.65rem; border-radius: 100px; }
  .bl-card-body { display: flex; flex-direction: column; flex: 1; padding: 14px 16px 16px; }
  .bl-card-title { font-size: 0.92rem; font-weight: 700; color: var(--text); line-height: 1.35; margin: 0 0 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
  .bl-card:hover .bl-card-title { color: #CF6F59; }
  .bl-card-excerpt { font-size: 0.82rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.85rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bl-card-footer { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-top: 0.6rem; border-top: 1px dashed #232B26; }
  .bl-card-date { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); font-weight: 500; }
  .bl-card-action { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--brand); white-space: nowrap; }

  .cc-pagination { display: flex; align-items: center; justify-content: center; gap: 0.6rem; flex-wrap: wrap; margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px dashed #232B26; }
  .cc-pg-link { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--brand); text-decoration: none; padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #232B26; background: var(--card); transition: all 0.15s; }
  .cc-pg-link:hover { border-color: var(--brand); color: var(--brand); }
  .cc-pg-disabled { color: #8A877C; opacity: 0.5; pointer-events: none; }
  .cc-pg-numbers { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .cc-pg-num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--text); text-decoration: none; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #232B26; background: var(--card); transition: all 0.15s; }
  .cc-pg-num:hover { border-color: var(--brand); color: var(--brand); }
  .cc-pg-active { background: #FFC94D; border-color: var(--text); color: #0b0e14; }
  .cc-pg-active:hover { color: #fff; }
  .cc-pg-ellipsis { font-size: 0.8rem; color: #8A877C; width: 38px; text-align: center; }

  .cc-empty { text-align: center; padding: 3rem 1rem; }
  .cc-empty p { color: var(--muted); font-size: 1rem; margin-bottom: 1.25rem; }

  .cc-seo-section { background: var(--card); border: 1px solid #232B26; border-radius: 14px; padding: 1.5rem; margin: 3.25rem 0 0; }
  .cc-section-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.3rem; letter-spacing: -0.01em; }
  .cc-seo-section .cc-section-title { font-size: 1.15rem; margin-bottom: 0.75rem; }
  .cc-seo-section p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.75rem; }
  .cc-seo-section p:last-child { margin-bottom: 0; }
  .cc-seo-section strong { color: var(--text); font-weight: 700; }
  .cc-seo-section a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-seo-section a:hover { text-decoration: underline; }

  .cc-cta { background: var(--card); border: 1px solid #232B26; color: var(--text); border-radius: 16px; padding: 30px 32px; text-align: center; margin: 3.25rem 0 0; }
  .cc-cta-eyebrow { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
  .cc-cta-text { font-size: 0.95rem; line-height: 1.6; margin: 0 auto 18px; max-width: 480px; color: var(--muted); }
  .cc-cta .cc-hero-btn { background: #FFC94D; color: #0b0e14; box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5); }
  .cc-cta .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }

  @media (max-width: 768px) {
    .cc-title { font-size: 1.9rem; }
    .cc-register { padding: 26px 20px 22px; }
    .cc-ledger-cell { border-left: none; padding: 8px 0; }
  }
  @media (max-width: 480px) {
    .cc-title { font-size: 1.7rem; }
    .cc-hero-btn { padding: 11px 16px; font-size: 0.85rem; }
  }
</style>

<script>
  (function () {
    function animateCount(el: Element): void {
      const target = parseInt(el.getAttribute('data-count') || '0', 10);
      if (isNaN(target)) return;
      const dur = 900;
      let start: number | null = null;
      function step(ts: number): void {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    var counters = document.querySelectorAll('[data-count]');
    if (!('IntersectionObserver' in window)) {
      counters.forEach(animateCount);
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animateCount(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      counters.forEach(function (c) { io.observe(c); });
    }
  })();
</script>

