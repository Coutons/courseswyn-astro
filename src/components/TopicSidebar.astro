---
interface TopicItem {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  topics: TopicItem[];
  currentSlug?: string;
}

const { topics, currentSlug } = Astro.props;
---

<aside class="tside" aria-label="Browse topics" transition:persist="topic-sidebar">
  <div class="tside-label">Browse topics</div>
  <nav class="tside-list" aria-label="Popular topics">
    {topics.map((t) => (
      <a
        href={`/topics/${t.slug}`}
        class:list={["tside-row", { active: t.slug === currentSlug }]}
        aria-current={t.slug === currentSlug ? "page" : undefined}
      >
        <span class="tside-ico" aria-hidden="true">{t.name.charAt(0).toUpperCase()}</span>
        <span class="tside-name">{t.name}</span>
        <span class="tside-count">{t.count}</span>
      </a>
    ))}
  </nav>
  <a class="tside-all" href="/topics">All topics →</a>
</aside>

<script>
  function syncTopicSidebar() {
    var m = window.location.pathname.match(/^\/topics\/([^/?#]+)/);
    var slug = m ? decodeURIComponent(m[1]) : null;
    document.querySelectorAll('.tside-row').forEach(function (a) {
      var el = a as HTMLAnchorElement;
      var href = el.getAttribute('href') || '';
      var isActive = slug !== null && href === '/topics/' + slug;
      el.classList.toggle('active', isActive);
      if (isActive) { el.setAttribute('aria-current', 'page'); }
      else { el.removeAttribute('aria-current'); }
    });
  }
  document.addEventListener('astro:page-load', syncTopicSidebar);
  syncTopicSidebar();
</script>

<style>
  .tside { position: sticky; top: 90px; max-height: calc(100vh - 110px); overflow-y: auto; padding: 1.5rem 0 2rem; }
  .tside-label { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; color: var(--muted); margin-bottom: 0.5rem; }
  .tside-list { display: flex; flex-direction: column; }
  .tside-row { display: flex; align-items: center; gap: 10px; padding: 8px 6px; border-bottom: 1px solid var(--border); text-decoration: none; border-radius: 6px; transition: background 0.15s; }
  .tside-row:hover { background: var(--bg-secondary); }
  .tside-row.active { background: var(--brand-soft); }
  .tside-row.active .tside-name { color: var(--brand); }
  .tside-ico { width: 24px; height: 24px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 7px; background: var(--card); font-size: 0.75rem; font-weight: 800; color: var(--brand); }
  .tside-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.84rem; font-weight: 500; color: var(--text); }
  .tside-count { flex-shrink: 0; font-size: 0.76rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .tside-all { display: block; margin-top: 0.75rem; font-size: 0.84rem; font-weight: 700; color: var(--brand); text-decoration: none; }
  .tside-all:hover { text-decoration: underline; }
</style>
