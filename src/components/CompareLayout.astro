---
import Layout from '../layouts/Layout.astro';

interface Crumb { name: string; href?: string }
interface Faq { q: string; a: string }
interface Related { href: string; label: string; desc: string }
interface Stat { val: number; label: string; plus?: boolean }
interface FeedItem { title: string; slug: string; cat: string; pct: number; timeLabel: string }

interface Props {
  title: string;
  description: string;
  keywords: string;
  canonical: string;
  crumbs: Crumb[];
  badge: string;
  h1Accent: string;
  h1Rest: string;
  heroSub: string;
  heroSubStrong?: string;
  stats: Stat[];
  heroFeed: FeedItem[];
  termTitle: string;
  termFoot: string;
  faqs: Faq[];
  related: Related[];
}

const { title, description, keywords, canonical, crumbs, badge, h1Accent, h1Rest, heroSub, heroSubStrong, stats, heroFeed, termTitle, termFoot, faqs, related } = Astro.props as Props;
const siteUrl = 'https://courseswyn.com';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        ...crumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: c.name,
          ...(c.href ? { item: `${siteUrl}${c.href}` } : { item: canonical }),
        })),
      ],
    },
    {
      '@type': ['WebPage', 'Article'],
      '@id': canonical,
      url: canonical,
      name: title,
      description,
      keywords,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${siteUrl}#website` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical} hideBreadcrumbs={false}>
  <Fragment slot="head">
    <meta name="keywords" content={keywords} />
  </Fragment>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="cc-root">
    <div class="cc-container">

      <header class="cc-header">
        <div class="dh-hero-grid">
          <div class="dh-hero-left">
            <div class="dh-hero-badge"><span class="lg-blip"></span> {badge}</div>
            <h1 class="dh-hero-title"><span class="cc-accent">{h1Accent}</span> {h1Rest}</h1>
            <p class="dh-hero-sub">{heroSub}{heroSubStrong && <strong> {heroSubStrong}</strong>}</p>
            <div class="dh-hero-stats">
              {stats.map((s) => (
                <div class="dh-stat"><b class="dh-stat-val"><span data-count={s.val}>0</span>{s.plus && <span class="lg-plus">+</span>}</b><span class="dh-stat-label">{s.label}</span></div>
              ))}
            </div>
          </div>
          <div class="dh-terminal">
            <div class="dh-term-head">
              <span class="dh-term-dot" style="background:#ff5f56"></span>
              <span class="dh-term-dot" style="background:#ffbd2e"></span>
              <span class="dh-term-dot" style="background:#27c93f"></span>
              <span class="dh-term-title">{termTitle}</span>
              <span class="dh-term-live"><span class="lg-blip"></span> Live</span>
            </div>
            <div class="dh-term-body">
              {heroFeed.map((d) => (
                <a class="dh-term-line" href={'/coupon/' + d.slug}>
                  <span class="dh-term-time">{d.timeLabel}</span>
                  <span class="dh-term-ok">✓</span>
                  <span class="dh-term-cat">{d.cat}</span>
                  <span class="dh-term-title2">{d.title}</span>
                  <span class="dh-term-save">−{d.pct}%</span>
                </a>
              ))}
              <div class="dh-term-line"><span class="dh-term-time">now</span><span class="dh-term-ok">✓</span><span class="dh-term-title2">codes checked by CoursesWyn<span class="caret"></span></span></div>
            </div>
            <div class="dh-term-foot">{termFoot}</div>
          </div>
        </div>
        <div class="cc-toolbar" style="margin-top:1.5rem;">
          <a class="cc-hero-btn" href="/udemy-coupon-code">View Udemy Coupons</a>
          <a class="cc-hero-btn ghost" href="/platforms">All Comparisons</a>
          <a class="cc-hero-btn ghost" href="/udemy-coupons-today">Today's New Deals</a>
        </div>
      </header>

      <slot />

      <section class="cc-section cc-faq" id="faq" aria-labelledby="faq-title" style="scroll-margin-top:1.5rem;">
        <h2 id="faq-title" class="cc-section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Frequently asked questions
          <span class="cc-tag">{faqs.length} questions</span>
        </h2>
        <div class="cc-faq-grid">
          {faqs.map((faq) => (
            <div class="cc-faq-card">
              <h3 class="cc-faq-q">{faq.q}</h3>
              <p class="cc-faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="cc-section" aria-label="Related comparisons">
        <div class="cc-sec-head">
          <h2 class="cc-sec-title">Keep comparing <span class="cc-tag">{related.length} guides</span></h2>
          <p class="cc-sec-desc">Every guide below uses the same live coupon data.</p>
        </div>
        <nav class="cc-cat-grid" aria-label="Related comparisons">
          {related.map((r) => (
            <a href={r.href} class="cc-cat">
              <div class="cc-cat-label">{r.label}</div>
              <div class="cc-cat-count">{r.desc}</div>
            </a>
          ))}
        </nav>
      </section>

      <section class="cc-cta">
        <p class="cc-cta-eyebrow">Cheapest seat in the house</p>
        <p class="cc-cta-text">Before paying any subscription, check today's verified Udemy coupons — many premium courses are free right now.</p>
        <a class="cc-hero-btn" href="/udemy-coupons-today">See Today's Free Deals →</a>
      </section>

    </div>
  </main>
</Layout>

<style>
  .cc-root { background: var(--bg); padding: 2rem 1rem 4rem; }
  .cc-container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .dh-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; }
  .dh-hero-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; }
  .dh-hero-title { font-size: clamp(2rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: var(--text-bright, var(--text)); margin: 0 0 0.75rem; line-height: 1.12; }
  .dh-hero-title .cc-accent { color: var(--brand); }
  .dh-hero-sub { color: var(--muted); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
  .dh-hero-sub strong { color: var(--text); }
  .dh-hero-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .dh-stat { display: flex; flex-direction: column; }
  .dh-stat-val { font-family: var(--font-display); font-size: 1.5rem; font-weight: 800; color: var(--brand); }
  .dh-stat-label { font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .lg-blip { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); animation: lgBlip 1.6s infinite; }
  @keyframes lgBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .caret { display: inline-block; width: 0.55ch; height: 1em; margin-left: 4px; background: var(--brand); vertical-align: text-bottom; animation: lgBlip 1.1s step-end infinite; }
  .dh-terminal { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; }
  .dh-term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); }
  .dh-term-dot { width: 11px; height: 11px; border-radius: 50%; }
  .dh-term-title { margin-left: 8px; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); }
  .dh-term-live { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--stamp); text-transform: uppercase; letter-spacing: 0.06em; }
  .dh-term-live .lg-blip { background: var(--stamp); }
  .dh-term-body { padding: 4px 0; }
  .dh-term-line { display: flex; align-items: center; gap: 10px; padding: 7px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text); text-decoration: none; }
  a.dh-term-line:hover { background: var(--brand-soft); }
  .dh-term-time { color: var(--muted); flex-shrink: 0; font-size: 0.7rem; min-width: 42px; }
  .dh-term-ok { color: var(--stamp); font-weight: 700; flex-shrink: 0; }
  .dh-term-cat { color: var(--brand); flex-shrink: 0; font-size: 0.7rem; min-width: 64px; }
  .dh-term-title2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .dh-term-save { color: var(--brand); font-weight: 700; flex-shrink: 0; }
  .dh-term-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: var(--bg-secondary); font-family: var(--font-mono); font-size: 0.78rem; color: var(--text); }
  .dh-term-foot b { color: var(--brand); }
  @media (max-width: 900px) { .dh-hero-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
  .cc-toolbar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cc-hero-btn { font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; text-decoration: none; padding: 12px 20px; border-radius: 9px; background: #FFC94D; color: #0b0e14; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35); transition: background 0.2s, transform 0.2s; white-space: nowrap; }
  .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
  .cc-hero-btn.ghost { background: transparent; color: var(--brand); border: 1px solid #FFC94D; box-shadow: none; }
  .cc-hero-btn.ghost:hover { background: #FFC94D; color: #0b0e14; }
  .cc-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .cc-sec-head { margin-bottom: 0.9rem; }
  .cc-sec-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.25rem; display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; letter-spacing: -0.01em; }
  .cc-sec-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-sec-desc { font-size: 0.85rem; color: var(--muted); margin: 0; }
  .cc-section-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.3rem; display: flex; align-items: center; gap: 0.6rem; letter-spacing: -0.01em; flex-wrap: wrap; }
  .cc-section-title svg { color: var(--brand); flex-shrink: 0; }
  .cc-section-title .cc-tag { font-family: var(--font-mono); font-size: 0.625rem; font-weight: 500; color: var(--muted); border: 1px solid #232B26; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .05em; margin-left: auto; white-space: nowrap; }
  .cc-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  @media (max-width: 768px) { .cc-faq-grid { grid-template-columns: 1fr; } }
  .cc-faq-card { background: var(--card); border: 1px solid #232B26; border-radius: 12px; padding: 1.1rem 1.15rem; }
  .cc-faq-card:hover { border-color: #8A877C; }
  .cc-faq-q { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.4rem; line-height: 1.4; }
  .cc-faq-a { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }
  .cc-faq-a a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .cc-faq-a a:hover { text-decoration: underline; }
  .cc-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
  .cc-cat { background: var(--card); border: 1px solid #232B26; border-radius: 12px; padding: 16px; text-align: left; text-decoration: none; display: block; transition: all 0.2s; }
  .cc-cat:hover { transform: translateY(-2px); border-color: #FFC94D; box-shadow: 0 10px 28px -16px rgba(0, 0, 0, 0.35); }
  .cc-cat-label { font-size: 0.75rem; color: var(--muted); margin-top: 3px; font-weight: 600; }
  .cc-cat-count { font-family: var(--font-mono); font-size: 0.65625rem; color: var(--brand); margin-top: 6px; font-weight: 500; }
  .cc-cta { background: var(--card); border: 1px solid #232B26; color: var(--text); border-radius: 16px; padding: 30px 32px; text-align: center; margin: 3.25rem 0 0; }
  .cc-cta-eyebrow { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: .07em; text-transform: uppercase; color: var(--brand); margin: 0 0 8px; }
  .cc-cta-text { font-size: 0.95rem; line-height: 1.6; margin: 0 auto 18px; max-width: 480px; color: var(--muted); }
  .cc-cta .cc-hero-btn { background: #FFC94D; color: #0b0e14; box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.5); }
  .cc-cta .cc-hero-btn:hover { background: #FFC94D; transform: translateY(-1px); }
  @media (max-width: 480px) { .cc-hero-btn { padding: 11px 16px; font-size: 0.85rem; } }
</style>

<style is:global>
  .vs-section { margin-top: 3.25rem; scroll-margin-top: 1.5rem; }
  .vs-verdict { background: var(--card); border: 1px solid var(--brand); border-radius: 14px; padding: 1.25rem 1.5rem; font-size: 0.95rem; line-height: 1.65; color: var(--text); margin-top: 3.25rem; }
  .vs-verdict strong { color: var(--brand); }
  .vs-h2 { font-size: 1.2rem; font-weight: 700; color: var(--text); margin: 0 0 0.75rem; letter-spacing: -0.01em; }
  .vs-p { font-size: 0.9rem; color: var(--muted); line-height: 1.65; margin: 0 0 0.75rem; }
  .vs-p strong { color: var(--text); }
  .vs-p a { color: var(--brand); text-decoration: none; font-weight: 600; }
  .vs-p a:hover { text-decoration: underline; }
  .vs-table-wrap { overflow-x: auto; margin: 1rem 0 0; border: 1px solid #232B26; border-radius: 16px; background: var(--card); }
  table.vs-table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .vs-table thead th { font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); text-align: left; padding: 12px 14px; border-bottom: 1px solid #232B26; background: var(--bg-secondary); white-space: nowrap; }
  .vs-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: top; font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
  .vs-table tr:last-child td { border-bottom: none; }
  .vs-table td:first-child { color: var(--text); font-weight: 600; white-space: nowrap; }
  .vs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1rem; }
  @media (max-width: 768px) { .vs-grid { grid-template-columns: 1fr; } }
  .vs-card { background: var(--card); border: 1px solid #232B26; border-radius: 12px; padding: 1.1rem 1.15rem; }
  .vs-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.5rem; }
  .vs-card h3 a { color: inherit; text-decoration: none; }
  .vs-card h3 a:hover { color: var(--brand); }
  .vs-card ul { margin: 0; padding-left: 1.1rem; font-size: 0.85rem; color: var(--muted); line-height: 1.7; }
  .vs-card li strong { color: var(--text); }
  .vs-card p { font-size: 0.85rem; color: var(--muted); line-height: 1.55; margin: 0; }
  .vs-card p a { color: var(--brand); text-decoration: none; font-weight: 600; }
</style>

<script>
  (function () {
    function animateCount(el: Element): void {
      const target = parseInt(el.getAttribute('data-count') || '0', 10);
      if (isNaN(target)) return;
      const dur = 900;
      let start: number | null = null;
      function step(ts: number): void {
        if (!start) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    var counters = document.querySelectorAll('[data-count]');
    if (!('IntersectionObserver' in window)) {
      counters.forEach(animateCount);
    } else {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { animateCount(e.target); io.unobserve(e.target); }
        });
      }, { threshold: 0.3 });
      counters.forEach(function (c) { io.observe(c); });
    }
  })();
</script>
