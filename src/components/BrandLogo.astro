---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<span class="brand-icon" style={{ width: `${size}px`, height: `${size}px` }} aria-hidden="true">
  <svg viewBox="0 0 48 48" width="100%" height="100%">
    <rect width="48" height="48" rx="9" fill="#FFC94D" />
    <path d="M14 17l8 7-8 7" fill="none" stroke="#0b0e14" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M24 31h11" stroke="#0b0e14" stroke-width="4.5" stroke-linecap="round" />
  </svg>
</span>

<style>
  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .brand-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>