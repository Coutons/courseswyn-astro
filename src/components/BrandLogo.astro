---
interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
---

<span class="brand-icon" aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 48 48" fill="currentColor">
    <path d="M24 5L4 16l20 11 16-8.8V33h4V16L24 5zm0 8.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5-2.5-1.12-2.5-2.5 1.12-2.5 2.5-2.5zM12.5 25.5L24 32l11.5-6.5V28L24 34.5 12.5 28v-2.5z"/>
  </svg>
</span>

<style>
  .brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0C6E4E 0%, #0B7A55 40%, #0E8A5F 60%, #0B7A55 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 16px rgba(11,122,85,0.25), inset 0 1px 0 rgba(255,255,255,0.15);
    position: relative;
  }
  .brand-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.12);
    pointer-events: none;
  }
</style>