---
interface Props {
  size?: number;
}

const { size = 26 } = Astro.props;
---

<span class="brand-icon" aria-hidden="true">
  <svg width="42" height="42" viewBox="0 0 48 48">
    <defs>
      <linearGradient id="cw-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0A5F40" />
        <stop offset="1" stop-color="#0B6B4A" />
      </linearGradient>
      <mask id="cw-notch">
        <rect width="48" height="48" rx="12" fill="white" />
        <circle cx="0" cy="24" r="6" fill="black" />
        <circle cx="48" cy="24" r="6" fill="black" />
      </mask>
    </defs>
    <g mask="url(#cw-notch)">
      <rect width="48" height="48" rx="12" fill="url(#cw-g)" />
      <path d="M11 14 L19 34 L24 23 L29 34 L37 14" fill="none" stroke="white" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="24" cy="23" r="1.6" fill="white" />
    </g>
  </svg>
</span>

<style>
  .brand-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    filter: drop-shadow(0 3px 8px rgba(11, 107, 74, 0.3));
  }
  .brand-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
