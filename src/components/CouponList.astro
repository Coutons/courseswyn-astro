---
// DealHack-style coupon LIST row: discount rail (left) + info/CTA (right).
// Same data/SEO contract as CouponGrid.astro — accepts `deal`, `eager`, `priority`, `rank`.
import { createInstructorSlug, parseInstructors } from '../lib/instructors';
import { slugifyCategory, slugifyTopic } from '../lib/utils';
import instructorDirectory from "../data/instructorCounts.json";

const { deal, eager = false, priority = false, rank } = Astro.props;

function formatCount(n: number) {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}
function formatDurationShort(duration: string) {
  if (!duration) return "";
  const m = String(duration).match(/(\d+)\s*h.*?(\d+)\s*m/i);
  if (m) return `${m[1]}h ${m[2]}m`;
  const h = String(duration).match(/(\d+(?:\.\d+)?)\s*h/i);
  if (h) return `${h[1]}h`;
  const min = String(duration).match(/(\d+)\s*m/i);
  if (min) return `${min[1]}m`;
  return String(duration).trim();
}
function toISOorEmpty(s?: string) {
  if (!s) return "";
  const t = new Date(s).getTime();
  if (isNaN(t)) return "";
  try { return new Date(s).toISOString(); } catch { return ""; }
}
function formatRel(dateString: string) {
  const t = new Date(dateString).getTime();
  if (isNaN(t)) return "";
  const mins = Math.max(0, Math.round((Date.now() - t) / 60000));
  if (mins < 1) return "just now";
  if (mins < 60) return `${mins}m ago`;
  const h = Math.floor(mins / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  return `${d}d ago`;
}

const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const hasDiscount = op > p && p > 0;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : 0;
const isFree = p === 0;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
const provider = (deal.provider || "Udemy").trim();
const dealUrl = `/coupon/${deal.slug}`;
const extUrl = String(deal.url || dealUrl).trim() || dealUrl;
const isExternal = extUrl !== dealUrl;
const studentsNum = typeof deal.students === "number" && isFinite(deal.students) && deal.students > 0 ? deal.students : 0;
const expISO = toISOorEmpty(deal.expiresAt);
const updatedISO = toISOorEmpty(deal.updatedAt || deal.createdAt);
const updatedRaw = String(deal.updatedAt || deal.createdAt || "");

const LANG_FLAGS: Record<string, string> = {
  english: "🇺🇸", spanish: "🇪🇸", turkish: "🇹🇷", german: "🇩🇪", french: "🇫🇷",
  portuguese: "🇧🇷", italian: "🇮🇹", arabic: "🇸🇦", indonesian: "🇮🇩", hindi: "🇮🇳",
  japanese: "🇯🇵", korean: "🇰🇷", chinese: "🇨🇳", russian: "🇷🇺", dutch: "🇳🇱",
  polish: "🇵🇱", thai: "🇹🇭", vietnamese: "🇻🇳", ukrainian: "🇺🇦", greek: "🇬🇷",
};
const instructorsList = deal.instructor ? parseInstructors(String(deal.instructor)) : [];
const firstInstructor = (instructorsList[0] ?? String(deal.instructor || "").split(/[,&]/)[0]?.trim() ?? "").trim();
const instructorSlug = firstInstructor ? createInstructorSlug(firstInstructor) : "";
const dirEntry = (instructorDirectory as unknown as Record<string, { name?: string; count?: number; image?: string }>)[instructorSlug];
const instructorImg = (deal as any).instructorImage || dirEntry?.image || "";
const instructorCourses = typeof (deal as any).instructorCourses === "number" ? (deal as any).instructorCourses : dirEntry?.count;
const dealLang = (deal.language || "").toString().trim();
const langFlag = LANG_FLAGS[dealLang.toLowerCase()] || "";
const insSub = typeof instructorCourses === "number" ? `${instructorCourses} course${instructorCourses === 1 ? "" : "s"}` : (dealLang || deal.category || provider);
const instructorHref = instructorSlug ? `/instructor/${instructorSlug}` : "";
const instructorInitials = firstInstructor.split(/\s+/).map((w: string) => w[0]).join("").slice(0, 2).toUpperCase();
const desc = String(deal.description || "").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim() || "Master this in-demand skill with comprehensive training from industry experts.";
const durationShort = deal.duration ? formatDurationShort(String(deal.duration)) : "";
const catName = String(deal.category || "").trim();
const subName = String(deal.subcategory || "").trim();
const catSlug = catName ? slugifyCategory(catName) : "";
const subSlug = subName ? slugifyTopic(subName) : "";
const categoryHref = catSlug ? `/categories/${catSlug}` : "";
const topicHref = subSlug ? `/topics/${subSlug}` : "";
const rankLabel = typeof rank === "number" && rank > 0 ? String(rank).padStart(2, "0") : "";
---

<article class="cl-row" itemscope itemtype="https://schema.org/Course">
  <meta itemprop="name" content={title} />
  <span itemprop="provider" itemscope itemtype="https://schema.org/Organization">
    <meta itemprop="name" content={provider} />
  </span>

  <div class="cl-rail">
    {rankLabel && <span class="cl-rank" aria-hidden="true">{rankLabel}</span>}
    <span class="cl-off">{isFree ? "100" : discountPct || "—"}</span>
    <span class="cl-offlab">{isFree ? "FREE" : discountPct ? "OFF" : "DEAL"}</span>
    <span class="cl-verified" title="Checked against Udemy live pricing">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      verified
    </span>
  </div>

  <div class="cl-main">
    <div class="cl-info">
      <div class="cl-merchant">
        <span class="cl-logo" aria-hidden="true">
          {instructorImg ? <img src={instructorImg} alt="" width="32" height="32" loading={eager ? "eager" : "lazy"} decoding="async" /> : <span class="cl-logo-fb">{instructorInitials}</span>}
        </span>
        {instructorHref ? <a href={instructorHref} class="cl-merchant-name">{firstInstructor}</a> : <span class="cl-merchant-name">{firstInstructor}</span>}
        {langFlag ? <span class="cl-flag" title={dealLang} role="img" aria-label={dealLang}>{langFlag}</span> : null}
        {typeof instructorCourses === "number" ? <span class="cl-merchant-sub">{insSub}</span> : null}
      </div>

      <div class="cl-titlerow">
        <h3 class="cl-title" itemprop="name"><a href={dealUrl}>{title}</a></h3>
        {r && <span class="cl-rating" title={studentsNum > 0 ? `${studentsNum.toLocaleString("en-US")} students` : ""}>★ {r.toFixed(1)}</span>}
      </div>

      <p class="cl-desc">{desc}</p>

      <ul class="cl-chips">
        {categoryHref && <li><a href={categoryHref} rel="tag" title={`Browse ${catName} courses`}>{catName}</a></li>}
        {topicHref && subName !== catName && <li class="cl-chip-topic"><a href={topicHref} rel="tag" title={`Browse ${subName} courses`}>{subName}</a></li>}
        {studentsNum > 0 && <li class="cl-chip-neutral">{formatCount(studentsNum)} students</li>}
        {durationShort && <li class="cl-chip-neutral">{durationShort}</li>}
        {updatedISO && <li class="cl-chip-neutral"><time datetime={updatedISO} title={formatRel(updatedRaw)}>updated {formatRel(updatedRaw)}</time></li>}
      </ul>
    </div>

    <div class="cl-buy">
      <div class="cl-price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <meta itemprop="priceCurrency" content="USD" />
        <meta itemprop="price" content={String(p)} />
        <link itemprop="availability" href="https://schema.org/InStock" />
        <link itemprop="url" href={dealUrl} />
        {expISO && <meta itemprop="priceValidUntil" content={expISO} />}
        {hasDiscount && <s class="cl-was">${op.toFixed(2)}</s>}
        <span class="cl-now">{isFree ? "FREE" : `$${p.toFixed(2)}`}</span>
      </div>
      <a href={extUrl} class="cl-cta" target={isExternal ? "_blank" : undefined} rel={isExternal ? "sponsored noopener noreferrer nofollow" : undefined} aria-label={`${isFree ? "Enroll for free" : "Get coupon"} for ${title} on ${provider}`}>
        {isFree ? "Enroll Free" : "Get Coupon"}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </div>

  <meta itemprop="description" content={desc.slice(0, 160)} />
</article>

<style>
  /* Schema-only nodes must never consume a grid cell. */
  .cl-row > meta, .cl-row > [itemprop="provider"] { display: none; }

  .cl-row {
    position: relative;
    display: grid;
    grid-template-columns: 92px 1fr;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    color: var(--text);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .cl-row:hover { border-color: rgba(169, 199, 255, 0.4); box-shadow: 0 10px 26px -14px rgba(169, 199, 255, 0.35); }
  .cl-row:focus-within { border-color: rgba(169, 199, 255, 0.5); box-shadow: 0 0 0 3px rgba(169, 199, 255, 0.15); }

  /* ── Left: discount rail ── */
  .cl-rail {
    position: relative;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 2px; text-align: center;
    padding: 1.1rem 0.4rem;
    background: var(--bg-secondary);
    border-right: 1px dashed var(--border);
  }
  .cl-rail::before, .cl-rail::after {
    content: ""; position: absolute; right: -8px; width: 15px; height: 15px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 50%;
  }
  .cl-rail::before { top: -8px; }
  .cl-rail::after { bottom: -8px; }
  .cl-rank {
    position: absolute; top: 8px; left: 9px;
    font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700;
    color: var(--muted); opacity: 0.55; font-variant-numeric: tabular-nums;
  }
  .cl-off { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--brand); letter-spacing: -0.03em; }
  .cl-offlab { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .cl-verified {
    display: inline-flex; align-items: center; gap: 3px;
    margin-top: 8px; padding: 3px 7px; border-radius: 999px;
    background: var(--stamp-soft); color: var(--stamp);
    border: 1px solid rgba(74, 222, 128, 0.35);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  }

  /* ── Right: info + CTA ── */
  .cl-main { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1.25rem; padding: 1rem 1.1rem; min-width: 0; }
  .cl-info { min-width: 0; }

  .cl-merchant { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; font-size: 0.78rem; color: var(--muted); min-width: 0; }
  .cl-logo { width: 32px; height: 32px; flex-shrink: 0; display: block; overflow: hidden; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-secondary); }
  .cl-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cl-logo-fb { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.72rem; color: var(--brand); background: var(--brand-soft); }
  .cl-merchant-name { color: var(--muted); font-weight: 700; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
  .cl-merchant-name:hover { color: var(--brand); text-decoration: underline; }
  .cl-merchant-sub { flex-shrink: 0; font-size: 0.7rem; color: var(--muted); opacity: 0.8; }
  .cl-flag { font-size: 1rem; line-height: 1; flex-shrink: 0; }

  .cl-titlerow { display: flex; align-items: flex-start; gap: 0.5rem; }
  .cl-title {
    font-size: 1rem; font-weight: 700; line-height: 1.35; color: var(--text);
    margin: 0; min-width: 0; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .cl-title a { color: inherit; text-decoration: none; }
  .cl-title a:hover { color: var(--brand); }
  .cl-rating { flex-shrink: 0; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--brand); background: var(--brand-soft); border: 1px solid rgba(169, 199, 255, 0.3); padding: 3px 7px; border-radius: 6px; line-height: 1; }

  .cl-desc {
    margin: 0.4rem 0 0; color: var(--muted); font-size: 0.84rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  }

  .cl-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.6rem 0 0; padding: 0; }
  .cl-chips li {
    font-size: 0.7rem; font-weight: 600; line-height: 1; padding: 5px 8px; border-radius: 6px;
    background: var(--bg-secondary); border: 1px solid var(--border); color: var(--muted);
    white-space: nowrap;
  }
  .cl-chips a { color: inherit; text-decoration: none; }
  .cl-chips a:hover { color: var(--brand); }
  .cl-chips .cl-chip-topic { background: var(--brand-soft); border-color: rgba(169, 199, 255, 0.3); color: var(--brand); }
  .cl-chips .cl-chip-neutral { font-family: var(--font-mono); font-weight: 500; }

  /* ── CTA column ── */
  .cl-buy { display: flex; flex-direction: column; align-items: flex-end; gap: 0.55rem; flex-shrink: 0; }
  .cl-price { display: flex; align-items: baseline; gap: 7px; }
  .cl-was { color: var(--muted); font-size: 0.85rem; text-decoration: line-through; }
  .cl-now { font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--text); letter-spacing: 0.01em; }
  .cl-cta {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 0.65rem 1.15rem; border-radius: 8px;
    background: var(--brand-gradient); color: #0a0b0d;
    font-weight: 800; font-size: 0.85rem; text-decoration: none; white-space: nowrap;
    transition: filter 0.18s ease, transform 0.18s ease;
  }
  .cl-cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
  .cl-cta svg { transition: transform 0.18s ease; }
  .cl-cta:hover svg { transform: translate(2px, -2px); }

  @media (max-width: 860px) {
    .cl-main { grid-template-columns: 1fr; align-items: stretch; gap: 0.85rem; }
    .cl-buy { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; }
  }
  @media (max-width: 560px) {
    .cl-row { grid-template-columns: 74px 1fr; }
    .cl-off { font-size: 1.4rem; }
    .cl-rank { font-size: 0.58rem; left: 6px; }
    .cl-verified { display: none; }
    .cl-desc { display: none; }
    .cl-title { font-size: 0.94rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-row, .cl-cta { transition: none; }
    .cl-cta:hover { transform: none; }
  }
</style>
