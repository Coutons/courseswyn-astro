---
import { Image } from 'astro:assets';

const { deal, eager = false, priority = false, variant = "row", num = "" } = Astro.props;

function formatCompactAgo(dateString: string) {
  const t = new Date(dateString).getTime();
  if (isNaN(t)) return "";
  const m = Math.floor(Math.max(0, Date.now() - t) / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}

function formatCount(n: number) {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}

function toISOorEmpty(s?: string) {
  if (!s) return "";
  const t = new Date(s).getTime();
  if (isNaN(t)) return "";
  try { return new Date(s).toISOString(); } catch { return ""; }
}

function slugifyCat(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-");
}

const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const hasDiscount = op > p;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
const students = typeof deal.students === "number" && isFinite(deal.students) && deal.students > 0 ? deal.students : null;
const provider = (deal.provider || "Udemy").trim();
const instructor = (deal.instructor || "").toString().split(/[,&]/)[0].trim();
const duration = (deal.duration || "").toString().trim();
const couponCode = (deal.coupon || "").toString().trim();
const checkedText = deal.updatedAt ? formatCompactAgo(deal.updatedAt) : "";
const checkedISO = toISOorEmpty(deal.updatedAt || deal.createdAt);
const updatedLine = checkedText || "Verified";
const dealUrl = `/coupon/${deal.slug}`;
const extUrl = deal.url || dealUrl;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : 0;
const isFree = p === 0;
const displayPrice = isFree ? "FREE" : `$${p.toFixed(2)}`;
const categoryLabel = (deal.category || "").trim();
const catHref = categoryLabel ? `/categories/${slugifyCat(categoryLabel)}` : "";
const shortDesc = String(deal.description || "").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim().slice(0, 110);

// Urgency: expires soon signal (was missing in card)
const expMs = deal.expiresAt ? new Date(deal.expiresAt).getTime() - Date.now() : null;
const expISO = toISOorEmpty(deal.expiresAt);
const expiringSoon = expMs !== null && expMs > 0 && expMs < 7 * 24 * 3600000;
const expDays = expiringSoon && expMs !== null ? Math.max(1, Math.ceil(expMs / 86400000)) : 0;
---

{variant === "grid" ? (
  <article class="lt-grid-card" itemscope itemtype="https://schema.org/Course">
    <meta itemprop="name" content={title} />
    <span itemprop="provider" itemscope itemtype="https://schema.org/Organization">
      <meta itemprop="name" content={provider} />
    </span>
    <div class="lt-grid-media">
      {deal.image ? (
        <Image src={deal.image} alt={title} width={400} height={225} loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} decoding={priority ? "sync" : "async"} inferSize={false} style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} itemprop="image" />
      ) : (
        <span class="lt-grid-fallback" aria-hidden="true"></span>
      )}
      <span class="lt-media-badge">{updatedLine ? `Updated ${updatedLine}` : "Updated recently"}</span>
      {isFree && <span class="lt-free-badge">FREE</span>}
    </div>
    <div class="lt-grid-body">
      {categoryLabel && <a href={catHref} class="lt-grid-cat" rel="tag">{categoryLabel}</a>}
      <h3 class="lt-grid-title" itemprop="name"><a href={dealUrl}>{title}</a></h3>
      {instructor && <p class="lt-instructor">By {instructor}</p>}
      {shortDesc && <p class="lt-grid-desc" itemprop="description">{shortDesc}</p>}
      <div class="lt-meta-row">
        {r && <span class="lt-rating">★ {r.toFixed(1)}{students ? ` (${formatCount(students)}+ students)` : ""}</span>}
        {expiringSoon && <span class="lt-expiring">⏳ {expDays}d left</span>}
      </div>
      <div class="lt-info-row">
        <span class="lt-price">{displayPrice}</span>
        {hasDiscount && <s>${op.toFixed(2)}</s>}
        {hasDiscount && <span class="lt-discount-badge">{discountPct}% OFF</span>}
        <span class="lt-verified">✓ Verified</span>
      </div>
      {duration && <p class="lt-duration">Course Duration: {duration}</p>}
      <a href={extUrl} class="lt-grid-cta" target="_blank" rel="sponsored noopener noreferrer nofollow" aria-label={`${isFree ? "Enroll for free" : "Get coupon"} for ${title} on Udemy (opens in new tab)`}>{isFree ? "Enroll for Free" : "Get Coupon"}</a>
    </div>
    <div itemprop="offers" itemscope itemtype="https://schema.org/Offer" style="display:none">
      <meta itemprop="priceCurrency" content="USD" />
      <meta itemprop="price" content={String(p)} />
      <link itemprop="availability" href="https://schema.org/InStock" />
      <link itemprop="url" href={dealUrl} />
      {expISO && <meta itemprop="priceValidUntil" content={expISO} />}
    </div>
    <meta itemprop="description" content={shortDesc} />
  </article>
) : (
<tr itemscope itemtype="https://schema.org/Course">
  <td>
    <div class="lt-course">
      <span class="lt-thumb">
        {deal.image ? (
          <Image src={deal.image} alt={title} width={104} height={76} loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} decoding={priority ? "sync" : "async"} inferSize={false} style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} />
        ) : (
          <span class="lt-thumb-fallback"></span>
        )}
      </span>
      <div>
        <a class="lt-title" href={dealUrl} itemprop="url"><span itemprop="name">{title}</span></a>
        <div class="lt-meta">
          {provider}
          {r && <span class="lt-rating">· ★ {r.toFixed(1)}</span>}
          {students && <span>· {formatCount(students)} students</span>}
        </div>
      </div>
    </div>
  </td>
  <td><span class="lt-price">${p.toFixed(2)}{hasDiscount && <s>${op.toFixed(2)}</s>}</span></td>
  <td class="cc-col-hide"><span class="lt-status">Working</span></td>
  <td class="lt-checked">{checkedISO ? <time datetime={checkedISO}>{checkedText || "—"}</time> : (checkedText || "—")}</td>
</tr>
)}

<style>
  td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--card-hover); }
  @media (max-width: 700px) { .cc-col-hide { display: none; } }

  .lt-course { display: flex; align-items: center; gap: 12px; }

  .lt-thumb {
    width: 52px;
    min-width: 52px;
    height: 38px;
    border-radius: 6px;
    overflow: hidden;
    flex: 0 0 auto;
    background-color: #f0f0f0;
  }
  .lt-thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.07) 0px, rgba(255, 255, 255, 0.07) 2px, transparent 2px, transparent 8px);
  }

  .lt-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 560px;
  }
  .lt-title:hover { color: var(--brand); }

  .lt-meta {
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    color: var(--muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 560px;
  }
  .lt-rating { color: var(--brand); }

  .lt-price {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    color: var(--brand);
    font-weight: 600;
    white-space: nowrap;
  }
  .lt-price s {
    color: var(--muted);
    text-decoration: line-through;
    font-weight: 400;
    margin-left: 4px;
  }

  .lt-status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--brand);
    background: var(--brand-soft);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .lt-checked {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .lt-checked time { color: inherit; }

  /* ===== COUPON CARD — fixed hierarchy + SEO-safe ===== */
  .lt-grid-card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .lt-grid-card:hover { border-color: var(--brand); transform: translateY(-3px); box-shadow: 0 12px 28px -12px rgba(37, 99, 235,0.28); }
  .lt-grid-card:focus-within { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }

  .lt-grid-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-soft), var(--bg-secondary));
    display: block;
  }
  .lt-grid-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; display: block; }
  .lt-grid-card:hover .lt-grid-media img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .lt-grid-card, .lt-grid-media img, .lt-grid-cta { transition: none !important; transform: none !important; }
  }
  .lt-grid-fallback { display: block; width: 100%; height: 100%; background-image: repeating-linear-gradient(100deg, rgba(37, 99, 235,0.08) 0 2px, transparent 2px 8px); }

  .lt-grid-top { display: flex; align-items: center; gap: 10px; padding: 0.75rem 1.25rem 0; }
  .lt-num {
    width: 26px; height: 26px; flex: 0 0 auto; border-radius: 50%;
    background: var(--brand-soft); border: 1px solid var(--brand); color: var(--brand);
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .lt-discount {
    flex: 0 0 auto; min-width: 76px; padding: 6px 10px; border-radius: 10px;
    background: var(--brand-soft); border: 1.5px solid var(--brand);
    display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1;
  }
  .lt-discount-val { font-family: var(--font-mono); font-weight: 800; font-size: 1.15rem; color: var(--brand); white-space: nowrap; }
  .lt-discount-cap { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; color: var(--muted); white-space: nowrap; }
  .lt-grid-badge-verified {
    margin-left: auto; background: var(--brand); color: #fff;
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;
    padding: 5px 10px; border-radius: 999px; white-space: nowrap; border: 1px solid var(--brand);
  }
  .lt-grid-badge-verified time { color: inherit; }
  .lt-badge-status { background: var(--stamp-soft); color: var(--stamp); font-size: 0.68rem; font-weight: 800; padding: 5px 10px; border-radius: 999px; white-space: nowrap; }
  .lt-instructor { margin: 0; font-size: 0.8rem; color: var(--muted); line-height: 1.4; }
  .lt-info-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .lt-info-row .lt-price { font-size: 1.25rem; font-weight: 800; color: var(--text); font-family: var(--font-display); }
  .lt-info-row s { color: var(--muted); font-size: 0.85rem; }
  .lt-save { color: var(--stamp); font-weight: 800; font-size: 0.8rem; }
  .lt-meta-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.78rem; color: var(--muted); }
  .lt-expiring { color: #b45309; font-weight: 800; }
  .lt-media-badge { position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(0,0,0,0.8); color: #fff; padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.7rem; font-weight: 700; backdrop-filter: blur(4px); }
  .lt-free-badge { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--brand); color: #fff; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; }
  .lt-discount-badge { background: var(--destructive); color: #fff; padding: 0.25rem 0.5rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; }
  .lt-verified { margin-left: auto; color: var(--muted); font-size: 0.72rem; font-weight: 700; }
  .lt-duration { margin: 0; color: var(--muted); font-size: 0.8rem; font-weight: 500; }
  .lt-code-row { display: flex; align-items: stretch; gap: 8px; margin-top: 2px; }
  .lt-code-row code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: var(--bg-secondary); border: 1px dashed var(--border); border-radius: 10px; padding: 10px 12px; font-family: var(--font-mono); font-weight: 800; color: var(--text); }
  .lt-code-btn { display: inline-flex; align-items: center; justify-content: center; background: var(--brand-gradient); color: #fff; border-radius: 10px; padding: 0 14px; font-weight: 800; white-space: nowrap; }
  .lt-detail-link { text-align: center; font-size: 0.8rem; font-weight: 700; color: var(--brand); margin-top: 2px; }

  .lt-grid-body { padding: 0.9rem 1.25rem 1.25rem; flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .lt-grid-cat { display: inline-flex; align-self: flex-start; font-size: 0.65rem; font-weight: 700; color: var(--brand); background: var(--brand-soft); border: 1px solid rgba(37, 99, 235,0.25); padding: 2px 8px; border-radius: 999px; text-decoration: none; }
  .lt-grid-cat:hover { background: var(--brand); color: #fff; }
  .lt-grid-title { font-size: 1.02rem; font-weight: 700; color: var(--text); margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .lt-grid-title a { color: inherit; text-decoration: none; }
  .lt-grid-title a:hover { color: var(--brand); }
  .lt-grid-title a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 4px; }
  .lt-grid-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lt-grid-price-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 6px; }
  .lt-grid-price { font-family: var(--font-display); font-size: 1.3rem; font-weight: 800; letter-spacing: -0.01em; color: var(--text); }
  .lt-grid-was { font-family: var(--font-display); font-size: 0.85rem; color: var(--muted); text-decoration: line-through; font-weight: 500; }
  .lt-rating { color: var(--brand); font-size: 0.8rem; font-weight: 600; }

  .lt-urgency { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--stamp); margin: 0; }
  .lt-urgency.is-free { color: var(--stamp); }
  .lt-urgency:not(.is-free):not(.is-ok) { color: #b45309; }

  .lt-grid-cta { display: block; width: 100%; text-align: center; margin-top: 4px; padding: 0.7rem 1rem; border-radius: 10px; background: var(--brand-gradient); color: #fff; font-family: var(--font-display); font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: filter 0.2s, transform 0.2s; }
  .lt-grid-cta:hover { filter: brightness(1.08); transform: translateY(-1px); color: #fff; }
  .lt-grid-cta:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
</style>
