---
import { Image } from 'astro:assets';

const { deal, eager = false, priority = false, variant = "row", num = "" } = Astro.props;

function formatCompactAgo(dateString: string) {
  const t = new Date(dateString).getTime();
  if (isNaN(t)) return "";
  const m = Math.floor(Math.max(0, Date.now() - t) / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}

function formatCount(n: number) {
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  return String(n);
}

const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const hasDiscount = op > p;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
const students = typeof deal.students === "number" && isFinite(deal.students) && deal.students > 0 ? deal.students : null;
const provider = (deal.provider || "Udemy").trim();
const checkedText = deal.updatedAt ? formatCompactAgo(deal.updatedAt) : "";
const dealUrl = `/coupon/${deal.slug}`;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : 0;
const isFree = p === 0;
const displayPrice = isFree ? "FREE" : `$${p.toFixed(2)}`;
const categoryLabel = (deal.category || "").trim();
const shortDesc = String(deal.description || "").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim().slice(0, 110);
---

{variant === "grid" ? (
  <article class="lt-grid-card">
    <a href={dealUrl} class="lt-grid-media" aria-label={title}>
      {deal.image ? (
        <Image src={deal.image} alt={title} width={400} height={225} loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} decoding={priority ? "sync" : "async"} inferSize={false} style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} />
      ) : (
        <span class="lt-grid-fallback" aria-hidden="true"></span>
      )}
    </a>
    <div class="lt-grid-top">
      <span class="lt-num" aria-hidden="true">{num}</span>
      <div class="lt-discount">
        <span class="lt-discount-val">{isFree ? "FREE" : `${discountPct}%`}</span>
        <span class="lt-discount-cap">{isFree ? "COURSE" : "OFF"}</span>
      </div>
      <span class="lt-grid-badge-verified">✓ {checkedText || "Verified"}</span>
    </div>
    <div class="lt-grid-body">
      {categoryLabel && <a href={`/categories/${categoryLabel.toLowerCase().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-")}`} class="lt-grid-cat">{categoryLabel}</a>}
      <h3 class="lt-grid-title"><a href={dealUrl}>{title}</a></h3>
      <span class="lt-worked">✓ worked at checkout</span>
      {shortDesc && <p class="lt-grid-desc">{shortDesc}</p>}
      <div class="lt-grid-tags">
        {hasDiscount && !isFree && <span class="lt-tag">saves ~{discountPct}%</span>}
        <span class="lt-tag">store verified</span>
      </div>
      <div class="lt-grid-price-row">
        <span class="lt-grid-price mono">{displayPrice}</span>
        {hasDiscount && !isFree && <s class="lt-grid-was mono">${op.toFixed(2)}</s>}
        {r && <span class="lt-rating">⭐ {r.toFixed(1)}</span>}
      </div>
      <a href={deal.url || dealUrl} class="lt-grid-cta" target="_blank" rel="noopener noreferrer nofollow">Get Code →</a>
    </div>
  </article>
) : (
<tr>
  <td>
    <div class="lt-course">
      <span class="lt-thumb">
        {deal.image ? (
          <Image src={deal.image} alt={title} width={104} height={76} loading={eager ? "eager" : "lazy"} fetchpriority={priority ? "high" : undefined} decoding={priority ? "sync" : "async"} inferSize={false} style={{ width: "100%", height: "100%", objectFit: "cover", display: "block" }} />
        ) : (
          <span class="lt-thumb-fallback"></span>
        )}
      </span>
      <div>
        <a class="lt-title" href={dealUrl}>{title}</a>
        <div class="lt-meta">
          {provider}
          {r && <span class="lt-rating">· ⭐ {r.toFixed(1)}</span>}
          {students && <span>· {formatCount(students)} students</span>}
        </div>
      </div>
    </div>
  </td>
  <td><span class="lt-price">${p.toFixed(2)}{hasDiscount && <s>${op.toFixed(2)}</s>}</span></td>
  <td class="cc-col-hide"><span class="lt-status">Working</span></td>
  <td class="lt-checked">{checkedText || "—"}</td>
</tr>
)}

<style>
  td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--card-hover); }
  @media (max-width: 700px) { .cc-col-hide { display: none; } }

  .lt-course { display: flex; align-items: center; gap: 12px; }

  .lt-thumb {
    width: 52px;
    min-width: 52px;
    height: 38px;
    border-radius: 6px;
    overflow: hidden;
    flex: 0 0 auto;
    background-color: #18201B;
  }
  .lt-thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
    background-image: repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.07) 0px, rgba(255, 255, 255, 0.07) 2px, transparent 2px, transparent 8px);
  }

  .lt-title {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 560px;
  }
  .lt-title:hover { color: var(--brand); }

  .lt-meta {
    font-family: var(--font-mono);
    font-size: 0.65625rem;
    color: var(--muted);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 560px;
  }
  .lt-rating { color: var(--brand); }

  .lt-price {
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    color: var(--brand);
    font-weight: 600;
    white-space: nowrap;
  }
  .lt-price s {
    color: var(--muted);
    text-decoration: line-through;
    font-weight: 400;
    margin-left: 4px;
  }

  .lt-status {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--brand);
    background: var(--brand-soft);
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .lt-checked {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ===== COUPON CARD — gaya Dealhack: nomor + box diskon besar ===== */
  .lt-grid-card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    transition: all 0.3s ease;
  }
  .lt-grid-card:hover { border-color: var(--brand); transform: translateY(-4px); box-shadow: 0 16px 32px -16px rgba(255,201,77,0.35); }
  .lt-grid-card:hover .lt-grid-media img { transform: scale(1.06); }

  .lt-grid-media {
    position: relative;
    height: 150px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--brand-soft), var(--bg-secondary));
    display: block;
  }
  .lt-grid-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; display: block; }
  .lt-grid-fallback { display: block; width: 100%; height: 100%; background-image: repeating-linear-gradient(100deg, rgba(255,201,77,0.08) 0 2px, transparent 2px 8px); }

  .lt-grid-top { display: flex; align-items: center; gap: 10px; padding: 0.75rem 1.5rem 0; }
  .lt-num {
    width: 26px; height: 26px; flex: 0 0 auto; border-radius: 50%;
    background: var(--brand-soft); border: 1px solid var(--brand); color: var(--brand);
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .lt-discount {
    flex: 0 0 auto; min-width: 92px; padding: 8px 12px; border-radius: 10px;
    background: var(--brand-soft); border: 1.5px solid var(--brand);
    display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1;
  }
  .lt-discount-val { font-family: var(--font-mono); font-weight: 800; font-size: 1.4rem; color: var(--brand); white-space: nowrap; }
  .lt-discount-cap { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.12em; color: var(--muted); white-space: nowrap; }
  .lt-grid-badge-verified {
    margin-left: auto; background: var(--brand); color: #0b0e14;
    font-size: 0.62rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;
    padding: 4px 10px; border-radius: 999px; white-space: nowrap; border: 1px solid var(--brand);
  }

  .lt-grid-body { padding: 1rem 1.5rem 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .lt-grid-cat { display: inline-flex; align-self: flex-start; font-size: 0.65rem; font-weight: 700; color: var(--brand); background: var(--brand-soft); border: 1px solid rgba(255,201,77,0.25); padding: 2px 8px; border-radius: 999px; text-decoration: none; }
  .lt-grid-cat:hover { background: var(--brand); color: #0A0D0B; }
  .lt-grid-title { font-size: 1.02rem; font-weight: 700; color: var(--text); margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
  .lt-grid-title a { color: inherit; text-decoration: none; }
  .lt-grid-title a:hover { color: var(--brand); }
  .lt-worked { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--stamp); }
  .lt-grid-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .lt-grid-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .lt-tag { font-family: var(--font-mono); font-size: 0.65rem; color: var(--muted); background: var(--bg-secondary); border: 1px solid var(--border); padding: 2px 8px; border-radius: 999px; }
  .lt-grid-price-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: auto; padding-top: 6px; }
  .lt-grid-price { font-family: var(--font-mono); font-size: 1.3rem; font-weight: 700; color: var(--text); }
  .lt-grid-was { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); text-decoration: line-through; }
  .lt-rating { color: var(--brand); font-size: 0.8rem; font-weight: 600; }

  .lt-grid-cta { display: block; width: 100%; text-align: center; margin-top: 8px; padding: 0.7rem 1rem; border-radius: 8px; background: var(--brand); color: #0b0e14; font-family: var(--font-display); font-size: 0.88rem; font-weight: 700; text-decoration: none; transition: all 0.25s; }
  .lt-grid-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 24px -4px rgba(255,201,77,0.5); }
</style>
