---
// Shared admin protection component for all admin pages.
// Admin is restricted to local development only (astro dev).
const isProduction =
  Astro.url.hostname?.includes(".com") &&
  !Astro.url.hostname?.includes("localhost");
---

{
  isProduction ? (
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0b0e14;color:#EDE9DC;font-family:Inter,system-ui,sans-serif;padding:2rem;text-align:center;">
      <div>
        <div style="width:52px;height:52px;border-radius:.85rem;display:grid;place-items:center;margin:0 auto 1rem;background:rgba(255,201,77,.12);border:1px solid rgba(255,201,77,.30);color:#ffc94d;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        </div>
        <h2 style="margin:0 0 .5rem;font-size:1.5rem;">Admin Access Blocked</h2>
        <p style="color:#868d9b;margin:0 0 .5rem;">Admin is restricted to local development only.</p>
        <small style="color:#5a6472;">Hostname: {(Astro.url.hostname || "unknown").trim()}</small>
      </div>
    </div>
  ) : (
    <slot />
  )
}
