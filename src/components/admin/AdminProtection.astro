---
// Shared admin protection component for all admin pages.
// Admin is restricted to local development only (astro dev).
const isProduction =
  Astro.url.hostname?.includes(".com") &&
  !Astro.url.hostname?.includes("localhost");
---

{
  isProduction ? (
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0b0d12;color:#e2e8f0;font-family:Inter,system-ui,sans-serif;padding:2rem;text-align:center;">
      <div>
        <div style="font-size:2.5rem;margin-bottom:1rem;">🚫</div>
        <h2 style="margin:0 0 .5rem;font-size:1.5rem;">Admin Access Blocked</h2>
        <p style="color:#a9b0c0;margin:0 0 .5rem;">Admin is restricted to local development only.</p>
        <small style="color:#64748b;">Hostname: {(Astro.url.hostname || "unknown").trim()}</small>
      </div>
    </div>
  ) : (
    <slot />
  )
}
