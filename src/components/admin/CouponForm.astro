---
import type { Deal } from "@/types/deal";

interface Props {
  deal?: Deal;
}

const { deal } = Astro.props;
const isEdit = !!deal;

const pad = (n: number) => String(n).padStart(2, "0");
function toLocalInput(iso?: string): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  const wib = new Date(d.getTime() + 7 * 3600000);
  return `${wib.getUTCFullYear()}-${pad(wib.getUTCMonth() + 1)}-${pad(wib.getUTCDate())}T${pad(wib.getUTCHours())}:${pad(wib.getUTCMinutes())}`;
}

const fmtDT = (iso?: string) => {
  if (!iso) return "-";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "-";
  return d.toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
};

const priceHistory = deal?.priceHistory ?? [];
const historyRows = [...priceHistory].sort((a, b) => new Date(b.checkedAt).getTime() - new Date(a.checkedAt).getTime()).slice(0, 8);

const submitLabel = isEdit ? "Save Changes" : "Create Coupon";
---

<form id="couponForm" class="adm-form" data-is-edit={String(isEdit)} data-deal-id={deal?.slug ?? ""} novalidate>
  <div class="adm-tabs">
    <button type="button" class="adm-tab active" data-tab="basic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>Basic Info</button>
    <button type="button" class="adm-tab" data-tab="pricing"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Pricing & Stats</button>
    <button type="button" class="adm-tab" data-tab="tracking"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Coupon & Tracking</button>
    <button type="button" class="adm-tab" data-tab="content"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>Content</button>
  </div>

  <!-- ======================= BASIC ======================= -->
  <div class="adm-tab-panel active" data-panel="basic">
    <div class="adm-card">
      <h3 class="adm-subhead"><span class="bar"></span>Basic Information</h3>
      <div class="adm-grid">
        <div>
          <label class="adm-label" for="title">Course Title *</label>
          <input class="adm-input" id="title" name="title" type="text" required placeholder="Advanced React Patterns & Performance" value={deal?.title ?? ""} data-slug-source />
          <span class="adm-hint">Auto-generates the URL slug when left blank.</span>
        </div>
        <div class="adm-grid adm-grid-2">
          <div>
            <label class="adm-label" for="provider">Provider</label>
            <input class="adm-input" id="provider" name="provider" type="text" value={deal?.provider ?? "Udemy"} readonly />
          </div>
          <div>
            <label class="adm-label" for="category">Category *</label>
            <input class="adm-input" id="category" name="category" type="text" required placeholder="Development" value={deal?.category ?? ""} />
          </div>
          <div>
            <label class="adm-label" for="subcategory">Subcategory</label>
            <input class="adm-input" id="subcategory" name="subcategory" type="text" placeholder="Web Development" value={deal?.subcategory ?? ""} />
          </div>
          <div>
            <label class="adm-label" for="instructor">Instructor</label>
            <input class="adm-input" id="instructor" name="instructor" type="text" placeholder="Maya Chen" value={deal?.instructor ?? ""} />
          </div>
        </div>
        <div>
          <label class="adm-label" for="url">Course URL (with coupon code) *</label>
          <input class="adm-input code" id="url" name="url" type="url" required placeholder="https://trk.udemy.com/.../?couponCode=CODE" value={deal?.url ?? ""} />
        </div>
        <div>
          <label class="adm-label" for="slug">Slug (URL)</label>
          <input class="adm-input code" id="slug" name="slug" type="text" placeholder="auto-generated from title" value={deal?.slug ?? ""} data-slug-target />
          <span class="adm-hint">Leave blank to auto-generate from the title. Changing it renames the /coupon/ URL.</span>
        </div>
        <div>
          <label class="adm-label" for="coupon">Coupon Code</label>
          <input class="adm-input code" id="coupon" name="coupon" type="text" placeholder="VOUCHER202608" value={deal?.coupon ?? ""} />
        </div>
        <div>
          <label class="adm-label" for="image">Thumbnail URL</label>
          <input class="adm-input code" id="image" name="image" type="url" placeholder="https://img-c.udemycdn.com/course/480x270/..." value={deal?.image ?? ""} />
          <span class="adm-hint">Otomatis dipakai juga untuk share sosmed (OG). Isi thumbnail saja cukup.</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================= PRICING ======================= -->
  <div class="adm-tab-panel" data-panel="pricing">
    <div class="adm-card">
      <h3 class="adm-subhead"><span class="bar"></span>Pricing & Statistics</h3>
      <div class="adm-grid adm-grid-2">
        <div>
          <label class="adm-label" for="price">Current Price (USD) *</label>
          <input class="adm-input" id="price" name="price" type="number" step="0.01" min="0" required value={deal?.price ?? ""} />
          <span class="adm-hint">Saving a changed price auto-appends a record to priceHistory.</span>
        </div>
        <div>
          <label class="adm-label" for="originalPrice">Original Price (USD)</label>
          <input class="adm-input" id="originalPrice" name="originalPrice" type="number" step="0.01" min="0" value={deal?.originalPrice ?? ""} />
          <span class="adm-hint">Discount % is computed automatically.</span>
        </div>
        <div>
          <label class="adm-label" for="rating">Rating (0–5)</label>
          <input class="adm-input" id="rating" name="rating" type="number" step="0.1" min="0" max="5" value={deal?.rating ?? ""} />
        </div>
        <div>
          <label class="adm-label" for="students">Students</label>
          <input class="adm-input" id="students" name="students" type="number" min="0" value={deal?.students ?? ""} />
        </div>
        <div>
          <label class="adm-label" for="duration">Duration</label>
          <input class="adm-input" id="duration" name="duration" type="text" placeholder="18.5 hours" value={deal?.duration ?? ""} />
        </div>
        <div>
          <label class="adm-label" for="level">Level</label>
          <select class="adm-select" id="level" name="level">
            <option value="">All Levels (default)</option>
            {["Beginner", "Intermediate", "Advanced", "All Levels"].map((lvl) => (
              <option value={lvl} selected={deal?.level === lvl}>{lvl}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="adm-label" for="language">Language</label>
          <input class="adm-input" id="language" name="language" type="text" placeholder="English" value={deal?.language ?? ""} />
        </div>
      </div>
    </div>
  </div>

  <!-- ======================= TRACKING ======================= -->
  <div class="adm-tab-panel" data-panel="tracking">
    <div class="adm-card">
      <h3 class="adm-subhead"><span class="bar"></span>Coupon & Tracking</h3>
      <div class="adm-grid adm-grid-2">
        <div>
          <label class="adm-label" for="expiresAt">Coupon Expiry (WIB)</label>
          <input class="adm-input" id="expiresAt" name="expiresAt" type="datetime-local" value={toLocalInput(deal?.expiresAt)} />
          <span class="adm-hint">Stored in Asia/Jakarta (WIB) timezone.</span>
        </div>
        <div>
          <label class="adm-label" for="createdAt">Created At</label>
          <input class="adm-input" id="createdAt" type="text" value={fmtDT(deal?.createdAt)} readonly disabled />
        </div>
        <div>
          <label class="adm-label" for="updatedAt">Last Updated</label>
          <input class="adm-input" id="updatedAt" type="text" value={fmtDT(deal?.updatedAt)} readonly disabled />
        </div>
      </div>

      <div style="margin-top:1.5rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
          <label class="adm-label" style="margin-bottom:0;">Price History (real tracking data)</label>
          {isEdit && (
            <button class="adm-btn adm-btn-ghost adm-btn-sm" type="button" id="recordCheck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Record check now</button>
          )}
        </div>
        {isEdit ? (
          historyRows.length ? (
            <table class="adm-table" style="margin-top:.5rem;">
              <thead>
                <tr><th>Checked At</th><th>Price</th><th></th></tr>
              </thead>
              <tbody>
                {historyRows.map((row, i) => (
                  <tr>
                    <td>{fmtDT(row.checkedAt)}</td>
                    <td class="adm-price">${row.price.toFixed(2)}</td>
                    <td>{i === 0 && <span class="adm-chip adm-chip-ok">latest</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="adm-note">No price history yet — it will be recorded the next time the price is saved.</p>
          )
        ) : (
          <p class="adm-note">On create, the current price becomes the first priceHistory record. Later price edits are appended automatically, so the price history chart becomes real data over time.</p>
        )}
      </div>
    </div>
  </div>

  <!-- ======================= CONTENT ======================= -->
  <div class="adm-tab-panel" data-panel="content">
    <div class="adm-card">
      <h3 class="adm-subhead"><span class="bar"></span>Course Content</h3>
      <div class="adm-grid">
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
            <label class="adm-label" for="description" style="margin-bottom:0;">Short Description</label>
            <button class="adm-btn adm-btn-ghost adm-btn-sm" type="button" id="genDesc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>Generate</button>
          </div>
          <textarea class="adm-textarea" id="description" name="description" rows="3" placeholder="One-two sentence summary shown in listings — or click Generate." style="margin-top:.45rem;">{deal?.description ?? ""}</textarea>
          <span class="adm-hint">Klik Generate untuk membuat ringkasan otomatis dari data di form — tidak perlu copy-paste dari Udemy.</span>
        </div>
        <div>
          <label class="adm-label" for="learn">What you'll learn (one per line)</label>
          <textarea class="adm-textarea" id="learn" name="learn" rows="6" placeholder={"Build production-ready React apps\nOptimize render performance"}>{deal?.learn?.join("\n") ?? ""}</textarea>
        </div>
        <div>
          <label class="adm-label" for="tags">Topics / Tags (one per line)</label>
          <textarea class="adm-textarea" id="tags" name="tags" rows="4" placeholder={"React Hooks\nPerformance Optimization\nFrontend"}>{deal?.tags?.join("\n") ?? ""}</textarea>
          <span class="adm-hint">Real Udemy topics. Shown as chips on the deal page and power the /topics pages (fallback: subcategory).</span>
        </div>
        <div>
          <label class="adm-label" for="keywords">Focus Keywords (one per line)</label>
          <textarea class="adm-textarea" id="keywords" name="keywords" rows="3" placeholder={"react hooks course\nlearn react hooks"}>{deal?.keywords?.join("\n") ?? ""}</textarea>
          <span class="adm-hint">Kata kunci Udemy + turunannya (mis. "react hooks course"). Disisipkan otomatis oleh tombol Generate ke dalam deskripsi.</span>
        </div>
        <div>
          <label class="adm-label" for="requirements">Requirements (one per line)</label>
          <textarea class="adm-textarea" id="requirements" name="requirements" rows="4" placeholder={"Basic JavaScript knowledge\nA computer with internet"}>{deal?.requirements?.join("\n") ?? ""}</textarea>
        </div>
        <div>
          <label class="adm-label" for="editorNote">Editor's take (optional)</label>
          <textarea class="adm-textarea" id="editorNote" name="editorNote" rows="3" placeholder="2–3 kalimat opini redaksi: kenapa kursus ini layak diambil.">{deal?.editorNote ?? ""}</textarea>
          <span class="adm-hint">Tampil di halaman deal sebagai box "Editor's take". Tulis dengan kata-katamu sendiri — ini konten unik yang paling ampuh untuk SEO. Kosongkan jika belum sempat.</span>
        </div>
        <p class="adm-note" style="margin:0;">FAQs halaman deal dibuat otomatis dari data (harga, rating, durasi, garansi) — tidak perlu diisi manual.</p>
      </div>
    </div>
  </div>

  <div class="adm-form-foot">
    <span id="formStatus" class="adm-form-status"></span>
    <a class="adm-btn adm-btn-outline" href="/admin">Cancel</a>
    <button class="adm-btn adm-btn-primary" type="submit">{submitLabel}</button>
  </div>
</form>

<script>
  const form = document.getElementById("couponForm") as HTMLFormElement;
  const isEdit = form.dataset.isEdit === "true";
  const dealId = form.dataset.dealId || null;
  const statusEl = document.getElementById("formStatus");

  function setStatus(text: string, kind = "") {
    if (statusEl) {
      statusEl.textContent = text;
      statusEl.className = `adm-form-status ${kind}`.trim();
      statusEl.style.color = kind === "adm-ok" ? "var(--adm-ok)" : kind === "adm-err" ? "var(--adm-danger)" : "";
    }
  }

  function showTab(name: string) {
    document.querySelectorAll<HTMLElement>(".adm-tab").forEach((t) => t.classList.toggle("active", t.dataset.tab === name));
    document.querySelectorAll<HTMLElement>(".adm-tab-panel").forEach((p) => p.classList.toggle("active", p.dataset.panel === name));
  }

  document.querySelectorAll<HTMLButtonElement>(".adm-tab").forEach((btn) => {
    btn.addEventListener("click", () => showTab(btn.dataset.tab || "basic"));
  });

  const slugSource = document.querySelector<HTMLInputElement>('[data-slug-source]');
  const slugTarget = document.querySelector<HTMLInputElement>('[data-slug-target]');  if (slugSource && slugTarget) {
    slugSource.addEventListener("blur", () => {
      if (!slugTarget.value.trim()) {
        slugTarget.value = slugify(slugSource.value);
      }
    });
  }

  function slugify(s: string): string {
    return s.toLowerCase()
      .replace(/&/g, " and ")
      .replace(/[^\w\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-|-$/g, "");
  }

  const descInput = document.getElementById("description") as HTMLTextAreaElement | null;
  const genDescBtn = document.getElementById("genDesc") as HTMLButtonElement | null;

  function pick<T>(arr: T[], seed: string): T {
    let h = 0;
    for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
    return arr[h % arr.length];
  }

  function cleanTitle(t: string): string {
    return t.replace(/\s*[_\-|:–—]\s*(udemy|course|coupon|free|202\d.*)?$/i, "").trim() || t.trim();
  }

  genDescBtn?.addEventListener("click", () => {
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() || "";
    const title = cleanTitle(val("title"));
    if (!title) {
      setStatus("Fill Course Title first, then click Generate.", "adm-err");
      return;
    }
    const topic = val("subcategory") || val("category") || "this field";
    const rawLevel = val("level");
    const level = rawLevel && rawLevel !== "All Levels" ? `${rawLevel.toLowerCase()} learners` : "learners of all levels";
    const audience = /^beginner/i.test(rawLevel) ? "beginners" : /^intermediate/i.test(rawLevel) ? "intermediate learners" : /^advanced/i.test(rawLevel) ? "advanced learners" : "";
    const learnLines = val("learn").split("\n").map((l) => l.trim()).filter(Boolean);
    const skills = learnLines.slice(0, 2).map((s) => s.charAt(0).toLowerCase() + s.slice(1).replace(/[.。]$/, "")).join(" and ");
    const duration = val("duration");

    // Focus keywords + auto derivatives ("turunan"): "{keyword} for {audience}"
    // A keyword is dropped when it merely repeats the title/topic (>=2
    // significant words already present) so the output stays natural.
    const STOPWORDS = new Set(["the", "and", "for", "with", "from", "into", "learn", "learning", "course", "courses", "guide", "complete", "ultimate", "masterclass", "bootcamp", "class", "training", "tutorial", "tutorials", "practical", "hands", "step", "steps", "beginner", "beginners"]);
    function sigWords(s: string): string[] {
      return (s.toLowerCase().match(/[a-z0-9]+(?:-[a-z0-9]+)?/g) || []).filter((w) => w.replace(/-/g, "").length >= 3 && !STOPWORDS.has(w));
    }
    const kwRaw = val("keywords").split("\n").map((l) => l.trim()).filter(Boolean);
    const titleLc = title.toLowerCase();
    const topicLc = topic.toLowerCase();
    const haystack = `${title} ${topic}`.toLowerCase();
    const freshKw = kwRaw.filter((k) => {
      if (!k || titleLc.includes(k.toLowerCase()) || k.toLowerCase() === topicLc) return false;
      const overlap = sigWords(k).filter((w) => haystack.includes(w)).length;
      return overlap < 2;
    }).slice(0, 3);
    const kwPool = [...freshKw];
    if (freshKw.length && audience) {
      const deriv = `${freshKw[0]} for ${audience}`;
      if (!kwPool.some((k) => k.toLowerCase() === deriv.toLowerCase())) kwPool.push(deriv);
    }
    const kwList = kwPool.slice(0, 3);
    const kwClause = kwList.length ? ` Key topics include ${kwList.join(", ")}.` : "";

    const base = (withSkills: boolean, withDur: boolean) => pick([
      `${title} — a hands-on course on ${topic} for ${level}${withSkills && skills ? `, covering ${skills}` : ""}${withDur && duration ? ` across ${duration} of video` : ""}.`,
      `Learn ${topic} with ${title}, built for ${level}${withSkills && skills ? ` — you'll ${skills}` : ""}${withDur && duration ? ` in ${duration} of practical lessons` : ""}.`,
      `${title} teaches ${topic} step by step for ${level}${withSkills && skills ? `, including ${skills}` : ""}${withDur && duration ? `. Total runtime: ${duration}` : "."}`,
    ], title).replace(/\s+/g, " ").trim();

    const BUDGET = 350;
    const candidates = [
      base(true, true) + kwClause,
      base(true, false) + kwClause,
      base(false, false) + kwClause,
      base(false, false),
    ];
    let text = candidates[candidates.length - 1];
    for (const c of candidates) {
      if (c.length <= BUDGET) { text = c; break; }
    }
    if (descInput) {
      descInput.value = text;
      descInput.focus();
      setStatus("Description generated — review and edit if needed.", "adm-ok");
    }
  });

  const recordCheckBtn = document.getElementById("recordCheck") as HTMLButtonElement | null;
  recordCheckBtn?.addEventListener("click", async () => {
    recordCheckBtn.disabled = true;
    const original = recordCheckBtn.textContent;
    recordCheckBtn.textContent = "…";
    setStatus("Recording check…", "adm-warn");
    try {
      const res = await fetch(`/api/deals?id=${encodeURIComponent(String(dealId))}&check=1`, { method: "PUT" });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Request failed");
      setStatus("Check recorded ✓", "adm-ok");
      setTimeout(() => location.reload(), 500);
    } catch (err) {
      setStatus(`Error: ${(err as Error).message}`, "adm-err");
      recordCheckBtn.disabled = false;
      recordCheckBtn.textContent = original;
    }
  });

  const NUMERIC = new Set(["price", "originalPrice", "rating", "students"]);
  const ARRAYS = new Set(["learn", "requirements", "tags", "keywords"]);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const payload: Record<string, unknown> = {};

    for (const [key, value] of new FormData(form).entries()) {
      const raw = value.toString().trim();
      if (ARRAYS.has(key)) {
        const items = raw.split("\n").map((l) => l.replace(/\r$/, "").trim()).filter(Boolean);
        if (items.length) payload[key] = items;
      } else if (NUMERIC.has(key)) {
        const num = parseFloat(raw);
        if (!isNaN(num)) payload[key] = num;
      } else if (key === "expiresAt" && raw) {
        payload[key] = `${raw}:00+07:00`;
      } else if (raw) {
        payload[key] = raw;
      }
    }

    if (payload.slug === (dealId ?? "")) delete payload.slug;

    setStatus("Saving…", "adm-warn");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;

    try {
      const url = isEdit ? `/api/deals?id=${encodeURIComponent(String(dealId))}` : "/api/deals";
      const res = await fetch(url, {
        method: isEdit ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Request failed");
      }
      setStatus("Saved ✓", "adm-ok");
      setTimeout(() => (window.location.href = "/admin"), 400);
    } catch (err) {
      setStatus(`Error: ${(err as Error).message}`, "adm-err");
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
