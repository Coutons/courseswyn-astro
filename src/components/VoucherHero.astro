---
// Shared hero for voucher pages — mirrors the today-coupon dh-hero pattern:
// badge, big title with brand accent, sub, stats, CTA row + live terminal card.
interface Stat {
  val: string;
  label: string;
}
interface TermLine {
  href: string;
  code: string;
  name: string;
}
interface Props {
  badgeHref: string;
  badgeText: string;
  titleA: string;
  titleAccent: string;
  titleB?: string;
  subHtml: string;
  stats: Stat[];
  primary: { href: string; text: string; external?: boolean };
  secondary?: { href: string; text: string };
  noteHtml?: string;
  termTitle: string;
  termLines: TermLine[];
  termFootHtml: string;
}

const {
  badgeHref,
  badgeText,
  titleA,
  titleAccent,
  titleB = "",
  subHtml,
  stats,
  primary,
  secondary,
  noteHtml = "",
  termTitle,
  termLines,
  termFootHtml,
} = Astro.props as Props;
---

<header class="vh-hero">
  <div class="vh-grid">
    <div>
      <a class="vh-badge" href={badgeHref}><span class="vh-blip"></span> {badgeText}</a>
      <h1 class="vh-title">{titleA} <span style="color: #FF9800">{titleAccent}</span>{titleB ? ` ${titleB}` : ""}</h1>
      <p class="vh-sub" set:html={subHtml} />
      <div class="vh-stats">
        {stats.map((s) => (
          <div class="vh-stat"><b class="vh-stat-val">{s.val}</b><span class="vh-stat-label">{s.label}</span></div>
        ))}
      </div>
      <div class="vh-cta-row">
        {primary.external ? (
          <a class="vh-btn" href={primary.href} target="_blank" rel="sponsored noopener noreferrer">{primary.text}</a>
        ) : (
          <a class="vh-btn" href={primary.href}>{primary.text}</a>
        )}
        {secondary && <a class="vh-btn ghost" href={secondary.href}>{secondary.text}</a>}
      </div>
      {noteHtml && <p class="vh-note" set:html={noteHtml} />}
    </div>

    <div class="vh-fresh">
      <div class="vh-fresh-head"><span>Verified vouchers</span><span class="vh-fresh-count">{termLines.length} listed</span></div>
      <div class="vh-fresh-body">
        {termLines.map((l) => (
          <a class="vh-fresh-line" href={l.href} target="_blank" rel="sponsored noopener noreferrer">
            <span class="vh-fresh-code">{l.code}</span>
            <span class="vh-fresh-ok">✓</span>
            <span class="vh-fresh-name">{l.name}</span>
          </a>
        ))}
      </div>
      <div class="vh-fresh-foot" set:html={termFootHtml} />
    </div>
  </div>
</header>

<style>
  .vh-hero { padding: 0; }
  .vh-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; background: linear-gradient(135deg, #121212 0%, #1E1E1E 100%); border-radius: 24px; padding: clamp(1.75rem, 4vw, 3rem); position: relative; overflow: hidden; }
  .vh-grid::before { content: ''; position: absolute; top: -100px; left: 10%; width: 380px; height: 380px; background: radial-gradient(circle, rgba(255,152,0,0.12) 0%, transparent 65%); pointer-events: none; }
  .vh-grid > * { position: relative; z-index: 1; }
  @media (max-width: 900px) { .vh-grid { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .vh-grid { grid-template-columns: 1fr; } }
  .vh-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 700; color: #E4E4E7; background: rgba(228,228,231,0.08); border: 1px solid rgba(228,228,231,0.2); border-radius: 999px; padding: 6px 14px; margin-bottom: 1.25rem; text-decoration: none; }
  .vh-badge:hover { border-color: #FF9800; color: #FF9800; }
  .vh-blip { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; animation: vhBlip 1.6s infinite; }
  @keyframes vhBlip { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
  .vh-title { font-family: sans-serif; font-size: clamp(2.1rem, 4.3vw, 3rem); font-weight: 800; letter-spacing: -0.02em; color: #E4E4E7; margin: 0 0 0.75rem; line-height: 1.12; }
  .vh-sub { color: rgba(228,228,231,0.78); font-size: 1rem; line-height: 1.7; margin: 0 0 1.5rem; max-width: 560px; }
  .vh-sub strong { color: #E4E4E7; }
  .vh-stats { display: flex; gap: 2rem; flex-wrap: wrap; }
  .vh-stat { display: flex; flex-direction: column; }
  .vh-stat-val { font-size: 1.5rem; font-weight: 800; color: #E4E4E7; font-variant-numeric: tabular-nums; }
  .vh-stat-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9E9E9E; }
  .vh-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 1.5rem 0 0.5rem; }
  .vh-btn { display: inline-block; background: linear-gradient(135deg, #FFB74D 0%, #F57C00 100%); color: #1A1408; font-weight: 700; border-radius: 999px; padding: 0.85rem 1.9rem; text-decoration: none; }
  .vh-btn.ghost { background: transparent; color: #E4E4E7; border: 2px solid rgba(228,228,231,0.4); }
  .vh-btn.ghost:hover { border-color: #FF9800; color: #FF9800; }
  .vh-note { font-size: 0.75rem; color: rgba(228,228,231,0.6); margin: 0.5rem 0 0; line-height: 1.5; }
  .vh-note a { color: #FF9800; font-weight: 600; text-decoration: none; }
  .vh-fresh { background: #1E1E1E; border: 1px solid #2A2A2E; border-radius: 14px; overflow: hidden; text-align: left; }
  .vh-fresh-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: #26262B; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: #E4E4E7; }
  .vh-fresh-count { margin-left: auto; font-size: 0.75rem; font-weight: 700; color: #FF9800; text-transform: none; letter-spacing: 0; }
  .vh-fresh-body { padding: 4px 0; }
  .vh-fresh-line { display: flex; align-items: center; gap: 10px; padding: 8px 16px; font-size: 0.85rem; color: #E4E4E7; text-decoration: none; }
  .vh-fresh-line:hover { background: rgba(255,152,0,0.08); }
  .vh-fresh-code { color: #1A1408; background: linear-gradient(135deg, #FFB74D 0%, #F57C00 100%); font-weight: 700; flex-shrink: 0; font-size: 0.72rem; padding: 3px 9px; border-radius: 6px; min-width: 74px; text-align: center; }
  .vh-fresh-ok { color: #4ADE80; font-weight: 800; flex-shrink: 0; }
  .vh-fresh-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
  .vh-fresh-foot { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--border); background: #26262B; font-size: 0.78rem; color: #9E9E9E; }
  .vh-fresh-foot a { color: #FF9800; font-weight: 600; }
</style>
