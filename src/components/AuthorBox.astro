---
import { Image } from 'astro:assets';

interface Props {
  name?: string;
  bio?: string;
  image?: string;
  readingTime?: number;
  updatedDate?: string;
}

const { name = "Andrew Derek", bio = "Andrew Derek is a lead course analyst and digital education expert with 8+ years of experience evaluating online learning platforms. He has personally reviewed over 500 Udemy courses across programming, AI, data science, and cloud computing — helping students save money with verified 100% off coupon codes while finding high-quality instruction that delivers real career outcomes.", image, readingTime, updatedDate } = Astro.props;
const initials = name.split(' ').map((n: string) => n[0]).join('').substring(0, 2).toUpperCase();
---
<div class="ab" itemscope itemtype="https://schema.org/Person">
  <div class="ab-avatar">
    {image ? (
      <Image src={image} alt={name} width={56} height={56} inferSize={false} />
    ) : (
      <span class="ab-init">{initials}</span>
    )}
  </div>
  <div class="ab-body">
    <div class="ab-name" itemprop="name">{name}</div>
    <div class="ab-role">Lead Course Analyst · CoursesWyn</div>
    <p class="ab-bio" itemprop="description">{bio}</p>
    <div class="ab-links">
      <a href="https://x.com/CoursesWyn" target="_blank" rel="noopener noreferrer" itemprop="sameAs" aria-label="Twitter">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span>X</span>
      </a>
      <a href="https://www.facebook.com/CoursesWyn" target="_blank" rel="noopener noreferrer" itemprop="sameAs" aria-label="Facebook">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span>Facebook</span>
      </a>
    </div>
  </div>
</div>

<style>
  .ab {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, var(--card) 0%, color-mix(in srgb, var(--card) 95%, var(--brand)) 100%);
    border: 1px solid var(--border);
    border-radius: 12px;
    align-items: flex-start;
  }
  .ab-avatar {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: var(--brand);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 20%, transparent);
  }
  .ab-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .ab-init { color: #fff; font-weight: 700; font-size: 1.1rem; }
  .ab-body { flex: 1; min-width: 0; }
  .ab-name { font-weight: 700; font-size: 1rem; color: var(--text); }
  .ab-role { font-size: 0.78rem; color: var(--muted); margin-top: 1px; margin-bottom: 0.5rem; }
  .ab-bio { font-size: 0.85rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.65rem; }
  .ab-links { display: flex; gap: 1.25rem; }
  .ab-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .ab-links a:hover { color: var(--brand); }

  @media (max-width: 500px) {
    .ab { flex-direction: column; align-items: center; text-align: center; }
    .ab-links { justify-content: center; }
  }
</style>
