---
import { Image } from 'astro:assets';

const { deal, loading = 'lazy' } = Astro.props;

function formatDuration(duration: string) {
  if (!duration) return "";
  return duration
    .replace(/(\d+)h/g, '$1 hours')
    .replace(/(\d+)m/g, '$1 minutes')
    .replace(/\s+/g, ' ');
}

function formatRelativeTime(dateString: string) {
  const date = new Date(dateString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffHours / 24);
  if (diffHours < 1) return "Updated recently";
  else if (diffHours < 24) return `Updated ${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;
  else return `Updated ${diffDays} day${diffDays === 1 ? '' : 's'} ago`;
}

const p = typeof deal.price === "number" && isFinite(deal.price) && deal.price > 0 ? deal.price : 0;
const opRaw = typeof deal.originalPrice === "number" && isFinite(deal.originalPrice) ? deal.originalPrice : 119.99;
const op = opRaw > p ? opRaw : 119.99;
const r = typeof deal.rating === "number" && isFinite(deal.rating) ? deal.rating : null;
const hasDiscount = op > p && p > 0;
const discountPct = hasDiscount ? Math.round(100 - (p / op) * 100) : null;
const title = String(deal.title || "").replace(/&amp;/g, "&").replace(/&quot;/g, '"').replace(/&apos;|&#8217;/g, "'").replace(/&ndash;|&#8211;/g, " & ").replace(/\s{2,}/g, " ").trim();
const students = typeof deal.students === "number" && isFinite(deal.students) ? deal.students : null;
const catSlug = (deal.category || "").toLowerCase().replace(/ & /g, "-and-").replace(/ /g, "-").replace(/&/g, "and");
---

<div style={{
  background: "var(--card)",
  borderRadius: "16px",
  border: "1px solid var(--border)",
  overflow: "hidden",
  transition: "all 0.3s ease",
  position: "relative"
}}>
  <div style={{
    height: "180px",
    background: `linear-gradient(135deg, var(--brand-soft) 0%, rgba(255,90,44,0.05) 100%)`,
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    position: "relative"
  }}>
    {deal.image ? (
      <Image 
        src={deal.image}
        alt={title}
        width={400}
        height={225}
        style={{
          width: "100%",
          height: "100%",
          objectFit: "cover"
        }}
        loading="lazy"
        inferSize={false}
      />
    ) : (
      <svg width="60" height="60" viewBox="0 0 24 24" fill="var(--muted)" opacity="0.5">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    )}

    <div style={{
      position: "absolute",
      top: "1rem",
      right: "1rem",
      background: "rgba(0, 0, 0, 0.8)",
      color: "white",
      padding: "0.25rem 0.5rem",
      borderRadius: "4px",
      fontSize: "0.7rem",
      fontWeight: 600,
      backdropFilter: "blur(4px)"
    }}>
      {deal.updatedAt ? formatRelativeTime(deal.updatedAt) : "Updated recently"}
    </div>

    {p === 0 && (
      <div style={{
        position: "absolute",
        top: "1rem",
        left: "1rem",
        background: "var(--brand)",
        color: "var(--bg)",
        padding: "0.25rem 0.75rem",
        borderRadius: "999px",
        fontSize: "0.75rem",
        fontWeight: 700,
        zIndex: 10
      }}>
        FREE
      </div>
    )}
  </div>

  <div style={{ padding: "1.5rem" }}>
    <div style={{
      display: "flex",
      alignItems: "center",
      gap: "0.5rem",
      marginBottom: "0.5rem"
    }}>
      <a href={`/categories/${catSlug}`} style={{
        fontSize: "0.75rem",
        fontWeight: 700,
        color: "var(--brand)",
        textTransform: "uppercase",
        letterSpacing: "0.05em",
        textDecoration: "none"
      }}>{deal.category || "Udemy"}</a>
      <span style={{
        marginLeft: "auto",
        fontSize: "0.7rem",
        fontWeight: 500,
        color: "var(--muted)",
        display: "flex",
        alignItems: "center",
        gap: "0.25rem"
      }}>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="#4ade80">
          <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
        </svg>
        Verified
      </span>
    </div>

    <h3 style={{
      fontSize: "1.1rem",
      fontWeight: 700,
      color: "var(--text)",
      marginBottom: "0.5rem",
      lineHeight: 1.4,
      display: "-webkit-box",
      WebkitLineClamp: 2,
      WebkitBoxOrient: "vertical",
      overflow: "hidden"
    }}>
      <a href={`/coupon/${deal.slug}`} style={{
        color: "inherit",
        textDecoration: "none"
      }}>
        {title}
      </a>
    </h3>

    {deal.instructor && (
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.5rem",
        marginBottom: "0.75rem"
      }}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--muted)">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
        <span style={{
          color: "var(--text)",
          fontSize: "0.85rem",
          fontWeight: 600
        }}>
          By {deal.instructor}
        </span>
      </div>
    )}

    <p style={{
      color: "var(--muted)",
      fontSize: "0.9rem",
      marginBottom: "1rem",
      lineHeight: 1.5,
      display: "-webkit-box",
      WebkitLineClamp: 3,
      WebkitBoxOrient: "vertical",
      overflow: "hidden"
    }}>
      {deal.description || "Master this in-demand skill with comprehensive training from industry experts."}
    </p>

    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      marginBottom: "1rem"
    }}>
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.5rem"
      }}>
        {r && (
          <>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--brand)">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            <span style={{
              color: "var(--muted)",
              fontSize: "0.85rem",
              fontWeight: 600
            }}>
              {r.toFixed(1)} ({students ? `${students}+ students` : 'popular course'})
            </span>
          </>
        )}
      </div>

      {deal.subcategory && (
        <a href={`/topics/${deal.subcategory.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-')}`} style={{
          display: "flex",
          alignItems: "center",
          gap: "0.25rem",
          color: "var(--brand)",
          textDecoration: "none",
          fontSize: "0.8rem",
          fontWeight: 600,
          padding: "0.25rem 0.5rem",
          borderRadius: "4px",
          background: "var(--card-hover)",
          transition: "all 0.3s ease"
        }}>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
          </svg>
          {deal.subcategory}
        </a>
      )}
    </div>

    <div style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      marginBottom: "1rem"
    }}>
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.5rem"
      }}>
        <span style={{
          fontSize: "1.2rem",
          fontWeight: 700,
          color: "var(--brand)"
        }}>
          {p === 0 ? "FREE" : `$${p.toFixed(2)}`}
        </span>
        {hasDiscount && (
          <>
            <span style={{
              textDecoration: "line-through",
              color: "var(--muted)",
              fontSize: "0.9rem"
            }}>
              ${op.toFixed(2)}
            </span>
            <span style={{
              background: "var(--destructive)",
              color: "white",
              padding: "0.25rem 0.5rem",
              borderRadius: "4px",
              fontSize: "0.75rem",
              fontWeight: 700
            }}>
              {discountPct}% OFF
            </span>
          </>
        )}
      </div>
    </div>

    {deal.duration && (
      <div style={{
        display: "flex",
        alignItems: "center",
        gap: "0.35rem",
        marginBottom: "1rem"
      }}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span style={{
          color: "var(--muted)",
          fontSize: "0.8rem",
          fontWeight: 500
        }}>
          {formatDuration(deal.duration)}
        </span>
      </div>
    )}

    <a
      href={deal.url || `/coupon/${deal.slug}`}
      target="_blank"
      rel="noopener noreferrer"
      style={{
        display: "block",
        width: "100%",
        padding: "0.75rem 1.5rem",
        background: "var(--brand)",
        color: "var(--bg)",
        textDecoration: "none",
        borderRadius: "8px",
        textAlign: "center",
        fontWeight: 600,
        fontSize: "0.9rem",
        transition: "all 0.3s ease",
        border: "none",
        cursor: "pointer"
      }}
    >
      {p === 0 ? "Enroll for Free" : "Get Coupon"}
    </a>
  </div>
</div>
